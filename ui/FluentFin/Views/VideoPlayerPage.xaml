<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:c="using:FluentFin.Converters"
    xmlns:flyleaf="using:FlyleafLib.Controls.WinUI"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Views"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <controls:MediaPlayerHost
            x:Name="MediaPlayerHost"
            IsSkipButtonVisible="{x:Bind ViewModel.IsSkipButtonVisible, Mode=OneWay}"
            JellyfinClient="{x:Bind ViewModel.JellyfinClient}"
            MediaPlayerType="{x:Bind ViewModel.MediaPlayerType, Mode=OneWay}"
            Player="{x:Bind ViewModel.MediaPlayer, Mode=TwoWay}"
            Playlist="{x:Bind ViewModel.Playlist, Mode=OneWay}"
            SkipCommand="{x:Bind ViewModel.SkipCommand, Mode=OneWay}"
            Trickplay="{x:Bind ViewModel.TrickplayViewModel}"
            Visibility="{x:Bind CollapsedIf(ViewModel.IsMpv), Mode=OneWay}" />

        <!--
            MPV player: the backend's mpv draws into a Win32 child window that FluentFin keeps exactly over MpvVideoArea.
            XAML cannot draw over that window, so the message bar has its own row above it; transport controls are mpv's OSC.
        -->
        <Grid x:Name="MpvRoot" Visibility="{x:Bind VisibleIf(ViewModel.IsMpv), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar
                x:Name="MpvMessageBar"
                Grid.Row="0"
                IsClosable="True"
                IsOpen="{x:Bind HasText(ViewModel.MpvMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.MpvMessage, Mode=OneWay}"
                Severity="{x:Bind SeverityOf(ViewModel.MpvMessageIsError), Mode=OneWay}" />

            <Grid
                x:Name="MpvVideoArea"
                Grid.Row="1"
                Background="Black">
                <!--
                    fluentfin-mpv: the loading screen (docs/research/ux-review.md V10): what is starting, its backdrop, the
                    step and a Cancel. Collapsed while mpv's window is shown: under it the button would keep the keyboard.
                -->
                <Grid x:Name="MpvStartScreen" Visibility="{x:Bind VisibleIf(ViewModel.IsMpvStartScreenVisible), Mode=OneWay}">
                    <Image
                        x:Name="MpvBackdrop"
                        AutomationProperties.AccessibilityView="Raw"
                        Opacity="0.35"
                        Source="{x:Bind c:BaseItemDtoConverters.GetImage(ViewModel.MpvStartingItem, jm:ImageType.Backdrop, 720), Mode=OneWay}"
                        Stretch="UniformToFill" />
                    <Rectangle AutomationProperties.AccessibilityView="Raw">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#66000000" />
                                <GradientStop Offset="1" Color="#E6000000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel
                        x:Name="MpvStartPanel"
                        MaxWidth="640"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RequestedTheme="Dark"
                        Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.MpvStartingTitle, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind VisibleIfText(ViewModel.MpvStartingTitle), Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.MpvStartingSubtitle, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind VisibleIfText(ViewModel.MpvStartingSubtitle), Mode=OneWay}" />
                        <ProgressRing
                            Width="48"
                            Height="48"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsMpvStarting, Mode=OneWay}"
                            Visibility="{x:Bind VisibleIf(ViewModel.IsMpvStarting), Mode=OneWay}" />
                        <TextBlock
                            x:Name="MpvStepText"
                            HorizontalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.MpvStatusText, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <Button
                            x:Name="MpvLeaveButton"
                            MinWidth="120"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.LeaveMpvCommand}"
                            Content="{x:Bind ViewModel.MpvLeaveText, Mode=OneWay}"
                            GotFocus="OnLeaveButtonFocus"
                            LostFocus="OnLeaveButtonFocus" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</Page>
