<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.LibrariesLandingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    x:Name="Page"
    mc:Ignorable="d">

    <Grid RowSpacing="20" Margin="36,40,36,40">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock
        AutomationProperties.HeadingLevel="Level1"
        Style="{StaticResource GlassPageTitleTextBlockStyle}"
        Text="Libraries" />
    <ItemsView
        Grid.Row="1"
        IsItemInvokedEnabled="True"
        ItemInvoked="ItemsView_ItemInvoked"
        ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}"
        SelectionMode="None">
        <ItemsView.ItemTemplate>
            <DataTemplate x:DataType="jm:BaseItemDto">
                <!--  fluentfin-mpv: Narrator reads the library's name for the tile (ux-review A1)  -->
                <ItemContainer AutomationProperties.Name="{x:Bind Name}">
                    <!--
                        1.2.0 (1.1.3 layout audit, item 23): the art alone has the corners, 16:9 and filled without stretching, and the
                        name is a plain caption under it, as a poster's (it sat on a solid strip of its own, white in light)
                    -->
                    <Grid RowSpacing="8">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Command="{x:Bind root:App.Commands.PinToSideBarCommand}"
                                    CommandParameter="{x:Bind}"
                                    Icon="{ui:FontIcon Glyph=&#xE718;}"
                                    Text="Add to the top bar" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid CornerRadius="{StaticResource GlassCardCornerRadius}">
                            <controls:LoadingImage
                                Glyph="&#xEA8C;"
                                Source="{x:Bind c:BaseItemDtoConverters.GetImage((jm:BaseItemDto), jm:ImageType.Primary, 270)}"
                                Stretch="UniformToFill" />
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </ItemContainer>
            </DataTemplate>
        </ItemsView.ItemTemplate>
        <ItemsView.Layout>
            <!--  tiles that fill the row and keep their shape (16:9 art at 320 x 180, the caption under it)  -->
            <UniformGridLayout
                ItemsStretch="Uniform"
                MinColumnSpacing="16"
                MinItemHeight="210"
                MinItemWidth="320"
                MinRowSpacing="24" />
        </ItemsView.Layout>
    </ItemsView>
    </Grid>
</Page>
