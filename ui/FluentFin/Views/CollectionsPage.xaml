<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.6 (smart collections, plan 4.1): the Collections page: every collection in one place, skinned by the theme like
    the 1.4.0 Libraries page (its PageHeaderStyle title, gutter and ground). Rows: the server's box sets (tidied names,
    "6 films · 3 left"), Playlists, Made by Nixie by kind (each row ending in "See all"), Saved. A Nixie collection's tile is
    a 2×2 mosaic of its titles with a small Nixie mark; Narrator hears "made by Nixie". "See all" shows one row as a grid.
-->
<Page
    x:Class="FluentFin.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sc="using:FluentFin.Core.SmartCollections"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Background="{ThemeResource PageGroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  one tile: the art (the set's poster, or a Nixie collection's mosaic and mark), then its name and what it holds.
              1.7.1 (review M1): what it holds, its spoken name and its art change in place as a first read's pages come.
              1.8 (P1-4, stream t): a Nixie tile says its reason line (the facts, two lines at most, then the count on a line
              of its own, never cut off) and wears up to two award badges over its art; Narrator hears them in that order.
              The words take one height on every tile (NixieTileShown.WordsHeight: a title of two lines, facts of two and
              three count lines, grown with Windows' text size), so every tile of a row and of See all's grid is one size,
              nothing is clipped at 125 or 150 % text, and a reason that comes later moves nothing (rule 7). A badge too long
              for one line ("3 BAFTA Best Film winners") wraps to a second over the art; the tile keeps its size  -->
        <DataTemplate x:Key="CollectionTileTemplate" x:DataType="vm:CollectionTile">
            <Button
                Width="168"
                Margin="0,0,16,0"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind sc:NixieTileWords.TileName(AutomationName, Nixie), Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                Click="Tile_Click"
                CornerRadius="{StaticResource GlassCardCornerRadius}"
                FocusVisualMargin="-4"
                Style="{StaticResource BareButtonStyle}"
                Tag="{x:Bind}"
                ToolTipService.ToolTip="{x:Bind Title}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="252" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        AutomationProperties.AccessibilityView="Raw"
                        Background="{ThemeResource GlassInsetFillBrush}"
                        CornerRadius="{StaticResource GlassCardCornerRadius}">
                        <lc:LoadingImage
                            Glyph="&#xE8F1;"
                            Source="{x:Bind local:CollectionsPage.SetArt(Set), Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind local:CollectionsPage.ShownUnless(IsNixie)}" />
                        <lc:CollectionMosaic ImageHeight="252" Items="{x:Bind Mosaic, Mode=OneWay}" Visibility="{x:Bind IsNixie}" />
                        <!--  the Nixie mark: a small lit "N" over a dark plate, legible on any poster (Narrator: the tile's "made by Nixie")  -->
                        <Border
                            Width="26"
                            Height="26"
                            Margin="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#D9141018"
                            BorderBrush="#66FFC4A6"
                            BorderThickness="1"
                            CornerRadius="8"
                            ToolTipService.ToolTip="Made by Nixie"
                            Visibility="{x:Bind IsNixie}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#FFFFC4A6"
                                Text="N" />
                        </Border>
                        <!--  1.8 (P1-4): the award badges, over the art's foot (the chips of the cards' counts; Narrator: the tile's name)  -->
                        <StackPanel
                            x:Name="TileBadges"
                            Margin="0,0,0,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Spacing="4">
                            <Border
                                Height="Auto"
                                MinHeight="{StaticResource NixieBadgeSize}"
                                Margin="8,0,8,0"
                                Padding="8,3"
                                Style="{StaticResource NixieCountChipStyle}"
                                Visibility="{x:Bind local:NixieTileShown.Badge(Nixie, 0), Mode=OneWay}">
                                <TextBlock
                                    FontSize="12"
                                    MaxLines="2"
                                    Style="{StaticResource NixieCountChipTextStyle}"
                                    Text="{x:Bind sc:NixieTileWords.Badge(Nixie, 0), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </Border>
                            <Border
                                Height="Auto"
                                MinHeight="{StaticResource NixieBadgeSize}"
                                Margin="8,0,8,0"
                                Padding="8,3"
                                Style="{StaticResource NixieCountChipStyle}"
                                Visibility="{x:Bind local:NixieTileShown.Badge(Nixie, 1), Mode=OneWay}">
                                <TextBlock
                                    FontSize="12"
                                    MaxLines="2"
                                    Style="{StaticResource NixieCountChipTextStyle}"
                                    Text="{x:Bind sc:NixieTileWords.Badge(Nixie, 1), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel
                        Grid.Row="1"
                        Height="{x:Bind local:NixieTileShown.WordsHeight}"
                        Padding="4,0,4,0"
                        Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlassTextPrimaryBrush}"
                            MaxLines="2"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />
                        <!--  1.8: a Nixie tile's facts ("TMDb keyword “heist”"), or a server's set's "6 films · 3 left"  -->
                        <TextBlock
                            x:Name="TileFacts"
                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                            MaxLines="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind sc:NixieTileWords.TileFacts(Detail, Nixie), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />
                        <!--  1.8: a Nixie tile's count, how many are watched and its end date, each on a line of its own ("1,204 titles", "1,150 unwatched", "until Sun 29 Nov")  -->
                        <TextBlock
                            x:Name="TileCount"
                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                            MaxLines="3"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind sc:NixieTileWords.TileCount(Nixie), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollView x:Name="PageScroller" HorizontalScrollMode="Disabled">
        <StackPanel
            x:Name="PageContent"
            Padding="36,72,36,48"
            lc:PageGrid.Apply="True"
            Spacing="20">
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level1"
                AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                Style="{StaticResource PageHeaderStyle}"
                Text="{x:Bind lc:PageGrid.Title(ViewModel.Title), Mode=OneWay}" />

            <!--
                the first read of the libraries: Made by Nixie is on its way (1.7.1, BH-171-m1: or it stopped part way, said so).
                1.7.3 (BH-171-m4): the panel around it is the page's (ShowReadingLine): when the line goes, the panel keeps its
                height for the rest of the visit, so the rows under the keyboard and the pointer stay where they are
            -->
            <Grid
                x:Name="ReadingPanel"
                MinHeight="20"
                Visibility="Collapsed">
                <StackPanel
                    x:Name="ReadingLine"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.ShowsReadingLine, Mode=OneWay}">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsReadingIndex, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsReadingIndex, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource GlassTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.ReadingText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!--  the rows; an ItemsControl, not a virtualizing repeater, so Tab reaches every row  -->
            <ItemsControl
                x:Name="RowsView"
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Rows}"
                Visibility="{x:Bind local:CollectionsPage.ShownUnless(ViewModel.IsSeeAll), Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CollectionsRow">
                        <StackPanel Spacing="8">
                            <!--  the Made by Nixie section's heading: a small lit kicker over its rows, as Home's rows wear it  -->
                            <StackPanel Margin="0,28,0,4" Orientation="Horizontal" Spacing="10" Visibility="{x:Bind HasHeading}">
                                <Border
                                    Width="26"
                                    Height="26"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Background="#D9141018"
                                    BorderBrush="#66FFC4A6"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFC4A6"
                                        Text="N" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level2"
                                    CharacterSpacing="80"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                    Text="{x:Bind local:CollectionsPage.Kicker(Heading)}" />
                            </StackPanel>
                            <lc:ShelfRow
                                HasSeeAll="{x:Bind HasSeeAll}"
                                Header="{x:Bind Title}"
                                ItemTemplate="{StaticResource CollectionTileTemplate}"
                                ItemsSource="{x:Bind Tiles}"
                                SeeAll="Row_SeeAll"
                                Tag="{x:Bind}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!--
                1.8 (the owner: "reverse the direction of the sort in collections"): See all's direction, as the Library's
                button: an icon of one width (no jump when it flips), its arrow the way the tiles run, Narrator "A to Z, switch to
                Z to A"; the words beside it. A tab stop before the grid, so keyboard and gamepad reach it
            -->
            <StackPanel
                x:Name="GridDirectionBar"
                Orientation="Horizontal"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsSeeAll, Mode=OneWay}">
                <Button
                    x:Name="GridDirectionButton"
                    AutomationProperties.Name="{x:Bind ViewModel.GridDirectionName, Mode=OneWay}"
                    Click="GridDirection_Click"
                    Style="{StaticResource NixieCompactIconButtonStyle}"
                    ToolTipService.Placement="Bottom"
                    ToolTipService.ToolTip="{x:Bind ViewModel.GridDirectionTip, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.GridDirectionGlyph, Mode=OneWay}" />
                </Button>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Foreground="{ThemeResource GlassTextSecondaryBrush}"
                    Text="{x:Bind ViewModel.GridDirectionWords, Mode=OneWay}" />
            </StackPanel>

            <!--  See all: one row's tiles as a grid  -->
            <lc:RowList
                x:Name="GridList"
                AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                TabFocusNavigation="Once"
                Visibility="{x:Bind ViewModel.IsSeeAll, Mode=OneWay}"
                XYFocusKeyboardNavigation="Enabled">
                <ItemsRepeater
                    x:Name="GridRepeater"
                    ItemTemplate="{StaticResource CollectionTileTemplate}"
                    ItemsSource="{x:Bind ViewModel.GridTiles, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            MinColumnSpacing="16"
                            MinRowSpacing="24"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </lc:RowList>

            <!--  loading, nothing yet, or the server could not be read: said, with Retry  -->
            <lc:LoadStateView ShowsLoading="True" State="{x:Bind ViewModel.State}" />
        </StackPanel>
    </ScrollView>
</Page>
