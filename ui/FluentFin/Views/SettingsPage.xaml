<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.JellyfinSettings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Views.JellyfinSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mpv="using:FluentFin.Core.Mpv"
    xmlns:outside="using:FluentFin.Core.Outside"
    xmlns:root="using:FluentFin"
    xmlns:s="using:FluentFin.Core.Contracts.Services"
    xmlns:sc="using:FluentFin.Core.SmartCollections"
    xmlns:settings="using:FluentFin.Core.Settings"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Background="{ThemeResource PageGroundBrush}"
    mc:Ignorable="d">


    <!--
        Seaglass 1.1.4 (layout audit, items 3 and 17): no panel around a group: its header (Body Strong) sits above its cards,
        which keep the toolkit's own card look, as Windows Settings does; the column is left-aligned.
    -->

    <!--  fluentfin-mpv: scrolls (the Playback section made it taller than a window) and narrows with the window  -->
    <!--
        Seaglass 1.1.3 (UX review, prioritised fixes 1, 2, 6 and 9): every group has a title, in task order: Appearance,
        Playback, Audio and subtitles, Servers and accounts, Integrations, then Advanced and About last. Removing a server or a
        sign-in is a neutral button that asks first, naming it (SettingsViewModel.Confirm).
        Seaglass 1.1.4 (fix 15): Other devices (Quick Connect, SyncPlay) after Servers and accounts.
    -->
    <ScrollViewer>
        <!--  left-aligned: one star column up to 1000 px; the rest of a wide window stays empty on the right  -->
        <!--  Nixie 1.4.0 (the UX review's plan item 13, CL-m7): on the theme's page grid: its gutter, the title at its y, its title style  -->
        <Grid
            x:Name="SettingsColumn"
            Padding="36,72,36,40"
            controls:PageGrid.Apply="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,4">
                <TextBlock
                    HorizontalAlignment="Left"
                    AutomationProperties.HeadingLevel="Level1"
                    AutomationProperties.Name="Settings"
                    Style="{StaticResource PageHeaderStyle}"
                    Text="{x:Bind controls:PageGrid.Title('Settings')}" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="2">
                <!--  Seaglass: Settings > Appearance; the choice is saved on this PC and applies at once  -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="1,28,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Appearance" />
                    <!--
                        Nixie 1.3.0: the layout theme, one tile per theme (ThemePicker), applied at once and saved on this PC
                        (ThemeSwitcher); under it the active theme's own options (ILayoutTheme.CreateOptions). Hidden in a build
                        with one theme.
                    -->
                    <StackPanel
                        x:Name="ThemeSection"
                        Margin="0,0,0,8"
                        Spacing="6"
                        Visibility="{x:Bind ThemePicker.HasChoice}">
                        <TextBlock
                            Margin="1,0,0,0"
                            AutomationProperties.HeadingLevel="Level3"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Theme" />
                        <TextBlock
                            Margin="1,0,0,4"
                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Changes the layout of the browsing pages. It applies at once and keeps your place; buttons, keys, dialogs and menus stay the same."
                            TextWrapping="WrapWholeWords" />
                        <controls:ThemePicker x:Name="ThemeTiles" ViewModel="{x:Bind ThemePicker}" />
                        <StackPanel Spacing="4" Visibility="{x:Bind ThemePicker.HasOptions, Mode=OneWay}">
                            <TextBlock
                                Margin="1,4,0,2"
                                AutomationProperties.HeadingLevel="Level3"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ThemePicker.OptionsHeader, Mode=OneWay}" />
                            <ContentPresenter x:Name="ThemeOptions" Content="{x:Bind ThemePicker.OptionsBlock, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <ctk:SettingsCard
                        Description="{x:Bind ViewModel.SelectedGlass.Description, Mode=OneWay}"
                        Header="Glass"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <ComboBox
                            MinWidth="160"
                            AutomationProperties.Name="Glass"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind vm:SettingsViewModel.GlassChoices}"
                            SelectedItem="{x:Bind ViewModel.SelectedGlass, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <!--  1.2.0 merge: the library stream's Continue Watching cleanup (ContinueWatchingSettingViewModel), on this PC only  -->
                    <ctk:SettingsCard
                        Description="{x:Bind ContinueWatching.Description}"
                        Header="{x:Bind ContinueWatching.Header}"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE81C;}">
                        <ComboBox
                            MinWidth="160"
                            AutomationProperties.Name="{x:Bind ContinueWatching.Header}"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ContinueWatching.Choices}"
                            SelectedItem="{x:Bind ContinueWatching.Selected, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <!--  1.5 fixes: rewatching in Up next and Continue Watching (the owner's 1.5 choice: on by default), on this PC only  -->
                    <ctk:SettingsCard
                        Description="Up next and Continue Watching show the next episode of a show you're watching again. Only on this PC."
                        Header="Include shows I'm rewatching"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8EE;}">
                        <ToggleSwitch AutomationProperties.Name="Include shows I'm rewatching" IsOn="{x:Bind ViewModel.IncludeRewatching, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <!--  END 1.5 fixes  -->

                </StackPanel>
                <!--  1.6 collections: Settings > Collections, on this PC: tidy names, Home's Made by Nixie rows, each kind  -->
                <StackPanel x:Name="CollectionsSection" Spacing="4">
                    <TextBlock
                        Margin="1,28,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Collections" />
                    <ctk:SettingsCard
                        Description="{x:Bind CollectionsSettings.TidyNames.Description}"
                        Header="{x:Bind CollectionsSettings.TidyNames.Name}"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8F1;}">
                        <ToggleSwitch AutomationProperties.Name="{x:Bind CollectionsSettings.TidyNames.Name}" IsOn="{x:Bind CollectionsSettings.TidyNames.IsOn, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <ctk:SettingsExpander
                        x:Name="NixieHomeRowsExpander"
                        Description="Rows of collections Nixie makes from your libraries, after New in. Only on this PC."
                        Header="Made by Nixie on Home"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE80F;}"
                        ItemsSource="{x:Bind CollectionsSettings.HomeRows}">
                        <ctk:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="sc:CollectionSwitch">
                                <ctk:SettingsCard Description="{x:Bind Description}" Header="{x:Bind Name}">
                                    <ToggleSwitch AutomationProperties.Name="{x:Bind Name}" IsOn="{x:Bind IsOn, Mode=TwoWay}" />
                                </ctk:SettingsCard>
                            </DataTemplate>
                        </ctk:SettingsExpander.ItemTemplate>
                    </ctk:SettingsExpander>
                    <ctk:SettingsExpander
                        x:Name="NixieKindsExpander"
                        Description="The kinds of collection Nixie makes from your server's own data, on the Collections page and Home. Nothing is sent anywhere."
                        Header="Made by Nixie collections"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8FD;}"
                        ItemsSource="{x:Bind CollectionsSettings.Kinds}">
                        <ctk:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="sc:CollectionSwitch">
                                <ctk:SettingsCard Header="{x:Bind Name}">
                                    <ToggleSwitch AutomationProperties.Name="{x:Bind Name}" IsOn="{x:Bind IsOn, Mode=TwoWay}" />
                                </ctk:SettingsCard>
                            </DataTemplate>
                        </ctk:SettingsExpander.ItemTemplate>
                    </ctk:SettingsExpander>
                </StackPanel>
                <!--  end 1.6 collections  -->
                <!--
                    1.7 keyless: Settings > Look up lists online (Core\Outside): a switch per outside source, every one off until the
                    user turns it on, each with its "What is sent" card (as "Look up intros online") and a status line in Nixie's
                    own words (the last refusal, or that the lists are up to date). Kept on this PC.
                -->
                <StackPanel x:Name="OutsideListsSection" Spacing="4">
                    <TextBlock
                        Margin="1,28,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Look up lists online" />
                    <TextBlock
                        x:Name="OutsideListsIntro"
                        Margin="1,0,0,4"
                        Foreground="{ThemeResource GlassTextSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Public lists Nixie fetches and matches to your libraries on this PC. Nothing about your server, account or libraries is sent. Each one is off until you turn it on."
                        TextWrapping="WrapWholeWords" />
                    <ctk:SettingsExpander
                        x:Name="TmdbExportsExpander"
                        Description="{x:Bind OutsideSources.TmdbExports.Description}"
                        Header="{x:Bind OutsideSources.TmdbExports.Name}"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8F1;}">
                        <ToggleSwitch
                            x:Name="TmdbExportsSwitch"
                            AutomationProperties.Name="{x:Bind OutsideSources.TmdbExports.Name}"
                            IsOn="{x:Bind OutsideSources.TmdbExports.IsOn, Mode=TwoWay}" />
                        <ctk:SettingsExpander.Items>
                            <ctk:SettingsCard
                                AutomationProperties.Name="What is sent to TMDb"
                                Description="{x:Bind OutsideSources.TmdbExports.WhatIsSent}"
                                Header="What is sent">
                                <HyperlinkButton
                                    AutomationProperties.Name="TMDb, opens in your browser"
                                    Content="{x:Bind OutsideSources.TmdbExports.Link.Text}"
                                    NavigateUri="{x:Bind OutsideSources.TmdbExports.Link.Uri}" />
                            </ctk:SettingsCard>
                            <ctk:SettingsCard
                                AutomationProperties.Name="{x:Bind OutsideSources.TmdbExports.StatusName}"
                                Description="{x:Bind OutsideSources.TmdbExports.Status, Mode=OneWay}"
                                Header="Status" />
                        </ctk:SettingsExpander.Items>
                    </ctk:SettingsExpander>
                    <ctk:SettingsExpander
                        x:Name="WikidataExpander"
                        Description="{x:Bind OutsideSources.Wikidata.Description}"
                        Header="{x:Bind OutsideSources.Wikidata.Name}"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE734;}">
                        <ToggleSwitch
                            x:Name="WikidataSwitch"
                            AutomationProperties.Name="{x:Bind OutsideSources.Wikidata.Name}"
                            IsOn="{x:Bind OutsideSources.Wikidata.IsOn, Mode=TwoWay}" />
                        <ctk:SettingsExpander.Items>
                            <ctk:SettingsCard
                                AutomationProperties.Name="What is sent to Wikidata"
                                Description="{x:Bind OutsideSources.Wikidata.WhatIsSent}"
                                Header="What is sent">
                                <HyperlinkButton
                                    AutomationProperties.Name="Wikidata, opens in your browser"
                                    Content="{x:Bind OutsideSources.Wikidata.Link.Text}"
                                    NavigateUri="{x:Bind OutsideSources.Wikidata.Link.Uri}" />
                            </ctk:SettingsCard>
                            <!--  1.7 keyless (Wikidata): the query endpoint, as its service moves to a new backend (available through June 2027)  -->
                            <ctk:SettingsCard
                                x:Name="WikidataEndpointCard"
                                AutomationProperties.Name="Wikidata query endpoint"
                                Description="{x:Bind OutsideSources.SelectedWikidataEndpoint.Description, Mode=OneWay}"
                                Header="Query endpoint">
                                <ComboBox
                                    x:Name="WikidataEndpointBox"
                                    MinWidth="220"
                                    AutomationProperties.Name="Wikidata query endpoint"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind outside:OutsideSourcesSettingsViewModel.WikidataEndpoints}"
                                    SelectedItem="{x:Bind OutsideSources.SelectedWikidataEndpoint, Mode=TwoWay}" />
                            </ctk:SettingsCard>
                            <ctk:SettingsCard
                                x:Name="WikidataCustomCard"
                                AutomationProperties.Name="Wikidata endpoint address"
                                Description="{x:Bind OutsideSources.WikidataCustomNote, Mode=OneWay}"
                                Header="Endpoint address"
                                Visibility="{x:Bind c:Converters.BooleanToVisibility(OutsideSources.IsCustomEndpoint), Mode=OneWay}">
                                <TextBox
                                    x:Name="WikidataCustomBox"
                                    MinWidth="320"
                                    AutomationProperties.Name="Wikidata endpoint address"
                                    PlaceholderText="https://"
                                    Text="{x:Bind OutsideSources.WikidataCustomUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </ctk:SettingsCard>
                            <ctk:SettingsCard
                                AutomationProperties.Name="{x:Bind OutsideSources.Wikidata.StatusName}"
                                Description="{x:Bind OutsideSources.Wikidata.Status, Mode=OneWay}"
                                Header="Status" />
                        </ctk:SettingsExpander.Items>
                    </ctk:SettingsExpander>
                    <!--  1.7 trending: stream T adds Trakt and TMDb trending in this panel (their switches, "What is sent" cards and the token field)  -->
                    <StackPanel x:Name="TrendingSourcesPanel" Spacing="4">
                        <!--
                            1.7 trending: Trakt (its Client ID only, built into a release; no sign-in, ever: the switch can't turn on in a
                            build without one) and TMDb trending (the user's own token, kept with DPAPI and never shown back)
                        -->
                        <ctk:SettingsExpander
                            x:Name="TraktExpander"
                            Description="{x:Bind TrendingSources.Trakt.Description}"
                            Header="{x:Bind TrendingSources.Trakt.Name}"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE9D2;}">
                            <ToggleSwitch
                                x:Name="TraktSwitch"
                                AutomationProperties.Name="{x:Bind TrendingSources.Trakt.Name}"
                                IsEnabled="{x:Bind TrendingSources.Trakt.IsAvailable}"
                                IsOn="{x:Bind TrendingSources.Trakt.IsOn, Mode=TwoWay}" />
                            <ctk:SettingsExpander.Items>
                                <ctk:SettingsCard
                                    AutomationProperties.Name="{x:Bind TrendingSources.Trakt.WhatIsSentName}"
                                    Description="{x:Bind TrendingSources.Trakt.WhatIsSent}"
                                    Header="What is sent">
                                    <HyperlinkButton
                                        AutomationProperties.Name="{x:Bind TrendingSources.Trakt.LinkName}"
                                        Content="{x:Bind TrendingSources.Trakt.Link.Text}"
                                        NavigateUri="{x:Bind TrendingSources.Trakt.Link.Uri}" />
                                </ctk:SettingsCard>
                                <ctk:SettingsCard
                                    AutomationProperties.Name="{x:Bind TrendingSources.Trakt.StatusName}"
                                    Description="{x:Bind TrendingSources.Trakt.Status, Mode=OneWay}"
                                    Header="Status" />
                            </ctk:SettingsExpander.Items>
                        </ctk:SettingsExpander>
                        <ctk:SettingsExpander
                            x:Name="TmdbTrendingExpander"
                            Description="{x:Bind TrendingSources.TmdbTrending.Description}"
                            Header="{x:Bind TrendingSources.TmdbTrending.Name}"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE8B2;}">
                            <ToggleSwitch
                                x:Name="TmdbTrendingSwitch"
                                AutomationProperties.Name="{x:Bind TrendingSources.TmdbTrending.Name}"
                                IsEnabled="{x:Bind TrendingSources.TmdbTrending.IsAvailable, Mode=OneWay}"
                                IsOn="{x:Bind TrendingSources.TmdbTrending.IsOn, Mode=TwoWay}" />
                            <ctk:SettingsExpander.Items>
                                <ctk:SettingsCard
                                    x:Name="TmdbTokenCard"
                                    AutomationProperties.Name="Your TMDb token"
                                    Description="{x:Bind TrendingSources.TokenDescription, Mode=OneWay}"
                                    Header="Your TMDb token">
                                    <StackPanel MaxWidth="420" Spacing="6">
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <PasswordBox
                                                x:Name="TmdbTokenBox"
                                                Width="240"
                                                AutomationProperties.Name="TMDb API Read Access Token"
                                                Password="{x:Bind TrendingSources.TokenEntry, Mode=TwoWay}"
                                                PlaceholderText="Paste your token" />
                                            <Button
                                                x:Name="SaveTmdbTokenButton"
                                                AutomationProperties.Name="Save TMDb token"
                                                Command="{x:Bind TrendingSources.SaveTokenCommand}"
                                                Content="Save" />
                                            <Button
                                                x:Name="RemoveTmdbTokenButton"
                                                AutomationProperties.Name="Remove TMDb token"
                                                Command="{x:Bind TrendingSources.RemoveTokenCommand}"
                                                Content="Remove"
                                                Visibility="{x:Bind c:Converters.BooleanToVisibility(TrendingSources.HasToken), Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="TmdbTokenMessage"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.LiveSetting="Polite"
                                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind TrendingSources.TokenMessage, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard
                                    AutomationProperties.Name="{x:Bind TrendingSources.TmdbTrending.WhatIsSentName}"
                                    Description="{x:Bind TrendingSources.TmdbTrending.WhatIsSent}"
                                    Header="What is sent">
                                    <HyperlinkButton
                                        AutomationProperties.Name="{x:Bind TrendingSources.TmdbTrending.LinkName}"
                                        Content="{x:Bind TrendingSources.TmdbTrending.Link.Text}"
                                        NavigateUri="{x:Bind TrendingSources.TmdbTrending.Link.Uri}" />
                                </ctk:SettingsCard>
                                <ctk:SettingsCard
                                    AutomationProperties.Name="{x:Bind TrendingSources.TmdbTrending.StatusName}"
                                    Description="{x:Bind TrendingSources.TmdbTrending.Status, Mode=OneWay}"
                                    Header="Status" />
                            </ctk:SettingsExpander.Items>
                        </ctk:SettingsExpander>
                    </StackPanel>
                    <!--  end 1.7 trending  -->
                </StackPanel>
                <!--  end 1.7 keyless  -->
                <!--  fluentfin-mpv: Settings > Playback (docs/research/ux-review.md T1)  -->
                <!--  kept on this PC; the bridge has no field for the skip and wheel settings yet (docs/BRIDGE.md v1), so mpv's own controls ignore them;
                      Nixie's player controls over the MPV player use the Skip button, the wheel and the step (MpvControlsViewModel)  -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="1,28,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Playback" />
                    <!--  Seaglass 1.1.3: only when this copy can run more than one player  -->
                    <ctk:SettingsCard
                        Description="Plays everything you play here, and what other devices send here by remote control. Takes effect at once."
                        Header="Player"
                        HeaderIcon="{ui:FontIcon Glyph=&#xEA69;}"
                        Visibility="{x:Bind c:Converters.BooleanToVisibility(HasPlayerChoice)}">
                        <ComboBox
                            AutomationProperties.Name="Player"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind vm:SettingsViewModel.MediaPlayers}"
                            SelectedItem="{x:Bind ViewModel.SelectedMediaPlayer, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <!--  fluentfin-mpv player controls: who draws the controls over the MPV player's video (docs/research/player-controls.md)  -->
                    <ctk:SettingsCard
                        Description="This app's own controls or mpv's. If mpv's library can't load on this PC, mpv's are used and the player says so."
                        Header="Player controls"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE768;}"
                        Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsMpvSelected), Mode=OneWay}">
                        <ComboBox
                            x:Name="PlayerControlsBox"
                            AutomationProperties.Name="Player controls"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind vm:SettingsViewModel.PlayerControlsChoices}"
                            SelectedItem="{x:Bind ViewModel.SelectedPlayerControls, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        Description="With Nixie's player controls and Windows Media Player. mpv's own controls have their own setting."
                        Header="Show Skip intro and Skip credits"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE893;}">
                        <ToggleSwitch AutomationProperties.Name="Show Skip intro and Skip credits" IsOn="{x:Bind ViewModel.ShowSkipPrompt, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <!--  Seaglass 1.1.4 (layout audit, item 17): a one-line description; what is sent and the three sources under the expander, not beside the toggle  -->
                    <ctk:SettingsExpander
                        x:Name="IntrosOnlineExpander"
                        Description="When the server and the file mark no intro or credits, ask TheIntroDB or AniSkip. Off by default."
                        Header="Look up intros online"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE774;}">
                        <ToggleSwitch AutomationProperties.Name="Look up intros online" IsOn="{x:Bind ViewModel.LookUpIntrosOnline, Mode=TwoWay}" />
                        <ctk:SettingsExpander.Items>
                            <ctk:SettingsCard
                                Description="Sent: the show's public ID, season, episode and length. Not sent: your server, account or file names. For anime, AniSkip finds the show through arm.haglund.dev."
                                Header="What is sent">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <HyperlinkButton Content="TheIntroDB" NavigateUri="https://theintrodb.org" />
                                    <HyperlinkButton Content="AniSkip" NavigateUri="https://aniskip.com" />
                                    <HyperlinkButton Content="arm.haglund.dev" NavigateUri="https://arm.haglund.dev" />
                                </StackPanel>
                            </ctk:SettingsCard>
                        </ctk:SettingsExpander.Items>
                    </ctk:SettingsExpander>
                    <!--
                        1.6 skip: skipping repeated extras (docs/BRIDGE.md set_skip_options, skip_rules). The server's ad and
                        preview segments; learning from the viewer's seeks (1.5's "Learn intros from my skips", the same switch);
                        what a show's skip rule does; and the rules themselves, read from the backend when the list opens, with a
                        Forget for each and for each show, and Forget all (it replaces "Forget learned intros"). With the mpv
                        player only, as the skips are its backend's.
                    -->
                    <ctk:SettingsCard
                        x:Name="AdsAndPreviewsCard"
                        Description="Ad breaks and previews your server marks, if it marks any."
                        Header="Ads and previews the server marks"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE789;}"
                        Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsMpvSelected), Mode=OneWay}">
                        <ComboBox
                            x:Name="AdsAndPreviewsBox"
                            AutomationProperties.Name="Ads and previews the server marks"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind vm:SettingsViewModel.AdsAndPreviewsChoices}"
                            SelectedItem="{x:Bind ViewModel.SelectedAdsAndPreviews, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        x:Name="LearnSkipsCard"
                        Description="Skipped the same part in two episodes of a show? Nixie offers to skip it every time."
                        Header="Learn skips from my seeks"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE7BE;}"
                        Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsMpvSelected), Mode=OneWay}">
                        <ToggleSwitch AutomationProperties.Name="Learn skips from my seeks" IsOn="{x:Bind ViewModel.LearnIntros, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        x:Name="SkipRuleActionCard"
                        Description="A rule you mark in the player can choose for itself."
                        Header="When a show has a skip rule"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE893;}"
                        Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsMpvSelected), Mode=OneWay}">
                        <ComboBox
                            x:Name="SkipRuleActionBox"
                            AutomationProperties.Name="When a show has a skip rule"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind vm:SettingsViewModel.SkipRuleChoices}"
                            SelectedItem="{x:Bind ViewModel.SelectedSkipRuleAction, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <ctk:SettingsExpander
                        x:Name="SkipRulesExpander"
                        Description="Parts skipped in every episode of a show, and intros learned from your skips. Kept on this PC."
                        Expanded="OnSkipRulesExpanded"
                        Header="Skip rules"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8C6;}"
                        ItemsSource="{x:Bind ViewModel.SkipRules.Rows}"
                        Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsMpvSelected), Mode=OneWay}">
                        <Button
                            x:Name="ForgetAllSkipRulesButton"
                            Command="{x:Bind ViewModel.ForgetAllSkipRulesCommand}"
                            Content="Forget all"
                            IsEnabled="{x:Bind ViewModel.SkipRules.CanForgetAll, Mode=OneWay}" />
                        <ctk:SettingsExpander.ItemsHeader>
                            <TextBlock
                                x:Name="SkipRulesStatus"
                                Margin="16,8"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SkipRules.Status, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.SkipRules.HasStatus), Mode=OneWay}" />
                        </ctk:SettingsExpander.ItemsHeader>
                        <ctk:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="mpv:SkipRuleRow">
                                <ctk:SettingsCard
                                    Description="{x:Bind Detail}"
                                    Header="{x:Bind Title}"
                                    HeaderIcon="{x:Bind root:SkipRuleLook.Icon(IsShow)}">
                                    <Button
                                        AutomationProperties.Name="{x:Bind ForgetName}"
                                        Click="OnForgetSkipRuleClick"
                                        Content="Forget"
                                        Tag="{x:Bind}" />
                                </ctk:SettingsCard>
                            </DataTemplate>
                        </ctk:SettingsExpander.ItemTemplate>
                    </ctk:SettingsExpander>
                    <!--  end 1.6 skip  -->
                    <ctk:SettingsCard
                        Description="With Nixie's player controls and Windows Media Player. mpv's own controls always change the volume with the wheel."
                        Header="Change the volume with the mouse wheel"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE962;}">
                        <ToggleSwitch AutomationProperties.Name="Change the volume with the mouse wheel" IsOn="{x:Bind ViewModel.MouseWheelVolume, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        Description="How much one wheel notch or arrow key changes the volume, in percent. With Nixie's player controls and Windows Media Player."
                        Header="Volume step"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE767;}">
                        <!--
                            Seaglass 1.1.4 (UX review, prioritised fix 7): spin buttons of 32 x 32 px (WinUI's are 32 x 24), the text
                            centred in the taller box; the keys are the box's: Up/Down 1, PageUp/PageDown 5, typing and Enter
                        -->
                        <NumberBox
                            x:Name="VolumeStepBox"
                            MinWidth="120"
                            Padding="10,9,6,9"
                            controls:NumberBoxTargets.MinTargetSize="32"
                            AutomationProperties.Name="Volume step, in percent"
                            LargeChange="5"
                            Maximum="20"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.VolumeStep, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <!--  1.6 player: the default quality at home and away, and the Playback stats button (Controls\PlayerQualitySettingsPanel)  -->
                    <controls:PlayerQualitySettingsPanel x:Name="PlayerQualityGroup" />
                    <!--  end 1.6 player  -->

                </StackPanel>
                <!--  kept by the server for this user, as jellyfin-web's Playback settings: they reach every player  -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="1,28,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Audio and subtitles" />
                    <TextBlock
                        Margin="1,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ServerPreferencesCaption()}"
                        TextWrapping="WrapWholeWords" />
                    <controls:LoadStateView
                        LoadingText="Loading your playback preferences…"
                        ShowsLoading="True"
                        State="{x:Bind ViewModel.PlaybackPreferences}" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                        Severity="Warning"
                        Title="Not saved">
                        <InfoBar.ActionButton>
                            <Button Command="{x:Bind ViewModel.SavePlaybackPreferencesCommand}" Content="Try again" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <StackPanel Spacing="5" Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.PlaybackPreferences.IsLoaded), Mode=OneWay}">
                        <ctk:SettingsCard Header="Preferred audio language" HeaderIcon="{ui:FontIcon Glyph=&#xE8D6;}">
                            <ComboBox
                                MinWidth="220"
                                AutomationProperties.Name="Preferred audio language"
                                ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.AudioLanguage, Mode=TwoWay}" />
                        </ctk:SettingsCard>
                        <ctk:SettingsCard Header="Preferred subtitle language" HeaderIcon="{ui:FontIcon Glyph=&#xED1E;}">
                            <ComboBox
                                MinWidth="220"
                                AutomationProperties.Name="Preferred subtitle language"
                                ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SubtitleLanguage, Mode=TwoWay}" />
                        </ctk:SettingsCard>
                        <ctk:SettingsCard
                            Description="{x:Bind ViewModel.SubtitleMode.Description, Mode=OneWay}"
                            Header="Subtitles"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE7F0;}">
                            <ComboBox
                                MinWidth="220"
                                AutomationProperties.Name="Subtitles"
                                ItemsSource="{x:Bind vm:SettingsViewModel.SubtitleModes}"
                                SelectedItem="{x:Bind ViewModel.SubtitleMode, Mode=TwoWay}" />
                        </ctk:SettingsCard>
                        <!--
                            Seaglass 1.1.4 (interaction audit, item 7): for every player again. The mpv player follows it too: the player
                            sends the user's EnableNextEpisodeAutoPlay to the backend before every play (set_auto_play, the player stream's
                            PlaybackPreferences.PlaysNextItem); 1.1.3 hid it with mpv, which left no way to turn auto-play off.
                        -->
                        <ctk:SettingsCard
                            x:Name="AutoPlayCard"
                            Description="When an episode ends, the next one starts by itself. Other Jellyfin apps follow this too."
                            Header="Play the next episode automatically"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE893;}">
                            <ToggleSwitch AutomationProperties.Name="Play the next episode automatically" IsOn="{x:Bind ViewModel.AutoPlayNextEpisode, Mode=TwoWay}" />
                        </ctk:SettingsCard>
                    </StackPanel>

                </StackPanel>
                <!--  Seaglass 1.1.3: the saved servers and sign-ins, with neutral Remove buttons that ask first (no accent: that is for Play)  -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="1,28,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Servers and accounts" />
                    <TextBlock
                        Margin="1,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="The servers and sign-ins saved on this PC. Removing one changes nothing on the server."
                        TextWrapping="WrapWholeWords" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Servers}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="settings:SavedServer">
                                <!--  Seaglass 1.1.4 (layout audit, item 17): Remove server inside the expanded card, as Windows Settings > Accounts; the address under the name  -->
                                <ctk:SettingsExpander
                                    Description="{x:Bind PublicUrl}"
                                    Header="{x:Bind DisplayName}"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xE968;}"
                                    ItemsSource="{x:Bind Users}"
                                    Tag="{x:Bind}">
                                    <ctk:SettingsExpander.ItemsFooter>
                                        <ctk:SettingsCard
                                            Description="Forgets this server and the sign-ins saved for it on this PC. Nothing changes on the server."
                                            Header="Remove this server">
                                            <Button
                                                AutomationProperties.Name="{x:Bind vm:SettingsViewModel.RemoveServerLabel(DisplayName)}"
                                                Command="{Binding ElementName=Page, Path=ViewModel.DeleteServerCommand}"
                                                CommandParameter="{x:Bind}"
                                                Content="Remove server" />
                                        </ctk:SettingsCard>
                                    </ctk:SettingsExpander.ItemsFooter>
                                    <ctk:SettingsExpander.ItemTemplate>
                                        <DataTemplate x:DataType="settings:SavedUser">
                                            <ctk:SettingsCard Header="{x:Bind Username}" HeaderIcon="{ui:FontIcon Glyph=&#xE77B;}">
                                                <Button
                                                    AutomationProperties.Name="{x:Bind vm:SettingsViewModel.RemoveUserLabel(Username)}"
                                                    Click="RemoveUser"
                                                    Content="Remove sign-in"
                                                    Tag="{x:Bind}" />
                                            </ctk:SettingsCard>
                                        </DataTemplate>
                                    </ctk:SettingsExpander.ItemTemplate>
                                </ctk:SettingsExpander>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <!--
                        Seaglass 1.1.4 (UX review, prioritised fix 15): the server's administration (the account menu's old Dashboard:
                        users, libraries, playback, activity, scheduled tasks), for administrators only
                    -->
                    <ctk:SettingsCard
                        x:Name="ServerAdministrationCard"
                        Description="Users, libraries, playback, activity and scheduled tasks on this server. Shown to administrators."
                        Header="Server administration"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE912;}"
                        Visibility="{x:Bind c:Converters.BooleanToVisibility(ShowsServerAdministration)}">
                        <Button
                            x:Name="ServerAdministrationButton"
                            AutomationProperties.Name="Open server administration"
                            Click="OnServerAdministrationClick"
                            Content="Open" />
                    </ctk:SettingsCard>
                </StackPanel>
                <!--
                    Seaglass 1.1.4 (UX review, prioritised fix 15): what the old profile flyout held for other devices. SyncPlay's button
                    is disabled with the mpv player or an account the server does not allow it, and the card says why
                    (SettingsViewModel.IsSyncPlayAvailable). Play On (choosing a cast target) left: its dialog showed nothing with no
                    other device, and a cast target belongs by what you play (layout audit, item 18).
                -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="1,28,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Other devices" />
                    <ctk:SettingsCard
                        x:Name="QuickConnectCard"
                        Description="Sign in on another device without typing your password: choose Quick Connect there, then enter the code it shows."
                        Header="Quick Connect"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE703;}">
                        <Button
                            x:Name="QuickConnectButton"
                            AutomationProperties.Name="Enter a code for Quick Connect"
                            Command="{x:Bind root:App.Dialogs.QuickConnectAuthCommand}"
                            Content="Enter a code" />
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        x:Name="SyncPlayCard"
                        Description="{x:Bind ViewModel.SyncPlayDescription, Mode=OneWay}"
                        Header="SyncPlay"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE895;}">
                        <Button
                            x:Name="SyncPlayButton"
                            AutomationProperties.Name="Choose a group for SyncPlay"
                            Command="{x:Bind root:App.Dialogs.SelectSyncPlayGroupCommand}"
                            Content="Choose a group"
                            IsEnabled="{x:Bind ViewModel.IsSyncPlayAvailable, Mode=OneWay}" />
                    </ctk:SettingsCard>
                </StackPanel>
                <!--  Seaglass 1.1.3: Jellyseerr left the rail (UX review, prioritised fix 1); it opens in the app, as before  -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="1,28,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Integrations" />
                    <ctk:SettingsCard
                        Description="{x:Bind JellyseerrDescription}"
                        Header="Jellyseerr"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE7BC;}">
                        <Button
                            x:Name="JellyseerrButton"
                            AutomationProperties.Name="{x:Bind JellyseerrButtonName}"
                            Click="OnJellyseerrClick"
                            Content="{x:Bind JellyseerrAction}" />
                    </ctk:SettingsCard>
                </StackPanel>
                <!--  fluentfin-mpv: developer settings out of the way (docs/research/ux-review.md T2); Seaglass 1.1.3: a group like the others  -->
                <StackPanel Spacing="4" Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsMpvSelected), Mode=OneWay}">
                    <TextBlock
                        Margin="1,28,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Advanced" />
                    <ctk:SettingsExpander
                        Description="The command that starts it, and whether it's running."
                        Header="mpv backend"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE90F;}">
                        <ctk:SettingsExpander.Items>
                            <ctk:SettingsCard
                                Description="Leave empty to find it automatically. Otherwise the command up to --config-dir, for example C:\jellyfin-mpv-shim\.venv\Scripts\python.exe -I -m jellyfin_mpv_shim.bridge. Takes effect at once: a backend that is not playing restarts with it."
                                Header="mpv backend command"
                                HeaderIcon="{ui:FontIcon Glyph=&#xE756;}">
                                <TextBox
                                    MinWidth="420"
                                    AutomationProperties.Name="mpv backend command"
                                    PlaceholderText="Automatic"
                                    Text="{x:Bind ViewModel.MpvBackendCommand, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </ctk:SettingsCard>
                            <ctk:SettingsCard Header="mpv backend status" HeaderIcon="{ui:FontIcon Glyph=&#xE9D9;}">
                                <ctk:SettingsCard.Description>
                                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.MpvBackendStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                </ctk:SettingsCard.Description>
                            </ctk:SettingsCard>
                        </ctk:SettingsExpander.Items>
                    </ctk:SettingsExpander>
                </StackPanel>
                <!--  1.5 updater: Settings > Updates (Controls\UpdateSettingsPanel.xaml): the check, every step of an update, Install when I close Nixie  -->
                <controls:UpdateSettingsPanel x:Name="UpdatesGroup" />
                <!--  end 1.5 updater  -->
                <!--
                    Seaglass 1.1.3: Settings > About, last (UX review, prioritised fixes 1, 6 and 9): the version, the licence, the two
                    projects it is built from, Contribute and Report a problem (they left the rail; clickable cards are buttons, so Enter
                    and Space work), and the shortcut sheet, which sat under Playback (Nixie 1.5: Check for updates has its own group above, Updates).
                -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="1,28,0,6"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="About" />
                    <ctk:SettingsCard
                        x:Name="AboutVersionCard"
                        Description="A Jellyfin client for Windows. Free software under the GNU General Public License, version 3 (GPL-3.0)."
                        Header="{x:Bind vm:SettingsViewModel.AboutTitle}"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE946;}">
                        <HyperlinkButton
                            AutomationProperties.Name="License: GPL-3.0"
                            Content="License"
                            NavigateUri="{x:Bind vm:SettingsViewModel.LicenseUri}" />
                    </ctk:SettingsCard>
                    <!--  Seaglass: the shortcut sheet (also on ? anywhere, and in the player)  -->
                    <ctk:SettingsCard
                        Click="OnKeyboardShortcutsClick"
                        Description="Every key and mouse button. Press ? on any page to open it."
                        Header="Keyboard shortcuts"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE765;}"
                        IsClickEnabled="True" />
                    <!--  1.5 fixes (the button review's L1, L2; WCAG 2.1.4): single-letter keys can be turned off  -->
                    <ctk:SettingsCard
                        Description="N goes to Up next and C to Continue Watching. Turn off if you press them by accident (speech input, for example)."
                        Header="Letter keys on Home"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8D2;}">
                        <ToggleSwitch AutomationProperties.Name="Letter keys on Home" IsOn="{x:Bind ViewModel.HomeLetterKeys, Mode=TwoWay}" />
                    </ctk:SettingsCard>
                    <!--  END 1.5 fixes  -->
                    <ctk:SettingsCard
                        x:Name="ReportProblemCard"
                        ActionIcon="{ui:FontIcon Glyph=&#xE8A7;}"
                        ActionIconToolTip="Opens in your browser"
                        Click="OnReportProblemClick"
                        Description="Opens a new issue on GitHub. Say what you did, what happened, and your Nixie version."
                        Header="Report a problem"
                        HeaderIcon="{ui:FontIcon Glyph=&#xEBE8;}"
                        IsClickEnabled="True" />
                    <ctk:SettingsCard
                        x:Name="ContributeCard"
                        ActionIcon="{ui:FontIcon Glyph=&#xE8A7;}"
                        ActionIconToolTip="Opens in your browser"
                        Click="OnContributeClick"
                        Description="Nixie's code, ideas and fixes are on GitHub: github.com/mbustos27/fluentfin-mpv."
                        Header="Contribute"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE943;}"
                        IsClickEnabled="True" />
                    <ctk:SettingsCard
                        Description="Nixie's interface comes from FluentFin by insomniachi, and its playback from jellyfin-mpv-shim by the Jellyfin project and its contributors. Both are GPL-3.0. Seaglass is not affiliated with either, nor with Jellyfin or mpv."
                        Header="Built on FluentFin and jellyfin-mpv-shim"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8F1;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <HyperlinkButton Content="FluentFin" NavigateUri="{x:Bind vm:SettingsViewModel.FluentFinUri}" />
                            <HyperlinkButton Content="jellyfin-mpv-shim" NavigateUri="{x:Bind vm:SettingsViewModel.ShimUri}" />
                        </StackPanel>
                    </ctk:SettingsCard>
                    <!--
                        1.7 keyless: credits for the outside lists (Look up lists online): TMDb's notice in its terms' words, and
                        Wikidata's. TMDb's terms also ask for its approved logo here; none is downloaded yet (an open item).
                    -->
                    <ctk:SettingsCard
                        x:Name="ListCreditsCard"
                        AutomationProperties.Name="Lists from outside sources"
                        Header="Lists from outside sources"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE774;}">
                        <ctk:SettingsCard.Description>
                            <StackPanel x:Name="ListCreditsPanel" Spacing="2">
                                <!--
                                    1.7 trending: TMDb's approved logo ("Alt short (blue)", themoviedb.org's logos page, the owner's yes of
                                    2026-11-22) beside its notice, its colours, aspect and orientation as TMDb draws it, 14 epx high: less
                                    prominent than Nixie's own marks. Rasterized at 3x (42 px) for crisp edges on high-DPI screens.
                                -->
                                <Image
                                    x:Name="TmdbLogo"
                                    Height="14"
                                    Margin="0,4,0,2"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="TMDB logo"
                                    Stretch="Uniform">
                                    <Image.Source>
                                        <SvgImageSource
                                            RasterizePixelHeight="42"
                                            RasterizePixelWidth="323"
                                            UriSource="ms-appx:///Assets/Credits/tmdb-logo.svg" />
                                    </Image.Source>
                                </Image>
                                <!--  end 1.7 trending  -->
                                <TextBlock
                                    x:Name="TmdbNotice"
                                    Text="{x:Bind outside:OutsideCredits.TmdbNotice}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Name="WikidataCredit"
                                    Text="{x:Bind outside:OutsideCredits.WikidataCredit}"
                                    TextWrapping="WrapWholeWords" />
                                <!--  1.7 trending: Trakt's line goes here  -->
                                <TextBlock
                                    x:Name="TraktDisclaimer"
                                    Text="{x:Bind outside:TrendingCredits.TraktDisclaimer}"
                                    TextWrapping="WrapWholeWords" />
                                <!--  end 1.7 trending  -->
                            </StackPanel>
                        </ctk:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <HyperlinkButton
                                AutomationProperties.Name="TMDb, opens in your browser"
                                Content="TMDb"
                                NavigateUri="{x:Bind outside:OutsideCredits.TmdbUri}" />
                            <HyperlinkButton
                                AutomationProperties.Name="Wikidata, opens in your browser"
                                Content="Wikidata"
                                NavigateUri="{x:Bind outside:OutsideCredits.WikidataUri}" />
                        </StackPanel>
                    </ctk:SettingsCard>
                    <!--  end 1.7 keyless  -->
                </StackPanel>
            </StackPanel>

        </Grid>
    </ScrollViewer>

</Page>
