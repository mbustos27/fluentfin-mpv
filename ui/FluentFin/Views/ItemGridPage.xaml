<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.ItemGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Margin="{StaticResource MediumLeftTopRightBottomMargin}"
    mc:Ignorable="d">

    <!--
        Seaglass scrolling: "See all" on a row without a library (Continue Watching, Next Up): its items as a vertical grid that
        wraps at any width (nothing scrolls sideways, WCAG 1.4.10), the cards as the library's own.
    -->
    <Grid
        x:Name="GridRoot"
        Background="Transparent"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="12,0,0,0"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource GlassPageTitleTextBlockStyle}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <!--  the Library's grid model (Controls\CardGrid.cs): one Tab stop, arrows both ways, Home/End, the last card remembered, "n of m"  -->
        <ScrollView x:Name="GridScroller" Grid.Row="1">
            <lc:RowList
                x:Name="GridList"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                TabFocusNavigation="Once">
            <ItemsRepeater x:Name="GridRepeater" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:BaseItemViewModel">
                        <ItemContainer
                            AutomationProperties.AccessibilityView="Raw"
                            CornerRadius="{StaticResource GlassCardCornerRadius}"
                            IsTabStop="False"
                            Style="{StaticResource BareItemContainerStyle}">
                            <lc:BaseItemDtoCard
                                BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Thumb, 192)}"
                                ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Thumb, 192)}"
                                JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                                Model="{x:Bind}" />
                        </ItemContainer>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsJustification="Start"
                        ItemsStretch="Fill"
                        MinColumnSpacing="8"
                        MinItemHeight="260"
                        MinItemWidth="390"
                        MinRowSpacing="8"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
            </lc:RowList>
        </ScrollView>
    </Grid>
</Page>
