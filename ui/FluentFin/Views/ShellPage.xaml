<Page
    x:Class="FluentFin.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:FluentFin.Behaviors"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Loaded="OnLoaded">

    <Page.Resources>
        <cc:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <!--
        1.2.0 (the top bar): no left rail. The sections are tabs in the window's one bar (TitleBarControl, TopTabStrip), which
        sits over this page: ContentRoot starts below it (TopBar.Height), or at the top for a page that extends under it (a
        hero: Controls.TopBar.ExtendsUnder) and while the bar is hidden (full screen). ShellPage.UpdateInsets.
    -->
    <!--
        Seaglass: the update notice (Settings > Check for updates; on by default since 1.3.1): quiet, above the page, never over
        the player. Nixie 1.5: every step of an update (UpdateNotice.xaml): found, downloading with its progress, checking,
        ready (Restart to update), a failure with why, and "Updated to" afterwards. Narrator hears each step once.
    -->
    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  1.5 updater  -->
        <!--
            Nixie 1.5 (the updater stream): the notice is its own control (Controls\UpdateNotice.xaml): every step of an update,
            one row, one Primary. The host hides it under the player; it shows itself while there is something to say, and the
            shell gives it room (OpenChanged, UpdateInsets).
        -->
        <Grid Visibility="{x:Bind Chrome.IsNavigationVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:UpdateNotice x:Name="UpdateBar" OpenChanged="OnUpdateBarOpenChanged" />
        </Grid>
        <!--  end 1.5 updater  -->
        <Frame
            x:Name="NavigationFrame"
            Grid.Row="1"
            x:FieldModifier="Public" />
    </Grid>
</Page>
