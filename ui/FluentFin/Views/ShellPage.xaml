<Page
    x:Class="FluentFin.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:FluentFin.Behaviors"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Loaded="OnLoaded">

    <Page.Resources>
        <cc:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <!--
        1.2.0 (the top bar): no left rail. The sections are tabs in the window's one bar (TitleBarControl, TopTabStrip), which
        sits over this page: ContentRoot starts below it (TopBar.Height), or at the top for a page that extends under it (a
        hero: Controls.TopBar.ExtendsUnder) and while the bar is hidden (full screen). ShellPage.UpdateInsets.
    -->
    <!--
        Seaglass: the update notice (Settings > Check for updates; on by default since 1.3.1): quiet, above the page, never over
        the player: "Nixie 1.3.2 is available", Download and install, Release notes and Dismiss (that version is not offered
        again). It only tells: nothing is downloaded before the click. InfoBar tells Narrator once when it opens.
    -->
    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            x:Name="UpdateBar"
            Margin="16,8,16,0"
            Closed="OnUpdateBarClosed"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational"
            Visibility="{x:Bind Chrome.IsNavigationVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <InfoBar.ActionButton>
                <!--  button review A25: Narrator reads the visible label (it said "Download and install" over "Open the download page")  -->
                <Button
                    x:Name="UpdateInstallButton"
                    Click="OnUpdateInstallClick"
                    Content="Download and install" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <StackPanel
                    Margin="0,0,0,8"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--  button review A26: a link with a 32 px hit area (it was about 20 px high, no padding)  -->
                    <HyperlinkButton
                        MinHeight="32"
                        Padding="4,6"
                        AutomationProperties.Name="Release notes"
                        Click="OnUpdateNotesClick"
                        Content="Release notes" />
                    <!--  Nixie 1.3.1: Dismiss says what the close button did (that version is not offered again)  -->
                    <Button
                        x:Name="UpdateDismissButton"
                        Click="OnUpdateDismissClick"
                        Content="Dismiss"
                        Style="{StaticResource NixieSubtleButtonStyle}"
                        ToolTipService.ToolTip="Don't offer this version again" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>
        <Frame
            x:Name="NavigationFrame"
            Grid.Row="1"
            x:FieldModifier="Public" />
    </Grid>
</Page>
