<Page
    x:Class="FluentFin.Views.SeriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dw="using:DevWinUI"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewmodels="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    mc:Ignorable="d">
    <Page.Resources>
        <c:JellyfinSubtitleConverter x:Key="SubtitleConverter" />
        <c:JellyfinFlyoutConverter x:Key="FlyoutConverter" />
        <cc:StringVisibilityConverter x:Key="StringVisibilityConverter" />
        <cc:EmptyObjectToObjectConverter
            x:Key="ObjectToVisibilityConverter"
            EmptyValue="Collapsed"
            NotEmptyValue="Visible" />
        <x:Double x:Key="ButtonStripHeight">75</x:Double>
        <x:Double x:Key="InputLabelWidth">125</x:Double>
        <x:Double x:Key="InputControlWidth">200</x:Double>
        <Style
            x:Key="InputLabelStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Width" Value="{StaticResource InputLabelWidth}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <c:StringJoinConverter x:Key="StringJoinConverter" />
    </Page.Resources>

    <Grid RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.RowSpan="4" Grid.ColumnSpan="2">
            <Grid>
                <Image
                    x:Name="BackdropImage"
                    Source="{x:Bind c:BaseItemDtoConverters.GetImage(ViewModel.Dto, jm:ImageType.Backdrop, 1000), Mode=OneWay}"
                    Stretch="UniformToFill" />
                <media:UIElementExtensions.VisualFactory>
                    <media:PipelineVisualFactory>
                        <media:TintEffect Color="Gray" />
                    </media:PipelineVisualFactory>
                </media:UIElementExtensions.VisualFactory>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2">
            <media:UIElementExtensions.VisualFactory>
                <media:PipelineVisualFactory>
                    <media:BlurEffect Amount="40" />
                    <media:CrossFadeEffect
                        Factor="1"
                        IsAnimatable="True"
                        Source="{media:BackdropSource}" />
                </media:PipelineVisualFactory>
            </media:UIElementExtensions.VisualFactory>
        </Grid>

        <!--  Dark scrim so the text below the title strip stays readable on any backdrop  -->
        <Border
            Grid.Row="2"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Background="{StaticResource MediaInfoScrimBrush}" />

        <Border
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Height="{StaticResource ButtonStripHeight}"
            VerticalAlignment="Bottom"
            Background="{StaticResource MediaInfoScrimBrush}" />

        <Grid
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="0,0,36,0">
            <Image
                Height="200"
                Source="{x:Bind c:BaseItemDtoConverters.GetImage(ViewModel.Dto, jm:ImageType.Logo, 200), Mode=OneWay}"
                Stretch="Uniform" />
        </Grid>

        <Grid
            x:Name="ButtonStrip"
            Grid.RowSpan="2"
            Grid.Column="1"
            Height="{StaticResource ButtonStripHeight}"
            VerticalAlignment="Bottom"
            ColumnSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <!--  fluentfin-mpv: the buttons have a column of their own, so a long title is trimmed rather than drawn under them  -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Dto.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="20">
                <TextBlock Text="{x:Bind ViewModel.Dto, Converter={StaticResource SubtitleConverter}, Mode=OneWay}" Visibility="{x:Bind ViewModel.Dto.ProductionYear, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                <Border Padding="8,0" Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}">
                    <TextBlock Text="{x:Bind ViewModel.Dto.OfficialRating, Mode=OneWay}" Visibility="{x:Bind ViewModel.Dto.OfficialRating, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
                </Border>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.Dto.CommunityRating, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}">
                    <FontIcon
                        AutomationProperties.Name="Community rating"
                        FontSize="16"
                        Foreground="{ThemeResource RatingStarBrush}"
                        Glyph="&#xE735;" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Dto.CommunityRating, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <!--  fluentfin-mpv: a named Play, names and tooltips on every icon button (ux-review I2, I3)  -->
            <StackPanel
                Grid.RowSpan="2"
                Grid.Column="1"
                Margin="{StaticResource SmallRightMargin}"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Height="50"
                    Padding="20,0"
                    AutomationProperties.Name="Play"
                    Command="{x:Bind root:App.Commands.PlayDtoCommand}"
                    CommandParameter="{x:Bind ViewModel.Dto, Mode=OneWay}"
                    CornerRadius="25"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="Play" />
                    </StackPanel>
                </Button>
                <ToggleButton
                    Width="50"
                    Height="50"
                    AutomationProperties.Name="Watched"
                    Background="Transparent"
                    Command="{x:Bind root:App.Commands.ToggleWatchedCommand}"
                    CommandParameter="{x:Bind ViewModel.Dto, Mode=OneWay}"
                    Content="{ui:FontIcon Glyph=&#xE73E;}"
                    CornerRadius="25"
                    IsChecked="{x:Bind ViewModel.Dto.UserData.Played, Mode=OneWay}"
                    Style="{StaticResource IconToggleButtonStyle}"
                    ToolTipService.ToolTip="Mark watched" />
                <ToggleButton
                    Width="50"
                    Height="50"
                    AutomationProperties.Name="Favorite"
                    Background="Transparent"
                    Command="{x:Bind root:App.Commands.ToggleFavoriteCommand}"
                    CommandParameter="{x:Bind ViewModel.Dto, Mode=OneWay}"
                    Content="{ui:FontIcon Glyph=&#xEB52;}"
                    CornerRadius="25"
                    IsChecked="{x:Bind ViewModel.Dto.UserData.IsFavorite, Mode=OneWay}"
                    Style="{StaticResource IconToggleButtonStyle}"
                    ToolTipService.ToolTip="Add to favorites">
                    <ToggleButton.Resources>
                        <StaticResource x:Key="SystemAccentColor" ResourceKey="FavoriteCheckedBrush" />
                    </ToggleButton.Resources>
                </ToggleButton>
                <Button
                    Width="50"
                    Height="50"
                    AutomationProperties.Name="More options"
                    Background="Transparent"
                    Content="{ui:SymbolIcon Symbol=More}"
                    CornerRadius="25"
                    Flyout="{x:Bind ViewModel.Dto, Converter={StaticResource FlyoutConverter}, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="More options" />
            </StackPanel>
        </Grid>


        <Grid
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="36,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            CornerRadius="15">
            <Image Source="{x:Bind c:BaseItemDtoConverters.GetImage(ViewModel.Dto, jm:ImageType.Primary, 800), Mode=OneWay}" Stretch="Uniform" />
        </Grid>

        <ScrollViewer
            Grid.Row="2"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="{StaticResource MediumTopBottomMargin}">
            <StackPanel Spacing="45">

                <!--  Overview  -->
                <!--  fluentfin-mpv: "Show more" for a long overview; tags and details wrap instead of running off the page (ux-review I1, I4)  -->
                <controls:ExpandableText Text="{x:Bind ViewModel.Dto.Overview, Mode=OneWay}" />


                <!--  Tags  -->
                <StackPanel Spacing="10">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Tags" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Dto.Tags, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <HyperlinkButton Content="{Binding}" Style="{StaticResource TextBlockButtonStyle}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <ctk:WrapLayout HorizontalSpacing="10" VerticalSpacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <!--  Details  -->
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource InputLabelStyle}"
                        Text="Genres" />
                    <ItemsRepeater
                        Grid.Row="0"
                        Grid.Column="1"
                        ItemsSource="{x:Bind ViewModel.Dto.GenreItems, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="jm:NameGuidPair">
                                <HyperlinkButton Content="{x:Bind Name}" Style="{StaticResource TextBlockButtonStyle}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <ctk:WrapLayout HorizontalSpacing="10" VerticalSpacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource InputLabelStyle}"
                        Text="Writers" />
                    <ItemsRepeater
                        Grid.Row="1"
                        Grid.Column="1"
                        ItemsSource="{x:Bind c:Converters.GetWriters(ViewModel.Dto.People), Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="jm:BaseItemPerson">
                                <HyperlinkButton Content="{x:Bind Name}" Style="{StaticResource TextBlockButtonStyle}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <ctk:WrapLayout HorizontalSpacing="10" VerticalSpacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource InputLabelStyle}"
                        Text="Studios" />
                    <ItemsRepeater
                        Grid.Row="2"
                        Grid.Column="1"
                        ItemsSource="{x:Bind ViewModel.Dto.Studios, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="jm:NameGuidPair">
                                <HyperlinkButton Content="{x:Bind Name}" Style="{StaticResource TextBlockButtonStyle}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <ctk:WrapLayout HorizontalSpacing="10" VerticalSpacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>

                <!--  Next Up  -->
                <StackPanel
                    HorizontalAlignment="Left"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.NextUp, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Next Up" />
                    <controls:BaseItemDtoCard
                        Width="390"
                        Height="240"
                        BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(ViewModel.NextUp.Dto, jm:ImageType.Thumb, 300), Mode=OneWay}"
                        ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(ViewModel.NextUp.Dto, jm:ImageType.Thumb, 300), Mode=OneWay}"
                        JellyfinClient="{x:Bind ViewModel.JellyfinClient}"
                        Model="{x:Bind ViewModel.NextUp, Mode=OneWay}" />
                </StackPanel>

                <!--  Seasons  -->
                <StackPanel Spacing="10">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Seasons" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled">
                        <ItemsRepeater Margin="0,0,15,0" ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:BaseItemViewModel">
                                    <controls:BaseItemDtoCard
                                        Width="200"
                                        BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Primary, 300)}"
                                        ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 300)}"
                                        JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                                        Model="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="10" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!--  Cast  -->
                <StackPanel Spacing="10">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Cast &amp; Crew" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled">
                        <ItemsRepeater Margin="0,0,15,0" ItemsSource="{x:Bind ViewModel.Dto.People, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="jm:BaseItemPerson">
                                    <Grid Width="150">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <PersonPicture
                                            Width="150"
                                            Height="150"
                                            DisplayName="{x:Bind Name}"
                                            ProfilePicture="{x:Bind c:BaseItemDtoConverters.GetImage((jm:BaseItemPerson), 300)}" />

                                        <StackPanel Grid.Row="1" Padding="3">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Name}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis">
                                                <Run Text="as" />
                                                <Run Text="{x:Bind Role}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="10" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!--  Similar  -->
                <StackPanel Spacing="10">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="More Like This" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled">
                        <ItemsRepeater Margin="0,0,15,0" ItemsSource="{x:Bind ViewModel.Similar, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:BaseItemViewModel">
                                    <controls:BaseItemDtoCard
                                        Width="200"
                                        ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 300)}"
                                        JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                                        Model="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="10" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
