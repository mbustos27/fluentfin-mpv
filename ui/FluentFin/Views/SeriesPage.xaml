<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.SeriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:core="using:FluentFin.Core"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:journal="using:FluentFin.Plugins.Journal.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewmodels="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    mc:Ignorable="d">

    <!--  Seaglass: the item page. The hero (backdrop, logo, chips, actions, overview) is always dark; the body below it is
          opaque content on the window's ambient backdrop: cast and episodes as cards, the journal as one glass card.  -->
    <Page.Resources>
        <cc:EmptyObjectToObjectConverter
            x:Key="ObjectToVisibilityConverter"
            EmptyValue="Collapsed"
            NotEmptyValue="Visible" />
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="PageContent">
            <StackPanel>
                <controls:ItemHero Dto="{x:Bind ViewModel.Dto, Mode=OneWay}" Overview="{x:Bind ViewModel.Dto.Overview, Mode=OneWay}">
                    <controls:ItemHero.PrimaryActions>
                        <!--  fluentfin-mpv: a named Play (ux-review I2, I3)  -->
                        <Button
                            AutomationProperties.Name="Play"
                            Command="{x:Bind root:App.Commands.PlayDtoCommand}"
                            CommandParameter="{x:Bind ViewModel.Dto, Mode=OneWay}"
                            Style="{StaticResource GlassAccentPillButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock Text="Play" />
                            </StackPanel>
                        </Button>
                    </controls:ItemHero.PrimaryActions>
                </controls:ItemHero>
                <StackPanel Margin="48,28,48,56" Spacing="32">
                    <!--  fluentfin-mpv: the TV journal's rating (docs/JOURNAL.md), one glass card  -->
                    <journal:JournalRatingPanel Item="{x:Bind ViewModel.Dto, Mode=OneWay}" />
                    <controls:ItemMetaRows Dto="{x:Bind ViewModel.Dto, Mode=OneWay}" />
                    <StackPanel HorizontalAlignment="Left" Spacing="12" Visibility="{x:Bind ViewModel.NextUp, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource GlassSectionTitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="Next Up" />
                        <controls:BaseItemDtoCard
                            Width="390"
                            Height="240"
                            BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(ViewModel.NextUp.Dto, jm:ImageType.Thumb, 300), Mode=OneWay}"
                            ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(ViewModel.NextUp.Dto, jm:ImageType.Thumb, 300), Mode=OneWay}"
                            JellyfinClient="{x:Bind ViewModel.JellyfinClient}"
                            Model="{x:Bind ViewModel.NextUp, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="12">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource GlassSectionTitleTextBlockStyle}" Text="Seasons" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <ItemsRepeater Margin="0,0,0,12" ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:BaseItemViewModel">
                                        <controls:BaseItemDtoCard
                                            Width="200"
                                            BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Primary, 300)}"
                                            ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 300)}"
                                            JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                                            Model="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="12" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                    <controls:CastRow Heading="Cast &amp; Crew" People="{x:Bind ViewModel.Dto.People, Mode=OneWay}" />
                    <StackPanel Spacing="12">
                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource GlassSectionTitleTextBlockStyle}" Text="More Like This" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <ItemsRepeater Margin="0,0,0,12" ItemsSource="{x:Bind ViewModel.Similar, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:BaseItemViewModel">
                                        <controls:BaseItemDtoCard
                                            Width="200"
                                            BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Primary, 300)}"
                                            ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 300)}"
                                            JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                                            Model="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="12" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  fluentfin-mpv: the item could not be loaded: said with Retry instead of a blank page (docs/research/ux-review.md §3.11)  -->
        <controls:LoadStateView
            Grid.RowSpan="10"
            Grid.ColumnSpan="10"
            State="{x:Bind ViewModel.State}"
            VerticalContentAlignment="Center" />
    </Grid>
</Page>
