<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentFin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--  Seaglass: the server's splash image is the ambient backdrop behind the card (LoginPage.xaml.cs), not a full-bleed image  -->
        <StackPanel
            MinWidth="500"
            Padding="50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource GlassPanelStrongBrush}"
            BorderBrush="{ThemeResource GlassStrokeBrush}"
            BorderThickness="{StaticResource GlassStrokeThickness}"
            CornerRadius="{StaticResource GlassPanelCornerRadius}"
            Spacing="20">
            <StackPanel.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Spacing" Value="5" />
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </StackPanel.Resources>
            <!--  Seaglass: the app's name on the card (the rename stream changes it)  -->
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                Style="{StaticResource GlassPageTitleTextBlockStyle}"
                Text="FluentFin MPV" />
            <StackPanel>
                <TextBlock Text="Username" />
                <AutoSuggestBox
                    x:Name="UsernameBox"
                    AutomationProperties.Name="Username"
                    DisplayMemberPath="Username"
                    ItemsSource="{x:Bind ViewModel.Server.Users}"
                    Loaded="UsernameBox_Loaded"
                    SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                    Text="{x:Bind ViewModel.Username, Mode=TwoWay}"
                    TextMemberPath="Username" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Password" />
                <PasswordBox
                    x:Name="PasswordBox"
                    AutomationProperties.Name="Password"
                    KeyDown="InputFieldKeyDown"
                    PasswordChanged="PasswordBox_PasswordChanged" />
            </StackPanel>
            <CheckBox Content="Remember me" IsChecked="{x:Bind ViewModel.KeepMeLoggedIn, Mode=TwoWay}" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    AutomationProperties.Name="Switch server"
                    Command="{x:Bind ViewModel.SwitchServerCommand}"
                    Style="{StaticResource GlassPillButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8AB;" />
                        <TextBlock Text="Switch server" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Quick Connect"
                    Command="{x:Bind ViewModel.QuickConnectCommand}"
                    Style="{StaticResource GlassAccentPillButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE703;" />
                        <TextBlock Text="Quick Connect" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Login"
                    Command="{x:Bind ViewModel.LoginCommand}"
                    Style="{StaticResource GlassAccentPillButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE725;" />
                        <TextBlock Text="Login" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
