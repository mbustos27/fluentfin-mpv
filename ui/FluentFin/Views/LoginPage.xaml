<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:c="using:FluentFin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentFin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        1.1.4 (states; layout audit #4 and #11): one glass card, as the server page. The app's name is the page's heading;
        under it, the server it signs in to with a Change link; labelled fields; ONE primary button, Sign in (full width,
        accent, no icon), and Use Quick Connect as a standard button under it. Enter in the username goes on to the
        password, Enter there signs in. A sign-in that fails says why ON the page (the InfoBar announces itself; the
        keyboard goes back to the password box), never in a dialog; progress on Sign in while the server answers. The
        server's splash image is the ambient backdrop behind the card.
    -->
    <Grid>
    <!--
        Nixie 1.3.0: the layout theme's sign-in backdrop (its SignInBackdropTemplate, given this page's view model) behind the
        form; without one, or in high contrast, nothing here and the dusk scene behind the window shows (ThemeResources).
        Decorative: no clicks, no Narrator.
    -->
    <ContentPresenter
        x:Name="ThemeBackdrop"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        AutomationProperties.AccessibilityView="Raw"
        IsHitTestVisible="False"
        Visibility="Collapsed" />
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <ContentControl
            Width="460"
            Margin="24"
            Padding="40,36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource GlassPanelStrongBrush}"
            Style="{StaticResource GlassSurfaceStyle}">
            <StackPanel Spacing="18">
                <StackPanel Spacing="2">
                    <!--  1.2.0: the app's name as the lit nixie tube (the glass stream's AppWordmark), still the page's heading  -->
                    <lc:AppWordmark
                        HorizontalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level1"
                        Size="64" />
                    <Grid HorizontalAlignment="Center" ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ServerLine"
                            MaxWidth="300"
                            VerticalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level2"
                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Heading, Mode=OneWay}" />
                        <HyperlinkButton
                            x:Name="ChangeServerLink"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Change server"
                            Command="{x:Bind ViewModel.SwitchServerCommand}"
                            Content="Change"
                            Style="{StaticResource NixieLinkButtonStyle}"
                            ToolTipService.ToolTip="Choose another server" />
                    </Grid>
                </StackPanel>

                <AutoSuggestBox
                    x:Name="UsernameBox"
                    AutomationProperties.Name="Username"
                    DisplayMemberPath="Username"
                    Header="Username"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Server.Users, Mode=OneWay}"
                    Loaded="UsernameBox_Loaded"
                    QuerySubmitted="UsernameBox_QuerySubmitted"
                    SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                    Text="{x:Bind ViewModel.Username, Mode=TwoWay}"
                    TextMemberPath="Username" />
                <PasswordBox
                    x:Name="PasswordBox"
                    AutomationProperties.Name="Password"
                    Header="Password"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    KeyDown="InputFieldKeyDown"
                    PasswordChanged="PasswordBox_PasswordChanged" />
                <CheckBox Content="Remember me" IsChecked="{x:Bind ViewModel.KeepMeLoggedIn, Mode=TwoWay}" />

                <!--  why the last attempt did not work and what to do (InfoBar announces itself when it opens)  -->
                <InfoBar
                    x:Name="ErrorBar"
                    CornerRadius="{StaticResource GlassCardCornerRadius}"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="Couldn't sign in" />

                <StackPanel Spacing="10">
                    <!--  the one primary action  -->
                    <Button
                        x:Name="SignInButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Sign in"
                        AutomationProperties.HelpText="Type a username to sign in"
                        Command="{x:Bind ViewModel.LoginCommand}"
                        Style="{StaticResource NixiePrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                AutomationProperties.AccessibilityView="Raw"
                                Foreground="{ThemeResource NixieAccentForegroundBrush}"
                                IsActive="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}"
                                Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsSigningIn), Mode=OneWay}" />
                            <TextBlock Text="Sign in" />
                        </StackPanel>
                    </Button>
                    <!--  1.5 (the button review's S2): why Sign in is off, on screen too (Narrator has it in the button's help text)  -->
                    <TextBlock
                        x:Name="SignInHint"
                        Margin="0,-4,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Type a username to sign in"
                        Visibility="{x:Bind local:LoginPage.SignInHintVisibility(ViewModel.Username, ViewModel.IsSigningIn), Mode=OneWay}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Use Quick Connect"
                        Command="{x:Bind ViewModel.QuickConnectCommand}"
                        Style="{StaticResource NixieButtonStyle}"
                        ToolTipService.ToolTip="Sign in by approving a code on a device that is already signed in">
                        <TextBlock Text="Use Quick Connect" />
                    </Button>
                </StackPanel>

                <TextBlock
                    x:Name="StatusLine"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource GlassTextSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsSigningIn), Mode=OneWay}" />
            </StackPanel>
        </ContentControl>
    </ScrollViewer>
    </Grid>
</Page>
