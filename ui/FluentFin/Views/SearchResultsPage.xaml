<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.SearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Background="{ThemeResource PageGroundBrush}"
    mc:Ignorable="d">

    <!--
        Seaglass 1.1.4 (interaction audit, item 2): Enter in the title bar's search opens this page: every match for the query,
        grouped by type (movies, shows, episodes), the query in the title. Each group is one Tab stop (the cards' arrows move
        inside it), named for Narrator, its heading a level-2 heading. Loading, no results and a failed search: LoadStateView.
    -->
    <!--  Nixie 1.4.0 (the UX review's plan item 13): on the theme's page grid (its gutter, its title y, its title style and ground)  -->
    <Grid
        x:Name="ResultsRoot"
        Padding="36,72,36,24"
        lc:PageGrid.Apply="True"
        Background="Transparent"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="ResultsTitle"
            AutomationProperties.HeadingLevel="Level1"
            AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
            Style="{StaticResource PageHeaderStyle}"
            Text="{x:Bind lc:PageGrid.Title(ViewModel.Title), Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <ScrollView
            x:Name="ResultsScroller"
            Grid.Row="1"
            Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.Results.IsLoaded), Mode=OneWay}">
            <!--  an ItemsControl, not a repeater: Tab must reach every group (HomePage's rows, the scrolling stream)  -->
            <ItemsControl
                x:Name="ResultGroups"
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.CardGroups, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="28" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchResultGroup">
                        <StackPanel Spacing="12">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource GlassSectionTitleTextBlockStyle}"
                                Text="{x:Bind Heading}" />
                            <lc:RowList
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind Name}"
                                TabFocusNavigation="Once">
                                <ItemsRepeater ItemsSource="{x:Bind Items}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BaseItemViewModel">
                                            <!--  the card is the keyboard stop and the element Narrator reads; the container is neither  -->
                                            <ItemContainer
                                                AutomationProperties.AccessibilityView="Raw"
                                                CornerRadius="{StaticResource GlassCardCornerRadius}"
                                                IsTabStop="False"
                                                Style="{StaticResource BareItemContainerStyle}">
                                                <lc:BaseItemDtoCard
                                                    BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Primary, 352)}"
                                                    ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 352)}"
                                                    JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                                                    Model="{x:Bind}" />
                                            </ItemContainer>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsJustification="Start"
                                            ItemsStretch="Fill"
                                            MinColumnSpacing="8"
                                            MinItemHeight="390"
                                            MinItemWidth="220"
                                            MinRowSpacing="8"
                                            Orientation="Horizontal" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </lc:RowList>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollView>

        <lc:LoadStateView
            Grid.Row="1"
            LoadingText="Searching…"
            ShowsLoading="True"
            State="{x:Bind ViewModel.Results}"
            VerticalContentAlignment="Center" />
    </Grid>
</Page>
