<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.JellyfinSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentFin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Nixie 1.2.0 (admin): no side pane. The server administration's sections are text tabs along the top (SelectorBar: one
        Tab stop, the arrows move between them, Narrator reads "Users, 3 of 7"); Libraries and Playback show their pages as a
        second row of tabs under them. A page opened from a section (a user's settings) gets a "Back to <section>" link.
        The tabs come from Core.Admin.AdminSections (their keys are the view models the Settings frame navigates to).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Padding="36,16,36,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Spacing="4">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Server administration" />
            <SelectorBar
                x:Name="SectionBar"
                AutomationProperties.Name="Server administration sections"
                SelectionChanged="SectionBar_SelectionChanged" />
            <SelectorBar
                x:Name="PageBar"
                SelectionChanged="PageBar_SelectionChanged"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <HyperlinkButton
                x:Name="BackLink"
                Margin="28,8,0,0"
                Click="BackLink_Click"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    <TextBlock x:Name="BackLinkText" />
                </StackPanel>
            </HyperlinkButton>
            <Frame x:Name="NavFrame" Grid.Row="1" />
        </Grid>
    </Grid>
</Page>
