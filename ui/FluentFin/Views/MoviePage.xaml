<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.MoviePage"
    lc:TopBar.ExtendsUnder="True"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:core="using:FluentFin.Core"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:journal="using:FluentFin.Plugins.Journal.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewmodels="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    mc:Ignorable="d">

    <!--  Seaglass: the item page. The hero (backdrop, logo, chips, actions, overview) is always dark; the body below it is
          opaque content on the window's ambient backdrop, in plain sections (1.2.0, 1.1.3 UX audit layout item 3: no glass
          panel per section; a section with nothing in it is not drawn).  -->
    <Page.Resources>
        <cc:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="PageContent">
            <StackPanel>
                <controls:ItemHero Dto="{x:Bind ViewModel.Dto, Mode=OneWay}" Overview="{x:Bind ViewModel.Dto.Overview, Mode=OneWay}">
                    <controls:ItemHero.PrimaryActions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!--  fluentfin-mpv: a named Play / "Resume at 12:34", "Play from start" next to it (ux-review I2, I3)  -->
                            <!--  Nixie 1.4.0 (the UX review's DI-M5): named, so the keyboard comes back to it after the player (ItemPagePlace)  -->
                            <Button
                                x:Name="PlayButton"
                                AutomationProperties.Name="{x:Bind ViewModel.PlayLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PlayCommand}"
                                Style="{StaticResource NixiePrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="{x:Bind ViewModel.PlayLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <!--  1.2.0 (Nixie button review, I37 / I50): "Play from start" in words, a secondary pill beside Resume (it was an icon alone)  -->
                            <Button
                                AutomationProperties.Name="{x:Bind core:ItemLabels.PlayFromBeginningAction(ViewModel.Dto), Mode=OneWay, FallbackValue='Play from start'}"
                                Command="{x:Bind ViewModel.PlayFromBeginningCommand}"
                                Style="{StaticResource NixieButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasResumePoint, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE777;" />
                                    <TextBlock Text="Play from start" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:ItemHero.PrimaryActions>
                </controls:ItemHero>
                <StackPanel Margin="48,28,48,56" Spacing="32">
                    <!--  the lists are named after their labels for Narrator (fluentfin-mpv)  -->
                    <StackPanel Spacing="20"><Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource GlassMetaTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Text="Video" />
                        <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind ViewModel.VideoTitle, Mode=OneWay}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Style="{StaticResource GlassMetaTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Text="Audio" />
                        <ctk:SwitchPresenter
                            Grid.Row="1"
                            Grid.Column="1"
                            TargetType="x:Int32"
                            Value="{x:Bind ViewModel.AudioStreams.Count, Mode=OneWay}">
                            <ctk:Case Value="0" />
                            <ctk:Case Value="1">
                                <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind ViewModel.SelectedAudioLabel, Mode=OneWay}" />
                            </ctk:Case>
                            <ctk:Case IsDefault="True">
                                <!--  1.2.0: plain labels (TrackLabels: "English (5.1)"), chosen by place; Media info keeps the codecs  -->
                                <ComboBox
                                    MinWidth="360"
                                    MaxWidth="720"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Audio"
                                    ItemsSource="{x:Bind ViewModel.AudioLabels, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.SelectedAudioIndex, Mode=TwoWay}" />
                            </ctk:Case>
                        </ctk:SwitchPresenter>

                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource GlassMetaTextBlockStyle}"
                            Text="Subtitle"
                            Visibility="{x:Bind ViewModel.HasSubtitles, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            MinWidth="360"
                            MaxWidth="720"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Subtitle"
                            ItemsSource="{x:Bind ViewModel.SubtitleLabels, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedSubtitleIndex, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.HasSubtitles, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                    <controls:ItemMetaRows Dto="{x:Bind ViewModel.Dto, Mode=OneWay}" /></StackPanel>
                    <controls:CastRow Heading="Cast &amp; crew" People="{x:Bind ViewModel.Dto.People, Mode=OneWay}" />
                    <lc:ShelfRow Header="More like this" HasSeeAll="True" ItemsSource="{x:Bind ViewModel.Similar, Mode=OneWay}" SeeAll="SimilarSeeAll" Visibility="{x:Bind c:ItemRowConverters.Show(ViewModel.Similar.Count), Mode=OneWay, FallbackValue=Collapsed}">
                            <lc:ShelfRow.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:BaseItemViewModel">
                                        <controls:BaseItemDtoCard
                                            Width="200"
                                            BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Primary, 300)}"
                                            ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 300)}"
                                            JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                                            Model="{x:Bind}" />
                                    </DataTemplate>
                            </lc:ShelfRow.ItemTemplate>
                        </lc:ShelfRow>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  fluentfin-mpv: the item could not be loaded: said with Retry instead of a blank page (docs/research/ux-review.md §3.11)  -->
        <controls:LoadStateView
            Grid.RowSpan="10"
            Grid.ColumnSpan="10"
            State="{x:Bind ViewModel.State}"
            VerticalContentAlignment="Center" />
    </Grid>
</Page>
