<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.JellyfinSettings.ScheduledTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Views.JellyfinSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    mc:Ignorable="d">

    <ScrollView Margin="0,36">
        <StackPanel Width="1000" Spacing="16">
        <InfoBar
            Closed="NoticeBar_Closed"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}"
            Severity="{x:Bind local:DashboardPage.Severity(ViewModel.Notice), Mode=OneWay}"
            Title="{x:Bind ViewModel.Notice.Title, Mode=OneWay}" />
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryTaskPair">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind Category}" />
                        <ItemsRepeater ItemsSource="{x:Bind Tasks}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="jm:TaskInfo">
                                    <!--  D43: the task's own description (every card said "Update the anime list…"); the action is "Run now" (E768), and the page says it started  -->
                                    <ctk:SettingsCard
                                        ActionIcon="{ui:FontIcon Glyph=&#xE768;}"
                                        ActionIconToolTip="Run now"
                                        AutomationProperties.Name="{x:Bind local:ScheduledTasksPage.RunName(Name)}"
                                        Command="{Binding ElementName=Page, Path=ViewModel.RunCommand}"
                                        CommandParameter="{x:Bind}"
                                        Description="{x:Bind Description}"
                                        Header="{x:Bind Name}"
                                        IsClickEnabled="True"
                                        IsTapEnabled="True" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="5" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
            <ItemsRepeater.Layout>
                <StackLayout Spacing="16" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>
        </StackPanel>
    </ScrollView>
</Page>
