<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.UserPasswordEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentFin.Dialogs.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:FluentFin.Views.JellyfinSettings"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    mc:Ignorable="d">

    <StackPanel
        Width="600"
        HorizontalAlignment="Left"
        Spacing="20">
        <PasswordBox x:Name="CurrentPassword" Header="Current password" />
        <PasswordBox x:Name="NewPassword" Header="New password" />
        <PasswordBox x:Name="ConfirmPassword" Header="New password again" />
        <!--
            Nixie 1.2.0 (admin, D38 / D39): "Change password" is the page's primary (role: Primary Compact); "Remove password…"
            (role: Destructive Compact, stock style until the glass stream's keys) asks first, naming the user, with Cancel the
            default, and stands 24 px away. What happened shows below (D40: was an untitled dialog).
        -->
        <StackPanel Orientation="Horizontal" Spacing="24">
            <Button
                x:Name="ChangePasswordButton"
                Click="ChangePasswordClicked"
                Content="Change password"
                Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="RemovePasswordButton" Click="RemovePasswordClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                    <TextBlock Text="Remove password…" />
                </StackPanel>
            </Button>
        </StackPanel>
        <InfoBar
            Closed="NoticeBar_Closed"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}"
            Severity="{x:Bind settings:DashboardPage.Severity(ViewModel.Notice), Mode=OneWay}"
            Title="{x:Bind ViewModel.Notice.Title, Mode=OneWay}" />
    </StackPanel>
</Page>
