<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.JellyfinSettings.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Views.JellyfinSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    mc:Ignorable="d">

    <Page.Resources>
        <c:JellyfinImageConverter x:Key="PrimaryImageConverter" />
        <c:HumanizeConverter x:Key="HumanizeConverter" />
    </Page.Resources>

    <Grid Padding="{StaticResource LargeLeftRightMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,40,0,36" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource SubheaderTextBlockStyle}"
                    Text="Users" />
                <!--  D25: a text button "Add user" (role: Secondary Compact); Help is a link that leaves the app (D26)  -->
                <Button x:Name="AddUserButton" Command="{x:Bind root:App.Dialogs.AddUserDialogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock Text="Add user" />
                    </StackPanel>
                </Button>
                <HyperlinkButton NavigateUri="https://jellyfin.org/docs/general/server/users/adding-managing-users/" ToolTipService.ToolTip="Opens jellyfin.org in your browser">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Help" />
                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>
            <InfoBar
                Closed="NoticeBar_Closed"
                IsOpen="{x:Bind local:LibrariesSettingsPage.IsOpen(ViewModel.Notice), Mode=OneWay}"
                Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}"
                Severity="{x:Bind local:DashboardPage.Severity(ViewModel.Notice), Mode=OneWay}"
                Title="{x:Bind ViewModel.Notice.Title, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="jm:UserDto">
                        <Grid CornerRadius="{StaticResource ControlCornerRadius}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:LoadingImage Glyph="&#xEA8C;" />

                            <Grid
                                Grid.Row="1"
                                Padding="8"
                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                    <TextBlock
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind LastActivityDate, Converter={StaticResource HumanizeConverter}}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <!--  D27: role Subtle/icon Compact (32), named for its user; D28-D31: sentence case, Delete last after a separator  -->
                                <Button
                                    Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.Name="{x:Bind local:UsersPage.MoreName(Name)}"
                                    Content="{ui:FontIcon Glyph=&#xE712;, FontSize=16}"
                                    ToolTipService.ToolTip="More options">
                                    <Button.Flyout>
                                        <MenuBarItemFlyout>
                                            <MenuFlyoutItem
                                                Click="MenuFlyoutItem_Click"
                                                CommandParameter="{x:Bind}"
                                                Icon="{ui:SymbolIcon Symbol=Edit}"
                                                Tag="{x:Bind vm:UserEditorSection.Profile}"
                                                Text="Edit user" />
                                            <MenuFlyoutItem
                                                Click="MenuFlyoutItem_Click"
                                                CommandParameter="{x:Bind}"
                                                Icon="{ui:FontIcon Glyph=&#xE72E;}"
                                                Tag="{x:Bind vm:UserEditorSection.Access}"
                                                Text="Library access" />
                                            <MenuFlyoutItem
                                                Click="MenuFlyoutItem_Click"
                                                CommandParameter="{x:Bind}"
                                                Tag="{x:Bind vm:UserEditorSection.ParentalControl}"
                                                Text="Parental control" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Click="DeleteUser_Click"
                                                CommandParameter="{x:Bind}"
                                                Icon="{ui:SymbolIcon Symbol=Delete}"
                                                Text="Delete user…" />
                                        </MenuBarItemFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="275"
                        MinItemWidth="200"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

    </Grid>

</Page>
