<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.JellyfinSettings.LibrariesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Views.JellyfinSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    mc:Ignorable="d">

    <Page.Resources>
        <c:JellyfinVirtualFolderImageConverter x:Key="ImageConverter" />
        <c:HumanizeConverter x:Key="HumanizeConverter" />
    </Page.Resources>

    <Grid Padding="{StaticResource LargeLeftRightMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Nixie 1.2.0 (admin, D17 / D18 / D19): "Scan all libraries" scans (it was "Scall All Libraries" with no action) and
            "Add library" creates one (Save returned at once in create mode); both role: Secondary Compact. Help is a link that
            leaves the app (E8A7 after the text).
        -->
        <StackPanel Margin="0,40,0,36" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddLibraryButton" Command="{x:Bind ViewModel.AddLibraryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock Text="Add library" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ScanAllButton"
                    Command="{x:Bind ViewModel.ScanAllCommand}"
                    Content="Scan all libraries" />
                <HyperlinkButton NavigateUri="https://jellyfin.org/docs/general/server/libraries/" ToolTipService.ToolTip="Opens jellyfin.org in your browser">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Help" />
                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>
            <InfoBar
                Closed="NoticeBar_Closed"
                IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}"
                Severity="{x:Bind local:DashboardPage.Severity(ViewModel.Notice), Mode=OneWay}"
                Title="{x:Bind ViewModel.Notice.Title, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.VirtualFolders, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="jm:VirtualFolderInfo">
                        <Grid CornerRadius="{StaticResource ControlCornerRadius}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:LoadingImage Glyph="&#xEA8C;" Source="{x:Bind c:BaseItemDtoConverters.GetImage((jm:VirtualFolderInfo))}" />

                            <Grid
                                Grid.Row="1"
                                Padding="8"
                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind CollectionType}" />
                                    <TextBlock Text="{x:Bind local:LibrariesSettingsPage.SingleOrCount(Locations)}" />
                                </StackPanel>

                                <!--  D20: role Subtle/icon Compact (32), named for its library; D21 / D23: "Refresh metadata…", Delete last after a separator  -->
                                <Button
                                    Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.Name="{x:Bind local:LibrariesSettingsPage.MoreName(Name)}"
                                    Content="{ui:FontIcon Glyph=&#xE712;, FontSize=16}"
                                    ToolTipService.ToolTip="More options">
                                    <Button.Flyout>
                                        <MenuBarItemFlyout>
                                            <MenuFlyoutItem
                                                Command="{x:Bind root:App.Dialogs.RefreshMetadataDialogCommand}"
                                                CommandParameter="{x:Bind c:Converters.ToGuid(ItemId)}"
                                                Icon="{ui:SymbolIcon Symbol=Refresh}"
                                                Text="Refresh metadata…" />
                                            <MenuFlyoutItem
                                                Click="OnManage"
                                                Icon="{ui:FontIcon Glyph=&#xE8D5;}"
                                                Tag="{x:Bind}"
                                                Text="Manage…" />
                                            <MenuFlyoutItem
                                                Click="OnRename"
                                                Icon="{ui:SymbolIcon Symbol=Rename}"
                                                Tag="{x:Bind}"
                                                Text="Rename…" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Click="OnDelete"
                                                Icon="{ui:SymbolIcon Symbol=Delete}"
                                                Tag="{x:Bind}"
                                                Text="Delete library…" />
                                        </MenuBarItemFlyout>
                                    </Button.Flyout>
                                </Button>

                            </Grid>

                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="270"
                        MinItemWidth="330"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

    </Grid>

</Page>
