<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:ctkl="using:CommunityToolkit.Labs.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dwui="using:DevWinUI"
    xmlns:generic="using:System.Collections.Generic"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:FluentFin.Core.Contracts.Services"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <cc:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <cc:StringFormatConverter x:Key="StringFormatConverter" />
        <!--  fluentfin-mpv: placeholders for a 390x240 wide card and a 225x385 poster card, each drawn at 90 % of its slot  -->
        <Style x:Key="WideCardPlaceholder" TargetType="ctkl:Shimmer">
            <Setter Property="Width" Value="351" />
            <Setter Property="Height" Value="216" />
            <Setter Property="Margin" Value="19.5,12" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="PosterCardPlaceholder" TargetType="ctkl:Shimmer">
            <Setter Property="Width" Value="202.5" />
            <Setter Property="Height" Value="346.5" />
            <Setter Property="Margin" Value="11.25,19.25" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Invoked="NextUpInvoked" />
        <KeyboardAccelerator Key="C" Invoked="ContinueInvoked" />
        <!--  Seaglass 1.1.4: Undo of a removal from Continue Watching, while its notice shows  -->
        <KeyboardAccelerator
            Key="Z"
            Invoked="UndoInvoked"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <!--
        fluentfin-mpv: progressive home. The page is laid out at once; Continue Watching, Next Up and each "Recently
        Added" row (named from the views sign-in already read) show placeholder cards, sized and spaced like the cards
        they stand in for (the cards draw at 90 % of their slot), until their own request answers. A section that
        turns out empty goes away. Upstream showed one shimmer page until every request had answered.
    -->
    <Grid>
    <!--
        1.1.4: the hero runs edge to edge (the page has no margin, the scroller none on top, the hero none): it sits right
        under the title bar, and under the top bar the account stream adds. The rest keeps the old inset (RowsMargin: 24 a
        side, and 36 on top while there is no hero).
    -->
    <ScrollViewer
        x:Name="PageScroller"
        Margin="0,0,0,36"
        VerticalScrollBarVisibility="Hidden">
        <StackPanel>
            <!--
                fluentfin-mpv: Home failed, is empty, or only partly loaded (docs/research/ux-review.md H6); no ring of its own,
                the placeholders are the loading state. No height when it has nothing to say: the hero is the first thing then.
            -->
            <lc:LoadStateView Margin="36,0" State="{x:Bind ViewModel.State}" />
            <!--  Seaglass: the hero; absent until the rows have something with a backdrop to show, so the first paint is the rows' placeholders  -->
            <lc:HomeHero Margin="0" Slides="{x:Bind ViewModel.Hero, Mode=OneWay}" />
            <StackPanel
                x:Name="RowsPanel"
                Margin="{x:Bind local:HomePage.RowsMargin(ViewModel.Hero), Mode=OneWay}"
                Spacing="20">
            <StackPanel Padding="12,0,0,0" Visibility="{x:Bind local:HomePage.SectionVisibility(ViewModel.IsContinueLoading, ViewModel.HasContinueItems), Mode=OneWay}">

                <!--  the loading state: the title and placeholder cards; the row below takes over (same slots, so nothing moves)  -->
                <StackPanel Visibility="{x:Bind ViewModel.IsContinueLoading, Mode=OneWay}">
                    <TextBlock
                        Margin="{StaticResource SmallTopBottomMargin}"
                        Style="{StaticResource GlassSectionTitleTextBlockStyle}"
                        Text="Continue Watching" />
                    <StackPanel Orientation="Horizontal">
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                    </StackPanel>
                </StackPanel>

                <lc:ShelfRow
                    x:Name="ContinueRow"
                    Header="Continue Watching"
                    HasSeeAll="True"
                    ItemsSource="{x:Bind ViewModel.ContinueItems, Mode=OneWay}"
                    SeeAll="ContinueSeeAll"
                    Visibility="{x:Bind local:HomePage.LoadedVisibility(ViewModel.IsContinueLoading), Mode=OneWay}">
                    <lc:ShelfRow.ItemTemplate>
                        <DataTemplate x:DataType="vm:BaseItemViewModel">
                            <lc:BaseItemDtoCard
                                Width="390"
                                Height="240"
                                BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Thumb, 192)}"
                                ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Thumb, 192)}"
                                JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                                Model="{x:Bind}" />
                        </DataTemplate>
                    </lc:ShelfRow.ItemTemplate>
                </lc:ShelfRow>
            </StackPanel>

            <StackPanel Padding="12,0,0,0" Visibility="{x:Bind local:HomePage.SectionVisibility(ViewModel.IsNextUpLoading, ViewModel.HasNextUpItems), Mode=OneWay}">

                <!--  the loading state: the title and placeholder cards; the row below takes over (same slots, so nothing moves)  -->
                <StackPanel Visibility="{x:Bind ViewModel.IsNextUpLoading, Mode=OneWay}">
                    <TextBlock
                        Margin="{StaticResource SmallTopBottomMargin}"
                        Style="{StaticResource GlassSectionTitleTextBlockStyle}"
                        Text="Next Up" />
                    <StackPanel Orientation="Horizontal">
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                        <ctkl:Shimmer Style="{StaticResource WideCardPlaceholder}" />
                    </StackPanel>
                </StackPanel>

                <lc:ShelfRow
                    x:Name="NextUpRow"
                    Header="Next Up"
                    HasSeeAll="True"
                    ItemsSource="{x:Bind ViewModel.NextUpItems, Mode=OneWay}"
                    SeeAll="NextUpSeeAll"
                    Visibility="{x:Bind local:HomePage.LoadedVisibility(ViewModel.IsNextUpLoading), Mode=OneWay}">
                    <lc:ShelfRow.ItemTemplate>
                        <DataTemplate x:DataType="vm:BaseItemViewModel">
                            <lc:BaseItemDtoCard
                                Width="390"
                                Height="240"
                                BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Thumb, 192)}"
                                ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Thumb, 192)}"
                                JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                                Model="{x:Bind}" />
                        </DataTemplate>
                    </lc:ShelfRow.ItemTemplate>
                </lc:ShelfRow>
            </StackPanel>

            <!--  Seaglass scrolling: an ItemsControl, not a virtualizing ItemsRepeater: Tab never reached the rows after the first one in a repeater (the audit's gap)  -->
            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.RecentItems, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NamedQueryResult">
                        <Grid>
                            <lc:ShelfRow
                                Margin="{StaticResource SmallLeftRightMargin}"
                                Header="{x:Bind Title}"
                                HasSeeAll="True"
                                ItemsSource="{x:Bind Items, Mode=OneWay}"
                                SeeAll="RecentSeeAll"
                                Tag="{x:Bind Library}"
                                Visibility="{x:Bind local:HomePage.LoadedVisibility(IsLoading), Mode=OneWay}">
                                <lc:ShelfRow.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BaseItemViewModel">
                                        <lc:BaseItemDtoCard
                                            Width="225"
                                            Height="385"
                                            BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Thumb, 302)}"
                                            ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 302)}"
                                            JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                                            Model="{x:Bind}" />
                                    </DataTemplate>
                                </lc:ShelfRow.ItemTemplate>
                            </lc:ShelfRow>

                            <!--  the same header and card slots as ShelfRow, so nothing moves when the row fills in  -->
                            <StackPanel
                                Margin="{StaticResource SmallLeftRightMargin}"
                                Spacing="16"
                                Visibility="{x:Bind IsLoading, Mode=OneWay}">
                                <Grid Height="40">
                                    <TextBlock Style="{StaticResource GlassSectionTitleTextBlockStyle}" Text="{x:Bind Title}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ctkl:Shimmer Style="{StaticResource PosterCardPlaceholder}" />
                                    <ctkl:Shimmer Style="{StaticResource PosterCardPlaceholder}" />
                                    <ctkl:Shimmer Style="{StaticResource PosterCardPlaceholder}" />
                                    <ctkl:Shimmer Style="{StaticResource PosterCardPlaceholder}" />
                                    <ctkl:Shimmer Style="{StaticResource PosterCardPlaceholder}" />
                                    <ctkl:Shimmer Style="{StaticResource PosterCardPlaceholder}" />
                                    <ctkl:Shimmer Style="{StaticResource PosterCardPlaceholder}" />
                                    <ctkl:Shimmer Style="{StaticResource PosterCardPlaceholder}" />
                                    <ctkl:Shimmer Style="{StaticResource PosterCardPlaceholder}" />
                                    <ctkl:Shimmer Style="{StaticResource PosterCardPlaceholder}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <!--
        Seaglass 1.1.4: the notice after a removal from Continue Watching: what happened and Undo (Ctrl+Z), for about ten
        seconds (held while the pointer or the keyboard is on it). Chrome over the content, so glass: the overlay recipe
        (GlassPanelStrongBrush, the light edge, 12 px corners). Narrator hears it as it appears (a polite live region).
        Shown, worded and its Undo shown from code (HomePage.ShowNotice): an x:Bind function of the notice was not called
        again when the notice went (null), and an empty panel with its Undo stayed on screen.
    -->
    <Border
        x:Name="NoticePanel"
        MinHeight="56"
        MaxWidth="640"
        Margin="24,0,24,32"
        Padding="20,8,8,8"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Background="{ThemeResource GlassPanelStrongBrush}"
        BorderBrush="{ThemeResource GlassStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource GlassOverlayCornerRadius}"
        PointerEntered="Notice_PointerEntered"
        PointerExited="Notice_PointerExited"
        GotFocus="Notice_GotFocus"
        LostFocus="Notice_LostFocus"
        Visibility="Collapsed">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="NoticeText"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource GlassTextPrimaryBrush}"
                TextWrapping="Wrap" />
            <Button
                x:Name="UndoButton"
                Grid.Column="1"
                MinHeight="40"
                Padding="18,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Undo"
                Click="UndoButton_Click"
                Content="Undo"
                Style="{StaticResource GlassInsetPillButtonStyle}"
                ToolTipService.ToolTip="Undo (Ctrl+Z)"
                Visibility="Collapsed" />
            <Button
                x:Name="NoticeCloseButton"
                Grid.Column="2"
                Width="40"
                Height="40"
                VerticalAlignment="Center"
                AutomationProperties.Name="Close the notice"
                Click="NoticeCloseButton_Click"
                Style="{StaticResource GlassIconButtonStyle}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>
    </Border>
    </Grid>
</Page>
