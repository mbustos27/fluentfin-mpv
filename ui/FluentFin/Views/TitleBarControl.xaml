<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Views.TitleBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="using:FluentFin.Behaviors"
    xmlns:behaviors="using:FluentFin.Behaviors"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:core="using:FluentFin.Core"
    xmlns:cvm="using:FluentFin.Core.ViewModels"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:devwinui="using:DevWinUI"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <UserControl.Resources>
        <cc:EmptyObjectToObjectConverter
            x:Key="ObjectToVisibilityConverter"
            EmptyValue="Collapsed"
            NotEmptyValue="Visible" />
        <cc:EmptyObjectToObjectConverter
            x:Key="ObjectToBoolConverter"
            EmptyValue="False"
            NotEmptyValue="True" />
    </UserControl.Resources>

    <!--
        1.2.0 (the top bar, replacing the left rail): the window's one bar, over the content (MainWindow, ShellPage): Back, the
        wordmark (a text placeholder: the glass stream's AppWordmark replaces it), the section tabs (TopTabStrip), then search
        and the account. One glass layer behind it; over a page that extends under it (a hero, Controls.TopBar.ExtendsUnder) a
        dark scrim instead, and the bar's text in the dark theme (TitleBarControl.ShowBackground). The TitleBar control keeps
        the window's drag regions and caption buttons: the tabs, search and account are its interactive areas.
        Narrow windows (1100 px and below): the tabs fold into one menu button, search into a button that opens the box.
    -->
    <Grid x:Name="BarRoot" Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsVisible), Mode=OneWay}">
        <!--
            Nixie 1.3.0: the glass and the scrim are the chrome's (TopBarChrome, its default style in Styles/TopBarChrome.xaml),
            drawn behind the bar: the active layout theme's TopBarStyle restyles the chrome alone (ThemeResources), so the bar's
            parts are never moved or rebuilt by a switch; the chrome's Padding insets them.
        -->
        <lc:TopBarChrome
            x:Name="BarChrome"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False" />
    <!--  the wordmark and the tabs in the left header, after Back: the TitleBar centres its Content; the middle stays the drag area  -->
    <!--
        Nixie 1.4.0 (item 4, the review's X8): the TitleBar itself is no Tab stop (it took the focus after navigation, with no
        name and no ring); its Back, tabs, search and account still are.
        Item 6 (the review's X14, CL-m1, DI-M8): a disabled Back keeps its slot but draws no tile (the dead control was the most
        button-like thing in the bar), its arrow at 40 %; Back is 40 x 32, 16 px from the window's edge, with the bar's subtle
        8-radius fill on hover and press (TitleBarControl.StyleBackButton); the account ends 22 px before the caption buttons.
    -->
    <TitleBar
        x:Name="TitleBar"
        Height="48"
        Margin="{x:Bind BarChrome.Padding, Mode=OneWay}"
        BackRequested="TitleBar_BackRequested"
        IsBackButtonEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
        IsBackButtonVisible="{x:Bind ViewModel.IsBackButtonShown, Mode=OneWay}"
        IsPaneToggleButtonVisible="False"
        IsTabStop="False">
        <TitleBar.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        <SolidColorBrush
                            x:Key="TitleBarBackButtonForegroundDisabled"
                            Opacity="0.4"
                            Color="{ThemeResource TextFillColorPrimary}" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <StaticResource x:Key="TitleBarBackButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        <SolidColorBrush
                            x:Key="TitleBarBackButtonForegroundDisabled"
                            Opacity="0.4"
                            Color="{ThemeResource TextFillColorPrimary}" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="TitleBarBackButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TitleBarBackButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <x:Double x:Key="TitleBarMinDragRegionWidth">22</x:Double>
            </ResourceDictionary>
        </TitleBar.Resources>
        <TitleBar.LeftHeader>
            <StackPanel
                x:Name="LeftHeaderPanel"
                VerticalAlignment="Stretch"
                Orientation="Horizontal"
                SizeChanged="OnHeaderSizeChanged">
                <!--
                    the wordmark: the glass stream's AppWordmark at title-bar size (plain, no glow); "Preview" on a test build.
                    Nixie 1.4.0 (CL-p3): a click on it goes Home (no Tab stop: the Home tab is the keyboard's); 16 px after
                    Back's arrow, 24 to the first tab's label (the review's 16 / 24 / 24 / 8 rhythm)
                -->
                <Button
                    x:Name="Wordmark"
                    Margin="4,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Home"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnWordmarkClick"
                    IsTabStop="False"
                    Style="{StaticResource DefaultButtonStyle}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <lc:AppWordmark
                            x:Name="WordmarkText"
                            VerticalAlignment="Center"
                            Size="15"
                            Text="{x:Bind ViewModel.AppName}" />
                        <TextBlock
                            x:Name="SubtitleText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Subtitle}" />
                    </StackPanel>
                </Button>
                <lc:TopTabStrip
                    x:Name="Tabs"
                    Margin="12,0,0,0"
                    VerticalAlignment="Stretch"
                    Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsNavigationShown), Mode=OneWay}" />
            </StackPanel>
        </TitleBar.LeftHeader>
        <TitleBar.RightHeader>
            <StackPanel
                x:Name="RightHeaderPanel"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                SizeChanged="OnHeaderSizeChanged"
                Spacing="8">
                <!--
                    Nixie 1.4.0 (the trail rule): the search box (or its button) and its mark, the tabs' underline on its bottom edge
                    while its results, or an item opened from it, show (TitleBarControl.ShowLit)
                -->
                <Grid x:Name="SearchHost" VerticalAlignment="Center">
                <!--  narrow windows: search is a button that opens the box (it folds back when left empty)  -->
                <!--  button review T5: a subtle 32 x 32 icon button, radius 8 (it rendered as a 40 x 44 ellipse); the role style at the merge  -->
                <Button
                    x:Name="SearchIconButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Search"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnSearchIconClick"
                    CornerRadius="8"
                    ToolTipService.Placement="Bottom"
                    ToolTipService.ToolTip="Search (Ctrl+F or /)"
                    Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE721;" />
                </Button>
            <AutoSuggestBox
                x:Name="SearchBox"
                Width="320"
                Height="32"
                VerticalAlignment="Center"
                LostFocus="OnSearchLostFocus"
                CornerRadius="8"
                AutomationProperties.Name="Search"
                KeyboardAcceleratorPlacementMode="Hidden"
                PlaceholderText="Search"
                ToolTipService.Placement="Bottom"
                ToolTipService.ToolTip="Search (Ctrl+F or /)"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextMemberPath="Name"
                Visibility="Collapsed">
                <!--
                    Seaglass 1.1.4 (interaction audit, item 2): the arrows only move through the rows, the box showing the row's name
                    (TextMemberPath: every row has a Name); Enter on a row opens it, Enter on the text opens the results page
                    (GlobalSearchBoxBehavior, SearchSuggestions.OnSubmitted). Narrator reads each row's ToString ("Name, year,
                    type"). The text clears when you leave for another page (TitleBarViewModel.OnPageShown).
                -->
                <!--  Seaglass: the search box is glass: the frosted brush and the lit edge, the stronger glass while typing (1.2.0: a field's corners, not a pill's)  -->
                <!--
                    1.4.0 contrast (the review's plan item 3): the field is its own dense plate in the bar's theme. It aliased the
                    app's glass brushes, which resolve in the app's theme: over a hero in Light the bar's text turned the dark
                    theme's while the field stayed the light glass (the placeholder 2.99 to 3.81:1, a typed word 1.35:1); and the
                    thin acrylic let bright art through (it samples the art behind the bar, not the bar). The dusk and noon tints
                    of GlassPanelStrongBrush at 88 % (94 % while typing): 4.5:1 or more over white and black art
                -->
                <AutoSuggestBox.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="TextControlBackground" Color="#E034181D" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#E034181D" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#F034181D" />
                                <StaticResource x:Key="TextControlBorderBrush" ResourceKey="GlassStrokeBrush" />
                                <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="GlassStrokeBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TextControlBackground" Color="#E0FFF3F1" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#E0FFF3F1" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#F0FFF3F1" />
                                <StaticResource x:Key="TextControlBorderBrush" ResourceKey="GlassStrokeBrush" />
                                <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="GlassStrokeBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SystemColorWindowColor}" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource SystemColorWindowColor}" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource SystemColorWindowColor}" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </AutoSuggestBox.Resources>
                <!--  Nixie 1.4.0: no Ctrl+F accelerator of its own: the window's shortcuts (WindowShortcuts, AppShortcut.FocusSearch) own Ctrl+F, Ctrl+E and /  -->
                <i:Interaction.Behaviors>
                    <b:GlobalSearchBoxBehavior />
                </i:Interaction.Behaviors>
                <!--  fluentfin-mpv: an item, or a message row (no results, a failed search to try again: SearchSuggestions)  -->
                <AutoSuggestBox.ItemTemplateSelector>
                    <lc:SearchSuggestionTemplateSelector>
                        <lc:SearchSuggestionTemplateSelector.ItemTemplate>
                            <DataTemplate x:DataType="cvm:SearchSuggestion">
                                <Grid Padding="3" ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid CornerRadius="{StaticResource ControlCornerRadius}">
                                        <lc:LazyLoadedImage
                                            Height="90"
                                            AutomationProperties.AccessibilityView="Raw"
                                            BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Item, jm:ImageType.Primary, 100)}"
                                            ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Item, jm:ImageType.Primary, 100)}"
                                            Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind c:BaseItemDtoConverters.GetCardSubtitle(Item)}" />
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind cvm:SearchLabels.KindTitle(Item.Type)}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </lc:SearchSuggestionTemplateSelector.ItemTemplate>
                        <lc:SearchSuggestionTemplateSelector.MessageTemplate>
                            <DataTemplate x:DataType="cvm:SearchMessage">
                                <StackPanel Padding="3,6" Spacing="2">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Message}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </DataTemplate>
                        </lc:SearchSuggestionTemplateSelector.MessageTemplate>
                        <!--  Seaglass 1.1.4: more matches than the list shows: the results page  -->
                        <lc:SearchSuggestionTemplateSelector.SeeAllTemplate>
                            <DataTemplate x:DataType="cvm:SearchSeeAll">
                                <StackPanel
                                    Padding="3,6"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="14"
                                        Glyph="&#xE721;" />
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                </StackPanel>
                            </DataTemplate>
                        </lc:SearchSuggestionTemplateSelector.SeeAllTemplate>
                    </lc:SearchSuggestionTemplateSelector>
                </AutoSuggestBox.ItemTemplateSelector>
                <AutoSuggestBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </AutoSuggestBox.ItemsPanel>
            </AutoSuggestBox>
                <Border
                    x:Name="SearchLit"
                    Height="2"
                    Margin="8,0,8,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource GlassTabUnderlineBrush}"
                    CornerRadius="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
                </Grid>
                <!--  fluentfin-mpv: a sign-out in progress (the mpv playback's stop and report, up to ~2 s, then the sign-out request)  -->
                <StackPanel
                    x:Name="SignOutPanel"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsSigningOut), Mode=OneWay}">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind ViewModel.IsSigningOut, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SignOutStatus, Mode=OneWay}" />
                </StackPanel>
                <!--
                    Seaglass 1.1.4 (UX review, prioritised fix 15): the Account menu: who is signed in and to which server, Switch user,
                    Settings and, last after a separator, Sign out (layout audit, item 18); it dims nothing (no light-dismiss overlay). Sync Play, Quick Connect and Play On moved to Settings > Other devices; the admin Dashboard
                    went (administrators open the server's administration from Settings > Servers and accounts). Hidden while the player
                    page is shown (fix 5: a Sign out over a playing video is a hazard), from the navigation (TitleBarViewModel).
                -->
                <!--  button review T8: a 32 px circle (it rendered as a 40 x 44 ellipse), the tooltip naming the user; the role style at the merge  -->
                <Button
                    x:Name="AccountButton"
                    Width="32"
                    Height="32"
                    MinHeight="0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind core:ItemLabels.AccountButtonName(ViewModel.User.Name), Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="16"
                    ToolTipService.Placement="Bottom"
                    ToolTipService.ToolTip="{x:Bind core:ItemLabels.AccountTooltip(ViewModel.User.Name), Mode=OneWay}"
                    Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsAccountShown), Mode=OneWay}">
                    <Grid>
                        <PersonPicture
                            Width="30"
                            Height="30"
                            AutomationProperties.AccessibilityView="Raw"
                            DisplayName="{x:Bind ViewModel.User.Name, Mode=OneWay}" />
                        <!--  Nixie 1.4.0 (the trail rule): Settings lit, an accent ring on the account (TitleBarControl.ShowLit)  -->
                        <Ellipse
                            x:Name="AccountLit"
                            Width="32"
                            Height="32"
                            IsHitTestVisible="False"
                            Stroke="{ThemeResource GlassTabUnderlineBrush}"
                            StrokeThickness="2"
                            Visibility="Collapsed" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout
                            x:Name="AccountFlyout"
                            AreOpenCloseAnimationsEnabled="True"
                            LightDismissOverlayMode="Off"
                            Placement="BottomEdgeAlignedRight">
                            <!--  the menu's pane is named for Narrator ("Account"); the glass is the shared presenter's  -->
                            <Flyout.FlyoutPresenterStyle>
                                <Style BasedOn="{StaticResource GlassFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="Account" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel
                                x:Name="AccountMenu"
                                MinWidth="260"
                                Spacing="2">
                                <!--  the signed-in user and the server  -->
                                <Grid
                                    x:Name="AccountIdentity"
                                    Margin="4,4,4,8"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture
                                        Width="48"
                                        Height="48"
                                        AutomationProperties.AccessibilityView="Raw"
                                        DisplayName="{x:Bind ViewModel.User.Name, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="AccountUserName"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind ViewModel.User.Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="AccountServerName"
                                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.ServerName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <MenuFlyoutSeparator Margin="{StaticResource XSmallTopBottomMargin}" />

                                <!--  1.6 topbar: the plugins' sections (Diary, Playback reports), moved here from the bar (the review's T4): TitleBarControl.ShowSections  -->
                                <StackPanel
                                    x:Name="AccountSections"
                                    Spacing="2"
                                    Visibility="Collapsed" />
                                <MenuFlyoutSeparator
                                    x:Name="AccountSectionsSeparator"
                                    Margin="{StaticResource XSmallTopBottomMargin}"
                                    Visibility="Collapsed" />
                                <!--  end 1.6 topbar  -->

                                <lc:MenuFlyoutButton
                                    x:Name="SwitchUserItem"
                                    HorizontalAlignment="Stretch"
                                    Click="CloseAccountFlyout"
                                    Command="{x:Bind ViewModel.SwitchUserCommand}"
                                    Content="Switch user"
                                    Icon="{ui:FontIcon Glyph=&#xE748;}" />
                                <lc:MenuFlyoutButton
                                    x:Name="SettingsItem"
                                    HorizontalAlignment="Stretch"
                                    Click="CloseAccountFlyout"
                                    Command="{x:Bind ViewModel.GoToSettingsCommand}"
                                    Content="Settings"
                                    Icon="{ui:FontIcon Glyph=&#xE713;}" />

                                <MenuFlyoutSeparator Margin="{StaticResource XSmallTopBottomMargin}" />

                                <lc:MenuFlyoutButton
                                    x:Name="SignOutItem"
                                    HorizontalAlignment="Stretch"
                                    Click="CloseAccountFlyout"
                                    Command="{x:Bind ViewModel.LogoutCommand}"
                                    Content="Sign out"
                                    Icon="{ui:FontIcon Glyph=&#xF3B1;}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </TitleBar.RightHeader>
    </TitleBar>
    </Grid>

</UserControl>
