<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.SelectServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentFin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:FluentFin.Core.Settings"
    mc:Ignorable="d">

    <Page.Resources>
        <cc:BoolToVisibilityConverter x:Name="BooleanToVisibilityConverter" />
    </Page.Resources>

    <!--
        1.1.4 (states): one glass card, as the sign-in page: the app's name is the page's heading, the saved servers a
        second-level one; a labelled address box with an example, where the keyboard starts; what is going on under the
        buttons (a polite live region) and why the last attempt did not work in a warning on the page (it announces itself).
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <ContentControl
            Width="560"
            Margin="24"
            Padding="44,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource GlassPanelStrongBrush}"
            Style="{StaticResource GlassSurfaceStyle}">
        <StackPanel Spacing="20">
            <StackPanel.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Spacing" Value="5" />
                </Style>
            </StackPanel.Resources>

            <StackPanel Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource GlassPageTitleTextBlockStyle}"
                    Text="Seaglass" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource GlassTextSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="Choose your Jellyfin server"
                    TextAlignment="Center" />
            </StackPanel>

            <StackPanel Margin="{StaticResource MediumBottomMargin}" Visibility="{x:Bind ViewModel.HasServers, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    FontWeight="SemiBold"
                    Text="Saved servers" />
                <ItemsView
                    AutomationProperties.Name="Saved servers"
                    IsItemInvokedEnabled="True"
                    ItemInvoked="ServerSelected"
                    ItemsSource="{x:Bind ViewModel.Servers}"
                    SelectionMode="None">
                    <ItemsView.ItemTemplate>
                        <DataTemplate x:DataType="settings:SavedServer">
                            <!--  fluentfin-mpv: named after the server (Narrator read "ItemContainer"); a long name is trimmed, whole in the tooltip  -->
                            <ItemContainer
                                Width="100"
                                Height="100"
                                AutomationProperties.Name="{x:Bind DisplayName}"
                                Background="{ThemeResource GlassInsetFillBrush}"
                                CornerRadius="{StaticResource GlassCardCornerRadius}"
                                ToolTipService.ToolTip="{x:Bind DisplayName}">
                                <Grid Padding="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Viewbox Width="50">
                                        <FontIcon Glyph="&#xED47;" />
                                    </Viewbox>

                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>
                    </ItemsView.ItemTemplate>
                    <ItemsView.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="10" />
                    </ItemsView.Layout>
                </ItemsView>
            </StackPanel>

            <!--  fluentfin-mpv: a labelled address box with an example (docs/research/ux-review.md F2)  -->
            <StackPanel>
                <TextBox
                    x:Name="TxtUrl"
                    AutomationProperties.Name="Server address"
                    Header="Server address"
                    InputScope="Url"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    KeyDown="InputFieldKeyDown"
                    PlaceholderText="https://jellyfin.example.com:8920" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <!--  fluentfin-mpv: named (a text in a panel does not name its button for Narrator)  -->
                <!--  1.1.4 (states): "Find servers" (it was "Detect": what it finds was not said)  -->
                <Button
                    AutomationProperties.Name="Find servers"
                    Command="{x:Bind ViewModel.DetectServersCommand}"
                    Style="{StaticResource GlassPillButtonStyle}"
                    ToolTipService.ToolTip="Look for Jellyfin servers on this network">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ctk:SwitchPresenter TargetType="x:Boolean" Value="{x:Bind ViewModel.IsDetecting, Mode=OneWay}">
                            <ctk:Case IsDefault="true" Value="False">
                                <FontIcon Glyph="&#xEDE4;" />
                            </ctk:Case>
                            <ctk:Case Value="True">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsIndeterminate="True" />
                            </ctk:Case>
                        </ctk:SwitchPresenter>
                        <TextBlock Text="Find servers" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Next"
                    Command="{x:Bind ViewModel.CheckConnectivityAndGoToLoginCommand}"
                    CommandParameter="{x:Bind TxtUrl.Text, Mode=OneWay}"
                    Style="{StaticResource GlassAccentPillButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <!--  fluentfin-mpv: progress while the address is checked  -->
                        <ctk:SwitchPresenter TargetType="x:Boolean" Value="{x:Bind ViewModel.IsConnecting, Mode=OneWay}">
                            <ctk:Case IsDefault="true" Value="False">
                                <FontIcon Glyph="&#xE725;" />
                            </ctk:Case>
                            <ctk:Case Value="True">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsIndeterminate="True" />
                            </ctk:Case>
                        </ctk:SwitchPresenter>
                        <TextBlock Text="Next" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  fluentfin-mpv: what is going on, and why the last attempt did not work (on the page, not in a dialog)  -->
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            <InfoBar
                x:Name="ErrorBar"
                CornerRadius="{StaticResource GlassCardCornerRadius}"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Warning" />
        </StackPanel>
        </ContentControl>
    </ScrollViewer>
</Page>
