<?xml version="1.0" encoding="utf-8" ?>
<!--
    Classic: the Library. Nixie 1.4.0 (the UX review's items 2, 8, 12, 13 and 4): the library's name and count, the shared
    toolbar (Unwatched, Sort with its direction in words, the direction, Filter, View); the filters on as chips with what is
    shown; the A to Z (or the sort's two directions) in a row whose height is always kept; then the grid of posters at their
    own 2:3 at every width (or the list), small, medium or large. While the library loads, the header stays and the grid's
    own layout draws the placeholders; a filter that leaves nothing says so.
-->
<Page
    x:Class="FluentFin.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:ctkl="using:CommunityToolkit.Labs.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Seaglass: the sort and filter bar is glass pills  -->
        <Style
            x:Key="LibrarySortFilterButtonStyle"
            BasedOn="{StaticResource GlassPillButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="18,8" />
        </Style>
        <!--  the Unwatched switch at the bar's height  -->
        <Style x:Key="LibraryToggleStyle" BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="{StaticResource NixieButtonHeight}" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="CornerRadius" Value="{StaticResource GlassButtonCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  the grid's card: the card inside is the keyboard stop and the element Narrator reads; the container is neither (ux-review A1)  -->
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:BaseItemViewModel">
            <ItemContainer
                AutomationProperties.AccessibilityView="Raw"
                CornerRadius="{StaticResource GlassCardCornerRadius}"
                IsTabStop="False"
                Style="{StaticResource BareItemContainerStyle}">
                <lc:BaseItemDtoCard
                    BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Primary, 352)}"
                    ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 352)}"
                    JellyfinClient="{Binding ElementName=Page, Path=ViewModel.JellyfinClient}"
                    Model="{x:Bind}" />
            </ItemContainer>
        </DataTemplate>
        <!--  the list's row (View > List)  -->
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:BaseItemViewModel">
            <ItemContainer
                AutomationProperties.AccessibilityView="Raw"
                IsTabStop="False"
                Style="{StaticResource BareItemContainerStyle}">
                <lc:LibraryListRow Model="{x:Bind}" />
            </ItemContainer>
        </DataTemplate>
        <!--  a placeholder in the card's own shape (its artwork and its two lines), drawn by a copy of the grid's own layout  -->
        <DataTemplate x:Key="SkeletonCardTemplate">
            <Grid
                ui:VisualExtensions.NormalizedCenterPoint="0.5, 0.5"
                ui:VisualExtensions.Scale="0.9"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ctkl:Shimmer CornerRadius="{StaticResource GlassCardCornerRadius}" />
                <StackPanel Grid.Row="1" Spacing="6">
                    <ctkl:Shimmer Width="140" Height="14" HorizontalAlignment="Left" CornerRadius="4" />
                    <ctkl:Shimmer Width="64" Height="12" HorizontalAlignment="Left" CornerRadius="4" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--
        Seaglass scrolling: hit-testable everywhere, so the wheel over its empty parts reaches the grid, and the page's margin
        is its padding: a margin is outside the page, where the wheel reached nothing
    -->
    <Grid
        x:Name="LibraryRoot"
        Padding="{StaticResource MediumLeftTopRightBottomMargin}"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HeaderRow"
            Margin="{StaticResource MediumBottomMargin}"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource GlassPageTitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <!--  Seaglass 1.1.4 (UX review, fix 16): how many titles the library has ("368 movies", "12 of 368 movies" filtered)  -->
            <TextBlock
                x:Name="CountText"
                Grid.Column="1"
                Margin="0,8,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.LibraryCountText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind local:LibraryPage.BarVisibility(ViewModel.State.Status), Mode=OneWay}" />
            <!--  Seaglass 1.1.4 (layout audit, item 22): nothing to sort or filter in an empty or failed library: the bar goes  -->
            <lc:LibraryToolbar
                x:Name="SortFilterBar"
                Grid.Column="2"
                VerticalAlignment="Center"
                ButtonStyle="{StaticResource LibrarySortFilterButtonStyle}"
                ToggleStyle="{StaticResource LibraryToggleStyle}"
                ViewModel="{x:Bind ViewModel}"
                Visibility="{x:Bind local:LibraryPage.BarVisibility(ViewModel.State.Status), Mode=OneWay}" />
        </Grid>

        <!--  Nixie 1.4.0 (item 2): what is filtered, "Showing 223 of 320 movies · Unwatched ✕ · Clear all"  -->
        <lc:AppliedFilterRow
            x:Name="AppliedFilters"
            Grid.Row="1"
            Margin="12,0,0,12"
            ViewModel="{x:Bind ViewModel}" />

        <!--  Nixie 1.4.0 (item 13): the A to Z, or the sort's directions; while loading its placeholder keeps its height  -->
        <Grid
            x:Name="LetterRow"
            Grid.Row="2"
            Margin="8,0,8,12">
            <lc:LetterBar x:Name="Letters" ViewModel="{x:Bind ViewModel}" />
            <ctkl:Shimmer
                x:Name="LetterPlaceholder"
                Width="420"
                Height="32"
                HorizontalAlignment="Left"
                CornerRadius="{StaticResource GlassChipCornerRadius}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>

        <!--
            Seaglass scrolling: the rows' model for a grid (Controls\CardGrid.cs): the grid is one Tab stop and a list named after
            the library (each card "n of m" in the whole library); arrows in both directions, Home/End, PageUp/PageDown; Tab
            back in lands on the last-focused card; a focused card is scrolled clear of the edges; the wheel anywhere on the
            page scrolls the grid. Nixie 1.4.0: letters typed on a card go to the first title they start.
        -->
        <ScrollView x:Name="GridScroller" Grid.Row="3">
            <lc:RowList
                x:Name="GridList"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                TabFocusNavigation="Once">
                <ItemsRepeater
                    x:Name="GridRepeater"
                    ItemTemplate="{StaticResource CardTemplate}"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <!--  Nixie 1.4.0 (the UX review's X15): Uniform, so a poster keeps its 2:3 at every width (Fill cropped it at 1100)  -->
                        <UniformGridLayout
                            x:Name="GridLayout"
                            ItemsJustification="Start"
                            ItemsStretch="Uniform"
                            MinColumnSpacing="8"
                            MinItemHeight="390"
                            MinItemWidth="220"
                            MinRowSpacing="8"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTransitionProvider>
                        <LinedFlowLayoutItemCollectionTransitionProvider />
                    </ItemsRepeater.ItemTransitionProvider>
                </ItemsRepeater>
            </lc:RowList>
        </ScrollView>

        <!--  Nixie 1.4.0 (item 13): while loading, placeholders laid out by a copy of the grid's own layout (LibrarySkeleton.Mirror)  -->
        <ItemsRepeater
            x:Name="SkeletonRepeater"
            Grid.Row="3"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            ItemTemplate="{StaticResource SkeletonCardTemplate}"
            ItemsSource="{x:Bind c:Converters.GetDummyItemSource(24)}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <UniformGridLayout x:Name="SkeletonLayout" Orientation="Horizontal" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>

        <!--  fluentfin-mpv: the library failed to load or is empty (docs/research/ux-review.md §3.11)  -->
        <lc:LoadStateView
            Grid.Row="3"
            VerticalContentAlignment="Center"
            State="{x:Bind ViewModel.State}" />

        <!--  Nixie 1.4.0 (item 2): a filter that leaves nothing says so  -->
        <lc:LibraryNoMatchesView Grid.Row="3" ViewModel="{x:Bind ViewModel}" />
    </Grid>
</Page>
