<?xml version="1.0" encoding="utf-8" ?>
<!--
    Seaglass: an episode as an opaque card: thumbnail with its progress and a watched mark, "3. Title", runtime and a short
    overview, and Play and Watched.
    Seaglass scrolling: the row is ONE keyboard stop (it was five buttons): Enter plays, Up/Down/Home/End move between episodes
    (EpisodeList), the menu key or Shift+F10 (or a right click, or a long press) opens the row's menu: the episode's page, then
    the More menu (favourite and the rest). Play and Watched stay for the pointer, named for their episode, with no Tab stop of
    their own. Narrator reads the row as a list item "S1E4 Title, watched", "4 of 8" (EpisodeRowAutomationPeer), with a focus
    ring of its own as a card has.
    Seaglass 1.1.4 (1.1.3 UX audit, interaction item 6): a click on the row plays the episode, as Enter does (it opened the
    episode's page), with a play disc over the thumbnail while the pointer is on the row or the keyboard on it; the title is a
    link to the episode's page (underlined under the pointer), as is "Episode details" in the row's menu.
-->
<UserControl
    x:Class="FluentFin.Controls.EpisodeRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    HorizontalContentAlignment="Stretch"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">

    <Grid>
        <Border
            x:Name="Body"
            Padding="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource GlassCardCornerRadius}"
            PointerEntered="Body_PointerEntered"
            PointerExited="Body_PointerExited"
            PointerCanceled="Body_PointerExited"
            Tapped="Body_Tapped">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    Width="176"
                    Height="99"
                    CornerRadius="8">
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Image
                        x:Name="Thumb"
                        AutomationProperties.AccessibilityView="Raw"
                        Stretch="UniformToFill" />
                    <!--
                        Seaglass 1.1.3: the progress and the watched mark are the accent on artwork (Glass.xaml,
                        SeaglassAccentOnImageBrush), as on a card: the bar on a dark track as tall as the bar (WinUI's track is a
                        1 px line), the mark's check in SeaglassOnAccentOnImageBrush (the light theme's deep colour is light).
                    -->
                    <ProgressBar
                        x:Name="Progress"
                        Height="4"
                        MinHeight="4"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource Black65O}"
                        Foreground="{ThemeResource SeaglassAccentOnImageBrush}"
                        Maximum="100"
                        Visibility="Collapsed">
                        <ProgressBar.Resources>
                            <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
                        </ProgressBar.Resources>
                    </ProgressBar>
                    <!--  Seaglass 1.1.4: what a click (or Enter) does, over the thumbnail while the row is pointed at or focused  -->
                    <Border
                        x:Name="PlayDisc"
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Background="{StaticResource Black65O}"
                        CornerRadius="22"
                        IsHitTestVisible="False"
                        RequestedTheme="Dark"
                        Visibility="Collapsed">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource GlassTextPrimaryBrush}"
                            Glyph="&#xF5B0;" />
                    </Border>
                    <Border
                        x:Name="WatchedMark"
                        Margin="6"
                        Padding="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Watched"
                        Background="{ThemeResource SeaglassAccentOnImageBrush}"
                        CornerRadius="999"
                        Visibility="Collapsed">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource SeaglassOnAccentOnImageBrush}"
                            Glyph="&#xE73E;" />
                    </Border>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <!--  the link to the episode's page (keyboard: "Episode details" in the row's menu)  -->
                    <TextBlock
                        x:Name="TitleText"
                        HorizontalAlignment="Left"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        PointerEntered="Title_PointerEntered"
                        PointerExited="Title_PointerExited"
                        Tapped="Title_Tapped"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="Episode details" />
                    <TextBlock
                        x:Name="RuntimeText"
                        Style="{StaticResource GlassMetaTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="OverviewText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    x:Name="Buttons"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  for the pointer: the row is the keyboard stop (Enter plays, the menu has Watched); each named for its episode (ux-review I3), its tooltip the same words (set in code)  -->
                    <Button
                        x:Name="PlayButton"
                        Width="44"
                        Height="44"
                        AutomationProperties.Name="Play"
                        Background="Transparent"
                        Command="{x:Bind root:App.Commands.PlayDtoCommand}"
                        Content="{ui:SymbolIcon Symbol=Play}"
                        CornerRadius="22"
                        IsTabStop="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Play" />
                    <ToggleButton
                        x:Name="WatchedButton"
                        Width="44"
                        Height="44"
                        AutomationProperties.Name="Mark as watched"
                        Background="Transparent"
                        Click="WatchedButton_Click"
                        Content="{ui:FontIcon Glyph=&#xE73E;}"
                        CornerRadius="22"
                        IsTabStop="False"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="Mark as watched" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  the pointer is over the row: a click opens the episode's page  -->
        <Border
            x:Name="HoverOverlay"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource GlassHoverOverlayBrush}"
            CornerRadius="{StaticResource GlassCardCornerRadius}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!--  the keyboard focus (never colour alone): a ring as a card's, never for a click  -->
        <Border
            x:Name="FocusRing"
            AutomationProperties.AccessibilityView="Raw"
            BorderBrush="{ThemeResource GlassTextPrimaryBrush}"
            BorderThickness="3"
            CornerRadius="{StaticResource GlassCardCornerRadius}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
