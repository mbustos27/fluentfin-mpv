<?xml version="1.0" encoding="utf-8" ?>
<!--
    Seaglass: an episode as an opaque row: thumbnail with its progress and a watched mark, the number and title, the runtime and
    a short overview.
    Seaglass scrolling: the row is ONE keyboard stop (it was five buttons): Enter plays, Up/Down/Home/End move between episodes
    (EpisodeList), the menu key or Shift+F10 (or a right click, or a long press) opens the row's menu: the episode's page, then
    the More menu (watched, favourite and the rest). Narrator reads the row as a list item "S1 E4 Title, watched", "4 of 8"
    (EpisodeRowAutomationPeer), with a focus ring of its own as a card has.
    1.2.0 (1.1.3 UX audit, interaction item 6, layout items 7 and 14): a click on the row plays the episode, as Enter
    does, with a Play disc on the thumbnail while the pointer is on the row or the keyboard on it; the title ("S1 E4 · Title ·
    10m") is a link to the episode's page, as is "Episode details" in the menu; the row's "…" sits right after the title; one
    watched mark (the thumbnail's), no check button at the row's end.
-->
<UserControl
    x:Class="FluentFin.Controls.EpisodeRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    HorizontalContentAlignment="Stretch"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">

    <Grid>
        <Border
            x:Name="Body"
            Padding="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource GlassCardCornerRadius}"
            PointerEntered="Body_PointerEntered"
            PointerExited="Body_PointerExited"
            PointerCanceled="Body_PointerExited"
            Tapped="Body_Tapped">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    Width="176"
                    Height="99"
                    CornerRadius="8">
                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Image
                        x:Name="Thumb"
                        AutomationProperties.AccessibilityView="Raw"
                        Stretch="UniformToFill" />
                    <!--
                        Seaglass 1.1.3: the progress and the watched mark are the accent on artwork (Glass.xaml,
                        NixieAccentOnImageBrush), as on a card: the bar on a dark track as tall as the bar (WinUI's track is a
                        1 px line), the mark's check in NixieOnAccentOnImageBrush (the light theme's deep colour is light).
                    -->
                    <ProgressBar
                        x:Name="Progress"
                        Height="4"
                        MinHeight="4"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource Black65O}"
                        Foreground="{ThemeResource NixieAccentOnImageBrush}"
                        Maximum="100"
                        Visibility="Collapsed">
                        <ProgressBar.Resources>
                            <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
                        </ProgressBar.Resources>
                    </ProgressBar>
                    <!--
                        1.2.0 (Nixie button review, I8): a decorative Play disc on the thumbnail while the row is pointed at or has
                        the keyboard; the row itself is the button (a click, Enter, Narrator's Invoke all play), so the disc takes
                        no click and Narrator does not read it.
                    -->
                    <Border
                        x:Name="PlayDisc"
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Background="{StaticResource Black65O}"
                        CornerRadius="22"
                        IsHitTestVisible="False"
                        Opacity="0"
                        RequestedTheme="Dark">
                        <FontIcon
                            FontSize="20"
                            Foreground="{ThemeResource GlassTextPrimaryBrush}"
                            Glyph="&#xF5B0;" />
                    </Border>
                    <!--  1.4.0 (the library UX review, X10): the same watched mark as every card, a dim neutral check, never the accent  -->
                    <Border
                        x:Name="WatchedMark"
                        Margin="6"
                        AutomationProperties.Name="Watched"
                        Style="{StaticResource NixieWatchedBadgeStyle}"
                        Visibility="Collapsed">
                        <FontIcon Style="{StaticResource NixieWatchedGlyphStyle}" />
                    </Border>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <!--
                        1.2.0: "S1 E1 · The Archive Problem · 10m" on one line (the one episode format, ItemLabels.EpisodeTitle),
                        then the row's "…" right after it, not at the window's edge (layout audit item 14). The title is the link to the
                        episode's page (keyboard: "Episode details" in the row's menu); watched is the thumbnail's mark only, and
                        "Mark as watched" is in the menu.
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!--  1.2.0 (Nixie button review, I9): a neutral link to the episode's page, no Tab stop of its own (the row menu's "Episode details" is the keyboard's)  -->
                        <HyperlinkButton
                            x:Name="TitleLink"
                            MaxWidth="560"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="TitleLink_Click"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            IsTabStop="False"
                            PointerEntered="Title_PointerEntered"
                            PointerExited="Title_PointerExited"
                            ToolTipService.ToolTip="Episode details">
                            <TextBlock
                                x:Name="TitleText"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                        </HyperlinkButton>
                        <TextBlock
                            x:Name="RuntimeText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource GlassMetaTextBlockStyle}" />
                        <Button
                            x:Name="MoreButton"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="More options"
                            Background="Transparent"
                            Click="MoreButton_Click"
                            Content="{ui:SymbolIcon Symbol=More}"
                            CornerRadius="8"
                            IsTabStop="False"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="More options" />
                    </StackPanel>
                    <TextBlock
                        x:Name="OverviewText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  the pointer is over the row: a click plays the episode  -->
        <Border
            x:Name="HoverOverlay"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource GlassHoverOverlayBrush}"
            CornerRadius="{StaticResource GlassCardCornerRadius}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!--  the keyboard focus (never colour alone): a ring as a card's, never for a click  -->
        <Border
            x:Name="FocusRing"
            AutomationProperties.AccessibilityView="Raw"
            BorderBrush="{ThemeResource GlassTextPrimaryBrush}"
            BorderThickness="3"
            CornerRadius="{StaticResource GlassCardCornerRadius}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
