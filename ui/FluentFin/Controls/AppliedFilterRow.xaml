<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.4.0 (the UX review's X4, item 2): what is filtered, under the toolbar in every theme: "Showing 223 of 320 movies",
    a chip per filter on ("Unwatched ✕", "Comedy ✕"), and Clear all. The count line is a polite live region (Narrator hears
    the new count when a filter changes it). Shown only while a filter is on.
-->
<UserControl
    x:Class="FluentFin.Controls.AppliedFilterRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Root"
    IsTabStop="False">

    <UserControl.Resources>
        <!--  a chip: the filter's words and a cross; the compact role's height and corners  -->
        <Style x:Key="AppliedFilterChipStyle" BasedOn="{StaticResource NixieCompactButtonStyle}" TargetType="Button">
            <Setter Property="Padding" Value="12,0,10,0" />
        </Style>
    </UserControl.Resources>

    <ctk:WrapPanel
        x:Name="Row"
        HorizontalSpacing="8"
        VerticalSpacing="8">
        <TextBlock
            x:Name="ShowingLine"
            Margin="0,0,4,0"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{x:Bind ViewModel.ShowingText, Mode=OneWay}"
            Foreground="{ThemeResource GlassTextSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{x:Bind ViewModel.ShowingText, Mode=OneWay}" />
        <ItemsControl
            x:Name="Chips"
            IsTabStop="False"
            ItemsSource="{x:Bind ViewModel.AppliedFilters, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AppliedFilter">
                    <Button
                        AutomationProperties.Name="{x:Bind Name}"
                        Click="Chip_Click"
                        Style="{StaticResource AppliedFilterChipStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind Name}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" />
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="10"
                                Glyph="&#xE711;" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <HyperlinkButton
            x:Name="ClearAllButton"
            VerticalAlignment="Center"
            AutomationProperties.Name="Clear all filters"
            Command="{x:Bind ViewModel.ClearFiltersCommand}"
            Content="Clear all"
            Style="{StaticResource NixieLinkButtonStyle}" />
    </ctk:WrapPanel>
</UserControl>
