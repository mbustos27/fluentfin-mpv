<?xml version="1.0" encoding="utf-8" ?>
<!--
    fluentfin-mpv: a page's loading, empty and error state (docs/research/ux-review.md §3.11): what happened, what to do,
    and a Retry, instead of a blank or stuck page. Collapsed while there is nothing to say.
-->
<UserControl
    x:Class="FluentFin.Controls.LoadStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--  part of the page could not be loaded: a warning above what was  -->
        <InfoBar
            x:Name="ProblemBar"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="{x:Bind State.HasProblem, Mode=OneWay, FallbackValue=False}"
            Message="{x:Bind State.Message, Mode=OneWay}"
            Severity="Warning"
            Title="{x:Bind State.Title, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind State.RetryCommand, Mode=OneWay}" Content="{x:Bind State.RetryText, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  nothing could be loaded, or there is nothing: a message in place of the content  -->
        <StackPanel
            x:Name="MessagePanel"
            MaxWidth="520"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="{x:Bind VerticalContentAlignment, Mode=OneWay}"
            Spacing="12"
            Visibility="{x:Bind c:Converters.BooleanToVisibility(State.HasMessage), Mode=OneWay, FallbackValue=Collapsed}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="40"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="{x:Bind GlyphOf(State.Status), Mode=OneWay}" />
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level2"
                AutomationProperties.LiveSetting="Assertive"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="{x:Bind State.Title, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind State.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
            <Button
                x:Name="RetryButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind State.RetryCommand, Mode=OneWay}"
                Content="{x:Bind State.RetryText, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>

        <!--  only where the page has no skeleton of its own  -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="{x:Bind VerticalContentAlignment, Mode=OneWay}"
            Spacing="12"
            Visibility="{x:Bind IsRingShown(State.IsLoading, ShowsLoading), Mode=OneWay, FallbackValue=Collapsed}">
            <ProgressRing HorizontalAlignment="Center" IsActive="{x:Bind State.IsLoading, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind LoadingText, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
