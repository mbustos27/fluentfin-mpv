<?xml version="1.0" encoding="utf-8" ?>
<!--
    fluentfin-mpv player controls ("Player controls: FluentFin", docs/research/player-controls.md): the video of the
    in-process mpv (a composition swap chain in VideoPanel) with FluentFin's controls drawn over it in the same XAML tree.
    The state and every action are MpvControlsViewModel's (FluentFin.Core); this control only lays them out and passes
    input on. Dark on purpose: video controls stay dark in the light theme too (Microsoft's media player guidance).
-->
<UserControl
    x:Class="FluentFin.Controls.MpvPlayerControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:themes="using:FluentFin.Themes"
    x:Name="Self"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="PlayerGlassFill" Color="#33FFFFFF" />
                <SolidColorBrush x:Key="PlayerGlassFillHover" Color="#4DFFFFFF" />
                <SolidColorBrush x:Key="PlayerGlassFillPressed" Color="#26FFFFFF" />
                <SolidColorBrush x:Key="PlayerGlassForeground" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="PlayerHoverTimeFill" Color="#E6170508" />
                <!--
                    1.2.0: the backing of the prompts over the video (Skip, Watch credits, Keep watching): dense, so their text
                    keeps 4.5:1 over any picture (PlayerPromptContrastTests: over a white frame and a black one, also under
                    the template's hover and press overlays). The bars' light fill (PlayerGlassFill, 20 % white) left white
                    text at about 1.6:1 over a white frame. Nixie 1.4.0 (the UX review's CL-M11): the palette's deep wine
                    (NixieDeepColor, as Cinematic's player panel), not 1.2.0's teal-black #EB101C20 found nowhere else in it.
                -->
                <SolidColorBrush x:Key="PlayerPromptFill" Color="#EB170508" />
                <!--  Nixie 1.4.0 (C-P4): the countdown's track on the Primary's fill, lighter than it, under the ink's 3 px line  -->
                <SolidColorBrush x:Key="PlayerPromptTrack" Color="#73FFFFFF" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="PlayerGlassFill" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="PlayerGlassFillHover" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="PlayerGlassFillPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="PlayerGlassForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="PlayerHoverTimeFill" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="PlayerPromptFill" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="PlayerPromptTrack" Color="{ThemeResource SystemColorWindowColor}" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!--
            Seaglass player (docs/design/DESIGN.md): no acrylic over the video (it cannot blur the swap chain), so the bars sit
            on gradient scrims, the buttons are light translucent fills with the glass edge, and the menus are on
            GlassPanelStrongBrush.
        -->
        <!--  1.2.0: denser under the title's second line (over a white frame it had about 2:1, seen off-screen)  -->
        <LinearGradientBrush x:Key="TopScrim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#CC000000" />
            <GradientStop Offset="0.55" Color="#A6000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
        <!--
            1.2.0: denser where the time and the seek bar sit (about 0.55 of the bar's height from its bottom): at 1.1.3's #80
            there, white time text over a white frame had about 3.8:1; now 0.7 black under it, 4.5:1 or more with the glow too.
        -->
        <LinearGradientBrush x:Key="BottomScrim" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Offset="0" Color="#D0000000" />
            <GradientStop Offset="0.62" Color="#B3000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
        <!--
            Nixie 1.3.0: the bars' own look, which the layout theme's PlayerTopBarStyle and PlayerBottomBarStyle (optional keys)
            go over in place, during playback too (themes:ThemeStyle): a theme sets what it changes (padding, margin, background,
            corner radius, alignment, width); the bars' parts and their logic stay these.
        -->
        <Style x:Key="PlayerTopBarBaseStyle" TargetType="Grid">
            <Setter Property="Padding" Value="24,16,32,56" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource TopScrim}" />
        </Style>
        <Style x:Key="PlayerBottomBarBaseStyle" TargetType="Grid">
            <Setter Property="Padding" Value="32,64,32,20" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Background" Value="{StaticResource BottomScrim}" />
        </Style>
        <!--  the timecode's glow (ConfigureTimecodeGlow): its strength and spread  -->
        <x:Double x:Key="TimecodeGlowOpacity">0.35</x:Double>
        <x:Double x:Key="TimecodeGlowBlur">10</x:Double>

        <!--  the seek bar: thin, rounded, the accent as its fill  -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="#4DFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource NixieAccentColor}" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource NixieAccentColor}" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource NixieAccentColor}" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFE0E0E0" />
        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>

                <StaticResource x:Key="ButtonBackground" ResourceKey="PlayerGlassFill" />
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="PlayerGlassFillHover" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PlayerGlassFillPressed" />
                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="PlayerGlassFillPressed" />
                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="GlassStrokeBrush" />
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="GlassStrokeBrush" />
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="GlassStrokeBrush" />
                <StaticResource x:Key="ButtonForeground" ResourceKey="PlayerGlassForeground" />
                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="PlayerGlassForeground" />
                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="PlayerGlassForeground" />
        <!--
            round icon buttons and pills on the scrim: translucent fill, the glass edge, no acrylic. Nixie 1.4.0 style (the library
            UX review, X13): the transport is on the button system: the 44 icon circles (NixiePlayerButtonStyle, the Nixie hover,
            press and focus glow), Play/Pause the 60 px hero (NixiePlayerPlayButtonStyle, the one documented exception to the
            44/32 sizes); the pills on the Secondary template. The player stream owns the layout and the prompts.
        -->
        <Style x:Key="PlayerButton" BasedOn="{StaticResource NixiePlayerButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource PlayerGlassFill}" />
            <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource PlayerGlassForeground}" />
        </Style>
        <!--
            Nixie 1.4.0 (the UX review's X12, plan item 9): the prompts over the video are on the button system, 44 high, radius 8,
            with the Nixie templates' hover, press and focus glow. "Next episode" is the Primary (the outcome that will happen
            carries the accent); Skip intro, Skip credits, Watch credits and Keep watching are Secondary on the dense
            PlayerPromptFill (the palette's deep wine, readable over any picture). In 1.3.1 they were PlayerPromptPill on WinUI's
            own template, the Next card 69 high and on the same teal-black fill as its cancel. They are the style stream's
            player roles (Glass.xaml: NixiePlayerPromptButtonStyle, NixiePlayerPromptPrimaryButtonStyle) with the player's own
            layout (44, centred) and, for the Secondary ones, the dense fill they need over video.
        -->
        <Style x:Key="PlayerPromptStyle" BasedOn="{StaticResource NixiePlayerPromptButtonStyle}" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource PlayerPromptFill}" />
            <Setter Property="Foreground" Value="{ThemeResource PlayerGlassForeground}" />
            <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        </Style>
        <Style x:Key="PlayerPromptPrimaryStyle" BasedOn="{StaticResource NixiePlayerPromptPrimaryButtonStyle}" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <!--  the one primary action: play/pause, in the accent, at 60 (the hero exception)  -->
        <Style x:Key="PlayerPlayButton" BasedOn="{StaticResource NixiePlayerPlayButtonStyle}" TargetType="Button" />

        <!--
            menus: Seaglass 1.1.3, the shared overlay recipe (Styles\Glass.xaml): the audio menu is a window of its own on
            GlassMenuFlyoutPresenterStyle's flat GlassOverlayBrush over its system backdrop (no acrylic of ours: glass on glass),
            the volume and subtitles flyouts on GlassFlyoutPresenterStyle; GlassOverlayCornerRadius (12), the glass edge and
            text. Only the padding is the player's (GlassOverlayTests.OverlayStyles).
        -->
        <Style
            x:Key="PlayerMenuPresenter"
            BasedOn="{StaticResource GlassMenuFlyoutPresenterStyle}"
            TargetType="MenuFlyoutPresenter">
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style
            x:Key="PlayerFlyoutPresenter"
            BasedOn="{StaticResource GlassFlyoutPresenterStyle}"
            TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="12" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Background="Black"
        DoubleTapped="OnVideoDoubleTapped"
        PointerWheelChanged="OnPointerWheelChanged"
        Tapped="OnVideoTapped">

        <SwapChainPanel x:Name="VideoPanel" />

        <!--
            Skip intro / Skip credits (docs/BRIDGE.md section 5 segments) and the Next episode prompt, bottom right, just above the
            bottom bar's controls while they show, a small margin from the bottom while they are hidden (the row's Margin is
            set by PlaceSkipButton: its right edge at the theme's bar padding, its foot above the bar's visible top). Never
            focused by themselves: Space stays play. Skip stays for the whole offer, also while the bars are hidden.
            1.2.0: the Next prompt comes near the end (MpvControlsViewModel.NextPromptAt: the credits, else the last 30 to 40 s),
            also while the bars are hidden, as Skip does; Previous and Next are in the transport row. Neither holds the bars up
            under the pointer: each collapses when pressed, and an element that collapses under the pointer need not get its
            PointerExited (the bars would stay up).
            Nixie 1.4.0 (the UX review's X8 and X12): first in the tree, so Tab reaches the prompts first while they show (the
            player's Tab order runs left to right: the prompts, Back, the seek bar, the transport row); drawn over the bars
            (Canvas.ZIndex). Every prompt is 44 high and centred on one line.
        -->
        <StackPanel
            x:Name="PillRow"
            Canvas.ZIndex="1"
            Margin="0,0,32,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="12">
            <!--
                button review P20: not "Cancel", as it keeps this item on: "Watch credits" in marked credits, else "Keep watching"
            -->
            <Button
                x:Name="CancelNextButton"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="{x:Bind Controls.CancelNextName, Mode=OneWay}"
                Click="OnCancelNextClick"
                Style="{StaticResource PlayerPromptStyle}"
                ToolTipService.ToolTip="{x:Bind Controls.CancelNextName, Mode=OneWay}"
                Visibility="{x:Bind VisibleIf(Controls.IsCountingDown), Mode=OneWay}">
                <TextBlock x:Name="CancelNextText" Text="{x:Bind Controls.CancelNextText, Mode=OneWay}" />
            </Button>
            <!--
                1.2.0 (the interaction audit, item 7): the Next prompt counts down when the next item plays by itself ("Next
                episode in 8"), with Keep watching (or Watch credits) beside it; a click plays it now. Its name starts with what it
                says ("Next episode in 8: <title>"; button review P21). Nixie 1.4.0: the Primary, a leading skip-next icon, the
                title in its tooltip and name (no second line), and the countdown as its own fill: a 3 px line in the foreground
                ink on a lighter track along its foot (in 1.3.1 a 2 px accent line on a dark track, nearly invisible over video).
                MinWidth: "in 10" and "in 9" are the same width, so the row does not jump as it counts.
            -->
            <Button
                x:Name="NextPill"
                MinWidth="212"
                AllowFocusOnInteraction="False"
                AutomationProperties.AcceleratorKey="Shift+N"
                AutomationProperties.Name="{x:Bind Controls.NextPromptName, Mode=OneWay}"
                Click="OnNextClick"
                Style="{StaticResource PlayerPromptPrimaryStyle}"
                ToolTipService.ToolTip="{x:Bind NextHint(Controls.NextToolTip), Mode=OneWay}"
                Visibility="{x:Bind VisibleIf(Controls.IsNextPromptVisible), Mode=OneWay}">
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Glyph="&#xE893;" />
                        <TextBlock
                            x:Name="NextPillText"
                            VerticalAlignment="Center"
                            Typography.NumeralAlignment="Tabular"
                            Text="{x:Bind Controls.NextPromptText, Mode=OneWay}" />
                    </StackPanel>
                    <Grid
                        x:Name="NextCountdownBar"
                        Height="3"
                        Margin="0,0,0,5"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AccessibilityView="Raw"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind VisibleIf(Controls.IsCountingDown), Mode=OneWay}">
                        <Border Background="{ThemeResource PlayerPromptTrack}" CornerRadius="1.5" />
                        <Border
                            x:Name="NextCountdownFill"
                            Background="{ThemeResource NixiePrimaryForegroundBrush}"
                            CornerRadius="1.5"
                            RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{x:Bind Controls.NextCountdownProgress, Mode=OneWay}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>
            </Button>
            <Button
                x:Name="SkipSegmentButton"
                AllowFocusOnInteraction="False"
                AutomationProperties.AcceleratorKey="S"
                AutomationProperties.Name="{x:Bind Controls.SkipText, Mode=OneWay}"
                Click="OnSkipSegmentClick"
                Style="{StaticResource PlayerPromptStyle}"
                ToolTipService.ToolTip="{x:Bind SkipToolTip(Controls.SkipText, Controls.SkipSourceNote), Mode=OneWay}"
                Visibility="{x:Bind VisibleIf(Controls.IsSkipVisible), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Glyph="&#xEB9D;" />
                    <TextBlock
                        x:Name="SkipSegmentText"
                        VerticalAlignment="Center"
                        Text="{x:Bind Controls.SkipText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--
            Nixie 1.3.1: every control of the bars and the pills takes no focus from a click (AllowFocusOnInteraction False;
            Tab and Narrator still reach each one): a click leaves the keyboard on the player, so every key works at once
            after it (docs/SHORTCUTS.md). PlayerKeysContractTests keeps it so, and keeps the named parts the key router and
            the harness rely on.
        -->
        <!--  top: back and the title, on a scrim  -->
        <Grid
            x:Name="TopBar"
            themes:ThemeStyle.Key="PlayerTopBarStyle"
            GotFocus="OnBarFocusChanged"
            LostFocus="OnBarFocusChanged"
            PointerEntered="OnBarPointerEntered"
            PointerExited="OnBarPointerExited"
            Style="{StaticResource PlayerTopBarBaseStyle}"
            Visibility="{x:Bind VisibleIf(Controls.ControlsVisible), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button
                    x:Name="BackButton"
                    AllowFocusOnInteraction="False"
                    VerticalAlignment="Center"
                    AutomationProperties.AcceleratorKey="Alt+Left"
                    AutomationProperties.Name="Back"
                    Click="OnBackClick"
                    Style="{StaticResource PlayerButton}"
                    ToolTipService.ToolTip="Back (Alt+Left)">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TitleText"
                        FontFamily="{StaticResource GlassDisplayFontFamily}"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GlassTextPrimaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind Controls.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="SubtitleText"
                        FontFamily="{StaticResource GlassTextFontFamily}"
                        FontSize="15"
                        Foreground="{ThemeResource GlassTextSecondaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind Controls.Subtitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind VisibleIfText(Controls.Subtitle), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <!--  1.2.0 (button review P2): no shortcut sheet button here; ? and F1 open it from anywhere  -->
        </Grid>

        <!--  the wheel's volume, shown briefly, also while the bars are hidden  -->
        <!--
            the volume indicator (wheel, volume keys, mute): glass, larger, the fill glides between levels and it fades (and
            scales) in and out. Its place is the same as before. Over the video there is nothing to frost, so the tint is dense
            and the rim and grain do the glass.
        -->
        <Border
            x:Name="VolumeIndicator"
            Margin="0,88,0,0"
            Padding="26,18"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource GlassPanelStrongSolidBrush}"
            BorderBrush="{ThemeResource GlassStrokeBrush}"
            BorderThickness="1"
            CornerRadius="20"
            IsHitTestVisible="False"
            SizeChanged="OnVolumeIndicatorSizeChanged"
            Visibility="{x:Bind VisibleIf(Controls.VolumeIndicatorVisible), Mode=OneWay}">
            <Grid>
                <controls:GrainOverlay />
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="34"
                        Foreground="{ThemeResource GlassTextPrimaryBrush}"
                        Glyph="{x:Bind VolumeGlyph(Controls.Volume, Controls.IsMuted), Mode=OneWay}" />
                    <StackPanel VerticalAlignment="Center" Spacing="10">
                        <TextBlock
                            x:Name="VolumeIndicatorText"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlassTextPrimaryBrush}"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Controls.VolumeText, Mode=OneWay}" />
                        <Grid Width="240" Height="10">
                            <Border CornerRadius="5" Background="#33FFFFFF" />
                            <!--  always full width: the code clips it to the volume (a rounded clip the compositor animates)  -->
                            <Border
                                x:Name="VolumeIndicatorFill"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource NixieAccentBrush}"
                                CornerRadius="5"
                                Width="240" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            1.2.0: the speed or the subtitle delay a key just changed ("Speed 1.5×", "Subtitles 0.3 s later"), in the
            volume indicator's place and look (the two take each other's place), also while the bars are hidden. Narrator
            hears it from the code (Announce), so it is Raw here.
        -->
        <Border
            x:Name="ToastIndicator"
            Margin="0,88,0,0"
            Padding="26,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource GlassPanelStrongSolidBrush}"
            BorderBrush="{ThemeResource GlassStrokeBrush}"
            BorderThickness="1"
            CornerRadius="20"
            IsHitTestVisible="False"
            Visibility="{x:Bind VisibleIf(Controls.ToastVisible), Mode=OneWay}">
            <Grid>
                <controls:GrainOverlay />
                <TextBlock
                    x:Name="ToastLabel"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GlassTextPrimaryBrush}"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Controls.ToastText, Mode=OneWay}" />
            </Grid>
        </Border>

        <!--  bottom: the seek bar and the transport, on a scrim  -->
        <Grid
            x:Name="BottomBar"
            themes:ThemeStyle.Key="PlayerBottomBarStyle"
            GotFocus="OnBarFocusChanged"
            LostFocus="OnBarFocusChanged"
            PointerEntered="OnBarPointerEntered"
            PointerExited="OnBarPointerExited"
            SizeChanged="OnBottomBarSizeChanged"
            Style="{StaticResource PlayerBottomBarBaseStyle}"
            Visibility="{x:Bind VisibleIf(Controls.ControlsVisible), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--
                    1.2.0 (Nixie): the timecode has a soft glow in the accent, as a nixie tube's digits (a compositor shadow of the
                    text itself, drawn behind it in ElapsedGlow and RemainingGlow: nothing per frame). The text stays white on a
                    scrim dense enough for 4.5:1 with the glow at its brightest (TimecodeContrastTests).
                -->
                <Grid VerticalAlignment="Center">
                    <Canvas x:Name="ElapsedGlow" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" />
                    <TextBlock
                        x:Name="ElapsedText"
                        FontSize="15"
                        Typography.NumeralAlignment="Tabular"
                        Foreground="{ThemeResource GlassTextPrimaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Controls.ElapsedText, Mode=OneWay}" />
                </Grid>
                <Slider
                    x:Name="SeekBar"
                    AllowFocusOnInteraction="False"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Seek"
                    IsThumbToolTipEnabled="False"
                    Maximum="{x:Bind Seconds(Controls.DurationTicks), Mode=OneWay}"
                    Minimum="0"
                    StepFrequency="1"
                    Value="{x:Bind Seconds(Controls.PositionTicks), Mode=OneWay}"
                    ValueChanged="OnSeekBarValueChanged" />
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Canvas x:Name="RemainingGlow" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" />
                    <TextBlock
                        x:Name="RemainingText"
                        FontSize="15"
                        Typography.NumeralAlignment="Tabular"
                        Foreground="{ThemeResource GlassTextPrimaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Controls.RemainingText, Mode=OneWay}" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="VolumeButton"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="{x:Bind VolumeName(Controls.Volume, Controls.IsMuted), Mode=OneWay}"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="Volume (M mutes)">
                        <FontIcon FontSize="18" Glyph="{x:Bind VolumeGlyph(Controls.Volume, Controls.IsMuted), Mode=OneWay}" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="VolumeFlyout"
                                Closed="OnMenuClosed"
                                FlyoutPresenterStyle="{StaticResource PlayerFlyoutPresenter}"
                                Opened="OnMenuOpened"
                                Placement="Top">
                                <StackPanel
                                    Width="240"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="MuteButton"
                                        AutomationProperties.AcceleratorKey="M"
                                        AutomationProperties.Name="{x:Bind MuteName(Controls.IsMuted), Mode=OneWay}"
                                        Click="OnMuteClick"
                                        Style="{StaticResource PlayerButton}"
                                        ToolTipService.ToolTip="{x:Bind MuteToolTip(Controls.IsMuted), Mode=OneWay}">
                                        <FontIcon FontSize="20" Glyph="{x:Bind VolumeGlyph(Controls.Volume, Controls.IsMuted), Mode=OneWay}" />
                                    </Button>
                                    <Slider
                                        x:Name="VolumeSlider"
                                        Width="140"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Volume"
                                        Maximum="100"
                                        Minimum="0"
                                        StepFrequency="1"
                                        Value="{x:Bind VolumeValue(Controls.Volume), Mode=OneWay}"
                                        ValueChanged="OnVolumeSliderValueChanged" />
                                    <TextBlock
                                        Width="32"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind VolumeNumber(Controls.Volume), Mode=OneWay}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <!--  1.2.0: previous and next with the transport (an episode or a queue); the Next pill is the prompt near the end  -->
                    <Button
                        x:Name="PreviousButton"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.AcceleratorKey="Shift+P"
                        AutomationProperties.Name="{x:Bind Controls.PreviousName, Mode=OneWay}"
                        Click="OnPreviousClick"
                        IsEnabled="{x:Bind Controls.CanPrevious, Mode=OneWay}"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="{x:Bind KeyHint(Controls.PreviousName, 'Shift+P', Controls.CanPrevious), Mode=OneWay}"
                        Visibility="{x:Bind VisibleIf(Controls.ShowsNext), Mode=OneWay}">
                        <FontIcon FontSize="20" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        x:Name="SkipBackButton"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.AcceleratorKey="J"
                        AutomationProperties.Name="Back 10 seconds"
                        Click="OnSkipBackClick"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="Back 10 seconds (J)">
                        <FontIcon FontSize="20" Glyph="&#xED3C;" />
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.AcceleratorKey="Space"
                        AutomationProperties.Name="{x:Bind PlayPauseName(Controls.IsPaused), Mode=OneWay}"
                        Click="OnPlayPauseClick"
                        Style="{StaticResource PlayerPlayButton}"
                        ToolTipService.ToolTip="{x:Bind PlayPauseToolTip(Controls.IsPaused), Mode=OneWay}">
                        <Button.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="NixieAccentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="NixieAccentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="NixieAccentBrush" />
                                <StaticResource x:Key="ButtonForeground" ResourceKey="NixieDeepBrush" />
                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="NixieDeepBrush" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="NixieDeepBrush" />
                        </Button.Resources>
                        <FontIcon FontSize="26" Glyph="{x:Bind PlayPauseGlyph(Controls.IsPaused), Mode=OneWay}" />
                    </Button>
                    <Button
                        x:Name="SkipForwardButton"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.AcceleratorKey="L"
                        AutomationProperties.Name="Forward 10 seconds"
                        Click="OnSkipForwardClick"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="Forward 10 seconds (L)">
                        <!--
                            1.2.0 (button review P8): +10 s, as the back button and L (it was +30 s, matching no plain key).
                            The icon font has a "10" arrow only for back (ED3C): a clockwise arrow (E72C) with "10" in it.
                        -->
                        <Grid>
                            <FontIcon FontSize="20" Glyph="&#xE72C;" />
                            <TextBlock
                                Margin="0,1,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="8"
                                FontWeight="SemiBold"
                                Text="10" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="NextButton"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.AcceleratorKey="Shift+N"
                        AutomationProperties.Name="{x:Bind Controls.NextButtonName, Mode=OneWay}"
                        Click="OnNextClick"
                        IsEnabled="{x:Bind Controls.CanNext, Mode=OneWay}"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="{x:Bind KeyHint(Controls.NextToolTip, 'Shift+N', Controls.CanNext), Mode=OneWay}"
                        Visibility="{x:Bind VisibleIf(Controls.ShowsNext), Mode=OneWay}">
                        <FontIcon FontSize="20" Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--
                        Nixie 1.4.0 (the UX review's E-M10, plan item 14): the item's chapters, in every theme (Editorial had no way
                        to them, Cinematic only its panel's tab): a menu of the chapters with their times, the one playing
                        checked; a click goes there. Disabled, and saying so, when the item has none (the bar does not shift).
                    -->
                    <Button
                        x:Name="ChaptersButton"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.Name="Chapters, none"
                        IsEnabled="False"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="No chapters">
                        <FontIcon FontSize="20" Glyph="&#xE8FD;" />
                        <Button.Flyout>
                            <MenuFlyout
                                x:Name="ChaptersMenu"
                                Closed="OnMenuClosed"
                                MenuFlyoutPresenterStyle="{StaticResource PlayerMenuPresenter}"
                                Opened="OnMenuOpened"
                                Opening="OnChaptersMenuOpening"
                                Placement="Top" />
                        </Button.Flyout>
                    </Button>
                    <!--
                        1.2.0: the playback speed, a menu of 0.5x to 2x; the button shows the speed itself ("1×", "1.5×"),
                        so a changed speed is always in sight with the bars.
                    -->
                    <Button
                        x:Name="SpeedButton"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.AcceleratorKey="]"
                        AutomationProperties.Name="{x:Bind SpeedName(Controls.Speed), Mode=OneWay}"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="{x:Bind SpeedToolTip(Controls.Speed), Mode=OneWay}">
                        <!--  1.2.0 (button review P10): the speed itself at every speed ("1×" too), never an icon  -->
                        <TextBlock
                            x:Name="SpeedButtonText"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{x:Bind Controls.SpeedText, Mode=OneWay}" />
                        <Button.Flyout>
                            <MenuFlyout
                                x:Name="SpeedMenu"
                                Closed="OnMenuClosed"
                                MenuFlyoutPresenterStyle="{StaticResource PlayerMenuPresenter}"
                                Opened="OnMenuOpened"
                                Opening="OnSpeedMenuOpening"
                                Placement="Top" />
                        </Button.Flyout>
                    </Button>
                    <!--
                        1.2.0 (the interaction audit, item 15): one "Audio and subtitles" panel, as Netflix, Disney+ and the Apple TV
                        app have: the audio tracks on the left, the subtitle tracks on the right with the text size and the delay
                        under them. The button stays (disabled when there is nothing to choose), so the bar does not shift between
                        items. Until 1.1.3: an Audio menu and a Subtitles flyout, each there only with a choice.
                    -->
                    <!--
                        1.2.0 (button review P12): no key opens the panel, so none is announced as its accelerator (it said
                        "B, C", which change the tracks without it); the keys are in its help text. The panel opens up from the
                        button's right edge, so at 1100 px it stays in the window (centred, it ran off the right).
                    -->
                    <Button
                        x:Name="TracksButton"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.HelpText="B changes the audio track, C turns subtitles on or off, V changes them"
                        AutomationProperties.Name="Audio and subtitles"
                        Click="OnTracksClick"
                        IsEnabled="{x:Bind Controls.HasTrackChoice, Mode=OneWay}"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="{x:Bind TracksToolTip(Controls.HasTrackChoice), Mode=OneWay}">
                        <FontIcon FontSize="20" Glyph="&#xE8BD;" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="TracksMenu"
                                Closed="OnMenuClosed"
                                FlyoutPresenterStyle="{StaticResource PlayerFlyoutPresenter}"
                                Opened="OnTracksMenuOpened"
                                Opening="OnTracksMenuOpening"
                                Placement="TopEdgeAlignedRight">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="300" />
                                    </Grid.ColumnDefinitions>
                                    <!--  button review P13: the audio column only when there is a choice  -->
                                    <StackPanel
                                        x:Name="AudioColumn"
                                        Width="200"
                                        Spacing="8"
                                        Visibility="{x:Bind VisibleIf(Controls.HasAudioChoice), Mode=OneWay}">
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level2"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="Audio" />
                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                            <RadioButtons x:Name="AudioTracks" AutomationProperties.Name="Audio" SelectionChanged="OnAudioTrackChanged" />
                                        </ScrollViewer>
                                    </StackPanel>
                                    <!--  the subtitle tracks (filled as it opens), then the text size: 50 to 200 %, live, remembered; then the delay  -->
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level2"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="Subtitles" />
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <RadioButtons x:Name="SubtitleTracks" AutomationProperties.Name="Subtitles" SelectionChanged="OnSubtitleTrackChanged" />
                                        </ScrollViewer>
                                        <TextBlock
                                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                            Text="This item has no subtitles."
                                            TextWrapping="WrapWholeWords"
                                            Visibility="{x:Bind CollapsedIf(Controls.HasSubtitleChoice), Mode=OneWay}" />
                                        <StackPanel Spacing="8" Visibility="{x:Bind VisibleIf(Controls.HasSubtitleChoice), Mode=OneWay}">
                                            <Rectangle Height="1" Fill="{ThemeResource GlassStrokeBrush}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="Text size" />
                                                <TextBlock
                                                    x:Name="SubtitleSizeValue"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Typography.NumeralAlignment="Tabular"
                                                    Text="{x:Bind Controls.SubtitleSizeText, Mode=OneWay}" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Slider
                                                    x:Name="SubtitleSizeSlider"
                                                    MinHeight="32"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Subtitle text size"
                                                    LargeChange="20"
                                                    Maximum="200"
                                                    Minimum="50"
                                                    SmallChange="10"
                                                    StepFrequency="10"
                                                    IsThumbToolTipEnabled="False"
                                                    ValueChanged="OnSubtitleSizeChanged" />
                                                <Button
                                                    x:Name="SubtitleSizeReset"
                                                    Grid.Column="1"
                                                    MinHeight="32"
                                                    MinWidth="32"
                                                    Padding="8,0"
                                                    AutomationProperties.Name="Reset size"
                                                    AutomationProperties.HelpText="Subtitle text size back to 100%"
                                                    Click="OnSubtitleSizeReset"
                                                    Content="Reset size"
                                                    ToolTipService.ToolTip="Back to 100%" />
                                            </Grid>
                                            <!--
                                                the subtitle delay, in steps of 0.1 s (Z and X too), for this item only; each step is
                                                said (Announce) as well as shown
                                            -->
                                            <Rectangle Height="1" Fill="{ThemeResource GlassStrokeBrush}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="Subtitle delay" />
                                                <TextBlock
                                                    x:Name="SubtitleDelayValue"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.LiveSetting="Polite"
                                                    AutomationProperties.Name="{x:Bind DelayName(Controls.SubtitleDelay), Mode=OneWay}"
                                                    Typography.NumeralAlignment="Tabular"
                                                    Text="{x:Bind Controls.SubtitleDelayText, Mode=OneWay}" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    x:Name="SubtitleEarlierButton"
                                                    MinWidth="44"
                                                    MinHeight="32"
                                                    Padding="8,0"
                                                    AutomationProperties.AcceleratorKey="Z"
                                                    AutomationProperties.Name="Earlier"
                                                    AutomationProperties.HelpText="Subtitles 0.1 seconds earlier"
                                                    Click="OnSubtitleEarlierClick"
                                                    Content="Earlier"
                                                    ToolTipService.ToolTip="0.1 s earlier (Z)" />
                                                <Button
                                                    x:Name="SubtitleLaterButton"
                                                    Grid.Column="1"
                                                    MinWidth="44"
                                                    MinHeight="32"
                                                    Padding="8,0"
                                                    AutomationProperties.AcceleratorKey="X"
                                                    AutomationProperties.Name="Later"
                                                    AutomationProperties.HelpText="Subtitles 0.1 seconds later"
                                                    Click="OnSubtitleLaterClick"
                                                    Content="Later"
                                                    ToolTipService.ToolTip="0.1 s later (X)" />
                                                <Button
                                                    x:Name="SubtitleDelayReset"
                                                    Grid.Column="3"
                                                    MinHeight="32"
                                                    MinWidth="32"
                                                    Padding="8,0"
                                                    AutomationProperties.Name="Reset delay"
                                                    AutomationProperties.HelpText="Subtitles back in time with the picture"
                                                    Click="OnSubtitleDelayReset"
                                                    Content="Reset delay"
                                                    IsEnabled="{x:Bind NotZero(Controls.SubtitleDelay), Mode=OneWay}"
                                                    ToolTipService.ToolTip="No delay" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="FullScreenButton"
                        AllowFocusOnInteraction="False"
                        AutomationProperties.AcceleratorKey="F"
                        AutomationProperties.Name="{x:Bind FullScreenName(Controls.IsFullScreen), Mode=OneWay}"
                        Click="OnFullScreenClick"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="{x:Bind FullScreenToolTip(Controls.IsFullScreen), Mode=OneWay}">
                        <FontIcon FontSize="18" Glyph="{x:Bind FullScreenGlyph(Controls.IsFullScreen), Mode=OneWay}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!--
            the time under the pointer (or the thumb while dragged), above the seek bar; 1.2.0 (the interaction audit, item 9):
            with the item's trickplay thumbnail over it when the server has them. Placed by the code (OnSeekBarPointerMoved)
            in the player's coordinates, so it can be taller than the bar's row.
        -->
        <Border
            x:Name="HoverTime"
            Padding="4"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource PlayerHoverTimeFill}"
            BorderBrush="{ThemeResource GlassStrokeBrush}"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel Spacing="4">
                <Canvas
                    x:Name="HoverPreview"
                    AutomationProperties.AccessibilityView="Raw"
                    Visibility="Collapsed">
                    <Canvas.Clip>
                        <RectangleGeometry x:Name="HoverPreviewClip" />
                    </Canvas.Clip>
                    <Image x:Name="HoverPreviewImage" Stretch="Uniform">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="HoverPreviewShift" />
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
                <TextBlock
                    x:Name="HoverTimeText"
                    Margin="6,0,6,2"
                    HorizontalAlignment="Center"
                    Typography.NumeralAlignment="Tabular"
                    Foreground="{ThemeResource GlassTextPrimaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
