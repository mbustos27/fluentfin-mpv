<?xml version="1.0" encoding="utf-8" ?>
<!--
    fluentfin-mpv player controls ("Player controls: FluentFin", docs/research/player-controls.md): the video of the
    in-process mpv (a composition swap chain in VideoPanel) with FluentFin's controls drawn over it in the same XAML tree.
    The state and every action are MpvControlsViewModel's (FluentFin.Core); this control only lays them out and passes
    input on. Dark on purpose: video controls stay dark in the light theme too (Microsoft's media player guidance).
-->
<UserControl
    x:Class="FluentFin.Controls.MpvPlayerControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Self"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="PlayerGlassFill" Color="#33FFFFFF" />
                <SolidColorBrush x:Key="PlayerGlassFillHover" Color="#4DFFFFFF" />
                <SolidColorBrush x:Key="PlayerGlassFillPressed" Color="#26FFFFFF" />
                <SolidColorBrush x:Key="PlayerGlassForeground" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="PlayerHoverTimeFill" Color="#E6101C20" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="PlayerGlassFill" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="PlayerGlassFillHover" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="PlayerGlassFillPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="PlayerGlassForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="PlayerHoverTimeFill" Color="{ThemeResource SystemColorWindowColor}" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!--
            Seaglass player (docs/design/SEAGLASS.md): no acrylic over the video (it cannot blur the swap chain), so the bars sit
            on gradient scrims, the buttons are light translucent fills with the glass edge, and the menus are on
            GlassPanelStrongBrush.
        -->
        <LinearGradientBrush x:Key="TopScrim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#B3000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BottomScrim" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Offset="0" Color="#C0000000" />
            <GradientStop Offset="0.55" Color="#80000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>

        <!--  the seek bar: thin, rounded, the accent as its fill  -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="#4DFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SeaglassAccentColor}" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SeaglassAccentColor}" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SeaglassAccentColor}" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFE0E0E0" />
        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>

                <StaticResource x:Key="ButtonBackground" ResourceKey="PlayerGlassFill" />
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="PlayerGlassFillHover" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PlayerGlassFillPressed" />
                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="PlayerGlassFillPressed" />
                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="GlassStrokeBrush" />
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="GlassStrokeBrush" />
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="GlassStrokeBrush" />
                <StaticResource x:Key="ButtonForeground" ResourceKey="PlayerGlassForeground" />
                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="PlayerGlassForeground" />
                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="PlayerGlassForeground" />
        <!--  round icon buttons and pills on the scrim: translucent fill, the glass edge, no acrylic  -->
        <Style x:Key="PlayerButton" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource PlayerGlassFill}" />
            <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource PlayerGlassForeground}" />
        </Style>
        <Style x:Key="PlayerPill" BasedOn="{StaticResource PlayerButton}" TargetType="Button">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="CornerRadius" Value="{StaticResource GlassButtonCornerRadius}" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <!--  the one primary action: play/pause, in the accent  -->
        <Style x:Key="PlayerPlayButton" BasedOn="{StaticResource PlayerButton}" TargetType="Button">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Background" Value="{ThemeResource SeaglassAccentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource SeaglassDeepBrush}" />
        </Style>

        <!--  menus: the strongly tinted glass, one layer, rounded  -->
        <Style x:Key="PlayerMenuPresenter" TargetType="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{ThemeResource GlassPanelStrongBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style x:Key="PlayerFlyoutPresenter" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="{ThemeResource GlassPanelStrongBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Background="Black"
        DoubleTapped="OnVideoDoubleTapped"
        PointerMoved="OnPointerMoved"
        PointerWheelChanged="OnPointerWheelChanged"
        Tapped="OnVideoTapped">

        <SwapChainPanel x:Name="VideoPanel" />

        <!--  top: back and the title, on a scrim  -->
        <Grid
            x:Name="TopBar"
            Padding="24,16,32,56"
            VerticalAlignment="Top"
            Background="{StaticResource TopScrim}"
            GotFocus="OnBarFocusChanged"
            LostFocus="OnBarFocusChanged"
            PointerEntered="OnBarPointerEntered"
            PointerExited="OnBarPointerExited"
            Visibility="{x:Bind VisibleIf(Controls.ControlsVisible), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button
                    x:Name="BackButton"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Back"
                    Click="OnBackClick"
                    Style="{StaticResource PlayerButton}"
                    ToolTipService.ToolTip="Back">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TitleText"
                        FontFamily="{StaticResource GlassDisplayFontFamily}"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GlassTextPrimaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind Controls.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="SubtitleText"
                        FontFamily="{StaticResource GlassTextFontFamily}"
                        FontSize="15"
                        Foreground="{ThemeResource GlassTextSecondaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind Controls.Subtitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind VisibleIfText(Controls.Subtitle), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  the wheel's volume, shown briefly, also while the bars are hidden  -->
        <!--
            the volume indicator (wheel, volume keys, mute): glass, larger, the fill glides between levels and it fades (and
            scales) in and out. Its place is the same as before. Over the video there is nothing to frost, so the tint is dense
            and the rim and grain do the glass.
        -->
        <Border
            x:Name="VolumeIndicator"
            Margin="0,88,0,0"
            Padding="26,18"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource GlassPanelStrongSolidBrush}"
            BorderBrush="{ThemeResource GlassStrokeBrush}"
            BorderThickness="1"
            CornerRadius="20"
            IsHitTestVisible="False"
            SizeChanged="OnVolumeIndicatorSizeChanged"
            Visibility="{x:Bind VisibleIf(Controls.VolumeIndicatorVisible), Mode=OneWay}">
            <Grid>
                <controls:GrainOverlay />
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="34"
                        Foreground="{ThemeResource GlassTextPrimaryBrush}"
                        Glyph="{x:Bind VolumeGlyph(Controls.Volume, Controls.IsMuted), Mode=OneWay}" />
                    <StackPanel VerticalAlignment="Center" Spacing="10">
                        <TextBlock
                            x:Name="VolumeIndicatorText"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource GlassTextPrimaryBrush}"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Controls.VolumeText, Mode=OneWay}" />
                        <Grid Width="240" Height="10">
                            <Border CornerRadius="5" Background="#33FFFFFF" />
                            <Border
                                x:Name="VolumeIndicatorFill"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SeaglassAccentBrush}"
                                CornerRadius="5"
                                Width="240" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  bottom: the seek bar and the transport, on a scrim  -->
        <Grid
            x:Name="BottomBar"
            Padding="32,64,32,20"
            VerticalAlignment="Bottom"
            Background="{StaticResource BottomScrim}"
            GotFocus="OnBarFocusChanged"
            LostFocus="OnBarFocusChanged"
            PointerEntered="OnBarPointerEntered"
            PointerExited="OnBarPointerExited"
            SizeChanged="OnBottomBarSizeChanged"
            Visibility="{x:Bind VisibleIf(Controls.ControlsVisible), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ElapsedText"
                    VerticalAlignment="Center"
                    Typography.NumeralAlignment="Tabular"
                    Foreground="{ThemeResource GlassTextPrimaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Controls.ElapsedText, Mode=OneWay}" />
                <Slider
                    x:Name="SeekBar"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Seek"
                    IsThumbToolTipEnabled="False"
                    Maximum="{x:Bind Seconds(Controls.DurationTicks), Mode=OneWay}"
                    Minimum="0"
                    StepFrequency="1"
                    Value="{x:Bind Seconds(Controls.PositionTicks), Mode=OneWay}"
                    ValueChanged="OnSeekBarValueChanged" />
                <!--  the time under the pointer, above the bar  -->
                <Border
                    x:Name="HoverTime"
                    Grid.Column="1"
                    Margin="0,0,0,34"
                    Padding="10,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource PlayerHoverTimeFill}"
                    BorderBrush="{ThemeResource GlassStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="HoverTimeText"
                        Typography.NumeralAlignment="Tabular"
                        Foreground="{ThemeResource GlassTextPrimaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}" />
                </Border>
                <TextBlock
                    x:Name="RemainingText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Typography.NumeralAlignment="Tabular"
                    Foreground="{ThemeResource GlassTextPrimaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Controls.RemainingText, Mode=OneWay}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="VolumeButton"
                        AutomationProperties.Name="Volume"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="Volume">
                        <FontIcon FontSize="18" Glyph="{x:Bind VolumeGlyph(Controls.Volume, Controls.IsMuted), Mode=OneWay}" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="VolumeFlyout"
                                Closed="OnMenuClosed"
                                FlyoutPresenterStyle="{StaticResource PlayerFlyoutPresenter}"
                                Opened="OnMenuOpened"
                                Placement="Top">
                                <StackPanel
                                    Width="240"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="MuteButton"
                                        AutomationProperties.Name="{x:Bind MuteName(Controls.IsMuted), Mode=OneWay}"
                                        Click="OnMuteClick"
                                        Style="{StaticResource PlayerButton}"
                                        ToolTipService.ToolTip="{x:Bind MuteName(Controls.IsMuted), Mode=OneWay}">
                                        <FontIcon FontSize="16" Glyph="{x:Bind VolumeGlyph(Controls.Volume, Controls.IsMuted), Mode=OneWay}" />
                                    </Button>
                                    <Slider
                                        x:Name="VolumeSlider"
                                        Width="140"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Volume"
                                        Maximum="100"
                                        Minimum="0"
                                        StepFrequency="1"
                                        Value="{x:Bind VolumeValue(Controls.Volume), Mode=OneWay}"
                                        ValueChanged="OnVolumeSliderValueChanged" />
                                    <TextBlock
                                        Width="32"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind VolumeNumber(Controls.Volume), Mode=OneWay}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Button
                        x:Name="SkipBackButton"
                        AutomationProperties.Name="Back 10 seconds"
                        Click="OnSkipBackClick"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="Back 10 seconds">
                        <FontIcon FontSize="18" Glyph="&#xED3C;" />
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        AutomationProperties.Name="{x:Bind PlayPauseName(Controls.IsPaused), Mode=OneWay}"
                        Click="OnPlayPauseClick"
                        Style="{StaticResource PlayerPlayButton}"
                        ToolTipService.ToolTip="{x:Bind PlayPauseName(Controls.IsPaused), Mode=OneWay}">
                        <Button.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SeaglassAccentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SeaglassAccentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SeaglassAccentBrush" />
                                <StaticResource x:Key="ButtonForeground" ResourceKey="SeaglassDeepBrush" />
                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SeaglassDeepBrush" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SeaglassDeepBrush" />
                        </Button.Resources>
                        <FontIcon FontSize="26" Glyph="{x:Bind PlayPauseGlyph(Controls.IsPaused), Mode=OneWay}" />
                    </Button>
                    <Button
                        x:Name="SkipForwardButton"
                        AutomationProperties.Name="Forward 30 seconds"
                        Click="OnSkipForwardClick"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="Forward 30 seconds">
                        <FontIcon FontSize="18" Glyph="&#xED3D;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="AudioButton"
                        AutomationProperties.Name="Audio"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="Audio"
                        Visibility="{x:Bind VisibleIf(Controls.HasAudioChoice), Mode=OneWay}">
                        <FontIcon FontSize="18" Glyph="&#xE8D6;" />
                        <Button.Flyout>
                            <MenuFlyout
                                x:Name="AudioMenu"
                                Closed="OnMenuClosed"
                                MenuFlyoutPresenterStyle="{StaticResource PlayerMenuPresenter}"
                                Opened="OnMenuOpened"
                                Opening="OnAudioMenuOpening"
                                Placement="Top" />
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="SubtitlesButton"
                        AutomationProperties.Name="Subtitles"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="Subtitles"
                        Visibility="{x:Bind VisibleIf(Controls.HasSubtitleChoice), Mode=OneWay}">
                        <FontIcon FontSize="18" Glyph="&#xED1E;" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="SubtitlesMenu"
                                Closed="OnMenuClosed"
                                FlyoutPresenterStyle="{StaticResource PlayerFlyoutPresenter}"
                                Opened="OnMenuOpened"
                                Opening="OnSubtitlesMenuOpening"
                                Placement="Top">
                                <!--  the subtitle tracks (filled as it opens), then the text size: 50 to 200 %, live, remembered  -->
                                <StackPanel Width="280" Spacing="8">
                                    <RadioButtons x:Name="SubtitleTracks" AutomationProperties.Name="Subtitles" SelectionChanged="OnSubtitleTrackChanged" />
                                    <Rectangle Height="1" Fill="{ThemeResource GlassStrokeBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="Text size" />
                                        <TextBlock
                                            x:Name="SubtitleSizeValue"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Typography.NumeralAlignment="Tabular"
                                            Text="{x:Bind Controls.SubtitleSizeText, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            x:Name="SubtitleSizeSlider"
                                            MinHeight="32"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Subtitle text size"
                                            LargeChange="20"
                                            Maximum="200"
                                            Minimum="50"
                                            SmallChange="10"
                                            StepFrequency="10"
                                            IsThumbToolTipEnabled="False"
                                            ValueChanged="OnSubtitleSizeChanged" />
                                        <Button
                                            x:Name="SubtitleSizeReset"
                                            Grid.Column="1"
                                            MinHeight="32"
                                            MinWidth="32"
                                            Padding="8,0"
                                            AutomationProperties.Name="Reset subtitle text size to 100%"
                                            Click="OnSubtitleSizeReset"
                                            Content="Reset"
                                            ToolTipService.ToolTip="Reset to 100%" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="FullScreenButton"
                        AutomationProperties.Name="{x:Bind FullScreenName(Controls.IsFullScreen), Mode=OneWay}"
                        Click="OnFullScreenClick"
                        Style="{StaticResource PlayerButton}"
                        ToolTipService.ToolTip="{x:Bind FullScreenName(Controls.IsFullScreen), Mode=OneWay}">
                        <FontIcon FontSize="18" Glyph="{x:Bind FullScreenGlyph(Controls.IsFullScreen), Mode=OneWay}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!--
            Skip intro / Skip credits (docs/BRIDGE.md section 5 segments) and the Next episode pill, bottom right, just above the
            bottom bar's controls while they show, a small margin from the bottom while they are hidden (the row's Margin is
            set by PlaceSkipButton). Skip stays for the whole offer, also while the bars are hidden; the Next pill only with
            the bars (it is one of them: it holds them up under the pointer and the keyboard). Last in the tree, so it is on
            top of the bars' scrim. Never focused by itself: Space stays play.
            The Skip pill does not hold the bars up under the pointer: it collapses when pressed, and an element that
            collapses under the pointer need not get its PointerExited (the bars would stay up).
        -->
        <StackPanel
            x:Name="PillRow"
            Margin="0,0,32,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="NextPill"
                AutomationProperties.HelpText="{x:Bind Controls.NextToolTip, Mode=OneWay}"
                AutomationProperties.Name="Next episode"
                Click="OnNextClick"
                GotFocus="OnBarFocusChanged"
                LostFocus="OnBarFocusChanged"
                PointerEntered="OnBarPointerEntered"
                PointerExited="OnBarPointerExited"
                Style="{StaticResource PlayerPill}"
                ToolTipService.ToolTip="{x:Bind Controls.NextToolTip, Mode=OneWay}"
                Visibility="{x:Bind NextPillVisibility(Controls.ControlsVisible, Controls.ShowsNext, Controls.CanNext), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        x:Name="NextPillText"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        MaxLines="1"
                        Text="{x:Bind Controls.NextToolTip, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE893;" />
                </StackPanel>
            </Button>
            <Button
                x:Name="SkipSegmentButton"
                AutomationProperties.Name="{x:Bind Controls.SkipText, Mode=OneWay}"
                Click="OnSkipSegmentClick"
                Style="{StaticResource PlayerPill}"
                ToolTipService.ToolTip="{x:Bind SkipToolTip(Controls.SkipText), Mode=OneWay}"
                Visibility="{x:Bind VisibleIf(Controls.IsSkipVisible), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xEB9D;" />
                    <TextBlock
                        x:Name="SkipSegmentText"
                        VerticalAlignment="Center"
                        Text="{x:Bind Controls.SkipText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
