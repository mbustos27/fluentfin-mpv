<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.ShelfRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentFin.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--
        Seaglass scrolling: the one row control of every shelf (Home's Continue Watching, Next Up and Recently Added, the
        item pages' rows). One axis per input: the plain wheel scrolls the page (the row routes it, WinUI's horizontal
        scroll viewer would swallow it: microsoft-ui-xaml #10172), the tilt wheel, Shift+wheel and a swipe move the row.
        "See all" in the header; one Tab stop (TabFocusNavigation Once), Left/Right/Home/End along the row, Up/Down between
        rows; the title is a heading and the row a list for Narrator. Nixie 1.7.4 (the rows stream: a season's episodes past
        the window's edge could not be reached, and its row had no arrows because the theme hid the header they were in): the
        arrows are at the row's ends, over its cards, in every theme. They show while the pointer is over the row, each only
        while the row goes further its way; the keys move the row, so they are no Tab stop. The plain wheel scrolls the
        page while the page can move, else the row; a mouse drag moves the row too (RowPaging, RowDrag).
    -->
    <Grid x:Name="RowRoot" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  1.7.4: as tall as with the arrows that were here (44), so no row moves  -->
        <Grid
            MinHeight="44"
            Margin="0,0,12,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  the row's title, a heading (1.4.0: always; See all is its own link)  -->
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource GlassSectionTitleTextBlockStyle}"
                Text="{x:Bind Header, Mode=OneWay}" />

            <!--
                Nixie 1.4.0 (the library UX review, X13: "See all" came in four forms, a 179 x 40 title button, a 56 px tile, a
                48 x 32 link and a 40-high variant): one See all in every theme, the Link role (NixieLinkButtonStyle, 32 high,
                underlined) at the header's right, before the arrows; the title is always the plain heading. Narrator hears
                "See all <title>, link" (the visible words lead the name). The row header's one Tab stop (the arrows have none:
                the row's keys and the wheel move it).
            -->
            <HyperlinkButton
                x:Name="SeeAllButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="SeeAllButton_Click"
                Content="See all"
                Style="{StaticResource NixieLinkButtonStyle}"
                Visibility="Collapsed" />

        </Grid>

        <Grid x:Name="RowArea" Grid.Row="1">
            <ScrollViewer
                x:Name="Scroller"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                IsTabStop="False"
                TabFocusNavigation="Once"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <local:RowList x:Name="List" IsTabStop="False">
                    <ItemsRepeater
                        x:Name="Repeater"
                        ItemTemplate="{x:Bind ItemTemplate, Mode=OneWay}"
                        ItemsSource="{x:Bind ItemsSource, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </local:RowList>
            </ScrollViewer>

            <!--
                Nixie 1.7.4: the row's ends, over its cards: shown while the pointer is over the row, each only while the row goes
                further its way; no Tab stop (Left, Right, Home and End move the row). EdgeScroller shows them and pages the row
            -->
            <Button
                x:Name="ScrollLeftBtn"
                Width="44"
                Height="44"
                Margin="8,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="RowBackButton"
                AutomationProperties.Name="Scroll left"
                IsTabStop="False"
                Style="{StaticResource NixieIconButtonStyle}"
                ToolTipService.ToolTip="Scroll left"
                Visibility="Collapsed">
                <FontIcon FontSize="20" Glyph="&#xE76B;" />
            </Button>
            <Button
                x:Name="ScrollRightBtn"
                Width="44"
                Height="44"
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="RowNextButton"
                AutomationProperties.Name="Scroll right"
                IsTabStop="False"
                Style="{StaticResource NixieIconButtonStyle}"
                ToolTipService.ToolTip="Scroll right"
                Visibility="Collapsed">
                <FontIcon FontSize="20" Glyph="&#xE76C;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
