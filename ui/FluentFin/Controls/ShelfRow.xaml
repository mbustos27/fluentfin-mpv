<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.ShelfRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentFin.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--
        Seaglass scrolling: the one row control of every shelf (Home's Continue Watching, Next Up and Recently Added, the
        item pages' rows). One axis per input: the plain wheel scrolls the page (the row routes it, WinUI's horizontal
        scroll viewer would swallow it: microsoft-ui-xaml #10172), the tilt wheel, Shift+wheel and a swipe move the row.
        Always-visible arrows and "See all" in the header; one Tab stop (TabFocusNavigation Once), Left/Right/Home/End along
        the row, Up/Down between rows; the title is a heading and the row a list for Narrator. Seaglass 1.1.4 (layout audit,
        item 2): the title is the See all link (with a chevron), and the arrows are plain chevrons (the filled triangles read
        as Play), quiet (half strength) until the pointer is over the row or the keyboard is in it, never hidden.
    -->
    <Grid x:Name="RowRoot" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  a row with nowhere to go: its title, a heading  -->
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource GlassSectionTitleTextBlockStyle}"
                Text="{x:Bind Header, Mode=OneWay}" />

            <!--
                Seaglass 1.1.4 (UX review, fix 9): a row with a See all: the title itself is the button, with a chevron that shows
                it opens something; Narrator hears "See all <title>, button", and the title inside is still a heading. The row
                header's one Tab stop (the arrows have none: the row's keys and the wheel move it).
            -->
            <Button
                x:Name="SeeAllButton"
                MinHeight="40"
                Margin="-10,0,0,0"
                Padding="10,2,8,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="SeeAllButton_Click"
                CornerRadius="{StaticResource GlassButtonCornerRadius}"
                ToolTipService.ToolTip="See all"
                Visibility="Collapsed">
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="GlassHoverOverlayBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="GlassPressedOverlayBrush" />
                    <StaticResource x:Key="ButtonForeground" ResourceKey="GlassTextPrimaryBrush" />
                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="GlassTextPrimaryBrush" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="GlassTextPrimaryBrush" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        x:Name="SeeAllTitle"
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource GlassSectionTitleTextBlockStyle}"
                        Text="{x:Bind Header, Mode=OneWay}" />
                    <FontIcon
                        x:Name="SeeAllChevron"
                        Margin="0,3,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="16"
                        Glyph="&#xE76C;" />
                </StackPanel>
            </Button>

            <Button
                x:Name="ScrollLeftBtn"
                Grid.Column="2"
                Width="44"
                Height="44"
                VerticalAlignment="Center"
                AutomationProperties.Name="Scroll left"
                Click="ScrollLeftBtn_Click"
                IsEnabled="False"
                IsTabStop="False"
                Style="{StaticResource NixieIconButtonStyle}"
                ToolTipService.ToolTip="Scroll left"
                Visibility="Collapsed">
                <FontIcon FontSize="20" Glyph="&#xE76B;" />
            </Button>
            <Button
                x:Name="ScrollRightBtn"
                Grid.Column="3"
                Width="44"
                Height="44"
                VerticalAlignment="Center"
                AutomationProperties.Name="Scroll right"
                Click="ScrollRightBtn_Click"
                IsTabStop="False"
                Style="{StaticResource NixieIconButtonStyle}"
                ToolTipService.ToolTip="Scroll right"
                Visibility="Collapsed">
                <FontIcon FontSize="20" Glyph="&#xE76C;" />
            </Button>
        </Grid>

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            IsTabStop="False"
            TabFocusNavigation="Once"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <local:RowList x:Name="List" IsTabStop="False">
                <ItemsRepeater
                    x:Name="Repeater"
                    ItemTemplate="{x:Bind ItemTemplate, Mode=OneWay}"
                    ItemsSource="{x:Bind ItemsSource, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </local:RowList>
        </ScrollViewer>
    </Grid>
</UserControl>
