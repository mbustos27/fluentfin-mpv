<!--
    1.6 player: Settings > Playback's quality cards (Core.Settings.PlayerQualitySettings): the default quality at home and away
    (Auto by default; Nixie never moves them by itself; sent before every play) and "Show the Playback stats button" (off by
    default). Each description says a lower quality makes the server convert the video, and some servers don't allow it.
-->
<UserControl
    x:Class="FluentFin.Controls.PlayerQualitySettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:settings="using:FluentFin.Core.Settings"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <StackPanel Spacing="4">
        <ctk:SettingsCard
            x:Name="QualityAtHomeCard"
            Description="{x:Bind settings:PlayerQualitySettings.HomeDescription}"
            Header="{x:Bind settings:PlayerQualitySettings.HomeHeader}"
            HeaderIcon="{ui:FontIcon Glyph=&#xE80F;}">
            <ComboBox
                x:Name="QualityAtHomeBox"
                MinWidth="180"
                AutomationProperties.Name="{x:Bind settings:PlayerQualitySettings.HomeHeader}"
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind settings:PlayerQualitySettings.Choices}"
                SelectedItem="{x:Bind Settings.SelectedHome, Mode=TwoWay}" />
        </ctk:SettingsCard>
        <ctk:SettingsCard
            x:Name="QualityAwayCard"
            Description="{x:Bind settings:PlayerQualitySettings.AwayDescription}"
            Header="{x:Bind settings:PlayerQualitySettings.AwayHeader}"
            HeaderIcon="{ui:FontIcon Glyph=&#xE701;}">
            <ComboBox
                x:Name="QualityAwayBox"
                MinWidth="180"
                AutomationProperties.Name="{x:Bind settings:PlayerQualitySettings.AwayHeader}"
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind settings:PlayerQualitySettings.Choices}"
                SelectedItem="{x:Bind Settings.SelectedAway, Mode=TwoWay}" />
        </ctk:SettingsCard>
        <ctk:SettingsCard
            x:Name="StatsButtonCard"
            Description="{x:Bind settings:PlayerQualitySettings.StatsDescription}"
            Header="{x:Bind settings:PlayerQualitySettings.StatsHeader}"
            HeaderIcon="{ui:FontIcon Glyph=&#xE9D9;}">
            <ToggleSwitch
                x:Name="StatsButtonSwitch"
                AutomationProperties.Name="{x:Bind settings:PlayerQualitySettings.StatsHeader}"
                IsOn="{x:Bind Settings.ShowStatsButton, Mode=TwoWay}" />
        </ctk:SettingsCard>
    </StackPanel>
</UserControl>
