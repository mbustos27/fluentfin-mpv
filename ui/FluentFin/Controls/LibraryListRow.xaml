<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.4.0 (the UX review's X18, item 13): a library's list view, one row a title: a small poster, the title, its year,
    length and kind, and whether it is watched. One keyboard stop (Enter and Space open it), one Narrator element named as
    the card is ("Bridge of Avalon, 2023, watched"), a click anywhere opens it.
-->
<UserControl
    x:Class="FluentFin.Controls.LibraryListRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Controls"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    FocusVisualMargin="-2">
    <Grid
        x:Name="RowRoot"
        Height="88"
        Padding="8"
        Background="Transparent"
        ColumnSpacing="16"
        CornerRadius="8"
        Tapped="Row_Tapped"
        PointerEntered="Row_PointerEntered"
        PointerExited="Row_PointerExited">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border
            Width="48"
            Height="72"
            Background="{ThemeResource NixieDeepBrush}"
            CornerRadius="6">
            <Image
                AutomationProperties.AccessibilityView="Raw"
                Source="{x:Bind c:BaseItemDtoConverters.GetImage(Model.Dto, jm:ImageType.Primary, 144), Mode=OneWay}"
                Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlassTextPrimaryBrush}"
                Text="{x:Bind Model.Dto.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                FontSize="14"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                Text="{x:Bind local:LibraryListRow.Facts(Model.Dto), Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>
        <FontIcon
            Grid.Column="2"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            FontSize="16"
            Foreground="{ThemeResource GlassTextSecondaryBrush}"
            Glyph="&#xE73E;"
            Visibility="{x:Bind local:LibraryListRow.WatchedVisibility(Model.Dto), Mode=OneWay}" />
    </Grid>
</UserControl>
