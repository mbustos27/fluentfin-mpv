<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.BaseItemDtoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cb="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:cl="using:FluentFin.Controls.Lights"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:core="using:FluentFin.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:FluentFin.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    mc:Ignorable="d">
    <!--
        Seaglass: opaque artwork with GlassCardCornerRadius and no border, the title and subtitle below it, progress as a thin
        accent bar, a lift (a spring scale and a deeper shadow, only while GlassMode.MotionAllowed) on pointer-over and
        keyboard focus, and a focus ring of its own (FocusRing) around the artwork, since the system's rectangle would
        surround the whole slot.
    -->
    <!--
        fluentfin-mpv: the card is a keyboard stop of its own (Enter/Space open it, arrows move along its row), shows its buttons
        while it or one of them has focus as it does on hover, and Narrator reads it as one button named after the item
        (BaseItemDtoCardAutomationPeer; docs/research/ux-review.md A1). Hover and focus are handled in code, not by the
        PointerEntered/PointerExited behaviours it had, so a pointer leaving cannot hide a button that has keyboard focus.
    -->
    <UserControl.Resources>
        <SolidColorBrush
            x:Key="Black65O"
            Opacity="0.65"
            Color="Black" />
        <cc:DoubleToVisibilityConverter x:Key="MoreThanZeroToVisibilityConverter" GreaterThan="0" />
        <cc:EmptyStringToObjectConverter
            x:Key="EmptyStringVisibilityConverter"
            EmptyValue="Collapsed"
            NotEmptyValue="Visible" />
        <c:JellyfinTitleConverter x:Key="NameConverter" />
        <c:JellyfinSubtitleConverter x:Key="SubtitleConverter" />
        <!--  Seaglass 1.1.3: a card's menu is the keyboard's way to play it (the card is one stop)  -->
        <c:JellyfinFlyoutConverter x:Key="FlyoutConverter" IncludePlay="True" />
        <c:NullableDoubleToValueOrDefaultConverter x:Key="NullableDoubleToValueOrDefaultConverter" />
        <c:NullableIntToValueOrDefaultConverter x:Key="NullableIntToValueOrDefaultConverter" />
        <c:NullableBoolToValueOrDefaultConverter x:Key="NullableBoolToValueOrDefaultConverter" />
    </UserControl.Resources>

    <!--
        Seaglass 1.1.4 (1.1.3 UX audit, interaction item 11): the whole tile is one target, the title under the artwork too: the
        pointer over any of it lifts the card and shows its buttons, a click anywhere but on a button opens the item. No tilt
        toward the pointer and no sheen any more (a tvOS focus effect, odd with a mouse); the lift and the shadow stay.
    -->
    <Grid
        x:Name="RootGrid"
        ui:VisualExtensions.NormalizedCenterPoint="0.5, 0.5"
        ui:VisualExtensions.Scale="0.9"
        ContextFlyout="{x:Bind Model.Dto, Converter={StaticResource FlyoutConverter}, Mode=OneWay}"
        PointerCanceled="Card_PointerExited"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited"
        Tapped="Card_Tapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  casts the shadow the lift deepens; behind the artwork, which is opaque  -->
        <Border
            x:Name="ShadowHost"
            Background="{ThemeResource SeaglassDeepBrush}"
            CornerRadius="{StaticResource GlassCardCornerRadius}">
            <ui:Effects.Shadow>
                <media:AttachedCardShadow
                    x:Name="CardShadow"
                    BlurRadius="8"
                    CornerRadius="12"
                    Opacity="0.25"
                    Offset="0,3"
                    Color="Black" />
            </ui:Effects.Shadow>
        </Border>

        <Grid
            x:Name="ImageCanvas"
            Background="Transparent"
            CornerRadius="{StaticResource GlassCardCornerRadius}">

            <Grid ui:VisualExtensions.NormalizedCenterPoint="0.5, 0.5">
                <controls:LazyLoadedImage
                    BlurHashImageSource="{x:Bind BlurHashImageSource, Mode=OneWay}"
                    EnableBlurHash="True"
                    ImageSource="{x:Bind ImageSource, Mode=OneWay}" />
            </Grid>

            <Grid x:Name="ContentOverlay">
                <!--  under the buttons while they show, so they read on any artwork  -->
                <Border
                    x:Name="HoverScrim"
                    Background="{StaticResource Black65O}"
                    IsHitTestVisible="False"
                    Opacity="0.55"
                    Visibility="Collapsed" />
                <Button
                    x:Name="PlayButton" IsTabStop="False"
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ui:VisualExtensions.NormalizedCenterPoint="0.5,0.5"
                    ui:VisualExtensions.Scale="0.8"
                    AutomationProperties.Name="{x:Bind core:ItemLabels.PlayAction(Model.Dto), Mode=OneWay, FallbackValue=Play}"
                    Background="{StaticResource Black65O}"
                    BorderThickness="0"
                    Command="{x:Bind root:App.Commands.PlayDtoCommand}"
                    CommandParameter="{x:Bind Model.Dto, Mode=OneWay}"
                    CornerRadius="25"
                    Style="{ThemeResource BareButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind core:ItemLabels.PlayAction(Model.Dto), Mode=OneWay, FallbackValue=Play}"
                    Visibility="Collapsed">

                    <animations:Implicit.ShowAnimations>
                        <animations:OpacityAnimation
                            From="0"
                            To="1.0"
                            Duration="0:0:0.2" />
                    </animations:Implicit.ShowAnimations>
                    <animations:Explicit.Animations>
                        <animations:AnimationSet x:Name="ZoomAnimation">
                            <animations:ScaleAnimation To="1" Duration="0:0:0.3" />
                            <animations:StartAnimationActivity Animation="{Binding ElementName=OnEnter}" />
                        </animations:AnimationSet>
                        <animations:AnimationSet x:Name="ZoomOutAnimation">
                            <animations:ScaleAnimation To="0.8" Duration="0:0:0.3" />
                            <animations:StartAnimationActivity Animation="{Binding ElementName=OnExit}" />
                        </animations:AnimationSet>
                    </animations:Explicit.Animations>
                    <i:Interaction.Behaviors>
                        <i:EventTriggerBehavior EventName="PointerEntered">
                            <cb:StartAnimationAction Animation="{Binding ElementName=ZoomAnimation}" />
                        </i:EventTriggerBehavior>
                        <i:EventTriggerBehavior EventName="PointerExited">
                            <cb:StartAnimationAction Animation="{Binding ElementName=ZoomOutAnimation}" />
                        </i:EventTriggerBehavior>
                    </i:Interaction.Behaviors>

                    <FontIcon Glyph="&#xF5B0;">
                        <animations:Explicit.Animations>
                            <animations:AnimationSet x:Name="OnEnter">
                                <animations:ColorAnimation
                                    Layer="Xaml"
                                    Target="(FontIcon.Foreground).(SolidColorBrush.Color)"
                                    To="{ThemeResource SystemAccentColor}"
                                    Duration="0:0:0.3" />
                            </animations:AnimationSet>
                            <animations:AnimationSet x:Name="OnExit">
                                <animations:ColorAnimation
                                    Layer="Xaml"
                                    Target="(FontIcon.Foreground).(SolidColorBrush.Color)"
                                    To="White"
                                    Duration="0:0:0.3" />
                            </animations:AnimationSet>
                        </animations:Explicit.Animations>
                    </FontIcon>
                </Button>

                <InfoBadge
                    Width="50"
                    Height="25"
                    Margin="10"
                    Padding="5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{x:Bind c:BaseItemDtoConverters.CardBadgeBackground(Model), Mode=OneWay}"
                    FontSize="25"
                    FontWeight="ExtraBold"
                    IconSource="{x:Bind c:BaseItemDtoConverters.CardBadgeSource(Model), Mode=OneWay}"
                    Visibility="{x:Bind c:BaseItemDtoConverters.IsCardBadgeVisible(Model), Mode=OneWay}"
                    Value="{x:Bind c:BaseItemDtoConverters.GetCardBadgeValue(Model), Mode=OneWay}">
                    <InfoBadge.Resources>
                        <x:Double x:Key="InfoBadgeMaxHeight">100</x:Double>
                        <x:Double x:Key="InfoBadgeValueFontSize">18</x:Double>
                    </InfoBadge.Resources>
                </InfoBadge>

                <!--
                    Seaglass 1.1.3: the accent on artwork, on a dark track as tall as the bar (WinUI's track is a 1 px line, so the
                    bar sat on the poster itself: any poster near the accent's own lightness hid it). Glass.xaml, SeaglassAccentOnImageBrush.
                -->
                <ProgressBar
                    Height="4"
                    MinHeight="4"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource Black65O}"
                    Foreground="{ThemeResource SeaglassAccentOnImageBrush}"
                    Maximum="100"
                    Minimum="0"
                    Visibility="{x:Bind Model.UserData.PlayedPercentage, Converter={StaticResource MoreThanZeroToVisibilityConverter}, Mode=OneWay}"
                    Value="{x:Bind Model.UserData.PlayedPercentage, Converter={StaticResource NullableDoubleToValueOrDefaultConverter}, Mode=OneWay}">
                    <ProgressBar.Resources>
                        <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
                    </ProgressBar.Resources>
                </ProgressBar>

                <StackPanel
                    x:Name="ActionButtons"
                    RequestedTheme="Dark"
                    Margin="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="Collapsed">

                    <!--
                        Seaglass 1.1.4: each button is named for its item and says what a click does now, its tooltip the same
                        words (Seaglass UX review, fix 4): "Mark Inception as watched", "Remove Inception from favorites"
                    -->
                    <ToggleButton
                        x:Name="MarkWatchedButton" IsTabStop="False"
                        Width="40"
                        Height="40"
                        AutomationProperties.Name="{x:Bind core:ItemLabels.WatchedAction(Model.Dto, MarkWatchedButton.IsChecked), Mode=OneWay, FallbackValue='Mark as watched'}"
                        Click="MarkWatchedButton_Clicked"
                        Content="{ui:FontIcon Glyph=&#xE73E;,
                                              FontSize=15}"
                        Background="{StaticResource Black65O}"
                        CornerRadius="20"
                        IsChecked="{x:Bind Model.UserData.Played, Converter={StaticResource NullableBoolToValueOrDefaultConverter}, Mode=OneWay}"
                        Style="{ThemeResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind core:ItemLabels.WatchedAction(Model.Dto, MarkWatchedButton.IsChecked), Mode=OneWay, FallbackValue='Mark as watched'}" />

                    <ToggleButton
                        x:Name="AddToFavoriteButton" IsTabStop="False"
                        Width="40"
                        Height="40"
                        AutomationProperties.Name="{x:Bind core:ItemLabels.FavoriteAction(Model.Dto, AddToFavoriteButton.IsChecked), Mode=OneWay, FallbackValue='Add to favorites'}"
                        Click="AddToFavoriteButton_Clicked"
                        Content="{ui:FontIcon Glyph=&#xEB52;,
                                              FontSize=15}"
                        Background="{StaticResource Black65O}"
                        CornerRadius="20"
                        IsChecked="{x:Bind Model.UserData.IsFavorite, Converter={StaticResource NullableBoolToValueOrDefaultConverter}, Mode=OneWay}"
                        Style="{ThemeResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind core:ItemLabels.FavoriteAction(Model.Dto, AddToFavoriteButton.IsChecked), Mode=OneWay, FallbackValue='Add to favorites'}">
                        <ToggleButton.Resources>
                            <StaticResource x:Key="SystemAccentColor" ResourceKey="FavoriteCheckedBrush" />
                        </ToggleButton.Resources>
                    </ToggleButton>

                    <Button
                        x:Name="MoreButton" IsTabStop="False"
                        Width="40"
                        Height="40"
                        AutomationProperties.Name="{x:Bind core:ItemLabels.MoreOptions(Model.Dto), Mode=OneWay, FallbackValue='More options'}"
                        Content="{ui:FontIcon Glyph=&#xE712;,
                                              FontSize=15}"
                        Background="{StaticResource Black65O}"
                        CornerRadius="20"
                        Flyout="{x:Bind Model.Dto, Converter={StaticResource FlyoutConverter}, Mode=OneWay}"
                        Style="{ThemeResource IconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind core:ItemLabels.MoreOptions(Model.Dto), Mode=OneWay, FallbackValue='More options'}"
                        Visibility="{x:Bind c:JellyfinFlyoutConverter.CardMenuVisibility(Model.Dto), Mode=OneWay}" />

                </StackPanel>

            </Grid>

            <Border
                x:Name="FocusRing"
                BorderBrush="{ThemeResource GlassTextPrimaryBrush}"
                BorderThickness="3"
                CornerRadius="{StaticResource GlassCardCornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <!--  one very subtle light edge on the artwork, nothing else around it  -->
            <Border
                AutomationProperties.AccessibilityView="Raw"
                BorderBrush="{ThemeResource GlassStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource GlassCardCornerRadius}"
                IsHitTestVisible="False" />
        </Grid>
        <!--  the title and subtitle are plain text under the artwork: no plate, no border; part of the card's target (a transparent background takes the pointer between the lines)  -->
        <StackPanel
            x:Name="TitleArea"
            Grid.Row="1"
            Padding="2,10,2,2"
            Background="Transparent"
            Spacing="2">

            <TextBlock
                FontFamily="{StaticResource GlassTextFontFamily}"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlassTextPrimaryBrush}"
                Text="{x:Bind Model.Dto, Converter={StaticResource NameConverter}, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <TextBlock
                Style="{StaticResource GlassMetaTextBlockStyle}"
                Text="{x:Bind Model.Dto, Converter={StaticResource SubtitleConverter}, Mode=OneWay}"
                TextWrapping="NoWrap"
                Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text, Converter={StaticResource EmptyStringVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>
