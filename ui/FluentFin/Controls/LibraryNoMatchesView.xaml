<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.4.0 (the UX review's X4, item 2): a filter that leaves nothing says so, distinct from loading and from an empty
    library: "No unwatched movies in Comedy", what to do, the filters on as chips, and Clear filters. Shown only then.
-->
<UserControl
    x:Class="FluentFin.Controls.LibraryNoMatchesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentFin.Controls"
    x:Name="Root"
    IsTabStop="False">
    <StackPanel
        x:Name="Panel"
        MaxWidth="560"
        Padding="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12">
        <FontIcon
            HorizontalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            FontSize="40"
            Foreground="{ThemeResource GlassTextSecondaryBrush}"
            Glyph="&#xE71C;" />
        <TextBlock
            x:Name="TitleText"
            HorizontalAlignment="Center"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind ViewModel.NoMatchesText, Mode=OneWay}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            HorizontalAlignment="Center"
            Foreground="{ThemeResource GlassTextSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{x:Bind ViewModel.NoMatchesMessage, Mode=OneWay}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            x:Name="ClearButton"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Command="{x:Bind ViewModel.ClearFiltersCommand}"
            Content="Clear filters"
            Style="{StaticResource NixieButtonStyle}" />
    </StackPanel>
</UserControl>
