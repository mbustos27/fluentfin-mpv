<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.TopTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentFin.Controls"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI"
    IsTabStop="False">

    <!--
        1.2.0 (the top bar, replacing the left rail): the sections as plain text tabs. The marked one has a short underline in
        the theme's accent with a soft glow of it; hover brightens the text and shows a faint neutral line, a press dims it. No
        pill, no box. One Tab stop (the marked tab), Left/Right (and Home/End) move between the tabs, Enter or Space opens one;
        Narrator reads a tab list, each "tab item, n of m", selected or not (TopTabStrip.cs). Narrow windows: one menu button.
    -->
    <UserControl.Resources>
        <Style x:Key="TopTabButtonStyle" TargetType="local:TopTabButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="12,0,12,0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MaxWidth" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="2,4,2,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TopTabButton">
                        <Grid
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                            <!--  the marked tab's glow: the accent, soft, under its line (none in high contrast: the opacity is 0 there)  -->
                            <Border
                                x:Name="Glow"
                                Width="22"
                                Height="3"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                CornerRadius="1.5"
                                IsHitTestVisible="False"
                                Opacity="0">
                                <ui:Effects.Shadow>
                                    <media:AttachedCardShadow
                                        BlurRadius="10"
                                        CornerRadius="2"
                                        Opacity="{ThemeResource GlassShadowOpacity}"
                                        Color="{ThemeResource SeaglassAccentColor}" />
                                </ui:Effects.Shadow>
                            </Border>
                            <!--  hover: a faint neutral line where the marked tab's is  -->
                            <Border
                                x:Name="HoverLine"
                                Width="22"
                                Height="2"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource TextFillColorTertiaryBrush}"
                                CornerRadius="1"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="Underline"
                                Width="22"
                                Height="3"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource SeaglassAccentBrush}"
                                CornerRadius="1.5"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <!--  two labels in one cell (the cell is the bold one's width): nothing moves when the mark moves  -->
                            <TextBlock
                                x:Name="Label"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                TextLineBounds="Tight"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="SelectedLabel"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Opacity="0"
                                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                TextLineBounds="Tight"
                                TextTrimming="CharacterEllipsis" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="HoverLine.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Setter Target="SelectedLabel.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Setter Target="HoverLine.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Opacity" Value="0" />
                                            <Setter Target="SelectedLabel.Opacity" Value="1" />
                                            <Setter Target="Underline.Opacity" Value="1" />
                                            <Setter Target="Glow.Opacity" Value="1" />
                                            <Setter Target="HoverLine.Visibility" Value="Collapsed" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  narrow windows: the sections in a menu, behind one button naming the marked one; text only, as the tabs  -->
        <Style x:Key="TopMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="2,4,2,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                            <ContentPresenter
                                x:Name="Presenter"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel
            x:Name="TabsPanel"
            Orientation="Horizontal"
            Spacing="2"
            TabFocusNavigation="Once" />
        <Button
            x:Name="CompactButton"
            AutomationProperties.AutomationId="TopTabsMenu"
            Click="OnCompactClick"
            Style="{StaticResource TopMenuButtonStyle}"
            ToolTipService.ToolTip="Sections"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Glyph="&#xE700;" />
                <TextBlock
                    x:Name="CompactLabel"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    TextLineBounds="Tight" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
