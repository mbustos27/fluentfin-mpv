<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.AmbientBackdropView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsHitTestVisible="False"
    IsTabStop="False">

    <!--
        Seaglass: the soft artwork behind the whole window. A deep colour, then the artwork decoded about 64 px wide and
        stretched so it reads as blurred, then the dim brush. Solid mode and no artwork: the deep colour alone.
    -->
    <Grid x:Name="Container">
        <Rectangle x:Name="BaseFill" Fill="{ThemeResource SeaglassDeepBrush}" />
        <!--  the artwork layers drift together (Full mode only): a slow zoom and sway, run by the compositor  -->
        <Grid x:Name="Drift" SizeChanged="OnDriftSizeChanged">
            <Image
                x:Name="BackImage"
                AutomationProperties.AccessibilityView="Raw"
                Opacity="0"
                Stretch="UniformToFill" />
            <Image
                x:Name="FrontImage"
                AutomationProperties.AccessibilityView="Raw"
                ImageOpened="OnFrontImageOpened"
                Opacity="0"
                Stretch="UniformToFill" />
        </Grid>
        <Rectangle x:Name="Dim" Fill="{ThemeResource GlassAmbientDimBrush}" />
    </Grid>
</UserControl>
