<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.AmbientBackdropView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsHitTestVisible="False"
    IsTabStop="False">

    <!--
        The soft artwork behind the whole window: a deep colour, then the artwork decoded small and stretched so it reads as
        blurred, then the dim brush. With no artwork, the flat dusk scene drawn in code (FluentFin.Core.Theming.DuskScene): in
        full on sign-in, the server page and empty states (a banded sky, a striped sun with rings, starbursts, desert hills and
        a saguaro, faint scanlines and a vignette); inside the shell only a quiet strip of hills. High contrast: the deep colour
        alone. Nothing here is an image file, and nothing here takes input or appears to Narrator.
    -->
    <Grid x:Name="Container">
        <Rectangle x:Name="BaseFill" Fill="{ThemeResource SeaglassDeepBrush}" />

        <Grid
            x:Name="Scene"
            SizeChanged="OnSceneSizeChanged"
            Visibility="Collapsed">
            <Rectangle x:Name="Sky" />
            <!--  the sun, its rings and the starbursts: built and placed in code for the window's size  -->
            <Canvas x:Name="SkyArt" />
            <!--  the hills: one 1000x100 drawing stretched along the bottom, far to near  -->
            <Viewbox
                x:Name="Hills"
                VerticalAlignment="Bottom"
                Stretch="Fill">
                <Canvas Width="1000" Height="100">
                    <Path x:Name="FarHill" Data="M-40,60 C120,22 220,30 320,46 C420,62 520,12 640,26 C760,40 860,56 1040,32 L1040,100 L-40,100 Z" />
                    <!--  the buttes: flat tops with softened shoulders and curved talus slopes (the art pass: straight-sided blocks read crude)  -->
                    <Path x:Name="MesaHill" Data="M-40,74 L112,74 C134,74 146,70 154,60 L164,50 C167,47 170,46 174,46 L314,46 C318,46 321,47 324,50 L334,62 C342,70 356,71 376,71 L520,69 C600,67 680,75 752,74 C766,74 776,70 782,63 L790,56 C793,53 796,52 800,52 L914,52 C918,52 921,53 924,56 L934,68 C941,74 952,76 968,76 L1040,76 L1040,100 L-40,100 Z" />
                    <Path x:Name="NearHill" Data="M-40,84 C160,70 300,92 470,82 C640,72 820,90 1040,80 L1040,100 L-40,100 Z" />
                </Canvas>
            </Viewbox>
            <!--  one saguaro on the near hill: one trunk and two arms of even width, rounded tops and elbows (the art pass: square joints read as clip-art)  -->
            <Path
                x:Name="Saguaro"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Data="F1 M46,240 L46,30 A14,14 0 0 1 74,30 L74,240 Z M50,166 L34,166 A20,20 0 0 1 14,146 L14,104 A10,10 0 0 1 34,104 L34,140 A6,6 0 0 0 40,146 L50,146 Z M70,130 L86,130 A20,20 0 0 0 106,110 L106,70 A10,10 0 0 0 86,70 L86,104 A6,6 0 0 1 80,110 L70,110 Z"
                Stretch="Uniform" />
            <!--  the CRT touches (full scene, not Solid): a vignette, and scanlines drawn by the compositor  -->
            <Rectangle x:Name="Vignette" />
            <Border x:Name="Scanlines" />
        </Grid>

        <!--  the artwork layers drift together (Full mode only): a slow zoom and sway, run by the compositor  -->
        <Grid x:Name="Drift" SizeChanged="OnDriftSizeChanged">
            <Image
                x:Name="BackImage"
                AutomationProperties.AccessibilityView="Raw"
                Opacity="0"
                Stretch="UniformToFill" />
            <Image
                x:Name="FrontImage"
                AutomationProperties.AccessibilityView="Raw"
                ImageOpened="OnFrontImageOpened"
                Opacity="0"
                Stretch="UniformToFill" />
        </Grid>
        <!--  the title's colour, faintly (at most 10 %): the only place a title's hue shows  -->
        <Rectangle x:Name="Tint" Opacity="0.1">
            <Rectangle.Fill>
                <SolidColorBrush x:Name="TintBrush" Color="#C25A6E" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="Dim" Fill="{ThemeResource GlassAmbientDimBrush}" />
    </Grid>
</UserControl>
