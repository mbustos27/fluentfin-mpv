<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.4.0: the theatre's own message when a trailer can't play there (YouTube refused it, it didn't start, it is on
    another site, or the player didn't start): in the screen's place, on the screen's black in every theme (so the dark
    colours, whatever the app's), the heading, a one-line reason, and two Secondary buttons: the way to watch it elsewhere
    (Watch on YouTube, Open vimeo.com in browser: the browser opens only from here) and Close, which has the keyboard.
    High contrast: the system colours.
-->
<UserControl
    x:Class="FluentFin.Controls.TrailerMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    RequestedTheme="Dark">
    <Grid Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
        <StackPanel
            x:Name="Panel"
            MaxWidth="520"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Assertive"
            Spacing="10">
            <FontIcon
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="32"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                Glyph="&#xE714;" />
            <TextBlock
                x:Name="HeadingText"
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level2"
                FontFamily="{StaticResource GlassDisplayFontFamily}"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlassTextPrimaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ReasonText"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <StackPanel
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="LinkButton"
                    MaxWidth="320"
                    Click="LinkButton_Click"
                    Style="{StaticResource NixieButtonStyle}" />
                <Button
                    x:Name="CloseButton"
                    Click="CloseButton_Click"
                    Content="Close"
                    Style="{StaticResource NixieButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
