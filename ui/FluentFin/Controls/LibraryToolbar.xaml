<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.4.0 (the UX review's X4, X5, X13; items 2, 8 and 13): the library's toolbar in every theme, in one order: the
    one-click Unwatched switch, Sort (the key and its direction in words, "Date added · newest first"), the direction in one
    click, Filter (its count; a MinWidth so "Filter (2)" never moves Sort), and View (density, grid or list; Cinematic's
    stills or posters). Each theme gives the buttons its own style (ButtonStyle, ToggleStyle); the parts, their names and
    their order are this control's.
-->
<UserControl
    x:Class="FluentFin.Controls.LibraryToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentFin.Controls"
    xmlns:views="using:FluentFin.Views"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Root"
    IsTabStop="False">

    <UserControl.Resources>
        <!--  the Filter menu's rows: a kind's heading, or one of its check boxes (greyed at 0: it would leave nothing)  -->
        <DataTemplate x:Key="FilterHeaderTemplate" x:DataType="vm:FilterFacet">
            <TextBlock
                Margin="0,16,0,4"
                AutomationProperties.HeadingLevel="Level3"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Title}" />
        </DataTemplate>
        <DataTemplate x:Key="FilterOptionTemplate" x:DataType="vm:FilterOption">
            <CheckBox
                MinHeight="32"
                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                Content="{x:Bind Label, Mode=OneWay}"
                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                IsEnabled="{x:Bind IsAvailable, Mode=OneWay}" />
        </DataTemplate>
        <views:FilterRowTemplateSelector
            x:Key="FilterRowTemplates"
            Header="{StaticResource FilterHeaderTemplate}"
            Option="{StaticResource FilterOptionTemplate}" />
    </UserControl.Resources>

    <StackPanel
        x:Name="Bar"
        Orientation="Horizontal"
        Spacing="8">
        <!--  1.6 colpage (LB2): the switches only where a page has no presets strip (ShowSwitches); every theme has the strip now  -->
        <ToggleButton
            x:Name="UnwatchedToggle"
            Visibility="Collapsed"
            AutomationProperties.Name="{x:Bind local:LibraryToolbar.UnwatchedName(ViewModel.UnwatchedCount), Mode=OneWay}"
            IsChecked="{x:Bind ViewModel.Filter.Unwatched, Mode=TwoWay}"
            Style="{StaticResource NixieChipToggleButtonStyle}"
            ToolTipService.ToolTip="Only what you haven't watched"
            ToolTipService.Placement="Bottom">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE890;" />
                <TextBlock Text="Unwatched" />
            </StackPanel>
        </ToggleButton>
        <ToggleButton
            x:Name="FavoritesToggle"
            AutomationProperties.Name="Favorites"
            IsChecked="{x:Bind ViewModel.Filter.Favorites, Mode=TwoWay}"
            Style="{StaticResource NixieChipToggleButtonStyle}"
            ToolTipService.ToolTip="Only your favorites"
            ToolTipService.Placement="Bottom"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xEB51;" />
                <TextBlock Text="Favorites" />
            </StackPanel>
        </ToggleButton>

        <!--  the key and its direction in words; its menu: the keys (the one in use again turns it), then both directions in words  -->
        <Button
            x:Name="SortButton"
            AutomationProperties.Name="{x:Bind ViewModel.SortButtonName, Mode=OneWay}"
            ToolTipService.ToolTip="Sort"
            ToolTipService.Placement="Bottom">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                <TextBlock x:Name="SortText" Text="{x:Bind ViewModel.SortText, Mode=OneWay}" />
            </StackPanel>
            <Button.Flyout>
                <MenuFlyout x:Name="SortMenu" Opening="SortMenu_Opening" Placement="BottomEdgeAlignedRight" />
            </Button.Flyout>
        </Button>
        <Button
            x:Name="DirectionButton"
            AutomationProperties.Name="{x:Bind ViewModel.SortOrderButtonName, Mode=OneWay}"
            Click="DirectionButton_Click"
            Style="{StaticResource NixieCompactIconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind local:LibraryToolbar.SwitchTo(ViewModel.OtherDirectionWords), Mode=OneWay}"
            ToolTipService.Placement="Bottom">
            <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.SortGlyph, Mode=OneWay}" />
        </Button>

        <Button
            x:Name="FilterButton"
            MinWidth="116"
            AutomationProperties.Name="{x:Bind ViewModel.FilterButtonName, Mode=OneWay}"
            HorizontalContentAlignment="Left"
            ToolTipService.ToolTip="Filter"
            ToolTipService.Placement="Bottom">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE71C;" />
                <TextBlock Text="{x:Bind ViewModel.FilterText, Mode=OneWay}" />
            </StackPanel>
            <Button.Flyout>
                <Flyout x:Name="FilterFlyout" Placement="BottomEdgeAlignedRight">
                    <Grid
                        x:Name="FilterPanel"
                        Width="340"
                        MaxHeight="560"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Filter" />
                            <Button
                                x:Name="ClearFiltersButton"
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.ClearFiltersCommand}"
                                Content="Clear filters"
                                IsEnabled="{x:Bind views:LibraryPage.AnyOn(ViewModel.ActiveFilters), Mode=OneWay}"
                                Style="{StaticResource NixieCompactButtonStyle}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" Padding="0,0,12,0">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,4,0,4"
                                    AutomationProperties.HeadingLevel="Level3"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Show" />
                                <CheckBox
                                    x:Name="UnwatchedBox"
                                    MinHeight="32"
                                    Content="Unwatched only"
                                    IsChecked="{x:Bind ViewModel.Filter.Unwatched, Mode=TwoWay}" />
                                <CheckBox
                                    x:Name="FavoritesBox"
                                    MinHeight="32"
                                    Margin="0,0,0,12"
                                    Content="Favorites only"
                                    IsChecked="{x:Bind ViewModel.Filter.Favorites, Mode=TwoWay}" />
                                <!--  one virtualised list of the kinds' headings and their check boxes (a library's values can be hundreds)  -->
                                <ItemsRepeater
                                    x:Name="FilterRepeater"
                                    ItemTemplate="{StaticResource FilterRowTemplates}"
                                    ItemsSource="{x:Bind ViewModel.FilterRows, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!--  View: the posters' size, a grid or a list (and Cinematic's stills or posters), kept per library  -->
        <Button
            x:Name="ViewButton"
            AutomationProperties.Name="{x:Bind local:LibraryToolbar.ViewName(ViewModel.Density, ViewModel.Layout, ViewModel.Art, ShowArtChoice), Mode=OneWay}"
            Style="{StaticResource NixieCompactIconButtonStyle}"
            ToolTipService.ToolTip="View"
            ToolTipService.Placement="Bottom">
            <FontIcon FontSize="14" Glyph="{x:Bind local:LibraryToolbar.ViewGlyph(ViewModel.Layout), Mode=OneWay}" />
            <Button.Flyout>
                <MenuFlyout x:Name="ViewMenu" Opening="ViewMenu_Opening" Placement="BottomEdgeAlignedRight" />
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
