<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.PagedScrollView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewmodels="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  fluentfin-mpv: the row's title, drawn as plain text, but a button so the keyboard and Narrator can open the library  -->
        <Style x:Key="RowHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            AutomationProperties.AccessibilityView="Raw"
                            Background="{TemplateBinding Background}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="HeaderButton"
                HorizontalAlignment="Left"
                AutomationProperties.HeadingLevel="Level2"
                AutomationProperties.Name="{x:Bind Header, Mode=OneWay}"
                Click="HeaderButton_Click"
                Style="{StaticResource RowHeaderButtonStyle}">
                <TextBlock
                    PointerEntered="TextBlock_PointerEntered"
                    PointerExited="TextBlock_PointerExited"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind Header, Mode=OneWay}" />
            </Button>

            <!--  fluentfin-mpv: names and tooltips (ux-review I3)  -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    x:Name="ScrollLeftBtn"
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="Scroll left"
                    Click="ScrollLeftBtn_Click"
                    CornerRadius="25"
                    ToolTipService.ToolTip="Scroll left"
                    Visibility="Collapsed">
                    <FontIcon FontSize="12" Glyph="&#xedd9;" />
                </Button>
                <Button
                    x:Name="ScrollRightBtn"
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="Scroll right"
                    Click="ScrollRightBtn_Click"
                    CornerRadius="25"
                    ToolTipService.ToolTip="Scroll right">
                    <FontIcon FontSize="12" Glyph="&#xEDDA;" />
                </Button>
            </StackPanel>
        </Grid>



        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            GotFocus="Scroller_GotFocus"
            HorizontalScrollMode="Disabled"
            SizeChanged="Scroller_SizeChanged"
            ViewChanging="Scroller_ViewChanging">
            <Grid x:Name="ContentGrid">
                <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:BaseItemViewModel">
                            <local:BaseItemDtoCard
                                Width="225"
                                Height="385"
                                BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Thumb, 302)}"
                                ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 302)}"
                                JellyfinClient="{Binding ElementName=Page, Path=JellyfinClient}"
                                Model="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
