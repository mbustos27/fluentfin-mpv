<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.4.0 (the UX review's X16, item 13): the row under a library's toolbar, in every theme, its height always kept (a
    sort never moves the grid). Sorted by title with 48 titles or more: the A to Z, # and A to Z in one shape (a letter no title
    starts with is dimmed, skipped by the arrows and silent to Narrator), the letter in view marked from the tile (never a
    recycled button: the letter role's Selected state, bold accent text), at least 32 high, on one row (the tiles narrow to
    fit). Under any other sort, or fewer titles: the two directions in words ("Oldest first", "Newest first") as choice chips.
    At the end, where the view is ("M · 324 of 1,000"). The 1.4.0 style keys: NixieLetterButtonStyle, NixieChoiceChipStyle.
-->
<UserControl
    x:Class="FluentFin.Controls.LetterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentFin.Controls"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Root"
    IsTabStop="False">


    <Grid x:Name="RowGrid" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  one Tab stop, the arrows along it; a list named "Jump to a letter" of buttons "Jump to M"  -->
        <local:RowList
            x:Name="LetterList"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            AutomationProperties.Name="Jump to a letter"
            TabFocusNavigation="Once"
            XYFocusKeyboardNavigation="Enabled">
            <ItemsRepeater x:Name="LetterRepeater" ItemsSource="{x:Bind ViewModel.LetterTiles, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout x:Name="LetterLayout" Orientation="Horizontal" Spacing="2" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:LetterTile">
                        <Button
                            AutomationProperties.AccessibilityView="{x:Bind local:LetterBar.ViewFor(HasTitles), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            Click="Letter_Click"
                            Content="{x:Bind Letter}"
                            IsEnabled="{x:Bind HasTitles, Mode=OneWay}"
                            Tag="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </local:RowList>

        <!--  any other sort: its two directions, in its words  -->
        <StackPanel
            x:Name="Directions"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <RadioButton
                x:Name="AscendingButton"
                Click="Direction_Click"
                GroupName="LetterBarDirection"
                Style="{StaticResource NixieChoiceChipStyle}" />
            <RadioButton
                x:Name="DescendingButton"
                Click="Direction_Click"
                GroupName="LetterBarDirection"
                Style="{StaticResource NixieChoiceChipStyle}" />
        </StackPanel>

        <!--  where the view is (large libraries)  -->
        <Border
            x:Name="PositionPlate"
            Grid.Column="1"
            Padding="0"
            VerticalAlignment="Center"
            CornerRadius="8"
            Visibility="{x:Bind local:LetterBar.PositionVisibility(ViewModel.PositionText, ViewModel.TotalCount), Mode=OneWay}">
            <TextBlock
                x:Name="PositionLine"
                VerticalAlignment="Center"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Border>
    </Grid>
</UserControl>
