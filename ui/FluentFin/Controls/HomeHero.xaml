<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.HomeHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Seaglass: Home's hero (docs/design/SEAGLASS.md). The slide's backdrop fills the width, scrimmed at the left and the
        bottom so the words read on any artwork; its logo (or its title), meta line, overview, the Play pill and the More
        info pill sit at the lower left; the dots at the lower right. Slides crossfade (600 ms); they advance by themselves
        only when GlassMode allows motion, and not while the pointer or the focus is in the hero.
    -->
    <Grid
        x:Name="Root"
        Height="400"
        AutomationProperties.LandmarkType="Custom"
        AutomationProperties.LocalizedLandmarkType="Featured"
        AutomationProperties.Name="Featured"
        CornerRadius="{StaticResource GlassPanelCornerRadius}"
        GotFocus="Root_GotFocus"
        LostFocus="Root_LostFocus"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited">
        <Grid.Background>
            <SolidColorBrush Color="#FF101A1E" />
        </Grid.Background>

        <Image
            x:Name="BackdropBottom"
            HorizontalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            Stretch="UniformToFill" />
        <Image
            x:Name="BackdropTop"
            HorizontalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            Opacity="0"
            Stretch="UniformToFill" />

        <!--  the scrims: dark at the left (the words) and at the bottom (the dots, the edge into the page)  -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Offset="0" Color="#E6000000" />
                    <GradientStop Offset="0.55" Color="#66000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.55" Color="#00000000" />
                    <GradientStop Offset="1" Color="#99000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--  the hero sits on artwork in every theme: its words are the dark theme's glass text (white), the system text colour in high contrast  -->
        <!--  Seaglass: the words sit on one glass panel (the left scrim keeps its backdrop dark, so the white text reads on any artwork)  -->
        <ContentControl
            MaxWidth="600"
            Margin="32,0,32,32"
            Padding="26,22"
            HorizontalAlignment="Left"
            RequestedTheme="Dark"
            VerticalAlignment="Bottom"
            Style="{StaticResource GlassSurfaceStyle}">
            <StackPanel x:Name="Words" Spacing="12">
                <Image
                    x:Name="Logo"
                    MaxHeight="110"
                    HorizontalAlignment="Left"
                    AutomationProperties.AccessibilityView="Raw"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="TitleText"
                    Foreground="{ThemeResource GlassTextPrimaryBrush}"
                    Style="{StaticResource GlassHeroTitleTextBlockStyle}" />
                <TextBlock
                    x:Name="MetaText"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GlassTextPrimaryBrush}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="OverviewText"
                    FontSize="15"
                    Foreground="{ThemeResource GlassTextPrimaryBrush}"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="PlayButton" Click="Play_Click" Style="{StaticResource GlassAccentPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock x:Name="PlayText" Text="Play" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="MoreInfoButton"
                        Click="MoreInfo_Click"
                        Content="More info"
                        Foreground="{ThemeResource GlassTextPrimaryBrush}"
                        Style="{StaticResource GlassInsetPillButtonStyle}" />
                </StackPanel>
            </StackPanel>

        </ContentControl>

        <Border
            Margin="0,0,28,20"
            Padding="10,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#66000000"
            CornerRadius="{StaticResource GlassChipCornerRadius}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <!--  Seaglass scrolling: a visible pause for the auto-advance (WCAG 2.2.2); the dots are one Tab stop, Left/Right pick a slide  -->
                <Button
                    x:Name="PauseButton"
                    RequestedTheme="Dark"
                    Width="24"
                    Height="24"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Pause slideshow"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="PauseButton_Click"
                    CornerRadius="12"
                    ToolTipService.ToolTip="Pause slideshow">
                    <FontIcon
                        x:Name="PauseIcon"
                        FontSize="11"
                        Foreground="{ThemeResource GlassTextPrimaryBrush}"
                        Glyph="&#xE769;" />
                </Button>
                <StackPanel
                    x:Name="Dots"
                    AutomationProperties.Name="Slides"
                    Orientation="Horizontal"
                    Spacing="2"
                    TabFocusNavigation="Once" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
