<?xml version="1.0" encoding="utf-8" ?>
<!--
    Seaglass: the top of the movie, series, season and episode pages. The backdrop fills the width (decoded at the width it is
    drawn at) with a scrim at the bottom and one behind the text on the left; the logo (the title as text when there is none),
    the chip row, the actions and the overview sit on it. Always dark, so the text reads on any backdrop in both themes.
    1.2.0 (1.1.3 UX audit, layout items 8 and 21): the facts are one line of plain text with dots ("2008 · R · 1h 52m ·
    4K"; an episode's starts with "S1 E1"), not bordered chips, and the teal "S1 · E1" overline is gone; the hero's height is a
    share of the window's (HeroLayout: 360 to 640 px; HeightShare), compact (a smaller logo, two lines of overview) when short.
-->
<UserControl
    x:Class="FluentFin.Controls.ItemHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:core="using:FluentFin.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:journal="using:FluentFin.Plugins.Journal.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    HorizontalContentAlignment="Stretch"
    mc:Ignorable="d">

    <Grid
        x:Name="HeroGrid"
        Height="640"
        RequestedTheme="Dark">
        <Image
            x:Name="BackdropImage"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.AccessibilityView="Raw"
            Stretch="UniformToFill" />
        <Border Background="{ThemeResource NixieDeepBrush}" Opacity="0.35" />
        <Border Background="{ThemeResource ItemHeroSideScrimBrush}" />
        <Border
            Height="260"
            VerticalAlignment="Bottom"
            Background="{ThemeResource GlassImageScrimBrush}" />

        <StackPanel
            x:Name="Words"
            Margin="48,24,48,36"
            MaxWidth="{StaticResource ItemHeroTextMaxWidth}"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Spacing="14">
            <Image
                x:Name="LogoImage"
                MaxWidth="480"
                MaxHeight="160"
                HorizontalAlignment="Left"
                AutomationProperties.HeadingLevel="Level1"
                Stretch="Uniform"
                Visibility="Collapsed" />
            <!--  the logo stands in for the title (TitleText collapses): Narrator reads it by the item's name (set in code), as the page's heading  -->
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource GlassHeroTitleTextBlockStyle}" />
            <TextBlock
                x:Name="SubtitleText"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource GlassPageTitleTextBlockStyle}"
                Visibility="Collapsed" />

            <!--  the facts, plain text with dots (ItemChips.MetaLine); Narrator reads them as words (ItemChips.MetaName)  -->
            <TextBlock
                x:Name="MetaText"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlassTextPrimaryBrush}"
                TextWrapping="Wrap" />

            <!--
                the page's own play buttons, then trailer, watched, favourite, more and "Your rating". 1.2.0: the icon
                buttons are named for the item and say what a click does now, their tooltips the same words (set in code,
                UpdateActionNames); the rating sits in the row as a pill on every item page (Seaglass UX review, fix 12)
            -->
            <ctk:WrapPanel
                x:Name="ButtonStrip"
                HorizontalSpacing="10"
                VerticalSpacing="10">
                <ContentPresenter x:Name="PrimaryPresenter" />
                <Button
                    x:Name="TrailerButton"
                    AutomationProperties.Name="Watch trailer"
                    Click="TrailerButton_Click"
                    Style="{StaticResource NixieButtonStyle}"
                    ToolTipService.ToolTip="Watch trailer"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE714;" />
                        <TextBlock Text="Trailer" />
                    </StackPanel>
                </Button>
                <ToggleButton
                    x:Name="WatchedButton"
                    AutomationProperties.Name="Mark as watched"
                    Click="WatchedButton_Click"
                    Content="{ui:FontIcon Glyph=&#xE73E;}"
                    Style="{StaticResource ItemGlassToggleButtonStyle}"
                    ToolTipService.ToolTip="Mark as watched" />
                <ToggleButton
                    x:Name="FavoriteButton"
                    AutomationProperties.Name="Add to favorites"
                    Click="FavoriteButton_Click"
                    Style="{StaticResource ItemGlassToggleButtonStyle}"
                    ToolTipService.ToolTip="Add to favorites">
                    <ToggleButton.Resources>
                        <StaticResource x:Key="SystemAccentColor" ResourceKey="FavoriteCheckedBrush" />
                    </ToggleButton.Resources>
                    <!--  1.2.0 (Nixie button review, I25): an outline heart when off, filled when on (set with the names)  -->
                    <FontIcon x:Name="FavoriteGlyph" Glyph="&#xEB51;" />
                </ToggleButton>
                <Button
                    x:Name="MoreButton"
                    AutomationProperties.Name="More options"
                    Content="{ui:SymbolIcon Symbol=More}"
                    Style="{StaticResource NixieIconButtonStyle}"
                    ToolTipService.ToolTip="More options" />
                <!--
                    the journal's rating of the item, in the row at the row's height (it hides with the rating, which is
                    hidden for items the journal does not rate and when there is no journal); the stars' target is at least
                    24 px high and wide (WCAG 2.5.8; JournalRatingPanel). 1.2.0 (Nixie button review, I27): plain stars on the
                    hero, no pill around them (it read as a button)
                -->
                <Border
                    x:Name="RatingPill"
                    Height="{StaticResource GlassPillHeight}"
                    Padding="8,0"
                    Visibility="{x:Bind RatingPanel.Visibility, Mode=OneWay}">
                    <journal:JournalRatingPanel x:Name="RatingPanel" VerticalAlignment="Center" />
                </Border>
            </ctk:WrapPanel>

            <controls:ExpandableText x:Name="OverviewText" CollapsedLines="4" />
        </StackPanel>
    </Grid>
</UserControl>
