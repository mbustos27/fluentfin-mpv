<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.3.0: the layout theme picker (Settings > Appearance, and the one-time "Choose a look" step): one tile per theme,
    each its sketch (ThemePreview), its name, "In use" on the one shown, and a line on what it is. One Tab stop; the arrows
    move between the tiles and Space or Enter chooses (the focus alone never switches a theme). Narrator: "Theme" list, each
    option its name and line, "in use", and "n of m".
-->
<UserControl
    x:Class="FluentFin.Controls.ThemePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:vm="using:FluentFin.ViewModels">

    <GridView
        x:Name="Options"
        AutomationProperties.Name="Theme"
        ContainerContentChanging="OnContainerContentChanging"
        IsItemClickEnabled="False"
        ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
        SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
        SelectionMode="Single"
        SingleSelectionFollowsFocus="False">
        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
            <DataTemplate x:DataType="vm:ThemeOption">
                <StackPanel
                    Width="224"
                    Padding="6,6,6,12"
                    Spacing="6">
                    <Border
                        Height="119"
                        BorderBrush="{ThemeResource GlassStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <lc:ThemePreview Theme="{x:Bind Id}" />
                    </Border>
                    <Grid Padding="2,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="In use"
                            Visibility="{x:Bind IsActive, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Padding="2,0"
                        Foreground="{ThemeResource GlassTextSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Description}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</UserControl>
