<?xml version="1.0" encoding="utf-8" ?>
<!--  fluentfin-mpv: an item's overview, wrapped and cut to a few lines with "Show more" when it is longer (docs/research/ux-review.md I1)  -->
<UserControl
    x:Class="FluentFin.Controls.ExpandableText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="4">
        <TextBlock
            x:Name="Body"
            IsTextScaleFactorEnabled="True"
            IsTextTrimmedChanged="Body_IsTextTrimmedChanged"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{x:Bind Text, Mode=OneWay}"
            TextTrimming="WordEllipsis"
            TextWrapping="WrapWholeWords" />
        <HyperlinkButton
            x:Name="MoreButton"
            Padding="0,2"
            Click="MoreButton_Click"
            Content="Show more"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
