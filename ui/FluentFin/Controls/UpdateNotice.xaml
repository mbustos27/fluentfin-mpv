<!--
    Nixie 1.5 (the updater stream): the update notice, in the shell above the page (never over the player). One row,
    vertically centred, every step named as it happens: "Nixie 1.5.1 is available · 187 MB" (Download), "Downloading Nixie
    1.5.1" with a progress bar and "84 MB of 187 MB · 6.2 MB/s · about 20 s left" (Cancel), "Checking the download…", "Nixie
    1.5.1 is ready to install" (Restart to update), a failure with why (Retry, the release page), "Updated to Nixie 1.5.1"
    (What's new). The title is what Narrator hears, once per step; the progress line is not announced. The button roles are
    1.4.0's: one Primary (the step's action), the Link role for the notes or the release page, Subtle for Cancel and Dismiss.
    The detail takes the room that is left and trims, so the buttons always fit (1100 px wide windows too).
-->
<UserControl
    x:Class="FluentFin.Controls.UpdateNotice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">
    <Border
        x:Name="UpdateBarBorder"
        Padding="16,8,12,8"
        AutomationProperties.LandmarkType="Custom"
        AutomationProperties.LocalizedLandmarkType="Notice"
        AutomationProperties.Name="Update notice"
        Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
        BorderBrush="{ThemeResource InfoBarBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="UpdateIcon"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="16"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                Glyph="&#xE946;" />
            <TextBlock
                x:Name="UpdateTitle"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlassTextPrimaryBrush}" />
            <TextBlock
                x:Name="UpdateDetail"
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                Visibility="Collapsed" />
            <ProgressBar
                x:Name="UpdateProgress"
                Grid.Column="3"
                Width="160"
                VerticalAlignment="Center"
                AutomationProperties.Name="Download progress"
                Maximum="100"
                Minimum="0"
                Visibility="Collapsed" />
            <StackPanel
                Grid.Column="4"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="UpdatePrimaryButton"
                    VerticalAlignment="Center"
                    Click="OnPrimaryClick"
                    Style="{StaticResource NixiePrimaryCompactButtonStyle}"
                    Visibility="Collapsed" />
                <!--  the notes in the app, or the release page in the browser: the Link role, 32 high  -->
                <HyperlinkButton
                    x:Name="UpdateLinkButton"
                    VerticalAlignment="Center"
                    Click="OnLinkClick"
                    Style="{StaticResource NixieLinkButtonStyle}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="UpdateCancelButton"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    Click="OnCancelClick"
                    Content="Cancel"
                    Style="{StaticResource NixieSubtleButtonStyle}"
                    ToolTipService.ToolTip="Stop the download; Download carries on from where it stopped"
                    Visibility="Collapsed" />
                <!--  Dismiss: that version is not offered here again (Settings still has it)  -->
                <Button
                    x:Name="UpdateDismissButton"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    Click="OnDismissClick"
                    Content="Dismiss"
                    Style="{StaticResource NixieSubtleButtonStyle}"
                    ToolTipService.ToolTip="Don't offer this version again"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
