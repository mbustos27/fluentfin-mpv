<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.3.0, the Drive-in layout theme's dictionary (the default theme; DriveInTheme.cs). Merged by ThemeService while
    Drive-in is the theme. The keys every theme defines (TopBarStyle, RowHeaderTemplate, PosterTemplate, StillTemplate,
    PageHeaderStyle, SignInBackdropTemplate), then Drive-in's own (prefixed DriveIn). The colour rule: hot pink means you
    can act on it (the shared Nixie buttons, focus, progress), nixie orange is a number you read (NixieReadout), coral is
    decoration (the NOW SHOWING neon). The signs, the boards and the outdoor screen are lit objects: dark in both themes.
    High contrast: the system colours, no bulbs, no glow, no scene.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dc="using:FluentFin.Themes.DriveIn.Controls"
    xmlns:lc="using:FluentFin.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="DriveInGroundBrush" Color="#1A0710" />
            <LinearGradientBrush x:Key="DriveInConsoleBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#F2180710" />
                <GradientStop Offset="1" Color="#F70E0306" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DriveInHeaderTextBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="DriveInTileBrush" Color="#2A0814" />
            <SolidColorBrush x:Key="DriveInTileEdgeBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="DriveInTileRestBrush" Color="#A88F92" />
            <SolidColorBrush x:Key="DriveInFocusRingBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="DriveInFocusGlowBrush" Color="#F96985" />
            <LinearGradientBrush x:Key="DriveInSkyBarBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#A31C0512" />
                <GradientStop Offset="1" Color="#7A1A050E" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DriveInSkyBarStrokeBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="DriveInPageTextBrush" Color="#F8EFF0" />
            <SolidColorBrush x:Key="DriveInPageTextSecondaryBrush" Color="#D9C6C8" />
            <LinearGradientBrush x:Key="DriveInScreenFrameBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#3A1824" />
                <GradientStop Offset="1" Color="#1C0810" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DriveInScreenFrameEdgeBrush" Color="#1FFFDCD2" />
            <SolidColorBrush x:Key="DriveInScreenEdgeBrush" Color="#8CFFF4EE" />
            <SolidColorBrush x:Key="DriveInKickerBrush" Color="#F7AA9C" />
            <SolidColorBrush x:Key="DriveInScreenTextBrush" Color="#F3E6E7" />
            <SolidColorBrush x:Key="DriveInScreenTextSecondaryBrush" Color="#D9C6C8" />
            <SolidColorBrush x:Key="DriveInSignFaceBrush" Color="#D10C0206" />
            <SolidColorBrush x:Key="DriveInNeonCoralBrush" Color="#EC6A79" />
            <SolidColorBrush x:Key="DriveInNeonCoreBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="DriveInNeonTextBrush" Color="#FFE9E4" />
            <LinearGradientBrush x:Key="DriveInBoardBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#130409" />
                <GradientStop Offset="1" Color="#0C0206" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DriveInBoardRimBrush" Color="#4A1830" />
            <SolidColorBrush x:Key="DriveInBoardHairlineBrush" Color="#38F7AA9C" />
            <SolidColorBrush x:Key="DriveInBoardTextBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="DriveInBoardTextSecondaryBrush" Color="#D9C6C8" />
            <SolidColorBrush x:Key="DriveInBoardRuleBrush" Color="#40F7AA9C" />
            <SolidColorBrush x:Key="DriveInEntryHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="DriveInEntryPressedBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="DriveInEntryForegroundBrush" Color="#F8EFF0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <!--  noon: the ground under the rows is pale, the page's text dark; the lit objects stay dark  -->
            <SolidColorBrush x:Key="DriveInGroundBrush" Color="#FBEFEA" />
            <LinearGradientBrush x:Key="DriveInConsoleBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#F2180710" />
                <GradientStop Offset="1" Color="#F70E0306" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DriveInHeaderTextBrush" Color="#2D0F16" />
            <SolidColorBrush x:Key="DriveInTileBrush" Color="#2A0814" />
            <SolidColorBrush x:Key="DriveInTileEdgeBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="DriveInTileRestBrush" Color="#A88F92" />
            <SolidColorBrush x:Key="DriveInFocusRingBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="DriveInFocusGlowBrush" Color="#F96985" />
            <!--  over a hero the bar's text is the dark theme's (TopBarChrome): a dense dusk bar over the noon sky, so it keeps 4.5:1  -->
            <LinearGradientBrush x:Key="DriveInSkyBarBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#D91C0512" />
                <GradientStop Offset="1" Color="#C21C0512" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DriveInSkyBarStrokeBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="DriveInPageTextBrush" Color="#2D0F16" />
            <SolidColorBrush x:Key="DriveInPageTextSecondaryBrush" Color="#633A41" />
            <LinearGradientBrush x:Key="DriveInScreenFrameBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#3A1824" />
                <GradientStop Offset="1" Color="#1C0810" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DriveInScreenFrameEdgeBrush" Color="#1FFFDCD2" />
            <SolidColorBrush x:Key="DriveInScreenEdgeBrush" Color="#8CFFF4EE" />
            <SolidColorBrush x:Key="DriveInKickerBrush" Color="#F7AA9C" />
            <SolidColorBrush x:Key="DriveInScreenTextBrush" Color="#F3E6E7" />
            <SolidColorBrush x:Key="DriveInScreenTextSecondaryBrush" Color="#D9C6C8" />
            <SolidColorBrush x:Key="DriveInSignFaceBrush" Color="#E60C0206" />
            <SolidColorBrush x:Key="DriveInNeonCoralBrush" Color="#EC6A79" />
            <SolidColorBrush x:Key="DriveInNeonCoreBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="DriveInNeonTextBrush" Color="#FFE9E4" />
            <LinearGradientBrush x:Key="DriveInBoardBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#130409" />
                <GradientStop Offset="1" Color="#0C0206" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DriveInBoardRimBrush" Color="#4A1830" />
            <SolidColorBrush x:Key="DriveInBoardHairlineBrush" Color="#38F7AA9C" />
            <SolidColorBrush x:Key="DriveInBoardTextBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="DriveInBoardTextSecondaryBrush" Color="#D9C6C8" />
            <SolidColorBrush x:Key="DriveInBoardRuleBrush" Color="#40F7AA9C" />
            <SolidColorBrush x:Key="DriveInEntryHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="DriveInEntryPressedBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="DriveInEntryForegroundBrush" Color="#F8EFF0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DriveInGroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DriveInConsoleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DriveInHeaderTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInTileBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="DriveInTileEdgeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DriveInTileRestBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="DriveInFocusRingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DriveInFocusGlowBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DriveInSkyBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DriveInSkyBarStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInPageTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInPageTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInScreenFrameBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DriveInScreenFrameEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInScreenEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInKickerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInScreenTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInScreenTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInSignFaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DriveInNeonCoralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInNeonCoreBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInNeonTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInBoardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DriveInBoardRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInBoardHairlineBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DriveInBoardTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInBoardTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInBoardRuleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DriveInEntryHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DriveInEntryPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DriveInEntryForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  the display face of the boards and signs: Bahnschrift, Windows' own condensed DIN (no font file shipped)  -->
    <FontFamily x:Key="DriveInDisplayFontFamily">Bahnschrift</FontFamily>

    <!--  ===== the keys every theme defines ===================================================================================  -->

    <!--
        the shared top bar's chrome (TopBarChrome, drawn behind the bar's parts): over a page that starts below it, the shared glass; over Home's sky (a
        page whose art runs under the bar), a translucent maroon bar with its hairline instead of the black scrim: the sky
        shows through it, its text keeps 4.5:1 on the darkest band behind (the concept's "translucent bar over the sky")
    -->
    <Style x:Key="TopBarStyle" TargetType="lc:TopBarChrome">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="lc:TopBarChrome">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="BarStates">
                                <VisualState x:Name="OverContent" />
                                <VisualState x:Name="OverHero">
                                    <VisualState.Setters>
                                        <Setter Target="BarGlass.Visibility" Value="Collapsed" />
                                        <Setter Target="BarSky.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="BarGlass"
                            Background="{ThemeResource GlassTitleBarBrush}"
                            BorderBrush="{ThemeResource GlassTitleBarStrokeBrush}"
                            BorderThickness="0,0,0,1"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="BarSky"
                            Background="{ThemeResource DriveInSkyBarBrush}"
                            BorderBrush="{ThemeResource DriveInSkyBarStrokeBrush}"
                            BorderThickness="0,0,0,1"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  a row's header: the marquee board (a level-2 heading named in the row's words)  -->
    <DataTemplate x:Key="RowHeaderTemplate">
        <dc:MarqueeSign Text="{Binding}" />
    </DataTemplate>

    <!--
        a poster card: the shared card, its Narrator name and menu unchanged. These two templates read their item from the
        DataContext (dc:DriveInCards.Item), which a ListView or GridView gives; a row's ItemsRepeater gives none, so the
        theme's own rows use x:Bind copies of them (DriveInHomePage's DriveInStill and DriveInPoster)
    -->
    <DataTemplate x:Key="PosterTemplate">
        <lc:BaseItemDtoCard
            Width="225"
            Height="397"
            dc:DriveInRows.Nixie="True"
            dc:DriveInCards.Image="Primary,302"
            dc:DriveInCards.Item="{Binding}" />
    </DataTemplate>

    <!--  a still card (Continue watching): the time left in tubes on the artwork, an episode's code in tubes under its title  -->
    <DataTemplate x:Key="StillTemplate">
        <lc:BaseItemDtoCard
            Width="390"
            Height="252"
            dc:DriveInRows.Nixie="True"
            dc:DriveInCards.Image="Thumb,192"
            dc:DriveInCards.Item="{Binding}" />
    </DataTemplate>

    <!--  a page's title (shared pages that ask for it): the boards' display face  -->
    <Style x:Key="PageHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DriveInDisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  the sign-in page's backdrop: the lot at dusk, the outdoor screen the form sits on  -->
    <DataTemplate x:Key="SignInBackdropTemplate">
        <dc:SignInLot />
    </DataTemplate>

    <!--
        the player's overlay (optional keys, over the shared bars' own styles, during playback too): the bottom bar becomes the
        nixie console, a dark board with its rim floating over the video (no blur over video: a dense fill), elapsed, remaining
        and the volume in tubes, the seek bar a neon tube (DriveInPlayer.Console); the top bar keeps its scrim and shows when
        the film ends in tubes (DriveInPlayer.Clock). Every part and its logic stays the shared player's.
    -->
    <Style x:Key="PlayerBottomBarStyle" TargetType="Grid">
        <Setter Property="Margin" Value="40,0,40,28" />
        <Setter Property="Padding" Value="26,18,26,14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{ThemeResource DriveInBoardRimBrush}" />
        <Setter Property="Background" Value="{ThemeResource DriveInConsoleBrush}" />
        <Setter Property="dc:DriveInPlayer.Console" Value="True" />
    </Style>
    <Style x:Key="PlayerTopBarStyle" TargetType="Grid">
        <Setter Property="dc:DriveInPlayer.Clock" Value="True" />
    </Style>

    <!--  ===== Drive-in's own =================================================================================================  -->

    <!--  the marquee header: a letter board 46 high, bulbs along its top and bottom edge, the name in capitals  -->
    <Style x:Key="DriveInMarqueeStyle" TargetType="dc:MarqueeSign">
        <Setter Property="Height" Value="52" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="dc:MarqueeSign">
                    <Grid Padding="0,3">
                        <Border
                            Background="{ThemeResource DriveInBoardBrush}"
                            BorderBrush="{ThemeResource DriveInBoardRimBrush}"
                            BorderThickness="2"
                            CornerRadius="8">
                            <Border
                                Margin="2"
                                BorderBrush="{ThemeResource DriveInBoardHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <dc:BoardLines Pitch="7" />
                            </Border>
                        </Border>
                        <dc:BulbFrame
                            Margin="0,-3"
                            Inset="12"
                            Offset="3"
                            Pitch="15"
                            Radius="1.6"
                            Sides="False" />
                        <TextBlock
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            AutomationProperties.HeadingLevel="{TemplateBinding Level}"
                            AutomationProperties.Name="{TemplateBinding Text}"
                            CharacterSpacing="170"
                            FontFamily="{StaticResource DriveInDisplayFontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontStretch="Condensed"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource DriveInBoardTextBrush}"
                            Text="{TemplateBinding DisplayText}"
                            TextWrapping="NoWrap" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource DriveInMarqueeStyle}" TargetType="dc:MarqueeSign" />

    <!--  a page's own marquee (the Library's name): larger, a level-1 heading set on it by the page  -->
    <Style
        x:Key="DriveInLargeMarqueeStyle"
        BasedOn="{StaticResource DriveInMarqueeStyle}"
        TargetType="dc:MarqueeSign">
        <Setter Property="Height" Value="70" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Padding" Value="30,0" />
    </Style>

    <!--  a compact marquee (narrow windows)  -->
    <Style
        x:Key="DriveInCompactMarqueeStyle"
        BasedOn="{StaticResource DriveInMarqueeStyle}"
        TargetType="dc:MarqueeSign">
        <Setter Property="Height" Value="46" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <!--  the letter board: a deep board, faint grooves, a dark rim and a coral hairline, bulbs around it  -->
    <Style x:Key="DriveInLetterBoardStyle" TargetType="dc:LetterBoard">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource DriveInBoardTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="dc:LetterBoard">
                    <Grid>
                        <Border
                            Background="{ThemeResource DriveInBoardBrush}"
                            BorderBrush="{ThemeResource DriveInBoardRimBrush}"
                            BorderThickness="2"
                            CornerRadius="8">
                            <Border
                                Margin="3"
                                BorderBrush="{ThemeResource DriveInBoardHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <dc:BoardLines Pitch="8" />
                            </Border>
                        </Border>
                        <dc:BulbFrame
                            x:Name="Bulbs"
                            Inset="14"
                            Offset="12"
                            Pitch="18"
                            Radius="2"
                            Sides="{TemplateBinding HasSideBulbs}"
                            Visibility="{TemplateBinding HasBulbs}" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource DriveInLetterBoardStyle}" TargetType="dc:LetterBoard" />

    <!--  an entry on a board (the Coming up sign): the whole row is the button; a quiet hover, the system's two focus rings  -->
    <Style x:Key="DriveInEntryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource DriveInEntryForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource DriveInEntryHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource DriveInEntryPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        Nixie 1.3.1: the theatre window (TrailerFrame) as a little drive-in at dusk (Controls\TheatreLot): the lot behind (the
        banded sky, the striped sun peeking past the screen, the hills, the ground and the screen's two posts), the marquee on two
        short poles above the screen (NOW SHOWING, then the title, a bulb border that chases once when it opens), the outdoor
        screen's painted steel frame around the video with the projector's warm spill on the sky, and two cars with their speaker
        posts in front. The marquee and the screen are lit objects, dark in both themes; the lot is the noon one in the light
        theme; high contrast: the system colours, no scene, no bulbs.
    -->
    <ControlTemplate x:Key="TrailerFrameTemplate" TargetType="lc:TrailerFrame">
        <dc:TheatreLot
            Background="{ThemeResource DriveInGroundBrush}"
            BorderBrush="{ThemeResource DriveInBoardRimBrush}"
            BorderThickness="1"
            CornerRadius="12"
            VideoWidth="{TemplateBinding VideoWidth}">
            <!--  each scene on a Canvas: a scene is sized to the lot, and must never size it (the stage does)  -->
            <Canvas>
                <dc:DriveInScene Layer="Back" />
            </Canvas>
            <Grid
                x:Name="Stage"
                Margin="0,18,0,100"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  the projector's warm spill on the sky around the screen  -->
                <Border
                    Grid.Row="2"
                    Margin="-70"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Offset="0.55" Color="#2EF7AA9C" />
                            <GradientStop Offset="1" Color="#00F7AA9C" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!--  the marquee: a letter board with bulbs all round, NOW SHOWING over the title  -->
                <Grid
                    MinWidth="320"
                    MaxWidth="{TemplateBinding VideoWidth}"
                    HorizontalAlignment="Center">
                    <Border
                        Background="{ThemeResource DriveInBoardBrush}"
                        BorderBrush="{ThemeResource DriveInBoardRimBrush}"
                        BorderThickness="2"
                        CornerRadius="8">
                        <Border
                            Margin="3"
                            BorderBrush="{ThemeResource DriveInBoardHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <dc:BoardLines Pitch="7" />
                        </Border>
                    </Border>
                    <dc:BulbFrame
                        Inset="12"
                        Offset="8"
                        Pitch="16"
                        Radius="1.8"
                        SideOpacity="0.6"
                        Sides="True" />
                    <StackPanel
                        Padding="40,16,40,15"
                        HorizontalAlignment="Center"
                        Spacing="3">
                        <TextBlock
                            HorizontalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            CharacterSpacing="320"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource DriveInKickerBrush}"
                            Text="NOW SHOWING" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level1"
                            AutomationProperties.Name="{TemplateBinding Title}"
                            CharacterSpacing="150"
                            FontFamily="{StaticResource DriveInDisplayFontFamily}"
                            FontSize="28"
                            FontStretch="Condensed"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource DriveInBoardTextBrush}"
                            MaxLines="1"
                            Text="{TemplateBinding MarqueeTitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!--  the marquee's two short poles, standing on the screen's top edge  -->
                <Grid Grid.Row="1" Width="220">
                    <Rectangle
                        Width="7"
                        HorizontalAlignment="Left"
                        Fill="{ThemeResource DriveInBoardRimBrush}"
                        Stroke="{ThemeResource DriveInBoardHairlineBrush}"
                        StrokeThickness="1" />
                    <Rectangle
                        Width="7"
                        HorizontalAlignment="Right"
                        Fill="{ThemeResource DriveInBoardRimBrush}"
                        Stroke="{ThemeResource DriveInBoardHairlineBrush}"
                        StrokeThickness="1" />
                </Grid>

                <!--  the outdoor screen: painted steel, a lit edge, the video  -->
                <Border
                    x:Name="Screen"
                    Grid.Row="2"
                    Padding="7"
                    Background="{ThemeResource DriveInScreenFrameBrush}"
                    BorderBrush="{ThemeResource DriveInScreenFrameEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Border
                        Width="{TemplateBinding VideoWidth}"
                        Height="{TemplateBinding VideoHeight}"
                        Background="Black"
                        BorderBrush="{ThemeResource DriveInScreenEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </Border>
            </Grid>
            <Canvas>
                <dc:DriveInScene Layer="Front" />
            </Canvas>
            <Button
                x:Name="PART_CloseButton"
                Margin="14"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="Close trailer"
                ToolTipService.ToolTip="Close trailer (Esc)"
                Style="{StaticResource NixieIconButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE711;" />
            </Button>
        </dc:TheatreLot>
    </ControlTemplate>

</ResourceDictionary>
