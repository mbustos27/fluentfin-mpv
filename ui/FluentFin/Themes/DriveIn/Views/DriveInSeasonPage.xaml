<?xml version="1.0" encoding="utf-8" ?>
<!--
    Drive-in: a season, as the series page (DriveInSeasonPage.xaml): its marquee board over the backdrop, the SHOWTIMES board
    of its episodes with the series' seasons as nixie tubes (a tube opens that season's page, as the shared season page's
    pills do), then the details and the cast. Every action and name is the shared season page's (SeasonViewModel): its board's
    Watched is "Mark Season 1 of <series> as watched".
-->
<Page
    x:Class="FluentFin.Themes.DriveIn.Views.DriveInSeasonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:core="using:FluentFin.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dc="using:FluentFin.Themes.DriveIn.Controls"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Themes.DriveIn.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    controls:TopBar.ExtendsUnder="True"
    Background="{ThemeResource DriveInGroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="DriveInPoster" x:DataType="vm:BaseItemViewModel">
            <controls:BaseItemDtoCard
                Width="200"
                dc:DriveInRows.Nixie="True"
                BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Primary, 300)}"
                ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 300)}"
                Model="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="PageContent">
            <StackPanel>
                <!--  the marquee board over the backdrop  -->
                <dc:ItemStage
                    x:Name="Stage"
                    Dto="{x:Bind ViewModel.Dto, Mode=OneWay}"
                    LeftOf="{x:Bind local:DriveInSeasonPage.NextOf(ViewModel.Episodes), Mode=OneWay}">
                    <dc:ItemStage.PrimaryActions>
                        <Button
                            x:Name="PlayButton"
                            AutomationProperties.Name="{x:Bind ViewModel.PlayTarget.Name, Mode=OneWay}"
                            Command="{x:Bind root:App.Commands.PlayDtoCommand}"
                            CommandParameter="{x:Bind ViewModel.Dto, Mode=OneWay}"
                            Style="{StaticResource NixiePrimaryButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PlayTarget.Name, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE768;" />
                                <TextBlock Text="{x:Bind ViewModel.PlayTarget.Label, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </dc:ItemStage.PrimaryActions>
                </dc:ItemStage>

                <StackPanel x:Name="Body" Padding="96,8,96,56" Spacing="24">
                    <!--  SHOWTIMES: the marquee, the season tubes, the season's summary and its details link  -->
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <dc:MarqueeSign VerticalAlignment="Center" Text="Showtimes" />
                            <!--
                                Nixie 1.7.4 (the rows stream): the tubes get what the summary leaves of the width and scroll in it, with the
                                rows' arrows on hover (EdgeScroller): a long show's tubes ran off the window
                            -->
                            <controls:LeadPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="28">
                                <Grid
                                    VerticalAlignment="Center"
                                    ColumnSpacing="14"
                                    Visibility="{x:Bind c:ItemRowConverters.Show(ViewModel.SeasonPills.Count), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        CharacterSpacing="140"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource DriveInPageTextSecondaryBrush}"
                                        Text="SEASON" />
                                    <Grid x:Name="SeasonTubesHost" Grid.Column="1">
                                        <ScrollViewer
                                            x:Name="SeasonTubesScroller"
                                            AutomationProperties.Name="Seasons"
                                            HorizontalScrollBarVisibility="Hidden"
                                            HorizontalScrollMode="Enabled"
                                            IsTabStop="False"
                                            VerticalScrollBarVisibility="Disabled"
                                            VerticalScrollMode="Disabled">
                                            <ItemsControl
                                                x:Name="SeasonTubes"
                                                AutomationProperties.Name="Seasons"
                                                IsTabStop="False"
                                                ItemsSource="{x:Bind ViewModel.SeasonPills, Mode=OneWay}"
                                                TabFocusNavigation="Once"
                                                XYFocusKeyboardNavigation="Enabled">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="core:SeasonPill">
                                                        <Button
                                                            AutomationProperties.Name="{x:Bind AutomationName}"
                                                            Command="{x:Bind root:App.Commands.DisplayDtoCommand}"
                                                            CommandParameter="{x:Bind Dto}"
                                                            Style="{StaticResource DriveInSeasonTubeButtonStyle}"
                                                            ToolTipService.ToolTip="{x:Bind Name}">
                                                            <dc:SeasonTube Pill="{x:Bind}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <!--  the rows' arrows at the tubes' ends (EdgeScroller: shown on hover, each only while there is more that way)  -->
                                        <Button
                                            x:Name="SeasonTubesBack"
                                            Width="32"
                                            Height="32"
                                            Margin="4,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="RowBackButton"
                                            AutomationProperties.Name="Scroll Seasons left"
                                            IsTabStop="False"
                                            Style="{StaticResource NixieIconButtonStyle}"
                                            ToolTipService.ToolTip="Scroll left (or Shift+wheel, drag, Left key)"
                                            Visibility="Collapsed">
                                            <FontIcon FontSize="14" Glyph="&#xE76B;" />
                                        </Button>
                                        <Button
                                            x:Name="SeasonTubesNext"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="RowNextButton"
                                            AutomationProperties.Name="Scroll Seasons right"
                                            IsTabStop="False"
                                            Style="{StaticResource NixieIconButtonStyle}"
                                            ToolTipService.ToolTip="Scroll right (or Shift+wheel, drag, Right key)"
                                            Visibility="Collapsed">
                                            <FontIcon FontSize="14" Glyph="&#xE76C;" />
                                        </Button>
                                    </Grid>
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource DriveInPageTextSecondaryBrush}"
                                    Text="{x:Bind vm:DriveInItems.SeasonSummary(ViewModel.Episodes), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </controls:LeadPanel>
                        </Grid>

                        <!--  the board: the whole season, one Tab stop per episode  -->
                        <dc:LetterBoard
                            Padding="18,30,18,26"
                            HasSideBulbs="False"
                            RequestedTheme="Dark">
                            <StackPanel>
                                <dc:ShowtimesList
                                    x:Name="Showtimes"
                                    AutomationProperties.Name="Episodes"
                                    ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                                    Next="{x:Bind local:DriveInSeasonPage.NextOf(ViewModel.Episodes), Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="jm:BaseItemDto">
                                            <dc:Showtime Dto="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <dc:ShowtimesPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </dc:ShowtimesList>
                            </StackPanel>
                        </dc:LetterBoard>
                    </StackPanel>

                    <controls:ItemMetaRows Dto="{x:Bind ViewModel.Dto, Mode=OneWay}" />
                    <controls:CastRow Heading="Cast &amp; crew" People="{x:Bind ViewModel.Dto.People, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <controls:LoadStateView
            State="{x:Bind ViewModel.State}"
            VerticalContentAlignment="Center" />
    </Grid>
</Page>
