<?xml version="1.0" encoding="utf-8" ?>
<!--
    Drive-in: the Library. A letter-board header on a strip of the dusk sky (never behind the posters): the library's name on
    a large marquee, its count in nixie tubes ("312 FEATURES ON THE LOT"), the shared toolbar; then the A to Z as letter tiles
    (every letter, those no title starts with resting, dimmed and not a stop; on one row at any width); then the filters on,
    and the posters on the plain ground at their 2:3 at every width. Nixie 1.4.0: once the grid scrolls, the sky folds to a
    band (a compact marquee and tubes). The grid's keyboard and Narrator model, the jump, the sort and the filter are the
    shared Library's (LibraryViewModel, LibraryGridHost, CardGrid, BaseItemDtoCard).
-->
<Page
    x:Class="FluentFin.Themes.DriveIn.Views.DriveInLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:ctkl="using:CommunityToolkit.Labs.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dc="using:FluentFin.Themes.DriveIn.Controls"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Themes.DriveIn.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:views="using:FluentFin.Views"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    lc:TopBar.ExtendsUnder="True"
    Background="{ThemeResource DriveInGroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  the grid's poster (the card is the stop and the Narrator element), the list's row, and a placeholder in the poster's shape  -->
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:BaseItemViewModel">
            <ItemContainer
                AutomationProperties.AccessibilityView="Raw"
                CornerRadius="8"
                IsTabStop="False"
                Style="{StaticResource BareItemContainerStyle}">
                <lc:BaseItemDtoCard
                    dc:DriveInRows.Nixie="True"
                    BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Primary, 352)}"
                    ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 352)}"
                    Model="{x:Bind}" />
            </ItemContainer>
        </DataTemplate>
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:BaseItemViewModel">
            <ItemContainer
                AutomationProperties.AccessibilityView="Raw"
                IsTabStop="False"
                Style="{StaticResource BareItemContainerStyle}">
                <lc:LibraryListRow Model="{x:Bind}" />
            </ItemContainer>
        </DataTemplate>
        <DataTemplate x:Key="SkeletonCardTemplate">
            <Grid
                ui:VisualExtensions.NormalizedCenterPoint="0.5, 0.5"
                ui:VisualExtensions.Scale="0.9"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ctkl:Shimmer CornerRadius="8" />
                <StackPanel Grid.Row="1" Spacing="6">
                    <ctkl:Shimmer Width="130" Height="14" HorizontalAlignment="Left" CornerRadius="4" />
                    <ctkl:Shimmer Width="60" Height="12" HorizontalAlignment="Left" CornerRadius="4" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!--  Drive-in: the sort and filter buttons are the compact Secondary role on the letter board's sky  -->
        <Style
            x:Key="LibrarySortFilterButtonStyle"
            BasedOn="{StaticResource NixieCompactButtonStyle}"
            TargetType="Button" />
        <!--
            the letter board's tiles: a dark tile with a groove, the letter in the display face; a tile with no titles rests
            (dimmed, 4.5:1 still, not a stop); the keyboard's tile gets the system's two rings and the pink edge
        -->
        <Style x:Key="DriveInLetterTileStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="FocusVisualPrimaryThickness" Value="2" />
            <Setter Property="FocusVisualSecondaryThickness" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource DriveInBoardTextBrush}" />
            <Setter Property="Background" Value="{ThemeResource DriveInTileBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DriveInTileEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource DriveInDisplayFontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Tile"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Tile.BorderBrush" Value="{ThemeResource NixieAccentBrush}" />
                                            <Setter Target="Tile.BorderThickness" Value="1.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Tile.BorderBrush" Value="{ThemeResource NixieAccentBrush}" />
                                            <Setter Target="Tile.BorderThickness" Value="1.5" />
                                            <Setter Target="Tile.Opacity" Value="0.85" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Letter.Foreground" Value="{ThemeResource DriveInTileRestBrush}" />
                                            <Setter Target="Tile.BorderBrush" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <!--  Nixie 1.4.0: the letter in view (LetterBar sets it from its tile): the accent letter and edge  -->
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Letter.Foreground" Value="{ThemeResource NixieCurrentLetterForegroundBrush}" />
                                            <Setter Target="Tile.BorderBrush" Value="{ThemeResource NixieCurrentLetterForegroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <dc:BoardLines Pitch="6" />
                            <ContentPresenter
                                x:Name="Letter"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="LibraryRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  the header on its strip of sky (Nixie 1.4.0: it folds to a band once the grid scrolls)  -->
        <Grid x:Name="Header">
            <dc:DriveInScene x:Name="Sky" Layer="Back" />
            <Grid x:Name="HeaderContent" Padding="96,56,96,18" RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <dc:MarqueeSign
                        x:Name="TitleSign"
                        VerticalAlignment="Center"
                        Level="Level1"
                        Style="{StaticResource DriveInLargeMarqueeStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                    <StackPanel
                        x:Name="CountPanel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="{x:Bind views:LibraryPage.BarVisibility(ViewModel.State.Status), Mode=OneWay}">
                        <dc:NixieReadout
                            x:Name="CountTubes"
                            DigitHeight="40"
                            Spoken="{x:Bind ViewModel.CountText, Mode=OneWay}"
                            Text="{x:Bind vm:DriveInLibrary.CountTubes(ViewModel.TotalCount, ViewModel.IsLoading), Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            CharacterSpacing="140"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource DriveInHeaderTextBrush}"
                            Text="{x:Bind vm:DriveInLibrary.CountLabel(ViewModel.DriveInCollectionType), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!--  Nixie 1.4.0: the shared toolbar (Unwatched, Sort in words, the direction, Filter, View) in the compact role  -->
                    <lc:LibraryToolbar
                        x:Name="SortFilterBar"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ButtonStyle="{StaticResource LibrarySortFilterButtonStyle}"
                        ViewModel="{x:Bind ViewModel}"
                        Visibility="{x:Bind views:LibraryPage.BarVisibility(ViewModel.State.Status), Mode=OneWay}" />
                </Grid>

                <!--
                    Nixie 1.4.0 (item 13): the shared A to Z on the board's tiles: # and A to Z in one shape, the absent ones resting,
                    the letter in view marked, on one row at any width (the tiles narrow below 1300 px); under another sort, the
                    two directions; "M · 324 of 1,000" at its end. Its height is kept while loading.
                -->
                <Grid x:Name="LetterRow" Grid.Row="1" MinHeight="42">
                    <lc:LetterBar
                        x:Name="Letters"
                        LetterStyle="{StaticResource DriveInLetterTileStyle}"
                        MinTileWidth="28"
                        ReadoutBrush="{ThemeResource DriveInHeaderTextBrush}"
                        TileHeight="42"
                        TileSpacing="4"
                        TileWidth="38"
                        ViewModel="{x:Bind ViewModel}" />
                    <ctkl:Shimmer
                        x:Name="LetterPlaceholder"
                        Height="42"
                        HorizontalAlignment="Stretch"
                        CornerRadius="8"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Grid>

        <!--  Nixie 1.4.0 (item 2): what is filtered, on the plain ground under the sky  -->
        <lc:AppliedFilterRow
            x:Name="AppliedFilters"
            Grid.Row="1"
            Margin="96,16,96,0"
            ViewModel="{x:Bind ViewModel}" />

        <!--  the posters on the plain ground: the shared grid's model (CardGrid); letters typed on a poster go to its title  -->
        <ScrollView x:Name="GridScroller" Grid.Row="2" Padding="88,24,88,24">
            <lc:RowList
                x:Name="GridList"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                TabFocusNavigation="Once">
                <ItemsRepeater
                    x:Name="GridRepeater"
                    ItemTemplate="{StaticResource CardTemplate}"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <!--  Nixie 1.4.0 (the UX review's DI-M7): Uniform, so a poster keeps its 2:3 at every width (Fill cut 13 % at 1100)  -->
                        <UniformGridLayout
                            x:Name="GridLayout"
                            ItemsJustification="Start"
                            ItemsStretch="Uniform"
                            MinColumnSpacing="8"
                            MinItemHeight="372"
                            MinItemWidth="206"
                            MinRowSpacing="8"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </lc:RowList>
        </ScrollView>

        <!--  loading: placeholders laid out by a copy of the grid's own layout, where the posters will stand  -->
        <ItemsRepeater
            x:Name="SkeletonRepeater"
            Grid.Row="2"
            Margin="88,24,88,0"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            ItemTemplate="{StaticResource SkeletonCardTemplate}"
            ItemsSource="{x:Bind c:Converters.GetDummyItemSource(24)}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <UniformGridLayout x:Name="SkeletonLayout" Orientation="Horizontal" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>

        <!--  Nixie 1.4.0 (item 2): a filter that leaves nothing says so (the tubes read 0)  -->
        <lc:LibraryNoMatchesView Grid.Row="2" ViewModel="{x:Bind ViewModel}" />

        <lc:LoadStateView
            Grid.Row="2"
            State="{x:Bind ViewModel.State}"
            VerticalContentAlignment="Center" />
    </Grid>
</Page>
