<?xml version="1.0" encoding="utf-8" ?>
<!--
    Drive-in: the motel sign. A coral neon arrow, NOW SHOWING, points at the outdoor screen (a click shows the next feature);
    under it a letter board with bulbs lists what is coming up (Next Up): each entry is one button that plays it, named for
    Narrator ("Play A Signal in Winter, season 2, episode 1"), its menu the card's; the entries are one Tab stop with Up and
    Down between them. "All of Up next (9)" opens Continue Watching and Next Up as a grid. Always dark (a lit sign).
-->
<UserControl
    x:Class="FluentFin.Themes.DriveIn.Controls.ComingUpSign"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dc="using:FluentFin.Themes.DriveIn.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Canvas x:Name="Root">
        <!--  the arrow: a neon tube around a dark sign face, the words in coral neon  -->
        <Grid x:Name="Arrow" Tapped="Arrow_Tapped">
            <Path
                x:Name="ArrowFace"
                AutomationProperties.AccessibilityView="Raw"
                Fill="{ThemeResource DriveInSignFaceBrush}" />
            <Path
                x:Name="ArrowHalo"
                AutomationProperties.AccessibilityView="Raw"
                Opacity="0.18"
                Stroke="{ThemeResource DriveInNeonCoralBrush}"
                StrokeLineJoin="Round"
                StrokeThickness="12" />
            <Path
                x:Name="ArrowGlow"
                AutomationProperties.AccessibilityView="Raw"
                Opacity="0.45"
                Stroke="{ThemeResource DriveInNeonCoralBrush}"
                StrokeLineJoin="Round"
                StrokeThickness="5" />
            <Path
                x:Name="ArrowCore"
                AutomationProperties.AccessibilityView="Raw"
                Stroke="{ThemeResource DriveInNeonCoreBrush}"
                StrokeLineJoin="Round"
                StrokeThickness="2" />
            <!--  the letters and their one glow: the glow's host is exactly the letters' box  -->
            <Grid
                x:Name="ArrowWords"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False">
                <Grid x:Name="ArrowGlowHost" />
                <TextBlock
                    x:Name="ArrowText"
                    CharacterSpacing="140"
                    FontFamily="{StaticResource DriveInDisplayFontFamily}"
                    FontSize="42"
                    FontStretch="Condensed"
                    FontWeight="Light"
                    Foreground="{ThemeResource DriveInNeonTextBrush}"
                    Text="NOW SHOWING" />
            </Grid>
        </Grid>

        <dc:LetterBoard x:Name="Board" Padding="20,34,20,34">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="Heading"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    AutomationProperties.Name="Up next"
                    CharacterSpacing="200"
                    FontFamily="{StaticResource DriveInDisplayFontFamily}"
                    FontSize="26"
                    FontStretch="Condensed"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource DriveInBoardTextBrush}"
                    Text="UP NEXT" />
                <Border
                    Grid.Row="1"
                    Height="1"
                    Margin="10,0,10,10"
                    Background="{ThemeResource DriveInBoardRuleBrush}" />
                <StackPanel
                    x:Name="Entries"
                    Grid.Row="2"
                    AutomationProperties.Name="Up next"
                    Spacing="0"
                    TabFocusNavigation="Once"
                    XYFocusKeyboardNavigation="Enabled" />
                <HyperlinkButton
                    x:Name="AllLink"
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    Click="AllLink_Click"
                    Content="All of Up next"
                    Style="{StaticResource NixieLinkButtonStyle}" />
            </Grid>
        </dc:LetterBoard>
    </Canvas>
</UserControl>
