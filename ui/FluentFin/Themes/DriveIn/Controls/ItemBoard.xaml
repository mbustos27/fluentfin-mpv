<?xml version="1.0" encoding="utf-8" ?>
<!--
    Drive-in: the item pages' marquee board, opaque over the backdrop: the kicker (NOW SHOWING, or the series' name), the
    title (its logo, else the display face in capitals; the page's level-1 heading, named in the item's own words), the facts,
    the overview, then the page's Play (its one Primary) with the time left in nixie tubes, Trailer, Watched, Favourite, the
    item's menu and the journal's rating. The buttons and their names are the shared item pages' (ItemHero): "Mark <item> as
    watched", "Add <item> to favorites", "More options for <item>". Always dark (a lit board in both themes).
-->
<UserControl
    x:Class="FluentFin.Themes.DriveIn.Controls.ItemBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dc="using:FluentFin.Themes.DriveIn.Controls"
    xmlns:journal="using:FluentFin.Plugins.Journal.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <dc:LetterBoard x:Name="Board" Padding="40,40,40,36">
        <StackPanel x:Name="Words" Spacing="0">
            <TextBlock
                x:Name="KickerText"
                Margin="0,0,0,14"
                CharacterSpacing="200"
                FontFamily="{StaticResource DriveInDisplayFontFamily}"
                FontSize="22"
                FontStretch="Condensed"
                FontWeight="SemiBold"
                Foreground="{ThemeResource DriveInBoardTextBrush}"
                Text="NOW SHOWING"
                TextTrimming="CharacterEllipsis" />
            <Image
                x:Name="LogoImage"
                MaxWidth="520"
                MaxHeight="120"
                Margin="0,0,0,8"
                HorizontalAlignment="Left"
                AutomationProperties.HeadingLevel="Level1"
                Stretch="Uniform"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level1"
                CharacterSpacing="60"
                FontFamily="{StaticResource DriveInDisplayFontFamily}"
                FontSize="64"
                FontWeight="SemiBold"
                Foreground="#FFF4EE"
                LineHeight="66"
                LineStackingStrategy="BlockLineHeight"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="SubtitleText"
                Margin="0,6,0,0"
                AutomationProperties.HeadingLevel="Level2"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{ThemeResource DriveInBoardTextBrush}"
                TextTrimming="CharacterEllipsis"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="MetaText"
                Margin="0,12,0,0"
                FontSize="15"
                Foreground="{ThemeResource DriveInBoardTextSecondaryBrush}"
                TextWrapping="Wrap" />
            <controls:ExpandableText
                x:Name="OverviewText"
                MaxWidth="700"
                Margin="0,14,0,0"
                HorizontalAlignment="Left"
                CollapsedLines="2" />
            <ctk:WrapPanel
                x:Name="ButtonStrip"
                Margin="0,22,0,0"
                HorizontalSpacing="14"
                VerticalSpacing="12">
                <ContentPresenter x:Name="PrimaryPresenter" VerticalAlignment="Center" />
                <StackPanel
                    x:Name="LeftPanel"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <dc:NixieReadout x:Name="LeftTubes" DigitHeight="26" />
                    <TextBlock
                        x:Name="LeftUnit"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        CharacterSpacing="100"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource DriveInBoardTextSecondaryBrush}" />
                </StackPanel>
                <Button
                    x:Name="TrailerButton"
                    AutomationProperties.Name="Watch trailer"
                    Click="TrailerButton_Click"
                    Style="{StaticResource NixieButtonStyle}"
                    ToolTipService.ToolTip="Watch trailer"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="15" Glyph="&#xE714;" />
                        <TextBlock Text="Trailer" />
                    </StackPanel>
                </Button>
                <ToggleButton
                    x:Name="WatchedButton"
                    AutomationProperties.Name="Mark as watched"
                    Click="WatchedButton_Click"
                    Style="{StaticResource NixieIconToggleButtonStyle}"
                    ToolTipService.ToolTip="Mark as watched">
                    <FontIcon FontSize="18" Glyph="&#xE73E;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="FavoriteButton"
                    AutomationProperties.Name="Add to favorites"
                    Click="FavoriteButton_Click"
                    Style="{StaticResource NixieIconToggleButtonStyle}"
                    ToolTipService.ToolTip="Add to favorites">
                    <FontIcon x:Name="FavoriteGlyph" FontSize="18" Glyph="&#xEB51;" />
                </ToggleButton>
                <Button
                    x:Name="MoreButton"
                    AutomationProperties.Name="More options"
                    Style="{StaticResource NixieIconButtonStyle}"
                    ToolTipService.ToolTip="More options">
                    <FontIcon FontSize="18" Glyph="&#xE712;" />
                </Button>
                <Border
                    x:Name="RatingPill"
                    Height="44"
                    Padding="8,0"
                    Visibility="{x:Bind RatingPanel.Visibility, Mode=OneWay}">
                    <journal:JournalRatingPanel x:Name="RatingPanel" VerticalAlignment="Center" />
                </Border>
            </ctk:WrapPanel>
        </StackPanel>
    </dc:LetterBoard>
</UserControl>
