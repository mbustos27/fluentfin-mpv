<?xml version="1.0" encoding="utf-8" ?>
<!--
    Editorial: the sign-in page's backdrop (SignInBackdropTemplate; the shared form sits over it, in the window's middle):
    the night ground, the name in big condensed type on the left with the Googie arc under it and one line of what the app
    is, and the sunset's six bands along the foot. Decoration (the page's own heading is the form's); the shared LoginPage
    leaves it out in high contrast.
-->
<UserControl
    x:Class="FluentFin.Themes.Editorial.Controls.EditorialSignInBackdrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ec="using:FluentFin.Themes.Editorial.Controls"
    AutomationProperties.AccessibilityView="Raw"
    IsHitTestVisible="False"
    IsTabStop="False">

    <Grid Background="{ThemeResource EditorialGroundBrush}">
        <StackPanel
            x:Name="Words"
            Margin="96,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <TextBlock
                x:Name="NameText"
                CharacterSpacing="40"
                FontSize="200"
                LineHeight="190"
                LineStackingStrategy="BlockLineHeight"
                Style="{StaticResource EditorialBigTypeTextBlockStyle}"
                Text="NIXIE" />
            <ec:EditorialArc
                x:Name="Arc"
                Width="460"
                Margin="-6,8,0,0"
                HorizontalAlignment="Left" />
            <TextBlock
                x:Name="LineText"
                MaxWidth="460"
                Margin="0,26,0,0"
                HorizontalAlignment="Left"
                FontSize="22"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                LineHeight="32"
                Text="A Jellyfin client for Windows. Sign in with your Jellyfin account."
                TextWrapping="Wrap" />
        </StackPanel>
        <!--  the sunset's bands along the foot of the window  -->
        <Border
            Height="6"
            VerticalAlignment="Bottom"
            Background="{ThemeResource EditorialSunsetRuleBrush}" />
    </Grid>
</UserControl>
