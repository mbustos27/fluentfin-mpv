<?xml version="1.0" encoding="utf-8" ?>
<!--
    Editorial: an episode as a wide still (the season's 4 x 2 grid): the still with the episode's big number in the display
    face along its dark foot, the watched mark or the progress, the title, its facts ("52 min · 28 Mar 2022 · 44 min left")
    and two lines of synopsis. One keyboard stop; a click or Enter plays it (as an episode row does); the menu key or a right
    click opens its menu. Focus: the two-tone ring and the pink glow, and the play glyph (also on hover).
-->
<UserControl
    x:Class="FluentFin.Themes.Editorial.Controls.EditorialStill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="FocusGlow"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border CornerRadius="8">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="12"
                        CornerRadius="10"
                        Opacity="{ThemeResource EditorialGlowOpacity}"
                        Color="{ThemeResource NixieAccentColor}" />
                </ui:Effects.Shadow>
            </Border>
            <Border CornerRadius="8">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="36"
                        CornerRadius="10"
                        Opacity="{ThemeResource EditorialSoftGlowOpacity}"
                        Color="{ThemeResource GlassNeonGlowColor}" />
                </ui:Effects.Shadow>
            </Border>
        </Grid>

        <Grid
            x:Name="Art"
            Height="190"
            CornerRadius="8">
            <Border Background="{ThemeResource NixieDeepBrush}" CornerRadius="8">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="16"
                        CornerRadius="8"
                        Offset="0,6"
                        Opacity="0.4"
                        Color="Black" />
                </ui:Effects.Shadow>
            </Border>
            <Image
                x:Name="Picture"
                AutomationProperties.AccessibilityView="Raw"
                Stretch="UniformToFill" />
            <!--  the dark foot the number sits on (always dark: the still is artwork)  -->
            <Border AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.45" Color="#00000000" />
                        <GradientStop Offset="1" Color="#B3000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock
                x:Name="NumberText"
                Margin="14,0,0,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="{StaticResource EditorialDisplayFontFamily}"
                FontSize="64"
                FontStretch="Condensed"
                FontWeight="Light"
                Foreground="{ThemeResource EditorialStillNumberBrush}"
                LineHeight="64"
                LineStackingStrategy="BlockLineHeight" />
            <Border
                x:Name="WatchedMark"
                Width="24"
                Height="24"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                Background="{ThemeResource NixieAccentOnImageBrush}"
                CornerRadius="6"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource NixieOnAccentOnImageBrush}"
                    Glyph="&#xE73E;" />
            </Border>
            <Grid
                x:Name="ProgressTrack"
                Height="4"
                Margin="110,0,16,16"
                VerticalAlignment="Bottom"
                AutomationProperties.AccessibilityView="Raw"
                Background="#A6000000"
                CornerRadius="2"
                Visibility="Collapsed">
                <Border
                    x:Name="ProgressFill"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource NixieAccentOnImageBrush}"
                    CornerRadius="2" />
            </Grid>
            <!--  the play glyph on focus and hover: a dark rounded square with a light edge (decorative: the still itself plays)  -->
            <Border
                x:Name="PlayGlyph"
                RequestedTheme="Dark"
                Width="56"
                Height="56"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Background="#99140610"
                BorderBrush="#5CFFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Opacity="0">
                <FontIcon
                    FontSize="22"
                    Foreground="{ThemeResource GlassTextPrimaryBrush}"
                    Glyph="&#xE768;" />
            </Border>
            <Border
                AutomationProperties.AccessibilityView="Raw"
                BorderBrush="{ThemeResource EditorialArtStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False" />
        </Grid>

        <Border
            x:Name="FocusRing"
            Height="198"
            Margin="-4"
            VerticalAlignment="Top"
            BorderBrush="{ThemeResource EditorialFocusOuterBrush}"
            BorderThickness="2"
            CornerRadius="12"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                BorderBrush="{ThemeResource EditorialFocusInnerBrush}"
                BorderThickness="2"
                CornerRadius="10" />
        </Border>

        <StackPanel Grid.Row="1" Padding="0,10,0,0">
            <TextBlock
                x:Name="TitleText"
                FontFamily="{StaticResource GlassDisplayFontFamily}"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlassTextPrimaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="MetaText"
                Margin="0,2,0,0"
                FontSize="13"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="SynopsisText"
                Margin="0,6,0,0"
                FontSize="14"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                LineHeight="20"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
