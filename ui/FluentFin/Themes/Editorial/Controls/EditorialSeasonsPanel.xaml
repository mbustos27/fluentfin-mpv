<?xml version="1.0" encoding="utf-8" ?>
<!--
    Editorial: the Seasons panel, a series' seasons at a glance: each with its number in nixie orange, its year and episode
    count, and how much of it is watched ("2 of 8 watched" and a bar, "Not started", "New · Not started"). A section panel
    over the backdrop (glass: GlassPanelStrongBrush, opaque in Solid). One Tab stop, Up/Down between the seasons; Narrator
    reads a tab list ("Season 1, 2 of 8 watched, selected, 1 of 3"); a pick shows that season's episodes.
-->
<UserControl
    x:Class="FluentFin.Themes.Editorial.Controls.EditorialSeasonsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ec="using:FluentFin.Themes.Editorial.Controls"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    IsTabStop="False">

    <UserControl.Resources>
        <DataTemplate x:Key="SeasonLineTemplate" x:DataType="vm:EditorialSeasonLine">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="30"
                    Style="{StaticResource EditorialNumberTextBlockStyle}"
                    Text="{x:Bind Number}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GlassTextPrimaryBrush}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource GlassTextSecondaryBrush}"
                        Text="{x:Bind Meta}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="13"
                        Foreground="{ThemeResource GlassTextSecondaryBrush}"
                        Text="{x:Bind Progress}"
                        TextTrimming="CharacterEllipsis" />
                    <Grid
                        Width="120"
                        Height="3"
                        HorizontalAlignment="Right"
                        Background="{ThemeResource EditorialChipStrokeBrush}"
                        CornerRadius="1.5"
                        Visibility="{x:Bind HasFraction}">
                        <Border
                            Width="{x:Bind ec:EditorialSeasonsPanel.BarWidth(Fraction, 120)}"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource NixieAccentBrush}"
                            CornerRadius="1.5" />
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--  a season line: a tab; hover a faint fill; picked: the accent's wash and a 3 px accent bar on the left  -->
        <Style x:Key="SeasonLineStyle" TargetType="ec:EditorialTabButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="62" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ec:EditorialTabButton">
                        <Grid>
                            <Border
                                x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <Border
                                x:Name="Bar"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource NixieAccentBrush}"
                                CornerRadius="1.5"
                                Opacity="0" />
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{ThemeResource EditorialRowHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{ThemeResource EditorialRowSelectedBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{ThemeResource EditorialRowSelectedBrush}" />
                                            <Setter Target="Bar.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="Panel"
        Padding="12,16,12,12"
        Background="{ThemeResource GlassPanelStrongBrush}"
        BorderBrush="{ThemeResource GlassStrokeBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="6">
            <Grid Margin="14,0,14,4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    CharacterSpacing="100"
                    FontSize="22"
                    Style="{StaticResource EditorialBigTypeTextBlockStyle}"
                    Text="SEASONS" />
                <TextBlock
                    x:Name="WatchedText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource GlassTextSecondaryBrush}" />
            </Grid>
            <ec:EditorialTabList
                x:Name="Tabs"
                AutomationProperties.Name="Seasons"
                Orientation="Vertical">
                <StackPanel x:Name="Lines" Spacing="2" />
            </ec:EditorialTabList>
        </StackPanel>
    </Border>
</UserControl>
