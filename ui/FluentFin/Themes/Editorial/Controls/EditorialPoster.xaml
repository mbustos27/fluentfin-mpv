<?xml version="1.0" encoding="utf-8" ?>
<!--
    Editorial: a dense poster (144 px wide at 1920, 122 at 1100): opaque 2:3 artwork with 8 px corners and a faint lit edge,
    the title and one line of facts under it. 1.4.0 (the library UX review, X9, X10, E-M8): watched a dim neutral check, top
    right; "N to watch" a neutral square count, top left; in progress the accent on a dark track along the foot. Keyboard
    focus: the two-tone ring (the neon core's near-white around the deep colour) and a small lift of the art in Full mode,
    no pink glow. A free pointer lifts it; a pointer while the keyboard is on another card only brightens it. Opened: the
    accent rim and a notch under it pointing at the details below the row, never the keyboard's ring. A click or Enter
    opens the details in place (EditorialDetailsHost); the menu key or a right click opens the item's menu.
-->
<UserControl
    x:Class="FluentFin.Themes.Editorial.Controls.EditorialPoster"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  1.6 colpage: the list form adds three columns (art, words, state; EditorialPoster.ApplyForm); the poster has none  -->


        <Grid x:Name="Art" CornerRadius="8">
            <!--  the shadow under the artwork (opaque, so nothing shows through)  -->
            <Border x:Name="ShadowHost" Background="{ThemeResource NixieDeepBrush}" CornerRadius="8">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        x:Name="ArtShadow"
                        BlurRadius="16"
                        CornerRadius="8"
                        Offset="0,6"
                        Opacity="0.4"
                        Color="Black" />
                </ui:Effects.Shadow>
            </Border>
            <controls:LazyLoadedImage x:Name="Picture" EnableBlurHash="True" />
            <!--  1.4.0: a pointer over a poster while the keyboard is on another card brightens it, nothing more  -->
            <Border
                x:Name="HoverBrighten"
                Background="{ThemeResource NixieCardHoverOverlayBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            <!--  1.4.0 (X10, E-m4): "N to watch" a neutral square count, top left; watched a dim neutral check, top right  -->
            <Border x:Name="CountChip" Style="{StaticResource NixieCountChipStyle}" Visibility="Collapsed">
                <TextBlock x:Name="CountText" Style="{StaticResource NixieCountChipTextStyle}" />
            </Border>
            <Border x:Name="WatchedMark" Style="{StaticResource NixieWatchedBadgeStyle}" Visibility="Collapsed">
                <FontIcon Style="{StaticResource NixieWatchedGlyphStyle}" />
            </Border>
            <!--  in progress: the accent on a dark track as tall as the bar, along the foot  -->
            <Grid
                x:Name="ProgressTrack"
                Height="4"
                Margin="10,0,10,10"
                VerticalAlignment="Bottom"
                AutomationProperties.AccessibilityView="Raw"
                Background="#A6000000"
                CornerRadius="2"
                Visibility="Collapsed">
                <Border
                    x:Name="ProgressFill"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource NixieAccentOnImageBrush}"
                    CornerRadius="2" />
            </Grid>
            <Border
                AutomationProperties.AccessibilityView="Raw"
                BorderBrush="{ThemeResource EditorialArtStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False" />
        </Grid>

        <!--
            1.4.0 (the library UX review, E-M8): opened is its own mark, the accent rim (1.5 px, the current place) and the notch,
            never the keyboard's ring, so an open poster and the focused one never look alike
        -->
        <Border
            x:Name="OpenRim"
            Margin="-3"
            VerticalAlignment="Top"
            BorderBrush="{ThemeResource NixieOpenRimBrush}"
            BorderThickness="1.5"
            CornerRadius="11"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!--  the ring: the outer near-white line around a deep one, 1 px outside the artwork  -->
        <Border
            x:Name="FocusRing"
            Margin="-4"
            BorderBrush="{ThemeResource EditorialFocusOuterBrush}"
            BorderThickness="2"
            CornerRadius="12"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                BorderBrush="{ThemeResource EditorialFocusInnerBrush}"
                BorderThickness="2"
                CornerRadius="10" />
        </Border>

        <!--  opened: a notch under the poster, in the details panel's colour, pointing at the panel  -->
        <Path
            x:Name="Notch"
            Grid.Row="1"
            Margin="0,0,0,-26"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AccessibilityView="Raw"
            Data="M0,12 L12,0 L24,12 Z"
            Fill="{ThemeResource EditorialPanelBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!--  1.6 colpage: the list form's row behind it (its hover and its ring take the whole line)  -->
        <Border
            x:Name="ListBack"
            Grid.ColumnSpan="3"
            Margin="-12,-8"
            Background="Transparent"
            CornerRadius="8"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="TitleArea"
            Grid.Row="1"
            Padding="1,8,1,0"
            Spacing="1">
            <TextBlock
                x:Name="TitleText"
                FontFamily="{StaticResource GlassTextFontFamily}"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource GlassTextPrimaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="MetaText"
                FontFamily="{StaticResource GlassTextFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource GlassTextSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <!--  1.6 colpage: the list form's short line (the overview's first sentence)  -->
            <TextBlock
                x:Name="ShortText"
                Margin="0,4,0,0"
                FontFamily="{StaticResource GlassTextFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource GlassTextPrimaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="Collapsed" />
        </StackPanel>

        <!--  1.6 colpage: the list form's state at the line's end ("Watched", "45% watched", "5 left"), in the kicker's peach  -->
        <TextBlock
            x:Name="StateText"
            Grid.Column="2"
            Margin="16,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource EditorialKickerTextBlockStyle}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
