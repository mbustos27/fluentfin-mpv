<?xml version="1.0" encoding="utf-8" ?>
<!--
    Editorial: the Googie arc, its one ornament: a coral swash that rises gently left to right and ends in a four-point
    sparkle, under a big heading (the Library's "MOVIES", the sign-in's "NIXIE"). Vector, scales with Width; decoration
    only (Narrator skips it). High contrast: the window text colour, no glow.
-->
<UserControl
    x:Class="FluentFin.Themes.Editorial.Controls.EditorialArc"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsHitTestVisible="False"
    IsTabStop="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="560" Height="40">
            <!--  the swash: pointed at the left, fullest a third of the way, thinning into the sparkle (art pass 2: the echo line under it read as a scratch and went)  -->
            <Path
                Data="M 2,35 C 110,24 300,11 512,14 C 300,17.5 130,30 2,35 Z"
                Fill="{ThemeResource EditorialArcBrush}"
                Opacity="0.9" />
            <!--  the sparkle: four points with curved sides, at the swash's end  -->
            <Path
                Canvas.Left="499"
                Canvas.Top="-1"
                Data="M 15,0 C 16.3,10.5 19.5,13.7 30,15 C 19.5,16.3 16.3,19.5 15,30 C 13.7,19.5 10.5,16.3 0,15 C 10.5,13.7 13.7,10.5 15,0 Z"
                Fill="{ThemeResource EditorialSparkBrush}" />
            <Ellipse
                Canvas.Left="511"
                Canvas.Top="11"
                Width="6"
                Height="6"
                Fill="{ThemeResource EditorialArcBrush}"
                Opacity="0.55" />
        </Canvas>
    </Viewbox>
</UserControl>
