<?xml version="1.0" encoding="utf-8" ?>
<!--
    Editorial: a whole season at once, as a grid of stills with their synopses (four across at 1920, all eight of a usual
    season in one view; three across from 1000 px, two below). Its heading ("Season 1", "8 episodes · 6 h 12 m") with
    Hide watched and the order on its right. One Tab stop (landing on the first episode not watched), the arrows move in
    the grid, Enter plays; Narrator reads a list "Episodes of Season 1", each still "S1 E3 Sawdust, 15% watched", "3 of 8".
-->
<UserControl
    x:Class="FluentFin.Themes.Editorial.Controls.EditorialEpisodeGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ec="using:FluentFin.Themes.Editorial.Controls"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    IsTabStop="False">

    <StackPanel Spacing="14">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Bottom"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource EditorialShelfTitleTextBlockStyle}" />
            <TextBlock
                x:Name="CaptionText"
                Grid.Column="1"
                Margin="0,0,0,5"
                VerticalAlignment="Bottom"
                Style="{StaticResource EditorialCaptionTextBlockStyle}" />
            <Button
                x:Name="HideWatchedButton"
                Grid.Column="2"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Hide watched episodes"
                Click="HideWatchedButton_Click"
                Content="Hide watched"
                Style="{StaticResource NixieCompactButtonStyle}" />
            <Button
                x:Name="OrderButton"
                Grid.Column="3"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Order: oldest first, switch to newest first"
                Click="OrderButton_Click"
                Style="{StaticResource NixieCompactButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                    <TextBlock x:Name="OrderText" Text="Oldest first" />
                </StackPanel>
            </Button>
        </Grid>

        <lc:RowList
            x:Name="List"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="Episodes"
            TabFocusNavigation="Once"
            XYFocusKeyboardNavigation="Enabled">
            <ItemsRepeater x:Name="Repeater">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="jm:BaseItemDto">
                        <ec:EditorialStill Episode="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <ec:EditorialColumnsLayout
                        x:Name="GridLayout"
                        ColumnSpacing="40"
                        Columns="4"
                        RowSpacing="26" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </lc:RowList>

        <TextBlock
            x:Name="EmptyText"
            Foreground="{ThemeResource GlassTextSecondaryBrush}"
            Text="Every episode of this season is watched. Show watched to see them."
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
