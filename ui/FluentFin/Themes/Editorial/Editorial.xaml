<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.3.0, the Editorial theme's dictionary (EditorialTheme.Dictionary): the keys every theme defines (TopBarStyle,
    RowHeaderTemplate, PosterTemplate, StillTemplate, PageHeaderStyle, SignInBackdropTemplate) and Editorial's own, each
    prefixed "Editorial". The look: a dense magazine on the night ground, the sunset rule under the bar, big condensed display
    type for the headings, nixie orange for the numbers you read, hot pink only on what you can act on. Colours come from the
    concept's sources (docs\reports\Nixie redesign concepts\Editorial\src); each text colour keeps 4.5:1 on its ground
    (EditorialThemeTests measures them). High contrast: the system colours, no glow, no gradient.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ec="using:FluentFin.Themes.Editorial.Controls"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/Editorial/Cards.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!--  the page's ground: the concept's night (#160610), opaque (content; the window's backdrop does not show through)  -->
            <SolidColorBrush x:Key="EditorialGroundBrush" Color="#160610" />
            <Color x:Key="EditorialGroundColor">#160610</Color>
            <!--  the top bar's night tint over the shared glass: the concept's denser bar  -->
            <SolidColorBrush x:Key="EditorialTopBarTintBrush" Color="#8C160610" />
            <!--  an item page's backdrop: held back from the left (the words sit on 82 % to 95 % night) and faded into the ground  -->
            <LinearGradientBrush x:Key="EditorialItemScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#F2160610" />
                <GradientStop Offset="0.4" Color="#D1160610" />
                <GradientStop Offset="0.7" Color="#4D160610" />
                <GradientStop Offset="1" Color="#33160610" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EditorialItemFadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.55" Color="#00160610" />
                <GradientStop Offset="1" Color="#FF160610" />
            </LinearGradientBrush>
            <!--  an opaque panel on the ground: the details in place, the Seasons panel, the paused column  -->
            <SolidColorBrush x:Key="EditorialPanelBrush" Color="#2A0C18" />
            <Color x:Key="EditorialPanelColor">#2A0C18</Color>
            <Color x:Key="EditorialPanelClearColor">#002A0C18</Color>
            <LinearGradientBrush x:Key="EditorialPanelStrokeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#2EFFDCD2" />
                <GradientStop Offset="0.25" Color="#12FFFFFF" />
                <GradientStop Offset="1" Color="#0DFFFFFF" />
            </LinearGradientBrush>
            <!--  numbers you read: nixie orange (10.6:1 on the ground)  -->
            <SolidColorBrush x:Key="EditorialNumberBrush" Color="#FFC2AE" />
            <!--  the kicker over a heading ("TONIGHT", "SERIES · 3 SEASONS"): peach (8.9:1)  -->
            <SolidColorBrush x:Key="EditorialKickerBrush" Color="#F7AA9C" />
            <!--  what is left to watch, bold at the end of a meta line  -->
            <SolidColorBrush x:Key="EditorialHighlightTextBrush" Color="#FFD7C4" />
            <!--  the lit genre; its tube is the accent  -->
            <SolidColorBrush x:Key="EditorialLitTextBrush" Color="#FFEFF2" />
            <!--  a chip: a faint fill and edge; picked: the accent's wash and rim  -->
            <SolidColorBrush x:Key="EditorialChipFillBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="EditorialChipStrokeBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="EditorialChipSelectedFillBrush" Color="#29F96985" />
            <SolidColorBrush x:Key="EditorialChipSelectedTextBrush" Color="#FFE3E8" />
            <!--  a hover row (Up next, the Seasons panel)  -->
            <SolidColorBrush x:Key="EditorialRowHoverBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="EditorialRowSelectedBrush" Color="#1FF96985" />
            <!--  the poster's edge: a faint inner line, lit along the top  -->
            <LinearGradientBrush x:Key="EditorialArtStrokeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#29FFFFFF" />
                <GradientStop Offset="0.2" Color="#1FFFFFFF" />
                <GradientStop Offset="1" Color="#14FFFFFF" />
            </LinearGradientBrush>
            <!--  the two-tone focus ring of a card (WinUI's rings for every other control use the same colours)  -->
            <SolidColorBrush x:Key="EditorialFocusOuterBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="EditorialFocusInnerBrush" Color="#170508" />
            <!--  the hero tile's scrim, left to right: text always on the night  -->
            <LinearGradientBrush x:Key="EditorialHeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#EB160610" />
                <GradientStop Offset="0.38" Color="#B3160610" />
                <GradientStop Offset="0.68" Color="#00160610" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EditorialHeroBottomScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.55" Color="#00160610" />
                <GradientStop Offset="1" Color="#99160610" />
            </LinearGradientBrush>
            <!--  the details panel's artwork fades into the panel from the left  -->
            <LinearGradientBrush x:Key="EditorialPanelArtFadeBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#FF2A0C18" />
                <GradientStop Offset="0.3" Color="#992A0C18" />
                <GradientStop Offset="0.6" Color="#002A0C18" />
            </LinearGradientBrush>
            <!--  the sunset rule under the top bar: maroon to peach in hard steps. 1.4.0 (E-m8): no hot-pink band; the accent marks only what you act on  -->
            <LinearGradientBrush x:Key="EditorialSunsetRuleBrush" StartPoint="0,0" EndPoint="1,0" Opacity="0.9">
                <GradientStop Offset="0" Color="#500723" />
                <GradientStop Offset="0.14" Color="#500723" />
                <GradientStop Offset="0.14" Color="#BC1E47" />
                <GradientStop Offset="0.30" Color="#BC1E47" />
                <GradientStop Offset="0.30" Color="#E6385F" />
                <GradientStop Offset="0.46" Color="#E6385F" />
                <GradientStop Offset="0.46" Color="#EC6A79" />
                <GradientStop Offset="0.70" Color="#EC6A79" />
                <GradientStop Offset="0.70" Color="#F7AA9C" />
                <GradientStop Offset="1" Color="#F7AA9C" />
            </LinearGradientBrush>
            <!--  the Googie arc: a coral swash with a sparkle at its end (decoration only)  -->
            <SolidColorBrush x:Key="EditorialArcBrush" Color="#EC6A79" />
            <SolidColorBrush x:Key="EditorialSparkBrush" Color="#FFF4EE" />
            <!--  a still's big episode number: the nixie orange, on the still's dark foot  -->
            <SolidColorBrush x:Key="EditorialStillNumberBrush" Color="#FFC2AE" />
            <x:Double x:Key="EditorialGlowOpacity">0.85</x:Double>
            <x:Double x:Key="EditorialSoftGlowOpacity">0.45</x:Double>
            <!--  1.4.0 style: a pressed row is the hover fill one step on, never the selected wash  -->
            <SolidColorBrush x:Key="EditorialRowPressedBrush" Color="#0AFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!--  "noon": a pale peach ground, deep maroon text; numbers and kickers in deep sunset colours (4.5:1 or more)  -->
            <SolidColorBrush x:Key="EditorialGroundBrush" Color="#FFF6F3" />
            <Color x:Key="EditorialGroundColor">#FFF6F3</Color>
            <SolidColorBrush x:Key="EditorialTopBarTintBrush" Color="#8CFFF6F3" />
            <LinearGradientBrush x:Key="EditorialItemScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#F5FFF6F3" />
                <GradientStop Offset="0.4" Color="#E0FFF6F3" />
                <GradientStop Offset="0.7" Color="#66FFF6F3" />
                <GradientStop Offset="1" Color="#4DFFF6F3" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EditorialItemFadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.55" Color="#00FFF6F3" />
                <GradientStop Offset="1" Color="#FFFFF6F3" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EditorialPanelBrush" Color="#FCE8E4" />
            <Color x:Key="EditorialPanelColor">#FCE8E4</Color>
            <Color x:Key="EditorialPanelClearColor">#00FCE8E4</Color>
            <LinearGradientBrush x:Key="EditorialPanelStrokeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.3" Color="#24500723" />
                <GradientStop Offset="1" Color="#1F500723" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EditorialNumberBrush" Color="#A33A12" />
            <SolidColorBrush x:Key="EditorialKickerBrush" Color="#A3283F" />
            <SolidColorBrush x:Key="EditorialHighlightTextBrush" Color="#7A102D" />
            <SolidColorBrush x:Key="EditorialLitTextBrush" Color="#24060F" />
            <SolidColorBrush x:Key="EditorialChipFillBrush" Color="#0A500723" />
            <SolidColorBrush x:Key="EditorialChipStrokeBrush" Color="#2E500723" />
            <SolidColorBrush x:Key="EditorialChipSelectedFillBrush" Color="#1FBC1E47" />
            <SolidColorBrush x:Key="EditorialChipSelectedTextBrush" Color="#7A102D" />
            <SolidColorBrush x:Key="EditorialRowHoverBrush" Color="#0F500723" />
            <SolidColorBrush x:Key="EditorialRowSelectedBrush" Color="#1ABC1E47" />
            <LinearGradientBrush x:Key="EditorialArtStrokeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#40FFFFFF" />
                <GradientStop Offset="0.2" Color="#1F000000" />
                <GradientStop Offset="1" Color="#29000000" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EditorialFocusOuterBrush" Color="#BC1E47" />
            <SolidColorBrush x:Key="EditorialFocusInnerBrush" Color="#FFFFFF" />
            <!--  the hero tile and the paused column stay dark (RequestedTheme Dark): these are the light theme's copies for any other text on art  -->
            <LinearGradientBrush x:Key="EditorialHeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#EB160610" />
                <GradientStop Offset="0.38" Color="#B3160610" />
                <GradientStop Offset="0.68" Color="#00160610" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EditorialHeroBottomScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.55" Color="#00160610" />
                <GradientStop Offset="1" Color="#99160610" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EditorialPanelArtFadeBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#FFFCE8E4" />
                <GradientStop Offset="0.3" Color="#B3FCE8E4" />
                <GradientStop Offset="0.62" Color="#00FCE8E4" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EditorialSunsetRuleBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#500723" />
                <GradientStop Offset="0.14" Color="#500723" />
                <GradientStop Offset="0.14" Color="#BC1E47" />
                <GradientStop Offset="0.30" Color="#BC1E47" />
                <GradientStop Offset="0.30" Color="#E6385F" />
                <GradientStop Offset="0.46" Color="#E6385F" />
                <GradientStop Offset="0.46" Color="#EC6A79" />
                <GradientStop Offset="0.70" Color="#EC6A79" />
                <GradientStop Offset="0.70" Color="#F7AA9C" />
                <GradientStop Offset="1" Color="#F7AA9C" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EditorialArcBrush" Color="#E6385F" />
            <SolidColorBrush x:Key="EditorialSparkBrush" Color="#BC1E47" />
            <SolidColorBrush x:Key="EditorialStillNumberBrush" Color="#FFC2AE" />
            <x:Double x:Key="EditorialGlowOpacity">0.35</x:Double>
            <x:Double x:Key="EditorialSoftGlowOpacity">0.2</x:Double>
            <!--  1.4.0 style: a pressed row is the hover fill one step on, never the selected wash  -->
            <SolidColorBrush x:Key="EditorialRowPressedBrush" Color="#17500723" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EditorialGroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <StaticResource x:Key="EditorialGroundColor" ResourceKey="SystemColorWindowColor" />
            <SolidColorBrush x:Key="EditorialTopBarTintBrush" Color="Transparent" />
            <SolidColorBrush x:Key="EditorialItemScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EditorialItemFadeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="EditorialPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <StaticResource x:Key="EditorialPanelColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="EditorialPanelClearColor" ResourceKey="SystemColorWindowColor" />
            <SolidColorBrush x:Key="EditorialPanelStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EditorialNumberBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EditorialKickerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EditorialHighlightTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EditorialLitTextBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EditorialChipFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EditorialChipStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="EditorialChipSelectedFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EditorialChipSelectedTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EditorialRowHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EditorialRowSelectedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EditorialArtStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EditorialFocusOuterBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EditorialFocusInnerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EditorialHeroScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EditorialHeroBottomScrimBrush" Color="Transparent" />
            <SolidColorBrush x:Key="EditorialPanelArtFadeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EditorialSunsetRuleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EditorialArcBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EditorialSparkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EditorialStillNumberBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <x:Double x:Key="EditorialGlowOpacity">0</x:Double>
            <x:Double x:Key="EditorialSoftGlowOpacity">0</x:Double>
            <!--  1.4.0 style  -->
            <SolidColorBrush x:Key="EditorialRowPressedBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  type: Segoe UI Variable for everything read; the one display face (condensed) for the big fixed headings and numbers  -->
    <FontFamily x:Key="EditorialDisplayFontFamily">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>

    <!--  the page's side margin: 56 at 1920, 40 at 1100 (the views switch it with the window's width)  -->
    <x:Double x:Key="EditorialWideMargin">56</x:Double>
    <x:Double x:Key="EditorialNarrowMargin">40</x:Double>
    <x:Double x:Key="EditorialNarrowWidth">1400</x:Double>
    <CornerRadius x:Key="EditorialCornerRadius">8</CornerRadius>

    <Style x:Key="EditorialKickerTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassTextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{ThemeResource EditorialKickerBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!--  the condensed display face, for "TONIGHT", "UP NEXT", "SEASONS", "MOVIES"  -->
    <Style x:Key="EditorialBigTypeTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EditorialDisplayFontFamily}" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="10" />
        <Setter Property="LineHeight" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!--  the numbers you read (Up next's 01, a season's 02): the display face, light, nixie orange  -->
    <Style x:Key="EditorialNumberTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EditorialDisplayFontFamily}" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource EditorialNumberBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="EditorialHeroTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassDisplayFontFamily}" />
        <Setter Property="FontSize" Value="58" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="LineHeight" Value="60" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!--  a shelf's or a section's title: "Sci-fi", "Season 1"  -->
    <Style x:Key="EditorialShelfTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassDisplayFontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="EditorialCaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassTextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="EditorialMetaTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassTextFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="EditorialBodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassTextFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  the required key: a page's big heading ("MOVIES", a series' title)  -->
    <Style x:Key="PageHeaderStyle" BasedOn="{StaticResource EditorialBigTypeTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="88" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="20" />
    </Style>

    <!--
        1.4.0 style (the library UX review, X13): icon buttons are the system's 44 circles in every theme, Editorial too (its
        rounded squares were the one exception, and the player's transport is round everywhere). The keys stay for its pages.
    -->
    <Style x:Key="EditorialIconButtonStyle" BasedOn="{StaticResource NixieIconButtonStyle}" TargetType="Button" />
    <Style x:Key="EditorialIconToggleButtonStyle" BasedOn="{StaticResource NixieIconToggleButtonStyle}" TargetType="ToggleButton" />

    <!--
        the genre strip's tabs: big type, the text secondary; the lit one bright with the accent's tube under it (and its glow);
        hover: the text bright (1.4.0: no faint line where the underline goes; hover and the lit tab differ in kind, not hue).
        Keyboard focus: WinUI's two rings (FocusVisualMargin keeps them off the text).
    -->
    <Style x:Key="EditorialGenreTabStyle" TargetType="ec:EditorialTabButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
        <Setter Property="Padding" Value="2,4,2,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="{StaticResource GlassDisplayFontFamily}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-6,-2,-6,-2" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ec:EditorialTabButton">
                    <Grid Padding="{TemplateBinding Padding}" Background="Transparent">
                        <Border
                            x:Name="Glow"
                            Height="3"
                            Margin="0,0,0,-6"
                            VerticalAlignment="Bottom"
                            CornerRadius="1.5"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <ui:Effects.Shadow>
                                <media:AttachedCardShadow
                                    BlurRadius="10"
                                    CornerRadius="2"
                                    Opacity="{ThemeResource EditorialGlowOpacity}"
                                    Color="{ThemeResource NixieAccentColor}" />
                            </ui:Effects.Shadow>
                        </Border>
                        <Border
                            x:Name="HoverLine"
                            Height="2"
                            Margin="0,0,0,-6"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource NixieTabHoverLineBrush}"
                            CornerRadius="1"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border
                            x:Name="Underline"
                            Height="3"
                            Margin="0,0,0,-6"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource NixieAccentBrush}"
                            CornerRadius="1.5"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="Label"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            TextWrapping="NoWrap" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{ThemeResource NixieDisabledForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{ThemeResource EditorialLitTextBrush}" />
                                        <Setter Target="Underline.Opacity" Value="1" />
                                        <Setter Target="Glow.Opacity" Value="1" />
                                        <Setter Target="HoverLine.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        a genre chip with a count: "Drama 84", single-select. 1.4.0 style (E-m6): 32 high (the Compact size; 34 was a third
        height), radius 8; picked: the neutral plate and its edge (never the accent, which marks only the current place), so it
        never looks like a switch that is on (EditorialToggleChipStyle: its check glyph)
    -->
    <Style x:Key="EditorialChipStyle" TargetType="ec:EditorialTabButton">
        <Setter Property="Background" Value="{ThemeResource EditorialChipFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EditorialChipStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="{StaticResource NixieCompactButtonHeight}" />
        <Setter Property="Height" Value="{StaticResource NixieCompactButtonHeight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassButtonCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ec:EditorialTabButton">
                    <Grid>
                        <Border
                            x:Name="Backplate"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="Overlay" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter
                            x:Name="Label"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Background" Value="{ThemeResource NixieHoverOverlayBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Background" Value="{ThemeResource NixiePressedOverlayBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{ThemeResource NixieDisabledForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Backplate.Background" Value="{ThemeResource NixieChipSelectedFillBrush}" />
                                        <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieChipSelectedBorderBrush}" />
                                        <Setter Target="Backplate.BorderThickness" Value="1.5" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource NixieChipSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        a chip that is a switch (Unwatched, Favourites). 1.4.0 style (E-m6): the shared switch chip (NixieChipToggleButtonStyle,
        32, radius 8): on, its check glyph shows before the words over the neutral plate, so it never reads as a picked genre
    -->
    <Style
        x:Key="EditorialToggleChipStyle"
        BasedOn="{StaticResource NixieChipToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource EditorialChipFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EditorialChipStrokeBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!--
        the required keys. TopBarStyle: the shared top bar (TopBarChrome), denser than the shared glass (a night tint over
        it), with the sunset rule along its foot: the theme's mark on every page, shared ones too. Over a page whose
        artwork runs under the bar (OverHero) the shared dark scrim, and the rule stays. High contrast: no tint, the rule
        the system highlight.
    -->
    <Style x:Key="TopBarStyle" TargetType="lc:TopBarChrome">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="lc:TopBarChrome">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="BarStates">
                                <VisualState x:Name="OverContent" />
                                <VisualState x:Name="OverHero">
                                    <VisualState.Setters>
                                        <Setter Target="BarGlass.Visibility" Value="Collapsed" />
                                        <Setter Target="BarTint.Visibility" Value="Collapsed" />
                                        <Setter Target="BarScrim.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="BarGlass"
                            Background="{ThemeResource GlassTitleBarBrush}"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="BarTint"
                            Background="{ThemeResource EditorialTopBarTintBrush}"
                            IsHitTestVisible="False" />
                        <Rectangle
                            x:Name="BarScrim"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#B0000000" />
                                    <GradientStop Offset="0.6" Color="#5A000000" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border
                            x:Name="SunsetRule"
                            Height="3"
                            Margin="0,0,0,-3"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource EditorialSunsetRuleBrush}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  (dictionary templates use {Binding}: x:Bind needs a dictionary with code behind, and the theme's is loaded by its address)  -->
    <!--  the sign-in page's backdrop (its content: the LoginViewModel; nothing of it is read)  -->
    <DataTemplate x:Key="SignInBackdropTemplate">
        <ec:EditorialSignInBackdrop />
    </DataTemplate>

    <!--
        the player's bars (optional keys, over MpvPlayerControls' own styles, in place during playback too): the page's
        margins (48), and the night instead of black in the scrims, deeper behind the transport so the time reads like the
        concept's. The bars' parts and logic are the shared ones.
    -->
    <Style x:Key="PlayerTopBarStyle" TargetType="Grid">
        <Setter Property="Padding" Value="48,24,48,64" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#D9160610" />
                    <GradientStop Offset="0.6" Color="#73160610" />
                    <GradientStop Offset="1" Color="#00160610" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlayerBottomBarStyle" TargetType="Grid">
        <Setter Property="Padding" Value="48,80,48,28" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Offset="0" Color="#F2160610" />
                    <GradientStop Offset="0.55" Color="#B3160610" />
                    <GradientStop Offset="1" Color="#00160610" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="RowHeaderTemplate">
        <TextBlock
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource EditorialShelfTitleTextBlockStyle}"
            Text="{Binding}" />
    </DataTemplate>
    <!--
        Nixie 1.3.1: the theatre window's frame (TrailerFrame): one strong glass panel with the theme's panel edge, the TRAILER
        kicker and the title in the shelf face, the sunset rule under them, Close as the theme's rounded square, and the video on
        black. Follows the theme (light glass at noon); high contrast: the system colours.
    -->
    <ControlTemplate x:Key="TrailerFrameTemplate" TargetType="lc:TrailerFrame">
        <Border
            Padding="24,18,24,24"
            Background="{ThemeResource GlassPanelStrongBrush}"
            BorderBrush="{ThemeResource EditorialPanelStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource EditorialCornerRadius}">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            AutomationProperties.AccessibilityView="Raw"
                            Style="{StaticResource EditorialKickerTextBlockStyle}"
                            Text="TRAILER" />
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource EditorialShelfTitleTextBlockStyle}"
                            Text="{TemplateBinding Title}" />
                    </StackPanel>
                    <Button
                        x:Name="PART_CloseButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Close trailer"
                        ToolTipService.ToolTip="Close trailer (Esc)"
                        Style="{StaticResource EditorialIconButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <Border
                    Grid.Row="1"
                    Height="3"
                    Background="{ThemeResource EditorialSunsetRuleBrush}"
                    CornerRadius="1.5" />
                <Border
                    Grid.Row="2"
                    Width="{TemplateBinding VideoWidth}"
                    Height="{TemplateBinding VideoHeight}"
                    Background="Black"
                    CornerRadius="{StaticResource EditorialCornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </Grid>
        </Border>
    </ControlTemplate>

</ResourceDictionary>
