<?xml version="1.0" encoding="utf-8" ?>
<!--
    Editorial's card templates (merged by Editorial.xaml): PosterTemplate, a dense 2:3 poster whose details open in place;
    StillTemplate, a 16:9 episode still with its big number, title, facts and synopsis. {Binding}: the dictionary is loaded by
    its address, so it has no code behind for x:Bind.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ec="using:FluentFin.Themes.Editorial.Controls">

    <DataTemplate x:Key="PosterTemplate">
        <ec:EditorialPoster Margin="0,0,18,30" Item="{Binding}" />
    </DataTemplate>

    <DataTemplate x:Key="EditorialNarrowPosterTemplate">
        <ec:EditorialPoster
            Margin="0,0,16,30"
            Item="{Binding}"
            PosterWidth="122" />
    </DataTemplate>

    <DataTemplate x:Key="StillTemplate">
        <ec:EditorialStill Episode="{Binding}" />
    </DataTemplate>
</ResourceDictionary>
