<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.3.0, the Editorial theme's Library: the library's name in big type over the Googie arc, what it holds ("312
    films · 41 unwatched · 18 added this month"), the sort, and its genres as chips with their counts (one click narrows
    the grid; All, Unwatched, Favourites). The grid is split by letter (sorted by name), dense posters, twelve across at
    1920; the section under the bar keeps its letter, its count and the A-Z jump on its line. A poster opens its details
    in place under its row; Full details there opens the item page.
    Keyboard: the chips are one Tab stop, the A-Z another, the grid one (Left/Right along the library, Up/Down by column,
    Home/End; Down from a poster into its open details, Up and Esc back). Narrator: the grid is a list named after the
    library, each poster "n of m" in it; the A-Z a list "Jump to a letter" of buttons "Jump to B".
-->
<Page
    x:Class="FluentFin.Themes.Editorial.Views.EditorialLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctkl="using:CommunityToolkit.Labs.WinUI"
    xmlns:ec="using:FluentFin.Themes.Editorial.Controls"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Themes.Editorial.Views"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Background="{ThemeResource EditorialGroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:EditorialSectionLine">
            <StackPanel
                Height="64"
                Padding="0,10,0,0"
                Orientation="Horizontal"
                Spacing="14">
                <TextBlock
                    VerticalAlignment="Bottom"
                    AutomationProperties.HeadingLevel="Level2"
                    AutomationProperties.Name="{x:Bind AutomationName}"
                    FontSize="44"
                    LineHeight="44"
                    LineStackingStrategy="BlockLineHeight"
                    Style="{StaticResource EditorialBigTypeTextBlockStyle}"
                    Text="{x:Bind Letter}" />
                <TextBlock
                    Margin="0,0,0,4"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource EditorialCaptionTextBlockStyle}"
                    Text="{x:Bind Caption}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:EditorialRowLine">
            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditorialCell">
                        <ec:EditorialPoster
                            Margin="0,0,0,30"
                            AutomationProperties.PositionInSet="{x:Bind Position}"
                            AutomationProperties.SizeOfSet="{x:Bind Size}"
                            Item="{x:Bind Item}"
                            PosterWidth="{Binding ElementName=Page, Path=PosterWidth}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="DetailsTemplate" x:DataType="vm:EditorialDetailsLine">
            <ec:InlineDetailsRow Margin="0,-4,0,30" Item="{x:Bind Item}" />
        </DataTemplate>
        <ec:EditorialLineTemplateSelector
            x:Key="LineTemplates"
            Details="{StaticResource DetailsTemplate}"
            Row="{StaticResource RowTemplate}"
            Section="{StaticResource SectionTemplate}" />

        <!--  the A-Z jump's letters: flat, 28 px; the section under the bar is underlined in the accent  -->
        <Style x:Key="LetterStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  the page's head: the name in big type over the arc, what it holds, the sort; then the genre chips  -->
        <StackPanel
            x:Name="Head"
            Padding="56,22,56,0"
            Spacing="14">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        x:Name="TitleText"
                        AutomationProperties.HeadingLevel="Level1"
                        LineHeight="84"
                        LineStackingStrategy="BlockLineHeight"
                        Style="{StaticResource PageHeaderStyle}"
                        Text="{x:Bind local:EditorialLibraryPage.Upper(ViewModel.Title), Mode=OneWay}" />
                    <ec:EditorialArc
                        x:Name="Arc"
                        Width="250"
                        Margin="-4,0,0,0"
                        HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock
                    x:Name="SummaryText"
                    Grid.Column="1"
                    Margin="0,0,0,26"
                    VerticalAlignment="Bottom"
                    FontSize="15"
                    Foreground="{ThemeResource GlassTextSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,0,22"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--
                        the sort in use on the button ("A to Z"), and to Narrator from the same words (Nixie 1.3.1, WCAG 2.5.3:
                        "A to Z, Sort: Name, ascending"); its menu: keys and direction
                    -->
                    <Button
                        x:Name="SortButton"
                        AutomationProperties.Name="{x:Bind vm:EditorialLibrary.SortButtonName(ViewModel.SortBy, ViewModel.Order, ViewModel.InPlaylistOrder, ViewModel.SortButtonName), Mode=OneWay}"
                        Style="{StaticResource NixieCompactButtonStyle}"
                        ToolTipService.ToolTip="Sort">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                            <TextBlock Text="{x:Bind vm:EditorialLibrary.SortWords(ViewModel.SortBy, ViewModel.Order, ViewModel.InPlaylistOrder), Mode=OneWay}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  the genre chips (the library's own counts), All first; Unwatched and Favourites after them  -->
            <ScrollViewer
                x:Name="ChipScroller"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ec:EditorialTabList x:Name="ChipList" AutomationProperties.Name="Genres">
                        <StackPanel x:Name="ChipStack" Orientation="Horizontal" Spacing="8" />
                    </ec:EditorialTabList>
                    <ToggleButton
                        x:Name="UnwatchedChip"
                        Click="UnwatchedChip_Click"
                        Style="{StaticResource EditorialToggleChipStyle}" />
                    <ToggleButton
                        x:Name="FavoritesChip"
                        Click="FavoritesChip_Click"
                        Style="{StaticResource EditorialToggleChipStyle}" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="GridScroller"
                Padding="56,0,56,0"
                VerticalScrollBarVisibility="Auto">
                <lc:RowList
                    x:Name="GridList"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TabFocusNavigation="Once">
                    <ItemsRepeater
                        x:Name="Lines"
                        Margin="0,0,0,40"
                        ItemTemplate="{StaticResource LineTemplates}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </lc:RowList>
            </ScrollViewer>

            <!--  the section under the bar: its letter and count, and the A-Z jump on its line (the ground behind, the grid passes under)  -->
            <Grid
                x:Name="SectionBar"
                Height="64"
                Padding="56,10,56,0"
                VerticalAlignment="Top"
                Background="{ThemeResource EditorialGroundBrush}"
                ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="BarLetter"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="44"
                    LineHeight="44"
                    LineStackingStrategy="BlockLineHeight"
                    Style="{StaticResource EditorialBigTypeTextBlockStyle}" />
                <TextBlock
                    x:Name="BarCaption"
                    Grid.Column="1"
                    Margin="0,0,0,4"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    Style="{StaticResource EditorialCaptionTextBlockStyle}" />
                <lc:RowList
                    x:Name="LetterList"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Jump to a letter"
                    TabFocusNavigation="Once"
                    XYFocusKeyboardNavigation="Enabled">
                    <ItemsRepeater x:Name="LetterRepeater" ItemsSource="{x:Bind ViewModel.Letters, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LetterJump">
                                <Button
                                    AutomationProperties.Name="{x:Bind Name}"
                                    Click="Letter_Click"
                                    Style="{StaticResource LetterStyle}"
                                    Tag="{x:Bind}">
                                    <Grid Width="28" Height="30">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Letter}" />
                                        <Border
                                            Width="14"
                                            Height="3"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource NixieAccentBrush}"
                                            CornerRadius="1.5"
                                            Opacity="0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </lc:RowList>
            </Grid>

            <!--  the library failed to load or is empty  -->
            <lc:LoadStateView State="{x:Bind ViewModel.State}" VerticalContentAlignment="Center" />

            <!--  while the titles load: placeholders where the posters go  -->
            <StackPanel
                x:Name="Skeleton"
                Padding="56,74,56,0"
                Orientation="Horizontal"
                Spacing="16"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ctkl:Shimmer Width="136" Height="204" CornerRadius="8" />
                <ctkl:Shimmer Width="136" Height="204" CornerRadius="8" />
                <ctkl:Shimmer Width="136" Height="204" CornerRadius="8" />
                <ctkl:Shimmer Width="136" Height="204" CornerRadius="8" />
                <ctkl:Shimmer Width="136" Height="204" CornerRadius="8" />
                <ctkl:Shimmer Width="136" Height="204" CornerRadius="8" />
                <ctkl:Shimmer Width="136" Height="204" CornerRadius="8" />
                <ctkl:Shimmer Width="136" Height="204" CornerRadius="8" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
