<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.3.0, the Editorial theme's Library: the library's name in big type over the Googie arc, what it holds ("312
    films · 41 unwatched · 18 added this month"), the toolbar, and its genres as chips with their counts (one click narrows
    the grid to a genre; All). Dense posters in rows that flow across letters, the first title of each letter tagged with it.
    A poster opens its details in place under its row; Full details there opens the item page.
    Nixie 1.4.0 (the UX review's E-B1, E-M1 to E-M5, E-m1, E-m12; items 2, 4, 12, 13): Unwatched and Favorites are switches in
    the shared toolbar (they sat off-screen after the chips), with Sort in words, the direction, Filter (every kind, several
    genres) and View; the chips' row says when it scrolls on, and ends in More filters; the filters on show as chips; the A to Z
    sits on its own line before the grid (Tab order too) with where the view is; scrolled, the head folds to one compact line.
    Keyboard: the toolbar, the chips (one stop), More filters, the A-Z (one stop), the grid (one stop: Left/Right along the
    library, Up/Down by column, Home/End, Page Up/Down; letters typed go to the first title they start; Down from a poster
    into its open details, Up and Esc back). Narrator: the grid is a list named after the library, each poster "n of m".
-->
<Page
    x:Class="FluentFin.Themes.Editorial.Views.EditorialLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctkl="using:CommunityToolkit.Labs.WinUI"
    xmlns:ec="using:FluentFin.Themes.Editorial.Controls"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Themes.Editorial.Views"
    xmlns:shared="using:FluentFin.Views"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Background="{ThemeResource EditorialGroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:EditorialSectionLine">
            <StackPanel
                Height="64"
                Padding="0,10,0,0"
                Orientation="Horizontal"
                Spacing="14">
                <TextBlock
                    VerticalAlignment="Bottom"
                    AutomationProperties.HeadingLevel="Level2"
                    AutomationProperties.Name="{x:Bind AutomationName}"
                    FontSize="44"
                    LineHeight="44"
                    LineStackingStrategy="BlockLineHeight"
                    Style="{StaticResource EditorialBigTypeTextBlockStyle}"
                    Text="{x:Bind Letter}" />
                <TextBlock
                    Margin="0,0,0,4"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource EditorialCaptionTextBlockStyle}"
                    Text="{x:Bind Caption}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:EditorialRowLine">
            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditorialCell">
                        <Grid>
                            <ec:EditorialPoster
                                Margin="0,0,0,30"
                                AutomationProperties.PositionInSet="{x:Bind Position}"
                                AutomationProperties.SizeOfSet="{x:Bind Size}"
                                Item="{x:Bind Item}"
                                PosterWidth="{Binding ElementName=Page, Path=PosterWidth}" />
                            <!--  Nixie 1.4.0: the first title of a letter carries it (the rows flow on across letters)  -->
                            <Border
                                Margin="6,6,0,0"
                                Padding="8,1,8,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw"
                                Background="{ThemeResource EditorialGroundBrush}"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind HasTag}">
                                <TextBlock
                                    FontSize="18"
                                    LineHeight="22"
                                    LineStackingStrategy="BlockLineHeight"
                                    Style="{StaticResource EditorialBigTypeTextBlockStyle}"
                                    Text="{x:Bind Tag}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="DetailsTemplate" x:DataType="vm:EditorialDetailsLine">
            <ec:InlineDetailsRow Margin="0,-4,0,30" Item="{x:Bind Item}" />
        </DataTemplate>
        <ec:EditorialLineTemplateSelector
            x:Key="LineTemplates"
            Details="{StaticResource DetailsTemplate}"
            Row="{StaticResource RowTemplate}"
            Section="{StaticResource SectionTemplate}" />

    </Page.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  the page's head: the name in big type over the arc, what it holds, the toolbar; then the genre chips  -->
        <StackPanel
            x:Name="Head"
            Padding="56,22,56,0"
            Spacing="14">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock
                        x:Name="TitleText"
                        AutomationProperties.HeadingLevel="Level1"
                        LineHeight="84"
                        LineStackingStrategy="BlockLineHeight"
                        Style="{StaticResource PageHeaderStyle}"
                        Text="{x:Bind local:EditorialLibraryPage.Upper(ViewModel.Title), Mode=OneWay}" />
                    <ec:EditorialArc
                        x:Name="Arc"
                        Width="250"
                        Margin="-4,0,0,0"
                        HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock
                    x:Name="SummaryText"
                    Grid.Column="1"
                    Margin="0,0,0,26"
                    VerticalAlignment="Bottom"
                    FontSize="15"
                    Foreground="{ThemeResource GlassTextSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
                <lc:LibraryToolbar
                    x:Name="SortFilterBar"
                    Grid.Column="2"
                    Margin="0,0,0,22"
                    VerticalAlignment="Bottom"
                    ShowFavorites="True"
                    ShowListChoice="False"
                    ViewModel="{x:Bind ViewModel}"
                    Visibility="{x:Bind shared:LibraryPage.BarVisibility(ViewModel.State.Status), Mode=OneWay}" />
            </Grid>

            <!--  the genre chips (counts against the other filters), All first; the row says when it scrolls on; More filters  -->
            <Grid x:Name="ChipRow" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer
                    x:Name="ChipScroller"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <ec:EditorialTabList x:Name="ChipList" AutomationProperties.Name="Genres">
                        <StackPanel x:Name="ChipStack" Orientation="Horizontal" Spacing="8" />
                    </ec:EditorialTabList>
                </ScrollViewer>
                <!--  the overflow cue: the row's last chips fade into the ground, and a chevron moves it on (and back)  -->
                <Border
                    x:Name="ChipFade"
                    Width="56"
                    HorizontalAlignment="Right"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="1" Color="{ThemeResource EditorialGroundColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Button
                    x:Name="ChipMore"
                    Grid.Column="1"
                    AutomationProperties.Name="More genres"
                    Click="ChipMore_Click"
                    IsTabStop="False"
                    Style="{StaticResource NixieCompactIconButtonStyle}"
                    ToolTipService.ToolTip="More genres"
                    Visibility="Collapsed">
                    <FontIcon x:Name="ChipMoreGlyph" FontSize="12" Glyph="&#xE76C;" />
                </Button>
                <HyperlinkButton
                    x:Name="MoreFilters"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="MoreFilters_Click"
                    Content="More filters"
                    Style="{StaticResource NixieLinkButtonStyle}" />
            </Grid>
        </StackPanel>

        <!--  what is filtered  -->
        <lc:AppliedFilterRow
            x:Name="AppliedFilters"
            Grid.Row="1"
            Margin="56,12,56,0"
            ViewModel="{x:Bind ViewModel}" />

        <!--  the A to Z (before the grid, in Tab order too), or the sort's two directions, and where the view is  -->
        <Grid
            x:Name="LetterRow"
            Grid.Row="2"
            MinHeight="32"
            Margin="56,12,56,8">
            <lc:LetterBar
                x:Name="Letters"
                TileWidth="30"
                ViewModel="{x:Bind ViewModel}" />
            <ctkl:Shimmer
                x:Name="LetterPlaceholder"
                Width="420"
                Height="32"
                HorizontalAlignment="Left"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer
                x:Name="GridScroller"
                Padding="56,0,56,0"
                VerticalScrollBarVisibility="Auto">
                <lc:RowList
                    x:Name="GridList"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TabFocusNavigation="Once">
                    <ItemsRepeater
                        x:Name="Lines"
                        Margin="0,8,0,40"
                        ItemTemplate="{StaticResource LineTemplates}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </lc:RowList>
            </ScrollViewer>

            <!--  the library failed to load or is empty  -->
            <lc:LoadStateView State="{x:Bind ViewModel.State}" VerticalContentAlignment="Center" />

            <!--  a filter that leaves nothing says so  -->
            <lc:LibraryNoMatchesView ViewModel="{x:Bind ViewModel}" />

            <!--  while the titles load: placeholders in the posters' own grid (their width, gap and rows)  -->
            <ItemsRepeater
                x:Name="Skeleton"
                Margin="56,8,56,0"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False"
                ItemsSource="{x:Bind local:EditorialLibraryPage.Slots(24)}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                        <StackPanel Spacing="8">
                            <ctkl:Shimmer Height="{Binding ElementName=Page, Path=PosterHeight}" CornerRadius="8" />
                            <ctkl:Shimmer
                                Width="96"
                                Height="14"
                                HorizontalAlignment="Left"
                                CornerRadius="4" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        x:Name="SkeletonLayout"
                        ItemsJustification="Start"
                        ItemsStretch="None"
                        MinColumnSpacing="16"
                        MinItemWidth="136"
                        MinRowSpacing="30"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </Grid>
    </Grid>
</Page>
