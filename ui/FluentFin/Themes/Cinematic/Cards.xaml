<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:FluentFin.Themes.Cinematic.Controls"
    xmlns:cin="using:FluentFin.Themes.Cinematic"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:vm="using:FluentFin.Core.ViewModels">
    <!--
        Nixie 1.3.0, the Cinematic theme's own resources (docs\reports\Nixie redesign concepts, "Theme 1: Cinematic"): the
        colours of things drawn ON artwork (always light on a dark band, in both themes; the system colours in high contrast),
        the focus glow, the hero's scrims, and the card templates. Every key carries the Cinematic prefix, except the shared
        keys Cinematic.xaml defines. Cinematic's views merge this dictionary themselves, so they do not depend on when the theme
        dictionary is swapped in.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="CinematicNightBrush" Color="#1A0710" />
            <Color x:Key="CinematicNightColor">#1A0710</Color>
            <Color x:Key="CinematicNightClearColor">#001A0710</Color>
            <SolidColorBrush x:Key="CinematicArtGroundBrush" Color="#2A0F19" />
            <!--  under the title art on a still: clear at the band's top, 78 % black at the art's foot (white text: 4.5:1 over a white still)  -->
            <LinearGradientBrush x:Key="CinematicArtShadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="0.35" Color="#73000000" />
                <GradientStop Offset="1" Color="#C7000000" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CinematicOnArtTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CinematicOnArtSecondaryBrush" Color="#EADBDC" />
            <SolidColorBrush x:Key="CinematicKickerBrush" Color="#F7AA9C" />
            <SolidColorBrush x:Key="CinematicNumberBrush" Color="#FFD7C4" />
            <SolidColorBrush x:Key="CinematicProgressTrackBrush" Color="#47FFFFFF" />
            <SolidColorBrush x:Key="CinematicProgressBrush" Color="#F96985" />
            <SolidColorBrush x:Key="CinematicBadgeFillBrush" Color="#B3170508" />
            <SolidColorBrush x:Key="CinematicBadgeStrokeBrush" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="CinematicGlyphFillBrush" Color="#8C140610" />
            <SolidColorBrush x:Key="CinematicGlyphStrokeBrush" Color="#47FFFFFF" />
            <LinearGradientBrush x:Key="CinematicArtEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#2EFFFFFF" />
                <GradientStop Offset="0.2" Color="#1AFFFFFF" />
                <GradientStop Offset="1" Color="#14FFFFFF" />
            </LinearGradientBrush>
            <!--  the focus sheen: white 22 % at the top-left corner, gone by 38 % of the diagonal (125 degrees)  -->
            <LinearGradientBrush x:Key="CinematicSheenBrush" StartPoint="0,0" EndPoint="1,0.7">
                <GradientStop Offset="0" Color="#38FFFFFF" />
                <GradientStop Offset="0.38" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <x:Double x:Key="CinematicRestShadowOpacity">0.45</x:Double>
            <x:Double x:Key="CinematicGlowOpacity">0.85</x:Double>
            <x:Double x:Key="CinematicGlowFarOpacity">0.38</x:Double>
            <!--  the hero: the words' side scrim, the foot into the page, the top under the island  -->
            <LinearGradientBrush x:Key="CinematicHeroSideScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#EB12050B" />
                <GradientStop Offset="0.3" Color="#C712050B" />
                <GradientStop Offset="0.4" Color="#9E12050B" />
                <GradientStop Offset="0.52" Color="#4D12050B" />
                <GradientStop Offset="0.66" Color="#1412050B" />
                <GradientStop Offset="0.76" Color="#0012050B" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicHeroFootScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.42" Color="#001A0710" />
                <GradientStop Offset="0.64" Color="#CC1A0710" />
                <GradientStop Offset="0.9" Color="#FF1A0710" />
            </LinearGradientBrush>
            <!--  an item page: the foot starts higher (the tabs and the episodes sit on it)  -->
            <LinearGradientBrush x:Key="CinematicItemFootScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.34" Color="#001A0710" />
                <GradientStop Offset="0.56" Color="#C71A0710" />
                <GradientStop Offset="0.76" Color="#FF1A0710" />
                <GradientStop Offset="1" Color="#FF1A0710" />
            </LinearGradientBrush>
            <!--  behind the credits at the right of an item page (they can fall on bright art)  -->
            <SolidColorBrush x:Key="CinematicCreditsBackingBrush" Color="#A612050B" />
            <!--  the island over a hero: dark glass in every theme (the bar's text is the dark theme's there), tinted enough to stay dark over a light ground  -->
            <AcrylicBrush
                x:Key="CinematicIslandHeroBrush"
                FallbackColor="#F21E0812"
                TintColor="#1E0812"
                TintLuminosityOpacity="0.9"
                TintOpacity="0.8" />
            <LinearGradientBrush x:Key="CinematicIslandHeroRimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#61FFFFFF" />
                <GradientStop Offset="0.3" Color="#1AFFFFFF" />
                <GradientStop Offset="1" Color="#0FFFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicIslandHeroSheenBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#29FFFFFF" />
                <GradientStop Offset="0.6" Color="#0AFFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <!--  the first screen is dusk in every theme; under it the page's own ground (nothing to fade in the dark theme)  -->
            <SolidColorBrush x:Key="CinematicFirstScreenFadeBrush" Color="Transparent" />
            <!--  the player: the tabs and their panel lie over the video on a dense fill (no blur over video); the top scrim  -->
            <SolidColorBrush x:Key="CinematicPlayerPanelBrush" Color="#EB170508" />
            <LinearGradientBrush x:Key="CinematicPlayerTopScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#D9000000" />
                <GradientStop Offset="0.6" Color="#99000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
            <!--  the library's preview stage: its foot fades into the page, where the grid's header line sits  -->
            <LinearGradientBrush x:Key="CinematicStageFootScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.3" Color="#001A0710" />
                <GradientStop Offset="0.7" Color="#CC1A0710" />
                <GradientStop Offset="1" Color="#FF1A0710" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicHeroTopScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#8C0A0306" />
                <GradientStop Offset="1" Color="#000A0306" />
            </LinearGradientBrush>
            <!--  the horizon: a thin coral-to-pink line where the art meets the shelf  -->
            <LinearGradientBrush x:Key="CinematicHorizonBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00F7AA9C" />
                <GradientStop Offset="0.3" Color="#66F7AA9C" />
                <GradientStop Offset="0.55" Color="#80F96985" />
                <GradientStop Offset="1" Color="#00F7AA9C" />
            </LinearGradientBrush>
            <!--  the island: a little clearer than the shared bar, lit along its top  -->
            <LinearGradientBrush x:Key="CinematicIslandSheenBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#29FFFFFF" />
                <GradientStop Offset="0.6" Color="#0AFFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <AcrylicBrush
                x:Key="CinematicIslandBrush"
                FallbackColor="#F01E0812"
                TintColor="#1E0812"
                TintLuminosityOpacity="0.3"
                TintOpacity="0.45" />
            <LinearGradientBrush x:Key="CinematicIslandRimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#61FFFFFF" />
                <GradientStop Offset="0.3" Color="#1AFFFFFF" />
                <GradientStop Offset="1" Color="#0FFFFFFF" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <!--  noon: the page ground is the light theme's; whatever sits ON artwork stays light on dark  -->
            <SolidColorBrush x:Key="CinematicNightBrush" Color="#FFF6F3" />
            <Color x:Key="CinematicNightColor">#FFF6F3</Color>
            <Color x:Key="CinematicNightClearColor">#00FFF6F3</Color>
            <SolidColorBrush x:Key="CinematicArtGroundBrush" Color="#3A1A22" />
            <LinearGradientBrush x:Key="CinematicArtShadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="0.35" Color="#73000000" />
                <GradientStop Offset="1" Color="#C7000000" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CinematicOnArtTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CinematicOnArtSecondaryBrush" Color="#EADBDC" />
            <SolidColorBrush x:Key="CinematicKickerBrush" Color="#F7AA9C" />
            <SolidColorBrush x:Key="CinematicNumberBrush" Color="#FFD7C4" />
            <SolidColorBrush x:Key="CinematicProgressTrackBrush" Color="#47FFFFFF" />
            <SolidColorBrush x:Key="CinematicProgressBrush" Color="#F96985" />
            <SolidColorBrush x:Key="CinematicBadgeFillBrush" Color="#B3170508" />
            <SolidColorBrush x:Key="CinematicBadgeStrokeBrush" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="CinematicGlyphFillBrush" Color="#8C140610" />
            <SolidColorBrush x:Key="CinematicGlyphStrokeBrush" Color="#47FFFFFF" />
            <LinearGradientBrush x:Key="CinematicArtEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#2EFFFFFF" />
                <GradientStop Offset="0.2" Color="#1AFFFFFF" />
                <GradientStop Offset="1" Color="#14FFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicSheenBrush" StartPoint="0,0" EndPoint="1,0.7">
                <GradientStop Offset="0" Color="#38FFFFFF" />
                <GradientStop Offset="0.38" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <x:Double x:Key="CinematicRestShadowOpacity">0.22</x:Double>
            <x:Double x:Key="CinematicGlowOpacity">0.55</x:Double>
            <x:Double x:Key="CinematicGlowFarOpacity">0.25</x:Double>
            <LinearGradientBrush x:Key="CinematicHeroSideScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#EB12050B" />
                <GradientStop Offset="0.3" Color="#C712050B" />
                <GradientStop Offset="0.4" Color="#9E12050B" />
                <GradientStop Offset="0.52" Color="#4D12050B" />
                <GradientStop Offset="0.66" Color="#1412050B" />
                <GradientStop Offset="0.76" Color="#0012050B" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicHeroFootScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.42" Color="#00FFF6F3" />
                <GradientStop Offset="0.64" Color="#CCFFF6F3" />
                <GradientStop Offset="0.9" Color="#FFFFF6F3" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicItemFootScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.36" Color="#00FFF6F3" />
                <GradientStop Offset="0.58" Color="#C7FFF6F3" />
                <GradientStop Offset="0.76" Color="#FFFFF6F3" />
                <GradientStop Offset="1" Color="#FFFFF6F3" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CinematicCreditsBackingBrush" Color="#A612050B" />
            <!--  the island over a hero: dark glass in every theme (the bar's text is the dark theme's there), tinted enough to stay dark over a light ground  -->
            <AcrylicBrush
                x:Key="CinematicIslandHeroBrush"
                FallbackColor="#F21E0812"
                TintColor="#1E0812"
                TintLuminosityOpacity="0.9"
                TintOpacity="0.8" />
            <LinearGradientBrush x:Key="CinematicIslandHeroRimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#61FFFFFF" />
                <GradientStop Offset="0.3" Color="#1AFFFFFF" />
                <GradientStop Offset="1" Color="#0FFFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicIslandHeroSheenBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#29FFFFFF" />
                <GradientStop Offset="0.6" Color="#0AFFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicFirstScreenFadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FF1A0710" />
                <GradientStop Offset="1" Color="#001A0710" />
            </LinearGradientBrush>
            <!--  the player: the tabs and their panel lie over the video on a dense fill (no blur over video); the top scrim  -->
            <SolidColorBrush x:Key="CinematicPlayerPanelBrush" Color="#EB170508" />
            <LinearGradientBrush x:Key="CinematicPlayerTopScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#D9000000" />
                <GradientStop Offset="0.6" Color="#99000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicStageFootScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.32" Color="#00FFF6F3" />
                <GradientStop Offset="0.72" Color="#CCFFF6F3" />
                <GradientStop Offset="1" Color="#FFFFF6F3" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicHeroTopScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#8C0A0306" />
                <GradientStop Offset="1" Color="#000A0306" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicHorizonBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00BC1E47" />
                <GradientStop Offset="0.3" Color="#59EC6A79" />
                <GradientStop Offset="0.55" Color="#80BC1E47" />
                <GradientStop Offset="1" Color="#00BC1E47" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CinematicIslandSheenBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#66FFFFFF" />
                <GradientStop Offset="0.6" Color="#14FFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <AcrylicBrush
                x:Key="CinematicIslandBrush"
                FallbackColor="#F0FCEAE8"
                TintColor="#FCEAE8"
                TintLuminosityOpacity="0.5"
                TintOpacity="0.35" />
            <LinearGradientBrush x:Key="CinematicIslandRimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.35" Color="#26000000" />
                <GradientStop Offset="1" Color="#1A000000" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CinematicNightBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <StaticResource x:Key="CinematicNightColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="CinematicNightClearColor" ResourceKey="SystemColorWindowColor" />
            <SolidColorBrush x:Key="CinematicArtGroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CinematicArtShadeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CinematicOnArtTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CinematicOnArtSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CinematicKickerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CinematicNumberBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CinematicProgressTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="CinematicProgressBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CinematicBadgeFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CinematicBadgeStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CinematicGlyphFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CinematicGlyphStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="CinematicArtEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CinematicSheenBrush" Color="Transparent" />
            <x:Double x:Key="CinematicRestShadowOpacity">0</x:Double>
            <x:Double x:Key="CinematicGlowOpacity">0</x:Double>
            <x:Double x:Key="CinematicGlowFarOpacity">0</x:Double>
            <SolidColorBrush x:Key="CinematicHeroSideScrimBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CinematicHeroFootScrimBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CinematicHeroTopScrimBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CinematicItemFootScrimBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CinematicCreditsBackingBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CinematicIslandHeroBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CinematicIslandHeroRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CinematicIslandHeroSheenBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CinematicFirstScreenFadeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CinematicPlayerPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CinematicPlayerTopScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CinematicStageFootScrimBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CinematicHorizonBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CinematicIslandSheenBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CinematicIslandBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CinematicIslandRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  type: the hero kicker (small tracked capitals in peach), a shelf's title and its count  -->
    <Style x:Key="CinematicKickerTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassTextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{ThemeResource CinematicKickerBrush}" />
    </Style>
    <!--  a page's own title (the library's name): Segoe UI Variable Display 28 SemiBold, a level-1 heading  -->
    <Style x:Key="CinematicPageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassDisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="CinematicShelfTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassDisplayFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
    </Style>
    <Style x:Key="CinematicShelfCountTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
    </Style>

    <!--  a still on a shelf: 384 x 216 (300 x 169 in a narrow window), room around it for the 1.1x zoom (FocusZoom)  -->
    <!--  (no x:Bind here: the theme dictionary is loaded by its address, ILayoutTheme.Dictionary. The still takes its item from its DataContext, a {Binding} to its typed Model never arrived, and loads its own picture)  -->
    <DataTemplate x:Key="CinematicStillTemplate">
        <cc:CinematicStill Margin="16,14,16,0" UseDataContext="True" />
    </DataTemplate>
    <DataTemplate x:Key="CinematicSmallStillTemplate">
        <cc:CinematicStill
            Margin="12,12,12,0"
            ArtHeight="169"
            ArtWidth="300"
            DecodeWidth="520"
            UseDataContext="True"
            TitleArtLogoHeight="44"
            TitleArtSize="20"
            TitleSize="15" />
    </DataTemplate>
</ResourceDictionary>
