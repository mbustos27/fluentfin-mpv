<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Themes.Cinematic.Views.CinematicMoviePage"
    lc:TopBar.ExtendsUnder="True"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:FluentFin.Themes.Cinematic.Controls"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:core="using:FluentFin.Core"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Themes.Cinematic.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Background="{ThemeResource CinematicNightBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="StillSmall" x:DataType="vm:BaseItemViewModel">
            <cc:CinematicStill
                Margin="12,12,12,12"
                ArtHeight="169"
                ArtWidth="300"
                DecodeWidth="520"
                Model="{x:Bind}"
                TitleArtLogoHeight="44"
                TitleArtSize="20"
                TitleSize="15" />
        </DataTemplate>
    </Page.Resources>

    <!--
        Nixie 1.3.0, Cinematic Movie: the film's backdrop fills the first screen with its details at the lower left
        (CinematicItemStage): Resume or Play (the one Primary; "Resume at 12:34") and Play from start beside it, Trailer,
        Watched, Favourite, More. More like this runs along the stage's foot as stills; below it the sound, the subtitles,
        the details and the cast. Same view model and same Back place as the shared movie page.
    -->
    <Grid>
        <ScrollViewer x:Name="PageContent">
            <StackPanel>
                <cc:CinematicItemStage x:Name="Stage" Dto="{x:Bind ViewModel.Dto, Mode=OneWay}">
                    <cc:CinematicItemStage.PrimaryActions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="PlayButton"
                                AutomationProperties.Name="{x:Bind ViewModel.PlayLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PlayCommand}"
                                Style="{StaticResource NixiePrimaryButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.PlayLabel, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                    <TextBlock Text="{x:Bind ViewModel.PlayLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="{x:Bind core:ItemLabels.PlayFromBeginningAction(ViewModel.Dto), Mode=OneWay, FallbackValue='Play from start'}"
                                Command="{x:Bind ViewModel.PlayFromBeginningCommand}"
                                Style="{StaticResource NixieButtonStyle}"
                                ToolTipService.ToolTip="Play from start"
                                Visibility="{x:Bind ViewModel.HasResumePoint, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE777;" />
                                    <TextBlock Text="Play from start" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </cc:CinematicItemStage.PrimaryActions>
                    <cc:CinematicItemStage.BottomContent>
                        <lc:ShelfRow
                            x:Name="SimilarShelf"
                            Margin="84,0,0,24"
                            HasSeeAll="True"
                            Header="More like this"
                            ItemsSource="{x:Bind ViewModel.Similar, Mode=OneWay}"
                            ItemTemplate="{StaticResource StillSmall}"
                            Loaded="SimilarShelf_Loaded"
                            SeeAll="SimilarSeeAll"
                            Visibility="{x:Bind c:ItemRowConverters.Show(ViewModel.Similar.Count), Mode=OneWay, FallbackValue=Collapsed}" />
                    </cc:CinematicItemStage.BottomContent>
                </cc:CinematicItemStage>

                <!--  the light theme: the stage's dusk fades into the page's ground  -->

                <Border

                    Height="72"

                    AutomationProperties.AccessibilityView="Raw"

                    Background="{ThemeResource CinematicFirstScreenFadeBrush}"

                    IsHitTestVisible="False" />

                <StackPanel
                    x:Name="Body"
                    Margin="96,24,48,56"
                    Spacing="32">
                    <!--  Nixie 1.4.0: "Part of: Copper and Glass", the film's collections, each opening its Collection page  -->
                    <lc:PartOfLink Collections="{x:Bind ViewModel.PartOf, Mode=OneWay}" />
                    <!--  the picture and the sound: the shared pickers (plain labels, TrackLabels)  -->
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                            Style="{StaticResource GlassMetaTextBlockStyle}"
                            Text="Video" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource GlassTextPrimaryBrush}"
                            Text="{x:Bind ViewModel.VideoTitle, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                            Style="{StaticResource GlassMetaTextBlockStyle}"
                            Text="Audio" />
                        <ctk:SwitchPresenter
                            Grid.Row="1"
                            Grid.Column="1"
                            TargetType="x:Int32"
                            Value="{x:Bind ViewModel.AudioStreams.Count, Mode=OneWay}">
                            <ctk:Case Value="0" />
                            <ctk:Case Value="1">
                                <TextBlock Foreground="{ThemeResource GlassTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedAudioLabel, Mode=OneWay}" />
                            </ctk:Case>
                            <ctk:Case IsDefault="True">
                                <ComboBox
                                    MinWidth="360"
                                    MaxWidth="720"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Audio"
                                    ItemsSource="{x:Bind ViewModel.AudioLabels, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.SelectedAudioIndex, Mode=TwoWay}" />
                            </ctk:Case>
                        </ctk:SwitchPresenter>
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource GlassTextSecondaryBrush}"
                            Style="{StaticResource GlassMetaTextBlockStyle}"
                            Text="Subtitle"
                            Visibility="{x:Bind ViewModel.HasSubtitles, Mode=OneWay}" />
                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            MinWidth="360"
                            MaxWidth="720"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Subtitle"
                            ItemsSource="{x:Bind ViewModel.SubtitleLabels, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedSubtitleIndex, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.HasSubtitles, Mode=OneWay}" />
                    </Grid>
                    <controls:ItemMetaRows Dto="{x:Bind ViewModel.Dto, Mode=OneWay}" />
                    <controls:CastRow Heading="Cast &amp; crew" People="{x:Bind ViewModel.Dto.People, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <controls:LoadStateView
            State="{x:Bind ViewModel.State}"
            VerticalContentAlignment="Center" />
    </Grid>
</Page>
