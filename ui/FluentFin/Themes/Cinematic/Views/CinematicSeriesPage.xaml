<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Themes.Cinematic.Views.CinematicSeriesPage"
    lc:TopBar.ExtendsUnder="True"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:FluentFin.Themes.Cinematic.Controls"
    xmlns:cin="using:FluentFin.Themes.Cinematic"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Themes.Cinematic.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Background="{ThemeResource CinematicNightBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  an episode still: 370 x 208 (300 x 169 narrow); Enter or a click plays it, its menu opens its page  -->
        <DataTemplate x:Key="EpisodeLarge" x:DataType="vm:BaseItemViewModel">
            <cc:CinematicStill
                Margin="16,14,16,14"
                ArtHeight="208"
                ArtWidth="370"
                DecodeWidth="600"
                Kind="Episode"
                Model="{x:Bind}"
                ShowTitleArt="False" />
        </DataTemplate>
        <DataTemplate x:Key="EpisodeSmall" x:DataType="vm:BaseItemViewModel">
            <cc:CinematicStill
                Margin="12,12,12,12"
                ArtHeight="169"
                ArtWidth="300"
                DecodeWidth="520"
                Kind="Episode"
                Model="{x:Bind}"
                ShowTitleArt="False"
                TitleSize="15" />
        </DataTemplate>
        <DataTemplate x:Key="StillSmall" x:DataType="vm:BaseItemViewModel">
            <cc:CinematicStill
                Margin="12,12,12,12"
                ArtHeight="169"
                ArtWidth="300"
                DecodeWidth="520"
                Model="{x:Bind}"
                TitleArtLogoHeight="44"
                TitleArtSize="20"
                TitleSize="15" />
        </DataTemplate>
    </Page.Resources>

    <!--
        Nixie 1.3.0, Cinematic Series (docs\reports\Nixie redesign concepts, "Theme 1: Cinematic", 02-series): a full-bleed page.
        The show's backdrop fills the first screen with its details at the lower left (CinematicItemStage), and directly under
        the actions the season tabs and the season's episodes as a shelf of stills (Enter or a click plays an episode, as the
        shared episode row; its menu opens the episode's page). Below: the details, cast and More like this. Same view model,
        same loading, same Back place as the shared series page.
    -->
    <Grid>
        <ScrollViewer x:Name="PageContent">
            <StackPanel>
                <cc:CinematicItemStage
                    x:Name="Stage"
                    Dto="{x:Bind ViewModel.Dto, Mode=OneWay}"
                    Kicker="{x:Bind local:CinematicSeriesPage.KickerFor(ViewModel.Dto, ViewModel.Seasons), Mode=OneWay}">
                    <cc:CinematicItemStage.PrimaryActions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!--  the page's one Primary: what Play starts ("Resume S1 E3", "Play S2 E1"; ItemPlay)  -->
                            <Button
                                x:Name="PlayButton"
                                AutomationProperties.Name="{x:Bind ViewModel.PlayTarget.Name, Mode=OneWay}"
                                Command="{x:Bind root:App.Commands.PlayDtoCommand}"
                                CommandParameter="{x:Bind ViewModel.Dto, Mode=OneWay}"
                                Style="{StaticResource NixiePrimaryButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.PlayTarget.Name, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                    <TextBlock Text="{x:Bind ViewModel.PlayTarget.Label, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <!--  how far in: a number you read (nixie orange), not a control  -->
                            <StackPanel
                                Margin="2,0,8,0"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.PlayTarget.HasProgress, Mode=OneWay}">
                                <TextBlock
                                    x:Name="LeftText"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CinematicNumberBrush}"
                                    Text="{x:Bind local:CinematicSeriesPage.LeftFor(ViewModel.Episodes), Mode=OneWay}" />
                                <ProgressBar
                                    Width="110"
                                    Height="4"
                                    MinHeight="4"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Background="{ThemeResource CinematicProgressTrackBrush}"
                                    Foreground="{ThemeResource CinematicProgressBrush}"
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.PlayTarget.ProgressValue, Mode=OneWay}">
                                    <ProgressBar.Resources>
                                        <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                            </StackPanel>
                        </StackPanel>
                    </cc:CinematicItemStage.PrimaryActions>
                    <cc:CinematicItemStage.BottomContent>
                        <StackPanel
                            x:Name="EpisodesBlock"
                            Padding="0,0,0,24"
                            Visibility="{x:Bind c:ItemRowConverters.Show(ViewModel.HasEpisodeSection), Mode=OneWay, FallbackValue=Collapsed}">
                            <!--  the season tabs, the season's count, and the link to the season's own page  -->
                            <StackPanel
                                x:Name="TabsRow"
                                Margin="88,0,48,6"
                                Orientation="Horizontal"
                                Spacing="18">
                                <cc:CinematicTabStrip x:Name="SeasonTabs" AutomationProperties.Name="Seasons" TabInvoked="SeasonTabs_TabInvoked" />
                                <TextBlock
                                    x:Name="SeasonSummaryText"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CinematicShelfCountTextBlockStyle}"
                                    Text="{x:Bind local:CinematicSeriesSupport.Summary(ViewModel.Episodes), Mode=OneWay}" />
                                <HyperlinkButton
                                    MinHeight="32"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind root:App.Commands.DisplayDtoCommand}"
                                    CommandParameter="{x:Bind ViewModel.SelectedSeason, Mode=OneWay}"
                                    Content="{x:Bind ViewModel.SeasonDetailsText, Mode=OneWay}"
                                    Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                            </StackPanel>
                            <!--  the season's episodes: a shelf of stills (one Tab stop, Left/Right; Narrator's list "Episodes")  -->
                            <lc:ShelfRow
                                x:Name="EpisodeShelf"
                                controls:UpNextMark.EpisodeId="{x:Bind ViewModel.PlayTarget.EpisodeId, Mode=OneWay}"
                                Margin="80,0,0,0"
                                Header="Episodes"
                                ItemTemplate="{StaticResource EpisodeLarge}"
                                ItemsSource="{x:Bind local:CinematicSeriesSupport.Wrap(ViewModel.Episodes), Mode=OneWay}"
                                Loaded="EpisodeShelf_Loaded">
                            </lc:ShelfRow>
                            <StackPanel
                                Margin="96,8,48,0"
                                Orientation="Horizontal"
                                Spacing="16"
                                Visibility="{x:Bind c:ItemRowConverters.Show(ViewModel.HasEpisodesMessage), Mode=OneWay}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                    Text="{x:Bind ViewModel.EpisodesMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Command="{x:Bind ViewModel.RetrySeasonCommand}"
                                    Content="Try again"
                                    Style="{StaticResource NixieButtonStyle}"
                                    Visibility="{x:Bind c:ItemRowConverters.Show(ViewModel.EpisodesFailed), Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </cc:CinematicItemStage.BottomContent>
                </cc:CinematicItemStage>

                <!--  below the first screen: the details, cast and More like this, plain sections  -->
                <!--  the light theme: the stage's dusk fades into the page's ground  -->
                <Border
                    Height="72"
                    AutomationProperties.AccessibilityView="Raw"
                    Background="{ThemeResource CinematicFirstScreenFadeBrush}"
                    IsHitTestVisible="False" />
                <StackPanel
                    x:Name="Body"
                    Margin="96,24,48,56"
                    Spacing="32">
                    <controls:ItemMetaRows Dto="{x:Bind ViewModel.Dto, Mode=OneWay}" />
                    <controls:CastRow Heading="Cast &amp; crew" People="{x:Bind ViewModel.Dto.People, Mode=OneWay}" />
                    <lc:ShelfRow
                        x:Name="SimilarShelf"
                        Margin="-12,0,0,0"
                        HasSeeAll="True"
                        Header="More like this"
                        ItemsSource="{x:Bind ViewModel.Similar, Mode=OneWay}"
                        ItemTemplate="{StaticResource StillSmall}"
                        Loaded="SimilarShelf_Loaded"
                        SeeAll="SimilarSeeAll"
                        Visibility="{x:Bind c:ItemRowConverters.Show(ViewModel.Similar.Count), Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <controls:LoadStateView
            State="{x:Bind ViewModel.State}"
            VerticalContentAlignment="Center" />
    </Grid>
</Page>
