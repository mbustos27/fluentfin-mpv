<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Themes.Cinematic.Views.CinematicHomePage"
    lc:TopBar.ExtendsUnder="True"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:FluentFin.Themes.Cinematic.Controls"
    xmlns:ctkl="using:CommunityToolkit.Labs.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Themes.Cinematic.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Background="{ThemeResource CinematicNightBrush}"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <!--  the stills, x:Bind to the item (a list's element never gets the item as its DataContext here)  -->
    <Page.Resources>
        <!--  Up next: "S1 E3 · Sawdust · 44 min left" under each still (CinematicLabels.UpNextLine)  -->
        <DataTemplate x:Key="UpNextLarge" x:DataType="vm:BaseItemViewModel">
            <cc:CinematicStill
                Margin="16,14,16,14"
                Line="{x:Bind vm:CinematicLabels.UpNextLine(Dto)}"
                Model="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="UpNextSmall" x:DataType="vm:BaseItemViewModel">
            <cc:CinematicStill
                Margin="12,12,12,12"
                ArtHeight="169"
                ArtWidth="300"
                DecodeWidth="520"
                Line="{x:Bind vm:CinematicLabels.UpNextLine(Dto)}"
                Model="{x:Bind}"
                TitleArtLogoHeight="44"
                TitleArtSize="20"
                TitleSize="15" />
        </DataTemplate>
        <DataTemplate x:Key="StillSmall" x:DataType="vm:BaseItemViewModel">
            <cc:CinematicStill
                Margin="12,12,12,12"
                ArtHeight="169"
                ArtWidth="300"
                DecodeWidth="520"
                Model="{x:Bind}"
                TitleArtLogoHeight="44"
                TitleArtSize="20"
                TitleSize="15" />
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Invoked="NextUpInvoked" />
        <KeyboardAccelerator Key="C" Invoked="ContinueInvoked" />
        <KeyboardAccelerator
            Key="Z"
            Invoked="UndoInvoked"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <!--
        Nixie 1.3.0, Cinematic Home (docs\reports\Nixie redesign concepts, "Theme 1: Cinematic"): the first screen is one title
        filling the window under the floating island (CinematicHero), with the Up next shelf (Continue Watching, then Next Up:
        HomeViewModel.UpNext) laid over the foot of its art below a thin horizon line. The libraries' "New in" shelves follow, as
        smaller stills. Same view model, same loading (placeholders until each part answers), the same notice and Undo after a
        removal, the same keys (N and C go to Up next) and the same place on Back as the shared Home.
    -->
    <Grid>
        <ScrollViewer
            x:Name="PageScroller"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <!--  the first screen is dusk in every theme (the art, the island over it, Up next on its foot); below it, the theme  -->
                <Grid x:Name="FirstScreen" RequestedTheme="Dark">
                    <cc:CinematicHero x:Name="Hero" Slides="{x:Bind ViewModel.Hero, Mode=OneWay}" />

                    <StackPanel
                        x:Name="UpNextBlock"
                        Padding="0,0,0,28"
                        VerticalAlignment="Bottom">
                        <!--  the horizon where the art meets the shelf  -->
                        <Rectangle
                            x:Name="Horizon"
                            Height="2"
                            Margin="0,0,0,18"
                            AutomationProperties.AccessibilityView="Raw"
                            Fill="{ThemeResource CinematicHorizonBrush}"
                            IsHitTestVisible="False" />
                        <lc:LoadStateView x:Name="StateView" Margin="96,0,96,12" State="{x:Bind ViewModel.State}" />

                        <!--  the loading state: the title and placeholder stills in the shelf's slots  -->
                        <StackPanel
                            x:Name="UpNextPlaceholder"
                            Margin="96,0,0,0"
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.UpNext.IsLoading, Mode=OneWay}">
                            <TextBlock Style="{StaticResource CinematicShelfTitleTextBlockStyle}" Text="Up next" />
                            <StackPanel Orientation="Horizontal" Spacing="32">
                                <ctkl:Shimmer Width="{x:Bind StillWidth, Mode=OneWay}" Height="{x:Bind StillHeight, Mode=OneWay}" CornerRadius="8" />
                                <ctkl:Shimmer Width="{x:Bind StillWidth, Mode=OneWay}" Height="{x:Bind StillHeight, Mode=OneWay}" CornerRadius="8" />
                                <ctkl:Shimmer Width="{x:Bind StillWidth, Mode=OneWay}" Height="{x:Bind StillHeight, Mode=OneWay}" CornerRadius="8" />
                                <ctkl:Shimmer Width="{x:Bind StillWidth, Mode=OneWay}" Height="{x:Bind StillHeight, Mode=OneWay}" CornerRadius="8" />
                                <ctkl:Shimmer Width="{x:Bind StillWidth, Mode=OneWay}" Height="{x:Bind StillHeight, Mode=OneWay}" CornerRadius="8" />
                            </StackPanel>
                        </StackPanel>

                        <lc:ShelfRow
                            x:Name="UpNextRow"
                            Margin="80,0,0,0"
                            HasSeeAll="True"
                            Header="Up next"
                            ItemsSource="{x:Bind ViewModel.UpNext.Items, Mode=OneWay}"
                            ItemTemplate="{StaticResource UpNextLarge}"
                            SeeAll="UpNextSeeAll"
                            Visibility="{x:Bind local:CinematicHomePage.UpNextVisibility(ViewModel.UpNext.IsLoading, ViewModel.UpNext.HasItems), Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!--  the light theme: the dusk of the first screen fades into the page's ground  -->
                <Border
                    Height="96"
                    AutomationProperties.AccessibilityView="Raw"
                    Background="{ThemeResource CinematicFirstScreenFadeBrush}"
                    IsHitTestVisible="False" />
                <!--  the libraries' newest, as smaller stills; an ItemsControl so Tab reaches every row  -->
                <ItemsControl
                    x:Name="RecentRows"
                    Margin="0,8,0,48"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.RecentItems, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NamedQueryResult">
                            <Grid>
                                <lc:ShelfRow
                                    Margin="{Binding ElementName=Page, Path=RowMargin}"
                                    HasSeeAll="True"
                                    Header="{x:Bind Title}"
                                    ItemsSource="{x:Bind Items, Mode=OneWay}"
                                    ItemTemplate="{StaticResource StillSmall}"
                                    Loaded="RecentRow_Loaded"
                                    SeeAll="RecentSeeAll"
                                    Tag="{x:Bind Library}"
                                    Visibility="{x:Bind local:CinematicHomePage.LoadedVisibility(IsLoading), Mode=OneWay}" />
                                <StackPanel
                                    Margin="{Binding ElementName=Page, Path=PlaceholderMargin}"
                                    Spacing="16"
                                    Visibility="{x:Bind IsLoading, Mode=OneWay}">
                                    <Grid Height="40">
                                        <TextBlock Style="{StaticResource CinematicShelfTitleTextBlockStyle}" Text="{x:Bind Title}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="24">
                                        <ctkl:Shimmer Width="300" Height="169" CornerRadius="8" />
                                        <ctkl:Shimmer Width="300" Height="169" CornerRadius="8" />
                                        <ctkl:Shimmer Width="300" Height="169" CornerRadius="8" />
                                        <ctkl:Shimmer Width="300" Height="169" CornerRadius="8" />
                                        <ctkl:Shimmer Width="300" Height="169" CornerRadius="8" />
                                        <ctkl:Shimmer Width="300" Height="169" CornerRadius="8" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="28" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!--  1.6 collections: the Made by Nixie rows, after "New in ...", each under a small "Made by Nixie" kicker  -->
                <ItemsControl
                    x:Name="NixieRows"
                    Margin="0,0,0,48"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.NixieRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NixieHomeRowViewModel">
                            <StackPanel>
                                <TextBlock
                                    Margin="{Binding ElementName=Page, Path=PlaceholderMargin}"
                                    CharacterSpacing="80"
                                    Foreground="{ThemeResource GlassTextSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="MADE BY NIXIE" />
                                <lc:ShelfRow
                                    Margin="{Binding ElementName=Page, Path=RowMargin}"
                                    HasSeeAll="True"
                                    Header="{x:Bind Title}"
                                    ItemsSource="{x:Bind Items, Mode=OneWay}"
                                    ItemTemplate="{StaticResource StillSmall}"
                                    Loaded="RecentRow_Loaded"
                                    SeeAll="NixieSeeAll"
                                    Tag="{x:Bind}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="28" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!--  end 1.6 collections  -->
            </StackPanel>
        </ScrollViewer>

        <!--  the notice after a removal from Up next (Continue Watching): the shared Home's, the overlay recipe  -->
        <Border
            x:Name="NoticePanel"
            MinHeight="56"
            MaxWidth="640"
            Margin="24,0,24,32"
            Padding="20,8,8,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource GlassPanelStrongBrush}"
            BorderBrush="{ThemeResource GlassStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource GlassOverlayCornerRadius}"
            GotFocus="Notice_GotFocus"
            LostFocus="Notice_LostFocus"
            PointerEntered="Notice_PointerEntered"
            PointerExited="Notice_PointerExited"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="NoticeText"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource GlassTextPrimaryBrush}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="UndoButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Undo"
                    Click="UndoButton_Click"
                    Content="Undo"
                    Style="{StaticResource NixieCompactButtonStyle}"
                    ToolTipService.ToolTip="Undo (Ctrl+Z)"
                    Visibility="Collapsed" />
                <Button
                    x:Name="NoticeCloseButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Close the notice"
                    Click="NoticeCloseButton_Click"
                    Style="{StaticResource NixieCompactIconButtonStyle}"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
