<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Themes.Cinematic.Views.CinematicLibraryPage"
    lc:TopBar.ExtendsUnder="True"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:FluentFin.Themes.Cinematic.Controls"
    xmlns:ctkl="using:CommunityToolkit.Labs.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:lc="using:FluentFin.Controls"
    xmlns:local="using:FluentFin.Themes.Cinematic.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:FluentFin.Views"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Background="{ThemeResource CinematicNightBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  the grid's stills: 264 x 149 (224 x 126 in a narrow window); the slot holds the rim and the zoom's room  -->
        <DataTemplate x:Key="GridLarge" x:DataType="vm:BaseItemViewModel">
            <cc:CinematicStill
                Margin="12,8,12,8"
                ArtHeight="149"
                ArtWidth="264"
                DecodeWidth="440"
                Line="{x:Bind local:CinematicLibraryPage.LineFor(Dto)}"
                Model="{x:Bind}"
                ShowTitleArt="False"
                TitleSize="15" />
        </DataTemplate>
        <DataTemplate x:Key="GridSmall" x:DataType="vm:BaseItemViewModel">
            <cc:CinematicStill
                Margin="12,6,12,6"
                ArtHeight="126"
                ArtWidth="224"
                DecodeWidth="380"
                Line="{x:Bind local:CinematicLibraryPage.LineFor(Dto)}"
                Model="{x:Bind}"
                ShowTitleArt="False"
                TitleSize="14" />
        </DataTemplate>
        <!--  Nixie 1.4.0 (the UX review's C-M15, item 12): the Posters view, the shared poster card at its 2:3  -->
        <DataTemplate x:Key="PosterCard" x:DataType="vm:BaseItemViewModel">
            <ItemContainer
                AutomationProperties.AccessibilityView="Raw"
                CornerRadius="8"
                IsTabStop="False"
                Style="{StaticResource BareItemContainerStyle}">
                <lc:BaseItemDtoCard
                    BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Dto, jm:ImageType.Primary, 352)}"
                    ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Dto, jm:ImageType.Primary, 352)}"
                    Model="{x:Bind}" />
            </ItemContainer>
        </DataTemplate>
        <!--  the list's row (View > List)  -->
        <DataTemplate x:Key="ListRow" x:DataType="vm:BaseItemViewModel">
            <ItemContainer
                AutomationProperties.AccessibilityView="Raw"
                IsTabStop="False"
                Style="{StaticResource BareItemContainerStyle}">
                <lc:LibraryListRow Model="{x:Bind}" />
            </ItemContainer>
        </DataTemplate>
        <!--  the A-Z letters: flat, at least 32 high (WCAG 2.5.8), the letter in view underlined in the accent  -->
        <Style x:Key="CinematicLetterButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!--
        Nixie 1.3.0, Cinematic Library (03-library). Nixie 1.4.0 (the UX review's C-M1, C-M2, C-M4, C-M15; items 2, 4, 12, 13):
        the library's name (the page's H1, read first), then the preview stage, a third of the window at most (the title the
        keyboard or the pointer is on, else the first in view, with its own Play: the library's one Primary), which folds to a
        96 px band once the grid scrolls; on the night ground directly above the grid, its header line: the sections as
        presets (lit only when they are exactly what is shown; they never reset the sort) and the shared toolbar (Unwatched,
        Sort in words, the direction, Filter, View with stills or posters); the filters on; the A to Z with "M · 324 of 320";
        then the stills (or posters, or the list). The grid, the jump, the sort and the filter are the shared library's
        (LibraryViewModel, LibraryGridHost, CardGrid: one Tab stop, arrows both ways, "n of m"). Ctrl+Up from a still: the
        stage's Play.
    -->
    <Grid x:Name="LibraryRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="StageRow" Height="312" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  the library's name first (the H1 Narrator reads before the preview); drawn over the stage (its ZIndex)  -->
        <Grid
            x:Name="TopLine"
            Margin="96,60,96,0"
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            RequestedTheme="Dark">
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource CinematicPageTitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <cc:CinematicPreviewStage
            x:Name="Stage"
            Grid.RowSpan="5"
            VerticalAlignment="Top"
            Canvas.ZIndex="0" />

        <!--  the header line, on the night ground above the grid: the sections (presets) and the shared toolbar  -->
        <Grid
            x:Name="HeaderLine"
            Grid.Row="1"
            Margin="96,0,96,10"
            Canvas.ZIndex="1"
            ColumnSpacing="20"
            Visibility="{x:Bind shared:LibraryPage.BarVisibility(ViewModel.State.Status), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <cc:CinematicTabStrip
                x:Name="SectionTabs"
                VerticalAlignment="Center"
                AutomationProperties.Name="Sections"
                TabFontSize="16"
                TabInvoked="SectionTabs_TabInvoked" />
            <lc:LibraryToolbar
                x:Name="SortFilterBar"
                Grid.Column="1"
                VerticalAlignment="Center"
                ShowArtChoice="True"
                ViewModel="{x:Bind ViewModel}" />
        </Grid>

        <!--  what is filtered  -->
        <lc:AppliedFilterRow
            x:Name="AppliedFilters"
            Grid.Row="2"
            Margin="96,0,96,10"
            Canvas.ZIndex="1"
            ViewModel="{x:Bind ViewModel}" />

        <!--  the A to Z (or the sort's directions) and where the view is; its height kept while loading  -->
        <Grid
            x:Name="LetterRow"
            Grid.Row="3"
            MinHeight="32"
            Margin="96,0,96,6"
            Canvas.ZIndex="1">
            <lc:LetterBar
                x:Name="Letters"
                LetterStyle="{StaticResource CinematicLetterButtonStyle}"
                TileWidth="30"
                ViewModel="{x:Bind ViewModel}" />
            <ctkl:Shimmer
                x:Name="LetterPlaceholder"
                Width="420"
                Height="32"
                HorizontalAlignment="Left"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>

        <!--  the grid on the page's ground (the light theme's too), the stage's dusk fading into it  -->
        <Border
            Grid.Row="4"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource CinematicNightBrush}"
            IsHitTestVisible="False" />
        <ScrollView x:Name="GridScroller" Grid.Row="4">
            <lc:RowList
                x:Name="GridList"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                TabFocusNavigation="Once">
                <ItemsRepeater
                    x:Name="GridRepeater"
                    Margin="84,0,84,32"
                    ItemTemplate="{StaticResource GridLarge}"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <!--  a slot is the still with its rim and its room for the zoom: a smaller slot would clip it  -->
                        <UniformGridLayout
                            x:Name="GridLayout"
                            ItemsJustification="Start"
                            ItemsStretch="None"
                            MinColumnSpacing="0"
                            MinItemHeight="224"
                            MinItemWidth="296"
                            MinRowSpacing="0"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </lc:RowList>
        </ScrollView>

        <!--  while the library loads: placeholders laid out by a copy of the grid's own layout, in a still's shape  -->
        <ItemsRepeater
            x:Name="Placeholders"
            Grid.Row="4"
            Margin="84,0,84,0"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            ItemsSource="{x:Bind local:CinematicLibraryPage.Slots(18)}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="x:Int32">
                    <StackPanel Margin="12,8,12,8" Spacing="8">
                        <ctkl:Shimmer
                            Width="264"
                            Height="149"
                            HorizontalAlignment="Left"
                            CornerRadius="8" />
                        <ctkl:Shimmer
                            Width="150"
                            Height="14"
                            HorizontalAlignment="Left"
                            CornerRadius="4" />
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
            <ItemsRepeater.Layout>
                <UniformGridLayout x:Name="SkeletonLayout" Orientation="Horizontal" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>

        <lc:LoadStateView
            Grid.Row="4"
            State="{x:Bind ViewModel.State}"
            VerticalContentAlignment="Center" />

        <!--  a filter that leaves nothing says so (and the stage, with its Play, goes)  -->
        <lc:LibraryNoMatchesView Grid.Row="4" ViewModel="{x:Bind ViewModel}" />
    </Grid>
</Page>
