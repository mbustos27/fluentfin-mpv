<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Themes.Cinematic.Controls.CinematicSignInScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AccessibilityView="Raw"
    IsHitTestVisible="False"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--
        Nixie 1.3.0, Cinematic's sign-in backdrop (SignInBackdropTemplate): a full-window dusk still, drawn as vectors (no image
        file): a banded sky over a low sun cut by three thin gaps, a mesa and a far butte, one saguaro, and the road running to
        the sun. The left third stays calm and dark for the form on glass. Decoration only: Narrator never reaches it. High
        contrast: the window colour alone (CinematicSignInScene.xaml.cs).
    -->
    <Grid x:Name="Root" Background="#1A0710">
        <Viewbox Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Canvas Width="1920" Height="1080">
                <!--  the sky: deep plum overhead to a rose band at the horizon  -->
                <Rectangle Width="1920" Height="730">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#1F0712" />
                            <GradientStop Offset="0.32" Color="#3B0D24" />
                            <GradientStop Offset="0.6" Color="#6E1E3E" />
                            <GradientStop Offset="0.84" Color="#A2465C" />
                            <GradientStop Offset="1" Color="#C0606A" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!--  the sun's soft glow  -->
                <Ellipse Canvas.Left="900" Canvas.Top="180" Width="960" Height="900">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#80F7AA9C" />
                            <GradientStop Offset="0.45" Color="#30EC6A79" />
                            <GradientStop Offset="1" Color="#00EC6A79" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!--  the sun, with three gaps across its lower part (the sky shows through)  -->
                <Path Data="M1240,645 A142,142 0 1 1 1524,645 L1524,652 L1240,652 Z M1240,664 L1524,664 L1523,676 L1241,676 Z M1243,688 L1521,688 L1517,698 L1247,698 Z M1252,708 L1512,708 L1506,716 L1258,716 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#FFE2B8" />
                            <GradientStop Offset="0.55" Color="#FCC79A" />
                            <GradientStop Offset="1" Color="#F5A88E" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <!--  the far butte at the right and the near mesa at the left of the road  -->
                <Path Data="M1772,722 C1790,690 1800,662 1812,650 L1920,650 L1920,722 Z" Fill="#4A1428" />
                <Path Data="M604,722 C626,690 646,642 660,617 L834,617 C848,628 880,666 900,690 C930,705 980,716 1040,722 Z" Fill="#3F1023" />
                <!--  the ground  -->
                <Rectangle Canvas.Top="718" Width="1920" Height="362">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#5A1A30" />
                            <GradientStop Offset="0.08" Color="#3A0F22" />
                            <GradientStop Offset="1" Color="#1A0710" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!--  the road and its lit edges  -->
                <Path Data="M1374,722 L1390,722 L2160,1080 L620,1080 Z" Fill="#220A14" />
                <Path
                    Data="M1374,722 L620,1080 M1390,722 L2160,1080"
                    Stroke="#7A3446"
                    StrokeThickness="3" />
                <!--  the centre line: dashes that grow toward the viewer  -->
                <Path Data="M1381,736 L1383,736 L1383.5,748 L1380.5,748 Z M1380,766 L1384,766 L1384.6,784 L1379.4,784 Z M1379,818 L1385,818 L1385.8,846 L1378.2,846 Z M1377.5,888 L1386.5,888 L1387.5,930 L1376.5,930 Z M1375.5,976 L1388.5,976 L1390,1032 L1374,1032 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#B7826E" />
                            <GradientStop Offset="1" Color="#E0B49A" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <!--  the saguaro: one stroke family, rounded elbows  -->
                <Path
                    Data="M866,910 L866,660 M866,800 C866,810 860,812 846,812 L828,812 C816,812 812,806 812,794 L812,745 M866,760 C866,770 872,772 886,772 L904,772 C916,772 920,766 920,754 L920,700"
                    Stroke="#2A0A17"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="30" />
            </Canvas>
        </Viewbox>
        <!--  the calm side for the form, and a soft foot  -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#B312050B" />
                    <GradientStop Offset="0.32" Color="#6612050B" />
                    <GradientStop Offset="0.5" Color="#0012050B" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
