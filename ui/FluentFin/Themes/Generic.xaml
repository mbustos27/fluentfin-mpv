<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cb="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:cl="using:FluentFin.Controls.Lights"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:FluentFin.Controls"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/MenuFlyoutButton.xaml" />
        <!--  Nixie 1.3.0: the top bar's chrome as 1.2.0 drew it (a theme's TopBarStyle goes over it)  -->
        <ResourceDictionary Source="/Styles/TopBarChrome.xaml" />
        <!--  Nixie 1.3.1: the theatre window's shared glass frame (a theme's TrailerFrameTemplate goes over it)  -->
        <ResourceDictionary Source="/Styles/TrailerFrame.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>

