<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluentFin.Dialogs.Views.QuickConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Dialogs.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:FluentFin.Dialogs.ViewModels"
    Title="Quick Connect"
    CloseButtonText="{x:Bind ViewModel.CloseText, Mode=OneWay}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanApprove, Mode=OneWay}"
    PrimaryButtonCommand="{x:Bind ViewModel.VerifyQuickConnectCommand}"
    PrimaryButtonText="Approve"
    Style="{StaticResource DefaultContentDialogStyleWithTitleBackground}"
    mc:Ignorable="d">

    <!--
        Seaglass 1.1.4 (layout audit, item 18): signs in another device with this account: one plain instruction, a "Code" field,
        Approve / Cancel (Close once approved). It said "the device you are logging in from" in an info bar, with OK / Close.
    -->
    <StackPanel Width="500" Spacing="16">
        <TextBlock Text="Enter the code shown on the other device. It signs in with your account as soon as you approve it." TextWrapping="WrapWholeWords" />

        <StackPanel Spacing="4">
            <TextBox
                x:Name="CodeBox"
                AutomationProperties.Name="Code"
                FontSize="20"
                Header="Code"
                InputScope="Number"
                Text="{x:Bind ViewModel.QuickConnectCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <!--  Seaglass 1.1.4: what Approve did (approved, or the code did not work), read out as it changes  -->
            <TextBlock
                x:Name="StatusText"
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>
    </StackPanel>

</ContentDialog>
