<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluentFin.Dialogs.Views.SessionPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:local="using:FluentFin.Dialogs.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:FluentFin.Dialogs.ViewModels"
    Title="Play on another device"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanPick, Mode=OneWay}"
    PrimaryButtonCommand="{x:Bind ViewModel.PlayOnSessionCommand}"
    PrimaryButtonText="{x:Bind ViewModel.PickText, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyleWithTitleBackground}"
    mc:Ignorable="d">

    <!--  Nixie 1.2.0 (admin, A71 / A72): the primary waits for a pick (it threw with none); an empty list says so  -->
    <Grid MinWidth="360">
        <TextBlock
            Style="{ThemeResource BodyTextBlockStyle}"
            Text="No other devices are signed in right now."
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        <ListView
            x:Name="ItemsView"
            AutomationProperties.Name="Devices"
            ContainerContentChanging="ItemsView_ContainerContentChanging"
            ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedSesion, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="jm:SessionInfoDto">
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Client}" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                            <Run Text="{x:Bind DeviceName}" /><Run Text=" · " /><Run Text="{x:Bind UserName}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

</ContentDialog>
