<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The glass look (docs/design/SEAGLASS.md; 1.1.4: the desert-sunset palette, deep plum glass with a hot-pink accent in the
        dark theme, pale peach glass with crimson in the light one): the materials, shapes and type that every page uses, so that
        the pages look like one app. Glass (in-app acrylic) is for panels, bars, pills and menus, never for each card in a
        row: every acrylic surface costs GPU time. High contrast: solid system colours, no glass.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SeaglassAccentColor">#F96985</Color>
            <Color x:Key="SeaglassDeepColor">#170508</Color>
            <SolidColorBrush x:Key="SeaglassAccentBrush" Color="#F96985" />
            <SolidColorBrush x:Key="SeaglassAccentOnImageBrush" Color="#FF9EB1" />
            <SolidColorBrush x:Key="SeaglassOnAccentOnImageBrush" Color="#24060F" />
            <SolidColorBrush x:Key="SeaglassDeepBrush" Color="#170508" />
            <AcrylicBrush
                x:Key="GlassPanelBrush"
                FallbackColor="#F02A1217"
                TintColor="#2A1217"
                TintLuminosityOpacity="0.34"
                TintOpacity="0.62" />
            <AcrylicBrush
                x:Key="GlassPanelStrongBrush"
                FallbackColor="#F534181D"
                TintColor="#34181D"
                TintLuminosityOpacity="0.8"
                TintOpacity="0.77" />
            <!--  one thin, light edge: brightest along the top (the warm white of a low sun), nearly gone below  -->
            <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#59FFEDE8" />
                <GradientStop Offset="0.3" Color="#14FFFFFF" />
                <GradientStop Offset="1" Color="#0AFFFFFF" />
            </LinearGradientBrush>
            <!--  the inner bevel: a second, fainter stroke just inside the rim, lit along the top edge only  -->
            <LinearGradientBrush x:Key="GlassBevelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#2EFFFFFF" />
                <GradientStop Offset="0.12" Color="#00FFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <!--  the milk of frosted glass: a little white over the tint  -->
            <SolidColorBrush x:Key="GlassMilkBrush" Color="#08FFFFFF" />
            <!--  the faint inner glow along a panel's top: light that seems to enter the glass edge  -->
            <LinearGradientBrush x:Key="GlassGlowBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#2EFFFFFF" />
                <GradientStop Offset="0.3" Color="#0AFFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <!--  the shadow under floating panels  -->
            <x:Double x:Key="GlassShadowOpacity">0.30</x:Double>
            <x:Double x:Key="GlassContactShadowOpacity">0.22</x:Double>
            <!--  the nixie glows: around a focused glass button, and under the primary action at rest  -->
            <x:Double x:Key="GlassGlowOpacity">0.7</x:Double>
            <x:Double x:Key="GlassRestGlowOpacity">0.45</x:Double>
            <SolidColorBrush x:Key="GlassHoverOverlayBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="GlassPressedOverlayBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="#F8EFF0" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="#D3BFC1" />
            <!--  under text laid over artwork: transparent at the top, dark at the bottom  -->
            <LinearGradientBrush x:Key="GlassImageScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00170508" />
                <GradientStop Offset="0.55" Color="#66170508" />
                <GradientStop Offset="1" Color="#F2170508" />
            </LinearGradientBrush>
            <!--  the soft artwork behind the window (AmbientBackdrop) is dimmed by this  -->
            <SolidColorBrush x:Key="GlassAmbientDimBrush" Color="#C7170508" />
            <SolidColorBrush x:Key="GlassSelectedOverlayBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="SeaglassAccentFillBrush" Color="#F96985" />
            <SolidColorBrush x:Key="SeaglassAccentForegroundBrush" Color="#24060F" />
            <!--  what GlassPanelBrush and GlassPanelStrongBrush become in Solid mode (GlassTheme): the same colours, opaque  -->
            <SolidColorBrush x:Key="GlassPanelSolidBrush" Color="#2A1217" />
            <SolidColorBrush x:Key="GlassPanelStrongSolidBrush" Color="#34181D" />
            <!--
                the overlays in windows of their own (menus, tooltips): a flat strong tint, never in-app acrylic. A menu's window
                already has Windows' acrylic under it (its system backdrop), so this is the one blur; in Solid it is opaque.
                SeaglassTheme sets both to the palette's container colour (OverlayColor).
            -->
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="#E634181D" />
            <SolidColorBrush x:Key="GlassOverlaySolidBrush" Color="#34181D" />
            <!--  a hairline inside an overlay (a dialog's line above its buttons)  -->
            <SolidColorBrush x:Key="GlassDividerBrush" Color="#1FFFFFFF" />
            <!--  a button that sits ON a glass panel: a flat light fill, never a second acrylic, and its label  -->
            <SolidColorBrush x:Key="GlassInsetFillBrush" Color="#1AFFFFFF" />
            <StaticResource x:Key="GlassInsetTextBrush" ResourceKey="GlassTextPrimaryBrush" />
            <!--
                keyboard focus: WinUI's two rings, the neon core's near-white (outer: it reads on the hot-pink Play too, where a pink
                ring would vanish) around the deep colour (inner); the glow brings the colour. High contrast keeps WinUI's own.
            -->
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#170508" />
            <!--  behind a dialog: a dusk smoke, not WinUI's grey (high contrast keeps WinUI's own)  -->
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#A61A0710" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SeaglassAccentColor">#BC1E47</Color>
            <Color x:Key="SeaglassDeepColor">#FFF6F3</Color>
            <SolidColorBrush x:Key="SeaglassAccentBrush" Color="#BC1E47" />
            <!--
                the accent ON ARTWORK (a progress bar on a poster's dark track, a watched badge): the light pink in both themes.
                The light theme's crimson has 1.2:1 on the track over a bright poster (Black65O over white); this keeps 3.6:1.
                Used by BaseItemDtoCard's and EpisodeRow's progress bars, whose Black65O track fills the whole bar
                (ProgressBarTrackHeight: WinUI draws a 1 px track line otherwise, and the bar would sit on the poster itself),
                and by EpisodeRow's watched mark, whose check takes SeaglassOnAccentOnImageBrush.
            -->
            <SolidColorBrush x:Key="SeaglassAccentOnImageBrush" Color="#FF9EB1" />
            <SolidColorBrush x:Key="SeaglassOnAccentOnImageBrush" Color="#24060F" />
            <SolidColorBrush x:Key="SeaglassDeepBrush" Color="#FFF6F3" />
            <AcrylicBrush
                x:Key="GlassPanelBrush"
                FallbackColor="#F0FCEAE8"
                TintColor="#FCEAE8"
                TintLuminosityOpacity="0.45"
                TintOpacity="0.28" />
            <AcrylicBrush
                x:Key="GlassPanelStrongBrush"
                FallbackColor="#F5FFF3F1"
                TintColor="#FFF3F1"
                TintLuminosityOpacity="0.85"
                TintOpacity="0.75" />
            <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.35" Color="#2E000000" />
                <GradientStop Offset="1" Color="#1F000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassBevelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#99FFFFFF" />
                <GradientStop Offset="0.12" Color="#00FFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlassMilkBrush" Color="#14FFFFFF" />
            <LinearGradientBrush x:Key="GlassGlowBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#99FFFFFF" />
                <GradientStop Offset="0.3" Color="#26FFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <x:Double x:Key="GlassShadowOpacity">0.22</x:Double>
            <x:Double x:Key="GlassContactShadowOpacity">0.20</x:Double>
            <x:Double x:Key="GlassGlowOpacity">0.45</x:Double>
            <x:Double x:Key="GlassRestGlowOpacity">0.3</x:Double>
            <SolidColorBrush x:Key="GlassHoverOverlayBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="GlassPressedOverlayBrush" Color="#08000000" />
            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="#2D0F16" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="#633A41" />
            <LinearGradientBrush x:Key="GlassImageScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00FFF6F3" />
                <GradientStop Offset="0.55" Color="#80FFF6F3" />
                <GradientStop Offset="1" Color="#F2FFF6F3" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlassAmbientDimBrush" Color="#85FFF6F3" />
            <SolidColorBrush x:Key="GlassSelectedOverlayBrush" Color="#1F000000" />
            <!--  light theme: the sunset's crimson, so white text on it reaches 4.5:1 (6.2:1)  -->
            <SolidColorBrush x:Key="SeaglassAccentFillBrush" Color="#BC1E47" />
            <SolidColorBrush x:Key="SeaglassAccentForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="GlassPanelSolidBrush" Color="#FCEAE8" />
            <SolidColorBrush x:Key="GlassPanelStrongSolidBrush" Color="#FFF3F1" />
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="#E6FFF3F1" />
            <SolidColorBrush x:Key="GlassOverlaySolidBrush" Color="#FFF3F1" />
            <SolidColorBrush x:Key="GlassDividerBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="GlassInsetFillBrush" Color="#0F000000" />
            <StaticResource x:Key="GlassInsetTextBrush" ResourceKey="GlassTextPrimaryBrush" />
            <!--  keyboard focus: WinUI's two rings, the accent (outer) around white (inner); high contrast keeps WinUI's own  -->
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#BC1E47" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#FFFFFF" />
            <!--  behind a dialog: a dusk smoke, not WinUI's grey (high contrast keeps WinUI's own)  -->
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#59500723" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="SeaglassAccentColor">#FFFFFF00</Color>
            <Color x:Key="SeaglassDeepColor">#FF000000</Color>
            <SolidColorBrush x:Key="SeaglassAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SeaglassAccentOnImageBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SeaglassOnAccentOnImageBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SeaglassDeepBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassPanelStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassGlowBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassBevelBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassMilkBrush" Color="Transparent" />
            <x:Double x:Key="GlassShadowOpacity">0</x:Double>
            <x:Double x:Key="GlassContactShadowOpacity">0</x:Double>
            <SolidColorBrush x:Key="GlassHoverOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassPressedOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassImageScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassAmbientDimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassSelectedOverlayBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SeaglassAccentFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SeaglassAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="GlassPanelSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassPanelStrongSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassOverlaySolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!--  a ButtonFace fill always carries ButtonText: a custom contrast scheme may make ButtonFace differ from Window  -->
            <SolidColorBrush x:Key="GlassInsetFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="GlassInsetTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        the glow of a lit nixie tube: warm orange-pink, the outer halo of a focused or primary control around the accent's own
        hot pink. One colour for both themes (it is only ever a soft shadow; GlassGlowOpacity makes it 0 in high contrast).
    -->
    <Color x:Key="GlassNeonGlowColor">#FF7A50</Color>
    <!--
        The glows' strength outside the Dark and Light dictionaries: none. High contrast has no value of its own for these two
        (its dictionary is the states stream's), so it falls back to these: no glow there.
    -->
    <x:Double x:Key="GlassGlowOpacity">0</x:Double>
    <x:Double x:Key="GlassRestGlowOpacity">0</x:Double>

    <!--  shapes  -->
    <!--  1.1.4: panels 12 like the pills and overlays (the layout audit: 20 read as phone cards)  -->
    <CornerRadius x:Key="GlassPanelCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="GlassCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="GlassButtonCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="GlassChipCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="GlassCircleCornerRadius">999</CornerRadius>
    <!--  every overlay: menus, context menus, flyouts, tooltips, dialogs  -->
    <CornerRadius x:Key="GlassOverlayCornerRadius">12</CornerRadius>
    <Thickness x:Key="GlassStrokeThickness">1</Thickness>
    <x:Double x:Key="GlassPillHeight">44</x:Double>

    <!--  type: Segoe UI Variable (Windows' own; Segoe UI on Windows 10)  -->
    <FontFamily x:Key="GlassDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="GlassTextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="GlassHeroTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassDisplayFontFamily}" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style x:Key="GlassPageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassDisplayFontFamily}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
    <Style x:Key="GlassSectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassDisplayFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
    </Style>
    <Style x:Key="GlassMetaTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassTextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  a glass panel: a Border with the frosted brush, the light edge and the panel corners  -->
    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassPanelCornerRadius}" />
    </Style>

    <!--
        A glass surface for a section (details, cast, settings group, hero words): the frosted brush, the lit top edge, the
        inner glow and a soft shadow under it. Content: a ContentControl. The shadow is drawn outside the panel only, so it
        does not darken the glass. One layer deep: never inside another glass panel.
    -->
    <ControlTemplate x:Key="GlassSurfaceTemplate" TargetType="ContentControl">
        <Grid>
            <!--  two shadows, as thick glass casts: a tight contact one and a wide soft one  -->
            <Border CornerRadius="{TemplateBinding CornerRadius}">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="28"
                        CornerRadius="12"
                        Offset="0,10"
                        Opacity="{ThemeResource GlassShadowOpacity}"
                        Color="Black" />
                </ui:Effects.Shadow>
            </Border>
            <Border CornerRadius="{TemplateBinding CornerRadius}">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="8"
                        CornerRadius="12"
                        Offset="0,2"
                        Opacity="{ThemeResource GlassContactShadowOpacity}"
                        Color="Black" />
                </ui:Effects.Shadow>
            </Border>
            <!--  bottom to top: the frosted glass, the milk, the grain (barely there), the inner glow, the body, then one thin light edge  -->
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
            <Border
                Background="{ThemeResource GlassMilkBrush}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False" />
            <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
                <controls:GrainOverlay />
            </Border>
            <Border
                Background="{ThemeResource GlassGlowBrush}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False" />
            <!--  1.1.4: the slab's body: a frosted rim and a shade along the bottom (none in Solid)  -->
            <controls:GlassVolume CornerRadius="{TemplateBinding CornerRadius}" />
            <controls:PanelSheen />
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False" />
            <ContentPresenter
                Padding="{TemplateBinding Padding}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTransitions="{TemplateBinding ContentTransitions}" />
        </Grid>
    </ControlTemplate>
    <!--
        1.1.4: a section WITHOUT a panel (the layout audit's "boxes in boxes"): the same padding and stretch as GlassSurfaceStyle,
        nothing drawn behind it, so a shelf (cast, more like this, seasons, up next) sits on the page like Home's rows. Swap a
        page's Style="{StaticResource GlassSurfaceStyle}" for this one; keep GlassSurfaceStyle for at most one form-like block a
        page (an item's details) and never one inside another.
    -->
    <Style x:Key="GlassSectionStyle" TargetType="ContentControl">
        <Setter Property="Padding" Value="0,8,0,8" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ContentPresenter
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassSurfaceStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassPanelCornerRadius}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{StaticResource GlassSurfaceTemplate}" />
    </Style>

    <!--
        Buttons. Pointer-over and pressed stay glass: a light (dark theme) or dark (light theme) overlay over the same
        material, never the default solid fill. Keyboard focus keeps the system focus visuals (in the accent, Dark and Light
        dictionaries) and adds a soft glow of the accent; a disabled button fades. The accent pill is for the primary action
        only, and glows softly at rest.
    -->
    <ControlTemplate x:Key="GlassPillButtonTemplate" TargetType="Button">
        <Grid>
            <!--
                keyboard focus: a nixie glow around the pill (two soft shadows, made on the first focus: the accent close in, a warm
                orange halo further out), as well as the system's focus rings, which stay the focus mark (never colour alone).
                High contrast: no glow (opacity 0).
            -->
            <Grid
                x:Name="FocusGlow"
                x:DeferLoadStrategy="Lazy"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Border CornerRadius="{TemplateBinding CornerRadius}">
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow
                            BlurRadius="8"
                            CornerRadius="16"
                            Opacity="{ThemeResource GlassGlowOpacity}"
                            Color="{ThemeResource SeaglassAccentColor}" />
                    </ui:Effects.Shadow>
                </Border>
                <Border CornerRadius="{TemplateBinding CornerRadius}">
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow
                            BlurRadius="24"
                            CornerRadius="16"
                            Opacity="{ThemeResource GlassGlowOpacity}"
                            Color="{StaticResource GlassNeonGlowColor}" />
                    </ui:Effects.Shadow>
                </Border>
            </Grid>
            <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
                <Border
                    x:Name="Backplate"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
                <Border
                    x:Name="Overlay"
                    Background="Transparent"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Border.BackgroundTransition>
                        <BrushTransition Duration="0:0:0.12" />
                    </Border.BackgroundTransition>
                </Border>
                <ContentPresenter
                    x:Name="ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    AutomationProperties.AccessibilityView="Raw"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTransitions="{TemplateBinding ContentTransitions}"
                    Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource GlassHoverOverlayBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource GlassPressedOverlayBrush}" />
                            <Setter Target="RootGrid.Opacity" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusGlow.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
    <!--  the accent pill: the same, with the accent's resting glow under it  -->
    <ControlTemplate x:Key="GlassAccentPillButtonTemplate" TargetType="Button">
        <Grid>
        <!--  the primary action's resting glow: a soft halo of the accent, as a neon sign's (none in high contrast)  -->
        <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
            <ui:Effects.Shadow>
                <media:AttachedCardShadow
                    BlurRadius="16"
                    CornerRadius="14"
                    Offset="0,2"
                    Opacity="{ThemeResource GlassRestGlowOpacity}"
                    Color="{StaticResource GlassNeonGlowColor}" />
            </ui:Effects.Shadow>
        </Border>
            <!--
                keyboard focus: a nixie glow around the pill (two soft shadows, made on the first focus: the accent close in, a warm
                orange halo further out), as well as the system's focus rings, which stay the focus mark (never colour alone).
                High contrast: no glow (opacity 0).
            -->
            <Grid
                x:Name="FocusGlow"
                x:DeferLoadStrategy="Lazy"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Border CornerRadius="{TemplateBinding CornerRadius}">
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow
                            BlurRadius="8"
                            CornerRadius="16"
                            Opacity="{ThemeResource GlassGlowOpacity}"
                            Color="{ThemeResource SeaglassAccentColor}" />
                    </ui:Effects.Shadow>
                </Border>
                <Border CornerRadius="{TemplateBinding CornerRadius}">
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow
                            BlurRadius="24"
                            CornerRadius="16"
                            Opacity="{ThemeResource GlassGlowOpacity}"
                            Color="{StaticResource GlassNeonGlowColor}" />
                    </ui:Effects.Shadow>
                </Border>
            </Grid>
            <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
                <Border
                    x:Name="Backplate"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
                <Border
                    x:Name="Overlay"
                    Background="Transparent"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Border.BackgroundTransition>
                        <BrushTransition Duration="0:0:0.12" />
                    </Border.BackgroundTransition>
                </Border>
                <ContentPresenter
                    x:Name="ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    AutomationProperties.AccessibilityView="Raw"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTransitions="{TemplateBinding ContentTransitions}"
                    Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource GlassHoverOverlayBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource GlassPressedOverlayBrush}" />
                            <Setter Target="RootGrid.Opacity" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusGlow.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style
        x:Key="GlassPillButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassButtonCornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource GlassPillHeight}" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template" Value="{StaticResource GlassPillButtonTemplate}" />
    </Style>
    <Style
        x:Key="GlassAccentPillButtonStyle"
        BasedOn="{StaticResource AccentButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SeaglassAccentFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource SeaglassAccentForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassButtonCornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource GlassPillHeight}" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template" Value="{StaticResource GlassAccentPillButtonTemplate}" />
    </Style>
    <!--  a pill that sits on a glass panel (the hero's More info): the flat inset fill, so the glass is not drawn twice  -->
    <Style
        x:Key="GlassInsetPillButtonStyle"
        BasedOn="{StaticResource GlassPillButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource GlassInsetFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource GlassInsetTextBrush}" />
    </Style>
    <Style
        x:Key="GlassIconButtonStyle"
        BasedOn="{StaticResource GlassPillButtonStyle}"
        TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource GlassCircleCornerRadius}" />
        <Setter Property="Width" Value="{StaticResource GlassPillHeight}" />
        <Setter Property="Height" Value="{StaticResource GlassPillHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!--
        Overlays: the More menu, card context menus, the profile flyout, tooltips, every ContentDialog and the player's menus
        (MpvPlayerControls.xaml's PlayerMenuPresenter and PlayerFlyoutPresenter are BasedOn the two keyed styles below and set
        only their padding) share one recipe: one blur under a strong tint, the light glass edge, GlassOverlayCornerRadius, the
        glass text colour. Never acrylic on acrylic: a flyout or a dialog draws inside the window and gets the strong in-app
        glass (GlassPanelStrongBrush); a menu or a tooltip is a window of its own, where in-app acrylic has nothing to blur, so
        it gets the flat GlassOverlayBrush (a menu keeps Windows' acrylic under it as its one blur). Solid makes both opaque
        (GlassTheme); high contrast uses the system colours through the same brushes. The dialog's template is in TextBlock.xaml.
    -->
    <Style
        x:Key="GlassFlyoutPresenterStyle"
        BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
        TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource GlassPanelStrongBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassOverlayCornerRadius}" />
    </Style>
    <Style
        x:Key="GlassMenuFlyoutPresenterStyle"
        BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}"
        TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource GlassOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassOverlayCornerRadius}" />
    </Style>
    <Style BasedOn="{StaticResource GlassFlyoutPresenterStyle}" TargetType="FlyoutPresenter" />
    <Style BasedOn="{StaticResource GlassMenuFlyoutPresenterStyle}" TargetType="MenuFlyoutPresenter" />
    <Style BasedOn="{StaticResource DefaultToolTipStyle}" TargetType="ToolTip">
        <Setter Property="Background" Value="{ThemeResource GlassOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassOverlayCornerRadius}" />
        <Setter Property="Padding" Value="12,8,12,9" />
    </Style>
</ResourceDictionary>
