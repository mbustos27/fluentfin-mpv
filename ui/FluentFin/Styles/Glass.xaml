        Secondary (glass), Subtle and icon (circles at 44, rounded squares at 32), Destructive (the danger ink, never filled,
        never glowing), Link (neutral, underlined), Tab (a neon underline). Two sizes: Large 44 (media surfaces), Compact 32 (forms
        and chrome). One radius, 8. Every state: rest, hover (an overlay; the weight never changes), pressed (a darker overlay,
        content at 80 to 85 %), keyboard focus (WinUI's two rings 3 px outside, plus the glow on Primary, Secondary, icons), and
        disabled: a neutral fill and text, never a fade, no glow. High contrast: the system colours through the Nixie* keys.
        The 1.1.x keys are aliases of these, so other XAML keeps compiling.
    -->
    <!--  1.2.0 button sizes: Large on media surfaces (and their dialogs), Compact in forms and chrome  -->
    <x:Double x:Key="NixieButtonHeight">44</x:Double>
    <x:Double x:Key="NixieCompactButtonHeight">32</x:Double>
    <!--  Primary, Large: the accent fill, its resting glow; disabled turns neutral  -->
    <ControlTemplate x:Key="NixiePrimaryButtonTemplate" TargetType="Button">
        <Grid>
            <!--  the Large primary at rest: the same glow at half strength (none disabled, none in high contrast)  -->
            <Grid x:Name="RestGlow" IsHitTestVisible="False">
                <Border CornerRadius="{TemplateBinding CornerRadius}">
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow
                            BlurRadius="8"
                            CornerRadius="10"
                            Opacity="{ThemeResource GlassContactShadowOpacity}"
                            Color="{ThemeResource NixieAccentColor}" />
                    </ui:Effects.Shadow>
                </Border>
                <Border CornerRadius="{TemplateBinding CornerRadius}">
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow
                            BlurRadius="20"
                            CornerRadius="10"
                            Offset="0,2"
                            Opacity="{ThemeResource GlassContactShadowOpacity}"
                            Color="{ThemeResource GlassNeonGlowColor}" />
                    </ui:Effects.Shadow>
                </Border>
            </Grid>
            <!--
                keyboard focus: a nixie glow around the button (the accent close in, GlassNeonGlowColor further out; made on the first
                focus; AttachedCardShadow cuts out its inside, so a translucent fill never turns pink) besides WinUI's two rings, which
                carry the meaning. High contrast: the shadow opacities are 0.
            -->
            <Grid
                x:Name="FocusGlow"
                x:DeferLoadStrategy="Lazy"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Border CornerRadius="{TemplateBinding CornerRadius}">
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow
                            BlurRadius="6"
                            CornerRadius="10"
                            Opacity="{ThemeResource GlassShadowOpacity}"
                            Color="{ThemeResource NixieAccentColor}" />
                    </ui:Effects.Shadow>
                </Border>
                <Border CornerRadius="{TemplateBinding CornerRadius}">
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow
                            BlurRadius="12"
                            CornerRadius="10"
                            Opacity="{ThemeResource GlassShadowOpacity}"
                            Color="{ThemeResource NixieAccentColor}" />
                    </ui:Effects.Shadow>
                </Border>
                <Border CornerRadius="{TemplateBinding CornerRadius}">
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow
                            BlurRadius="24"
                            CornerRadius="10"
                            Opacity="{ThemeResource GlassShadowOpacity}"
                            Color="{ThemeResource GlassNeonGlowColor}" />
                    </ui:Effects.Shadow>
                </Border>
            </Grid>
            <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
                <Border
                    x:Name="Backplate"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
                <Border
                    x:Name="Overlay"
                    Background="Transparent"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Border.BackgroundTransition>
                        <BrushTransition Duration="0:0:0.12" />
                    </Border.BackgroundTransition>
                </Border>
                <ContentPresenter
                    x:Name="ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    AutomationProperties.AccessibilityView="Raw"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTransitions="{TemplateBinding ContentTransitions}"
                    Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixiePrimaryHoverOverlayBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixiePrimaryHoverForegroundBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixiePrimaryHoverBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixiePrimaryPressedOverlayBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixiePrimaryPressedForegroundBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixiePrimaryHoverBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Backplate.Background" Value="{ThemeResource NixieDisabledFillBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieDisabledBorderBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieDisabledForegroundBrush}" />
                            <Setter Target="RestGlow.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusGlow.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

