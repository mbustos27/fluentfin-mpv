    <!--
        A glass surface for a section (details, cast, settings group, hero words): the frosted brush, the lit top edge, the
        inner glow and a soft shadow under it. Content: a ContentControl. The shadow is drawn outside the panel only, so it
        does not darken the glass. One layer deep: never inside another glass panel.
    -->
    <ControlTemplate x:Key="GlassSurfaceTemplate" TargetType="ContentControl">
        <Grid>
            <!--  two shadows, as thick glass casts: a tight contact one and a wide soft one  -->
            <Border CornerRadius="{TemplateBinding CornerRadius}">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="28"
                        CornerRadius="12"
                        Offset="0,10"
                        Opacity="{ThemeResource GlassShadowOpacity}"
                        Color="Black" />
                </ui:Effects.Shadow>
            </Border>
            <Border CornerRadius="{TemplateBinding CornerRadius}">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="8"
                        CornerRadius="12"
                        Offset="0,2"
                        Opacity="{ThemeResource GlassContactShadowOpacity}"
                        Color="Black" />
                </ui:Effects.Shadow>
            </Border>
            <!--  bottom to top: the frosted glass, the milk, the grain (barely there), the inner glow, the body, then one thin light edge  -->
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
            <Border
                Background="{ThemeResource GlassMilkBrush}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False" />
            <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
                <controls:GrainOverlay />
            </Border>
            <Border
                Background="{ThemeResource GlassGlowBrush}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False" />
            <!--  1.1.4: the slab's body: a frosted rim and a shade along the bottom (none in Solid)  -->
            <controls:GlassVolume CornerRadius="{TemplateBinding CornerRadius}" />
            <controls:PanelSheen />
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False" />
            <ContentPresenter
                Padding="{TemplateBinding Padding}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTransitions="{TemplateBinding ContentTransitions}" />
        </Grid>
    </ControlTemplate>
    <!--
        1.1.4: a section WITHOUT a panel (the layout audit's "boxes in boxes"): the same padding and stretch as GlassSurfaceStyle,
        nothing drawn behind it, so a shelf (cast, more like this, seasons, up next) sits on the page like Home's rows. Swap a
        page's Style="{StaticResource GlassSurfaceStyle}" for this one; keep GlassSurfaceStyle for at most one form-like block a
        page (an item's details) and never one inside another.
    -->
    <Style x:Key="GlassSectionStyle" TargetType="ContentControl">
        <Setter Property="Padding" Value="0,8,0,8" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ContentPresenter
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassSurfaceStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassPanelCornerRadius}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
