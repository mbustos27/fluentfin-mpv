<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:converters="using:FluentFin.Converters"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The glass look (docs/design/DESIGN.md; 1.1.4: the desert-sunset palette, deep plum glass with a hot-pink accent in the
        dark theme, pale peach glass with crimson in the light one): the materials, shapes and type that every page uses, so that
        the pages look like one app. Glass (in-app acrylic) is for panels, bars, pills and menus, never for each card in a
        row: every acrylic surface costs GPU time. High contrast: solid system colours, no glass.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="NixieAccentColor">#F96985</Color>
            <Color x:Key="NixieDeepColor">#170508</Color>
            <SolidColorBrush x:Key="NixieAccentBrush" Color="#F96985" />
            <SolidColorBrush x:Key="NixieAccentOnImageBrush" Color="#FF9EB1" />
            <SolidColorBrush x:Key="NixieOnAccentOnImageBrush" Color="#24060F" />
            <SolidColorBrush x:Key="NixieDeepBrush" Color="#170508" />
            <AcrylicBrush
                x:Key="GlassPanelBrush"
                FallbackColor="#F02A1217"
                TintColor="#2A1217"
                TintLuminosityOpacity="0.34"
                TintOpacity="0.62" />
            <AcrylicBrush
                x:Key="GlassPanelStrongBrush"
                FallbackColor="#F534181D"
                TintColor="#34181D"
                TintLuminosityOpacity="0.8"
                TintOpacity="0.77" />
            <!--  one thin, light edge: brightest along the top (the warm white of a low sun), nearly gone below  -->
            <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#59FFEDE8" />
                <GradientStop Offset="0.3" Color="#14FFFFFF" />
                <GradientStop Offset="1" Color="#0AFFFFFF" />
            </LinearGradientBrush>
            <!--  the inner bevel: a second, fainter stroke just inside the rim, lit along the top edge only  -->
            <LinearGradientBrush x:Key="GlassBevelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#2EFFFFFF" />
                <GradientStop Offset="0.12" Color="#00FFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <!--  the milk of frosted glass: a little white over the tint  -->
            <SolidColorBrush x:Key="GlassMilkBrush" Color="#08FFFFFF" />
            <!--  the faint inner glow along a panel's top: light that seems to enter the glass edge  -->
            <LinearGradientBrush x:Key="GlassGlowBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#2EFFFFFF" />
                <GradientStop Offset="0.3" Color="#0AFFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <!--  the shadow under floating panels  -->
            <x:Double x:Key="GlassShadowOpacity">0.30</x:Double>
            <x:Double x:Key="GlassContactShadowOpacity">0.22</x:Double>
            <SolidColorBrush x:Key="GlassHoverOverlayBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="GlassPressedOverlayBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="#F8EFF0" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="#D3BFC1" />
            <!--  under text laid over artwork: transparent at the top, dark at the bottom  -->
            <LinearGradientBrush x:Key="GlassImageScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00170508" />
                <GradientStop Offset="0.55" Color="#66170508" />
                <GradientStop Offset="1" Color="#F2170508" />
            </LinearGradientBrush>
            <!--  the soft artwork behind the window (AmbientBackdrop) is dimmed by this  -->
            <SolidColorBrush x:Key="GlassAmbientDimBrush" Color="#C7170508" />
            <SolidColorBrush x:Key="GlassSelectedOverlayBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="NixieAccentFillBrush" Color="#F96985" />
            <SolidColorBrush x:Key="NixieAccentForegroundBrush" Color="#24060F" />
            <!--  what GlassPanelBrush and GlassPanelStrongBrush become in Solid mode (GlassTheme): the same colours, opaque  -->
            <SolidColorBrush x:Key="GlassPanelSolidBrush" Color="#2A1217" />
            <SolidColorBrush x:Key="GlassPanelStrongSolidBrush" Color="#34181D" />
            <!--
                the overlays in windows of their own (menus, tooltips): a flat strong tint, never in-app acrylic. A menu's window
                already has Windows' acrylic under it (its system backdrop), so this is the one blur; in Solid it is opaque.
                NixieTheme sets both to the palette's container colour (OverlayColor).
            -->
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="#E634181D" />
            <SolidColorBrush x:Key="GlassOverlaySolidBrush" Color="#34181D" />
            <!--  a hairline inside an overlay (a dialog's line above its buttons)  -->
            <SolidColorBrush x:Key="GlassDividerBrush" Color="#1FFFFFFF" />
            <!--  a button that sits ON a glass panel: a flat light fill, never a second acrylic, and its label  -->
            <SolidColorBrush x:Key="GlassInsetFillBrush" Color="#1AFFFFFF" />
            <StaticResource x:Key="GlassInsetTextBrush" ResourceKey="GlassTextPrimaryBrush" />
            <!--
                keyboard focus: WinUI's two rings, the neon core's near-white (outer: it reads on the hot-pink Play too, where a pink
                ring would vanish) around the deep colour (inner); the glow brings the colour. High contrast keeps WinUI's own.
            -->
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#170508" />
            <!--  behind a dialog: a dusk smoke, not WinUI's grey (high contrast keeps WinUI's own)  -->
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#A61A0710" />
            <!--
                1.2.0, the top bar (the account stream's title bar with text tabs): the title bar's glass, a little more open than
                a panel (hero art runs under it, with the page's scrim), its Solid stand-in (GlassTheme), the hairline along its
                bottom, and the accent of the selected tab's underline (NeonUnderline draws the lit tube; this is the plain colour)
            -->
            <AcrylicBrush
                x:Key="GlassTitleBarBrush"
                FallbackColor="#F02A1217"
                TintColor="#2A1217"
                TintLuminosityOpacity="0.34"
                TintOpacity="0.62" />
            <SolidColorBrush x:Key="GlassTitleBarSolidBrush" Color="#2A1217" />
            <SolidColorBrush x:Key="GlassTitleBarStrokeBrush" Color="#26FFEDE8" />
            <SolidColorBrush x:Key="GlassTabUnderlineBrush" Color="#F96985" />
            <!--  1.2.0, the button system (Nixie button review, section 3): dusk; text on hot pink is dark (6.7:1)  -->
            <Color x:Key="GlassNeonGlowColor">#FF7A50</Color>
            <StaticResource x:Key="NixiePrimaryFillBrush" ResourceKey="NixieAccentFillBrush" />
            <SolidColorBrush x:Key="NixiePrimaryForegroundBrush" Color="#24060F" />
            <SolidColorBrush x:Key="NixiePrimaryHoverOverlayBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="NixiePrimaryHoverForegroundBrush" Color="#24060F" />
            <SolidColorBrush x:Key="NixiePrimaryPressedOverlayBrush" Color="#33000000" />
            <SolidColorBrush x:Key="NixiePrimaryPressedForegroundBrush" Color="#D924060F" />
            <StaticResource x:Key="NixiePrimaryHoverBorderBrush" ResourceKey="GlassStrokeBrush" />
            <StaticResource x:Key="NixieButtonFillBrush" ResourceKey="GlassInsetFillBrush" />
            <StaticResource x:Key="NixieButtonForegroundBrush" ResourceKey="GlassTextPrimaryBrush" />
            <StaticResource x:Key="NixieButtonBorderBrush" ResourceKey="GlassStrokeBrush" />
            <StaticResource x:Key="NixieHoverOverlayBrush" ResourceKey="GlassHoverOverlayBrush" />
            <StaticResource x:Key="NixieHoverBorderBrush" ResourceKey="GlassStrokeBrush" />
            <StaticResource x:Key="NixiePressedOverlayBrush" ResourceKey="GlassPressedOverlayBrush" />
            <StaticResource x:Key="NixieSubtleForegroundBrush" ResourceKey="GlassTextPrimaryBrush" />
            <!--  danger: amber (OKLCH hue 72), 34 degrees from the nearest palette hue; 7.5:1 on the glass fill  -->
            <SolidColorBrush x:Key="NixieDangerForegroundBrush" Color="#FFB347" />
            <SolidColorBrush x:Key="NixieDisabledFillBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NixieDisabledForegroundBrush" Color="#5CF8EFF0" />
            <SolidColorBrush x:Key="NixieDisabledBorderBrush" Color="#14FFFFFF" />
            <StaticResource x:Key="NixieLinkForegroundBrush" ResourceKey="GlassTextPrimaryBrush" />
            <SolidColorBrush x:Key="NixieLinkHoverForegroundBrush" Color="#FF9EB1" />
            <StaticResource x:Key="NixieTabForegroundBrush" ResourceKey="GlassTextSecondaryBrush" />
            <StaticResource x:Key="NixieTabSelectedForegroundBrush" ResourceKey="GlassTextPrimaryBrush" />
            <SolidColorBrush x:Key="NixieTabHoverLineBrush" Color="#66F8EFF0" />
            <SolidColorBrush x:Key="NixieToggleOnForegroundBrush" Color="#FF9EB1" />
            <SolidColorBrush x:Key="NixieToggleOnBorderBrush" Color="#F96985" />
            <StaticResource x:Key="NixieToggleOnFillBrush" ResourceKey="GlassInsetFillBrush" />
            <!--
                1.4.0 style: one accent budget (pink only for the view's one Primary, the current place and progress) and one
                highlight vocabulary. Badges sit ON artwork, so they are dark plates with light marks in both themes: watched a
                dim neutral check (top right), "N to watch" a neutral square count (top left), never the accent, never a capsule.
                A selected chip or section tab is a neutral plate and the weight; the current letter bold accent text; an open
                item the accent rim. Hover on a card brightens it (NixieCardHoverOverlayBrush); pressed is never selected.
            -->
            <SolidColorBrush x:Key="NixieBadgeFillBrush" Color="#B8170508" />
            <SolidColorBrush x:Key="NixieBadgeStrokeBrush" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="NixieBadgeForegroundBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="NixieWatchedGlyphBrush" Color="#D9C6C8" />
            <SolidColorBrush x:Key="NixieCardHoverOverlayBrush" Color="#17FFFFFF" />
            <LinearGradientBrush x:Key="NixieCardStripScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00100306" />
                <GradientStop Offset="0.35" Color="#CC100306" />
                <GradientStop Offset="0.6" Color="#F7100306" />
                <GradientStop Offset="1" Color="#FA100306" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NixieOpenRimBrush" Color="#F96985" />
            <SolidColorBrush x:Key="NixieChipSelectedFillBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="NixieChipSelectedBorderBrush" Color="#80F8EFF0" />
            <StaticResource x:Key="NixieChipSelectedForegroundBrush" ResourceKey="GlassTextPrimaryBrush" />
            <SolidColorBrush x:Key="NixieCurrentLetterForegroundBrush" Color="#FF9EB1" />
            <Color x:Key="NixieDangerColor">#FFB347</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="NixieAccentColor">#BC1E47</Color>
            <Color x:Key="NixieDeepColor">#FFF6F3</Color>
            <SolidColorBrush x:Key="NixieAccentBrush" Color="#BC1E47" />
            <!--
                the accent ON ARTWORK (a progress bar on a poster's dark track, a watched badge): the light pink in both themes.
                The light theme's crimson has 1.2:1 on the track over a bright poster (Black65O over white); this keeps 3.6:1.
                Used by BaseItemDtoCard's and EpisodeRow's progress bars, whose Black65O track fills the whole bar
                (ProgressBarTrackHeight: WinUI draws a 1 px track line otherwise, and the bar would sit on the poster itself),
                and by EpisodeRow's watched mark, whose check takes NixieOnAccentOnImageBrush.
            -->
            <SolidColorBrush x:Key="NixieAccentOnImageBrush" Color="#FF9EB1" />
            <SolidColorBrush x:Key="NixieOnAccentOnImageBrush" Color="#24060F" />
            <SolidColorBrush x:Key="NixieDeepBrush" Color="#FFF6F3" />
            <AcrylicBrush
                x:Key="GlassPanelBrush"
                FallbackColor="#F0FCEAE8"
                TintColor="#FCEAE8"
                TintLuminosityOpacity="0.45"
                TintOpacity="0.28" />
            <AcrylicBrush
                x:Key="GlassPanelStrongBrush"
                FallbackColor="#F5FFF3F1"
                TintColor="#FFF3F1"
                TintLuminosityOpacity="0.85"
                TintOpacity="0.75" />
            <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.35" Color="#2E000000" />
                <GradientStop Offset="1" Color="#1F000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassBevelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#99FFFFFF" />
                <GradientStop Offset="0.12" Color="#00FFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlassMilkBrush" Color="#14FFFFFF" />
            <LinearGradientBrush x:Key="GlassGlowBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#99FFFFFF" />
                <GradientStop Offset="0.3" Color="#26FFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <x:Double x:Key="GlassShadowOpacity">0.22</x:Double>
            <x:Double x:Key="GlassContactShadowOpacity">0.20</x:Double>
            <SolidColorBrush x:Key="GlassHoverOverlayBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="GlassPressedOverlayBrush" Color="#08000000" />
            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="#2D0F16" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="#633A41" />
            <LinearGradientBrush x:Key="GlassImageScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00FFF6F3" />
                <GradientStop Offset="0.55" Color="#80FFF6F3" />
                <GradientStop Offset="1" Color="#F2FFF6F3" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlassAmbientDimBrush" Color="#85FFF6F3" />
            <SolidColorBrush x:Key="GlassSelectedOverlayBrush" Color="#1F000000" />
            <!--  light theme: the sunset's crimson, so white text on it reaches 4.5:1 (6.2:1)  -->
            <SolidColorBrush x:Key="NixieAccentFillBrush" Color="#BC1E47" />
            <SolidColorBrush x:Key="NixieAccentForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="GlassPanelSolidBrush" Color="#FCEAE8" />
            <SolidColorBrush x:Key="GlassPanelStrongSolidBrush" Color="#FFF3F1" />
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="#E6FFF3F1" />
            <SolidColorBrush x:Key="GlassOverlaySolidBrush" Color="#FFF3F1" />
            <SolidColorBrush x:Key="GlassDividerBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="GlassInsetFillBrush" Color="#0F000000" />
            <StaticResource x:Key="GlassInsetTextBrush" ResourceKey="GlassTextPrimaryBrush" />
            <!--
                keyboard focus: WinUI's two rings, deep maroon (outer) around white (inner). Not crimson: it vanished on the crimson
                Play (the button review); the glow brings the colour.
            -->
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#2D0F16" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#FFFFFF" />
            <!--  behind a dialog: a dusk smoke, not WinUI's grey (high contrast keeps WinUI's own)  -->
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#59500723" />
            <!--  the top bar (see Dark)  -->
            <AcrylicBrush
                x:Key="GlassTitleBarBrush"
                FallbackColor="#F0FCEAE8"
                TintColor="#FCEAE8"
                TintLuminosityOpacity="0.45"
                TintOpacity="0.28" />
            <SolidColorBrush x:Key="GlassTitleBarSolidBrush" Color="#FCEAE8" />
            <SolidColorBrush x:Key="GlassTitleBarStrokeBrush" Color="#1F500723" />
            <SolidColorBrush x:Key="GlassTabUnderlineBrush" Color="#BC1E47" />
            <!--  1.2.0, the button system (Nixie button review, section 3): noon  -->
            <Color x:Key="GlassNeonGlowColor">#BC1E47</Color>
            <StaticResource x:Key="NixiePrimaryFillBrush" ResourceKey="NixieAccentFillBrush" />
            <SolidColorBrush x:Key="NixiePrimaryForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NixiePrimaryHoverOverlayBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="NixiePrimaryHoverForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NixiePrimaryPressedOverlayBrush" Color="#33000000" />
            <SolidColorBrush x:Key="NixiePrimaryPressedForegroundBrush" Color="#D9FFFFFF" />
            <StaticResource x:Key="NixiePrimaryHoverBorderBrush" ResourceKey="GlassStrokeBrush" />
            <StaticResource x:Key="NixieButtonFillBrush" ResourceKey="GlassInsetFillBrush" />
            <StaticResource x:Key="NixieButtonForegroundBrush" ResourceKey="GlassTextPrimaryBrush" />
            <StaticResource x:Key="NixieButtonBorderBrush" ResourceKey="GlassStrokeBrush" />
            <StaticResource x:Key="NixieHoverOverlayBrush" ResourceKey="GlassHoverOverlayBrush" />
            <StaticResource x:Key="NixieHoverBorderBrush" ResourceKey="GlassStrokeBrush" />
            <StaticResource x:Key="NixiePressedOverlayBrush" ResourceKey="GlassPressedOverlayBrush" />
            <StaticResource x:Key="NixieSubtleForegroundBrush" ResourceKey="GlassTextPrimaryBrush" />
            <!--  danger: dark amber (hue 70), as dusk's; 5.2:1 on the light glass fill (crimson-like reds were 1.1:1 from the accent)  -->
            <SolidColorBrush x:Key="NixieDangerForegroundBrush" Color="#805000" />
            <SolidColorBrush x:Key="NixieDisabledFillBrush" Color="#0A000000" />
            <!--  48 %, not the review's 36 %: that is 2.2:1 on the light disabled fill (36 % keeps 3:1 only in dark)  -->
            <SolidColorBrush x:Key="NixieDisabledForegroundBrush" Color="#7A2D0F16" />
            <SolidColorBrush x:Key="NixieDisabledBorderBrush" Color="#14000000" />
            <StaticResource x:Key="NixieLinkForegroundBrush" ResourceKey="GlassTextPrimaryBrush" />
            <SolidColorBrush x:Key="NixieLinkHoverForegroundBrush" Color="#BC1E47" />
            <StaticResource x:Key="NixieTabForegroundBrush" ResourceKey="GlassTextSecondaryBrush" />
            <StaticResource x:Key="NixieTabSelectedForegroundBrush" ResourceKey="GlassTextPrimaryBrush" />
            <SolidColorBrush x:Key="NixieTabHoverLineBrush" Color="#662D0F16" />
            <SolidColorBrush x:Key="NixieToggleOnForegroundBrush" Color="#BC1E47" />
            <SolidColorBrush x:Key="NixieToggleOnBorderBrush" Color="#BC1E47" />
            <StaticResource x:Key="NixieToggleOnFillBrush" ResourceKey="GlassInsetFillBrush" />
            <!--  1.4.0 style: the badge and highlight vocabulary (see Dark); the badges are on artwork, so the dark theme's  -->
            <SolidColorBrush x:Key="NixieBadgeFillBrush" Color="#B8170508" />
            <SolidColorBrush x:Key="NixieBadgeStrokeBrush" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="NixieBadgeForegroundBrush" Color="#FFF4EE" />
            <SolidColorBrush x:Key="NixieWatchedGlyphBrush" Color="#D9C6C8" />
            <SolidColorBrush x:Key="NixieCardHoverOverlayBrush" Color="#17FFFFFF" />
            <LinearGradientBrush x:Key="NixieCardStripScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00100306" />
                <GradientStop Offset="0.35" Color="#CC100306" />
                <GradientStop Offset="0.6" Color="#F7100306" />
                <GradientStop Offset="1" Color="#FA100306" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NixieOpenRimBrush" Color="#BC1E47" />
            <SolidColorBrush x:Key="NixieChipSelectedFillBrush" Color="#1F2D0F16" />
            <SolidColorBrush x:Key="NixieChipSelectedBorderBrush" Color="#992D0F16" />
            <StaticResource x:Key="NixieChipSelectedForegroundBrush" ResourceKey="GlassTextPrimaryBrush" />
            <SolidColorBrush x:Key="NixieCurrentLetterForegroundBrush" Color="#BC1E47" />
            <Color x:Key="NixieDangerColor">#805000</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <!--  1.1.4 (states): the user's contrast colours, not a fixed yellow and black (wrong in a light scheme)  -->
            <StaticResource x:Key="NixieAccentColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="NixieDeepColor" ResourceKey="SystemColorWindowColor" />
            <SolidColorBrush x:Key="NixieAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NixieAccentOnImageBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NixieOnAccentOnImageBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NixieDeepBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassPanelStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassGlowBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassBevelBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassMilkBrush" Color="Transparent" />
            <x:Double x:Key="GlassShadowOpacity">0</x:Double>
            <x:Double x:Key="GlassContactShadowOpacity">0</x:Double>
            <SolidColorBrush x:Key="GlassHoverOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassPressedOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassImageScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassAmbientDimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassSelectedOverlayBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NixieAccentFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NixieAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="GlassPanelSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassPanelStrongSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassOverlaySolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!--  a ButtonFace fill always carries ButtonText: a custom contrast scheme may make ButtonFace differ from Window  -->
            <SolidColorBrush x:Key="GlassInsetFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="GlassInsetTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <!--  1.2.0, the top bar (glass stream): the system's window colour, its text colour for the hairline, the highlight for the tab  -->
            <SolidColorBrush x:Key="GlassTitleBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassTitleBarSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassTitleBarStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassTabUnderlineBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!--  1.2.0, the button system (Nixie button review, section 3): high contrast, the system colours  -->
            <StaticResource x:Key="GlassNeonGlowColor" ResourceKey="SystemColorHighlightColor" />
            <SolidColorBrush x:Key="NixiePrimaryFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NixiePrimaryForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NixiePrimaryHoverOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NixiePrimaryHoverForegroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NixiePrimaryPressedOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NixiePrimaryPressedForegroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NixiePrimaryHoverBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NixieButtonFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="NixieButtonForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="NixieButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <!--  hover and pressed: a highlight border; the label keeps its own colour (ButtonText on ButtonFace)  -->
            <SolidColorBrush x:Key="NixieHoverOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NixieHoverBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NixiePressedOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NixieSubtleForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NixieDangerForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="NixieDisabledFillBrush" Color="Transparent" />
