    <!--
        1.4.0: the 1.1.x "Pill" aliases (GlassPillButtonStyle, GlassAccentPillButtonStyle, GlassInsetPillButtonStyle,
        GlassIconButtonStyle) are gone: every page names its role (NixieButtonStyle, NixiePrimaryButtonStyle,
        NixieIconButtonStyle), so no key says "pill" for a shape the system no longer draws.
    -->

    <!--  ======================================== 1.4.0 style ========================================  -->
    <!--
        1.4.0 (the library UX review, plan items 7 and 11): the shared keys the themes, the library and the player use, so one
        accent budget, one highlight vocabulary and one button system hold in all four themes.
        Highlights, one meaning each:
          - pink: the view's one Primary, the current place (a tab's underline, the current letter) and progress; nothing else;
          - keyboard focus: the two-tone ring (SystemControlFocusVisual*) plus the item's actions;
          - hover: a brighten (NixieCardHoverOverlayBrush) or a lift of the art; never a zoom or a Play glyph while the keyboard
            focus is in the grid;
          - pressed: the pressed overlay, never the selected look;
          - selected chip or section tab: a neutral plate and the weight; a switch that is on: its check glyph and the plate;
          - an open item (Editorial's details in place): the accent rim and the notch, never the focus ring.
        Badges (on artwork, so the same dark plate in both themes): watched is a dim neutral check, top right; "N to watch" a
        neutral square count, top left; 24 high, radius 6; never the accent, never a capsule.
    -->
    <x:Double x:Key="NixieBadgeSize">24</x:Double>
    <CornerRadius x:Key="NixieBadgeCornerRadius">6</CornerRadius>
    <Thickness x:Key="NixieBadgeMargin">8</Thickness>
    <!--  a card's action glyphs: 20 at 44, as every icon button  -->
    <x:Double x:Key="NixieCardGlyphSize">20</x:Double>
    <!--  the art grows on keyboard focus (or a free hover) by this much; its words never move: the growth is reserved in the gap  -->
    <x:Double x:Key="NixieCardArtLift">1.05</x:Double>

    <!--  watched: a dim neutral check on a dark square plate, top right  -->
    <Style x:Key="NixieWatchedBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource NixieBadgeSize}" />
        <Setter Property="Height" Value="{StaticResource NixieBadgeSize}" />
        <Setter Property="Margin" Value="{StaticResource NixieBadgeMargin}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{ThemeResource NixieBadgeFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NixieBadgeStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NixieBadgeCornerRadius}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
    <Style x:Key="NixieWatchedGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Glyph" Value="&#xE73E;" />
        <Setter Property="Foreground" Value="{ThemeResource NixieWatchedGlyphBrush}" />
    </Style>
    <!--  "N to watch": a neutral square count, top left (the card's name says it to Narrator: "5 unwatched episodes")  -->
    <Style x:Key="NixieCountChipStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="{StaticResource NixieBadgeSize}" />
        <Setter Property="Height" Value="{StaticResource NixieBadgeSize}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="{StaticResource NixieBadgeMargin}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{ThemeResource NixieBadgeFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NixieBadgeStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NixieBadgeCornerRadius}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
    <Style x:Key="NixieCountChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassTextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextLineBounds" Value="Tight" />
        <Setter Property="Foreground" Value="{ThemeResource NixieBadgeForegroundBrush}" />
    </Style>

    <!--
        A card's actions: one strip along the foot of the art (over NixieCardStripScrimBrush), centred, 8 apart: Play (the
        Primary, as an icon circle), then the icon toggles and More, all 44 with 20 px glyphs. The words under the art stay.
    -->
    <Style x:Key="NixieCardActionStripStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!--  Primary as a 44 icon circle (a card's Play): the accent fill on the icon template  -->
    <Style
        x:Key="NixiePrimaryIconButtonStyle"
        BasedOn="{StaticResource NixieIconButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource NixiePrimaryFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource NixiePrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
    </Style>
    <!--  the icon roles on artwork: the badges' dark plate under the glyph, so they read on any picture  -->
    <Style
        x:Key="NixieCardIconButtonStyle"
        BasedOn="{StaticResource NixieIconButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource NixieBadgeFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource NixieBadgeForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NixieBadgeStrokeBrush}" />
    </Style>
    <Style
        x:Key="NixieCardIconToggleButtonStyle"
        BasedOn="{StaticResource NixieIconToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource NixieBadgeFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource NixieBadgeForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NixieBadgeStrokeBrush}" />
    </Style>

    <!--  every toolbar (Sort, Filter, the Unwatched switch beside them): Compact 32 in every theme; no page makes it Large  -->
    <Style
        x:Key="NixieToolbarButtonStyle"
        BasedOn="{StaticResource NixieCompactButtonStyle}"
        TargetType="Button" />

    <!--  a chip that is an action (an applied filter's "Comedy ✕", Clear all): the Compact Secondary at 32, radius 8  -->
    <Style
        x:Key="NixieChipButtonStyle"
        BasedOn="{StaticResource NixieCompactButtonStyle}"
        TargetType="Button">
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!--
        A chip that is a switch (Unwatched, Favorites): 32, radius 8, the glass fill; on: its check glyph shows before the
        words and the neutral plate and edge come up (never the accent), so it reads as on/off beside a single-select chip.
    -->
    <ControlTemplate x:Key="NixieChipToggleButtonTemplate" TargetType="ToggleButton">
        <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
            <Border
                x:Name="Backplate"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <Border
                x:Name="Overlay"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <StackPanel
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <FontIcon
                    x:Name="CheckGlyph"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="12"
                    Foreground="{TemplateBinding Foreground}"
                    Glyph="&#xE73E;"
                    Visibility="Collapsed" />
                <ContentPresenter
                    x:Name="ContentPresenter"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixieHoverOverlayBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieHoverBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixiePressedOverlayBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieHoverBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Backplate.Background" Value="{ThemeResource NixieDisabledFillBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieDisabledBorderBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieDisabledForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                            <Setter Target="Backplate.Background" Value="{ThemeResource NixieChipSelectedFillBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieChipSelectedBorderBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieChipSelectedForegroundBrush}" />
                            <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource NixieChipSelectedForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                        <VisualState.Setters>
                            <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                            <Setter Target="Backplate.Background" Value="{ThemeResource NixieChipSelectedFillBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieChipSelectedBorderBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieChipSelectedForegroundBrush}" />
                            <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource NixieChipSelectedForegroundBrush}" />
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixieHoverOverlayBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                        <VisualState.Setters>
                            <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                            <Setter Target="Backplate.Background" Value="{ThemeResource NixieChipSelectedFillBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieChipSelectedBorderBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieChipSelectedForegroundBrush}" />
                            <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource NixieChipSelectedForegroundBrush}" />
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixiePressedOverlayBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedDisabled">
                        <VisualState.Setters>
                            <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                            <Setter Target="Backplate.Background" Value="{ThemeResource NixieDisabledFillBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieDisabledBorderBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieDisabledForegroundBrush}" />
                            <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource NixieDisabledForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused" />
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
    <Style
        x:Key="NixieChipToggleButtonStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassChipCornerRadius}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="MinHeight" Value="{StaticResource NixieCompactButtonHeight}" />
        <Setter Property="Height" Value="{StaticResource NixieCompactButtonHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="{ThemeResource NixieButtonFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource NixieButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NixieButtonBorderBrush}" />
        <Setter Property="Template" Value="{StaticResource NixieChipToggleButtonTemplate}" />
    </Style>

    <!--
        A single-select chip (a genre, a preset): a RadioButton, so Narrator hears "1 of 9, selected"; picked: the neutral plate,
        its edge and the weight (the hidden bold copy keeps its width, so nothing moves). Never the accent, never a check.
    -->
    <ControlTemplate x:Key="NixieChoiceChipTemplate" TargetType="RadioButton">
        <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
            <Border
                x:Name="Backplate"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <Border
                x:Name="Overlay"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <TextBlock
                x:Name="SelectedWidth"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontWeight="SemiBold"
                IsHitTestVisible="False"
                Opacity="0"
                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NixieTextOnlyConverter}}" />
            <ContentPresenter
                x:Name="ContentPresenter"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixieHoverOverlayBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieHoverBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixiePressedOverlayBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieHoverBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Backplate.Background" Value="{ThemeResource NixieDisabledFillBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieDisabledBorderBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieDisabledForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="Backplate.Background" Value="{ThemeResource NixieChipSelectedFillBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieChipSelectedBorderBrush}" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieChipSelectedForegroundBrush}" />
                            <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused" />
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
    <Style
        x:Key="NixieChoiceChipStyle"
        BasedOn="{StaticResource DefaultRadioButtonStyle}"
        TargetType="RadioButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassChipCornerRadius}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="MinHeight" Value="{StaticResource NixieCompactButtonHeight}" />
        <Setter Property="Height" Value="{StaticResource NixieCompactButtonHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="{ThemeResource NixieButtonFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource NixieButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NixieButtonBorderBrush}" />
        <Setter Property="Template" Value="{StaticResource NixieChoiceChipTemplate}" />
    </Style>

    <!--
        A section tab (Cinematic's All / Unwatched / Favorites, any view switch inside a page): selected is a neutral plate and
        the weight, never the underline, which marks only where you are in the top bar. A control goes to "Selected"
        (SelectionStates) from code, as the Tab role does.
    -->
    <ControlTemplate x:Key="NixieSectionTabButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
            <Border
                x:Name="Backplate"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <Border
                x:Name="Overlay"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}">
                <Border.BackgroundTransition>
                    <BrushTransition Duration="0:0:0.12" />
                </Border.BackgroundTransition>
            </Border>
            <TextBlock
                x:Name="SelectedWidth"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontWeight="SemiBold"
                IsHitTestVisible="False"
                Opacity="0"
                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NixieTextOnlyConverter}}" />
            <ContentPresenter
                x:Name="ContentPresenter"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixieHoverOverlayBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixiePressedOverlayBrush}" />
                            <Setter Target="ContentPresenter.Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieDisabledForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused" />
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Unselected" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Target="Backplate.Background" Value="{ThemeResource NixieChipSelectedFillBrush}" />
                            <Setter Target="Backplate.BorderBrush" Value="{ThemeResource NixieChipSelectedBorderBrush}" />
                            <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieChipSelectedForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
    <Style
        x:Key="NixieSectionTabButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource NixieTabForegroundBrush}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="{StaticResource NixieCompactButtonHeight}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassButtonCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource NixieSectionTabButtonTemplate}" />
    </Style>

    <!--
        An A to Z letter, one role in every theme: at least 32 x 32, radius 8, transparent at rest with the overlays on hover
        and press; a letter with no titles is disabled (dimmed, skipped); the current letter goes to "Selected" from code
        (SelectionStates): bold accent text, no underline, no plate (it is the current place). Narrator: set IsSelected on it.
    -->
    <ControlTemplate x:Key="NixieLetterButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
            <Border
                x:Name="Backplate"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <Border
                x:Name="Overlay"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <TextBlock
                x:Name="SelectedWidth"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontWeight="Bold"
                IsHitTestVisible="False"
                Opacity="0"
                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NixieTextOnlyConverter}}" />
            <ContentPresenter
                x:Name="ContentPresenter"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixieHoverOverlayBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource NixiePressedOverlayBrush}" />
                            <Setter Target="ContentPresenter.Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieDisabledForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused" />
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Unselected" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Target="ContentPresenter.FontWeight" Value="Bold" />
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NixieCurrentLetterForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
    <Style
        x:Key="NixieLetterButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassButtonCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="{StaticResource NixieCompactButtonHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource NixieCompactButtonHeight}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource NixieSubtleForegroundBrush}" />
        <Setter Property="Template" Value="{StaticResource NixieLetterButtonTemplate}" />
    </Style>

    <!--
        The player's transport on the system (the player stream lays it out): the 44 icon circles, with the Nixie hover, press
        and focus glow; Play/Pause at 60 in the accent is the one documented hero exception to the 44/32 sizes. The prompts:
        Secondary 44 (Skip, Watch credits, Keep watching) and the Primary 44 (the next episode).
    -->
    <Style
        x:Key="NixiePlayerButtonStyle"
        BasedOn="{StaticResource NixieIconButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource NixieBadgeFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource NixieBadgeForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
    </Style>
    <x:Double x:Key="NixiePlayerHeroButtonSize">60</x:Double>
    <Style
        x:Key="NixiePlayerPlayButtonStyle"
        BasedOn="{StaticResource NixieIconButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource NixiePlayerHeroButtonSize}" />
        <Setter Property="Height" Value="{StaticResource NixiePlayerHeroButtonSize}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Background" Value="{ThemeResource NixiePrimaryFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource NixiePrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
    </Style>
    <Style
        x:Key="NixiePlayerPromptButtonStyle"
        BasedOn="{StaticResource NixieButtonStyle}"
        TargetType="Button" />
    <Style
        x:Key="NixiePlayerPromptPrimaryButtonStyle"
        BasedOn="{StaticResource NixiePrimaryButtonStyle}"
        TargetType="Button" />

    <!--
        Delete (the item's delete confirmation): the Destructive role, Compact, with the trash glyph (E74D) before the verb;
        its focus glows in the danger ink at radius 8. NixieDeleteDialogStyle: the destructive dialog with that confirm.
    -->
    <Style
        x:Key="NixieDeleteCompactButtonStyle"
        BasedOn="{StaticResource NixieDestructiveCompactButtonStyle}"
        TargetType="Button">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Glyph="&#xE74D;" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  ====================================== end 1.4.0 style ======================================  -->
    <!--
        Dialogs with the Compact buttons (the button review, section 3.6), on the dialog template of TextBlock.xaml (merged
        earlier). NixieDialogStyle: the commit is the Primary. NixieDestructiveDialogStyle: the confirm is Destructive, and Cancel
        (the close button) is the default, drawn Secondary.
    -->
    <Style
        x:Key="NixieDialogStyle"
        BasedOn="{StaticResource DefaultContentDialogStyleWithTitleBackground}"
        TargetType="ContentDialog">
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource NixiePrimaryCompactButtonStyle}" />
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource NixieCompactButtonStyle}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource NixieCompactButtonStyle}" />
        <Setter Property="DefaultButton" Value="Primary" />
    </Style>
    <Style
        x:Key="NixieDestructiveDialogStyle"
        BasedOn="{StaticResource DefaultContentDialogStyleWithTitleBackground}"
        TargetType="ContentDialog">
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource NixieDestructiveCompactButtonStyle}" />
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource NixieCompactButtonStyle}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource NixieCompactButtonStyle}" />
        <Setter Property="DefaultButton" Value="Close" />
    </Style>
    <!--  1.4.0 style: the item's delete confirmation: the destructive dialog whose confirm carries the trash glyph  -->
    <Style
        x:Key="NixieDeleteDialogStyle"
        BasedOn="{StaticResource NixieDestructiveDialogStyle}"
        TargetType="ContentDialog">
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource NixieDeleteCompactButtonStyle}" />
    </Style>
    <!--
        Overlays: the More menu, card context menus, the profile flyout, tooltips, every ContentDialog and the player's menus
        (MpvPlayerControls.xaml's PlayerMenuPresenter and PlayerFlyoutPresenter are BasedOn the two keyed styles below and set
        only their padding) share one recipe: one blur under a strong tint, the light glass edge, GlassOverlayCornerRadius, the
        glass text colour. Never acrylic on acrylic: a flyout or a dialog draws inside the window and gets the strong in-app
        glass (GlassPanelStrongBrush); a menu or a tooltip is a window of its own, where in-app acrylic has nothing to blur, so
        it gets the flat GlassOverlayBrush (a menu keeps Windows' acrylic under it as its one blur). Solid makes both opaque
        (GlassTheme); high contrast uses the system colours through the same brushes. The dialog's template is in TextBlock.xaml.
    -->
    <Style
        x:Key="GlassFlyoutPresenterStyle"
        BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
        TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource GlassPanelStrongBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassOverlayCornerRadius}" />
    </Style>
    <Style
        x:Key="GlassMenuFlyoutPresenterStyle"
        BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}"
        TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource GlassOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassOverlayCornerRadius}" />
    </Style>
    <Style BasedOn="{StaticResource GlassFlyoutPresenterStyle}" TargetType="FlyoutPresenter" />
    <Style BasedOn="{StaticResource GlassMenuFlyoutPresenterStyle}" TargetType="MenuFlyoutPresenter" />
    <Style BasedOn="{StaticResource DefaultToolTipStyle}" TargetType="ToolTip">
        <Setter Property="Background" Value="{ThemeResource GlassOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassOverlayCornerRadius}" />
        <Setter Property="Padding" Value="12,8,12,9" />
    </Style>
</ResourceDictionary>
