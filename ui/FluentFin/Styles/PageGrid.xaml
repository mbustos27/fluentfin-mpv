<?xml version="1.0" encoding="utf-8" ?>
<!--
    Nixie 1.4.0 (the UX review's plan item 13): the page grid's tokens, Classic's values as the default. Each layout theme's
    dictionary (in App.xaml's LayoutThemeSlot, merged after this one) gives its own: the gutter at a 1100 px and a 1920 px
    window (PageGutterNarrow, PageGutterWide; Controls.PageGrid grows it in proportion between, on the 4 epx grid), the y of a
    page title's top in the window (PageTitleY), and the ground the shared pages are drawn on (PageGroundBrush; Classic: none,
    the window's glass ground shows).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="PageGutterNarrow">36</x:Double>
    <x:Double x:Key="PageGutterWide">36</x:Double>
    <x:Double x:Key="PageTitleY">72</x:Double>
    <SolidColorBrush x:Key="PageGroundBrush" Color="Transparent" />
</ResourceDictionary>
