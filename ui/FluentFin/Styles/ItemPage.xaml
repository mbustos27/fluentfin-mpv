<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Seaglass: what the movie, series, season and episode pages share. The hero at the top is always dark (white text on the
        backdrop and its scrims, in both themes); high contrast gets the system colours.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!--  left to right: a deep wash behind the text that fades to the open backdrop on the right  -->
            <LinearGradientBrush x:Key="ItemHeroSideScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#E60A1418" />
                <GradientStop Offset="0.6" Color="#BF0A1418" />
                <GradientStop Offset="1" Color="#000A1418" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ItemHeroSideScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  fixed: the backdrop is cropped to it (an image drawn at its own aspect ratio would fill the window)  -->
    <x:Double x:Key="ItemHeroHeight">640</x:Double>
    <x:Double x:Key="ItemHeroTextMaxWidth">660</x:Double>
    <Thickness x:Key="ItemPageGutter">48,0,48,0</Thickness>

    <Style x:Key="ItemChipTextBlockStyle" BasedOn="{StaticResource GlassMetaTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource GlassTextPrimaryBrush}" />
    </Style>

    <Style x:Key="ItemGlassToggleButtonStyle" BasedOn="{StaticResource IconToggleButtonStyle}" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassStrokeThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassCircleCornerRadius}" />
        <Setter Property="Width" Value="{StaticResource GlassPillHeight}" />
        <Setter Property="Height" Value="{StaticResource GlassPillHeight}" />
        <Setter Property="Padding" Value="0" />
    </Style>
</ResourceDictionary>
