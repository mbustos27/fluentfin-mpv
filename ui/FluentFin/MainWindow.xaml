<windowex:WindowEx
    x:Class="FluentFin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:fc="using:FluentFin.Controls"
    xmlns:core="using:FluentFin.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentFin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:FluentFin.Views"
    xmlns:windowex="using:WinUIEx"
    Title="Seaglass"
    MinWidth="500"
    MinHeight="500"
    PersistenceId="MainWindow"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Seaglass: the ambient backdrop under the title bar and every page, first-run pages included  -->
        <fc:AmbientBackdropView Grid.RowSpan="2" />

        <!--
            1.2.0 (the top bar): the pages run under the bar, which is drawn over them (after them here): the shell starts its
            pages below the bar, or at the top for a hero (ShellPage.UpdateInsets); the pages before sign-in start below it
            (MainWindow.OnRootNavigated).
        -->
        <Frame
            x:Name="RootFrame"
            Grid.Row="0"
            Grid.RowSpan="2"
            Navigated="OnRootNavigated" />

        <views:TitleBarControl Grid.Row="0" VerticalAlignment="Top" />

        <!--
            fluentfin-mpv (startup-perf): the window is shown before the automatic sign-in, which says so here. Shown from a
            bool: through a function of StartupStatus it never went once the text was null (x:Bind skips a function of null).
        -->
        <StackPanel
            x:Name="StartupPanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="12"
            Visibility="{x:Bind ViewModel.HasStartupStatus, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind ViewModel.HasStartupStatus, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.StartupStatus, Mode=OneWay}" />
        </StackPanel>

    </Grid>

</windowex:WindowEx>
