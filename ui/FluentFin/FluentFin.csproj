<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>FluentFin</RootNamespace>
		<ApplicationIcon>Assets/Nixie.ico</ApplicationIcon>
		<!-- Nixie (formerly Seaglass): the app is Nixie.exe / Nixie.dll; the namespaces and project names stay FluentFin.* for upstream merges -->
		<AssemblyName>Nixie</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- 1.2.0: a field assigned but never read is an error (it once hid an endless backdrop animation's missing stop) -->
		<WarningsAsErrors>$(WarningsAsErrors);CS0414</WarningsAsErrors>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- fluentfin-mpv: the release version (shown, and sent to Jellyfin through Core\AppVersion); docs\RELEASE.md -->
		<Version Condition=" '$(BuildVersion)' == '' ">1.4.1</Version>
		<Version Condition=" '$(BuildVersion)' != '' ">$(BuildVersion)</Version>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<!-- Nixie: what Properties > Details shows for Nixie.exe (the launcher and the backend say the same: tools/release) -->
		<Company>Nixie</Company>
		<Product>Nixie</Product>
		<AssemblyTitle>Nixie</AssemblyTitle>
		<Description>Nixie, a Jellyfin client for Windows</Description>
		<Copyright>Copyright (c) Nixie contributors, FluentFin authors and jellyfin-mpv-shim authors. GPL-3.0-or-later</Copyright>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<GenerateAppInstallerFile>True</GenerateAppInstallerFile>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<AppxBundle>Auto</AppxBundle>
		<AppxBundlePlatforms>x64</AppxBundlePlatforms>
		<GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
		<AppInstallerUri>D:\Test\</AppInstallerUri>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
		<FFmpegDir>FFMpeg-arm64</FFmpegDir>
