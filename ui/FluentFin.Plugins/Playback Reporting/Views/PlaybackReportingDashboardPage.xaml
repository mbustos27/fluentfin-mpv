<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Plugins.Playback_Reporting.Views.PlaybackReportingDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentFin.Plugins.Playback_Reporting.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Nixie 1.2.0 (admin): no side pane. The reports are text tabs along the top (SelectorBar: one Tab stop, the arrows move
        between them, Narrator reads "Usage, 4 of 5"); the tabs follow the frame however a report was opened.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Padding="36,16,36,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Spacing="4">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Playback reports" />
            <SelectorBar
                x:Name="ReportBar"
                AutomationProperties.Name="Reports"
                SelectionChanged="ReportBar_SelectionChanged" />
        </StackPanel>

        <Frame x:Name="NavFrame" Grid.Row="1" />
    </Grid>
</Page>
