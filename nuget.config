<?xml version="1.0" encoding="utf-8"?>
<!--
  Local dev: this machine's user-level NuGet.Config lists no package sources, so a plain
  `dotnet build` / `dotnet test` of ui\FluentFin.sln cannot restore anything. NuGet reads
  this file for every project below the repository root, so the build works without
  touching the user's global NuGet settings or the upstream files in ui\.
  The second feed is the one upstream's CI adds (ui\.github\workflows) for the
  CommunityToolkit.Labs packages, which are not on nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="CommunityToolkitLabs" value="https://pkgs.dev.azure.com/dotnet/CommunityToolkit/_packaging/CommunityToolkit-Labs/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
