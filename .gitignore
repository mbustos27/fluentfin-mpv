# Python venv and caches for the backend
backend/.venv/
.venv/
__pycache__/

# Local tool drops (mpv/libmpv copies, logs)
tools/mpv/
*.log

# Release builds (tools\release\build-release.ps1): the package, its zip, and dist\.work
/dist/

