# Python venv and caches for the backend
backend/.venv/
.venv/
__pycache__/

# Local tool drops (mpv/libmpv copies, logs)
tools/mpv/
*.log

# Release builds (tools\release\build-release.ps1): the package, its zip, and dist\.work
/dist/

# Build output of the tool/harness projects
tools/**/bin/
tools/**/obj/
tools/**/out/


# screenshots the dev streams save for review (tools\ui-harness), never committed
/shots/
# video files: the harness builds its test video in a cache and the screenshots' episode stays outside the repository
# (tools\ui-harness\gallery.ps1 -Video); none is committed
*.ogv
*.mkv
*.webm
*.mp4
# agent working notes in each worktree, never committed
/HANDOFF.md
/BRIEF.md
/PAUSED.md
