<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 2a spike (docs/research/player-controls.md): libmpv in this process, rendering in composition mode into a XAML
       SwapChainPanel (or, to compare, into a child window with wid), the shim attached over IPC in the bridge scenario.
       A WinUI window of its own, never Seaglass.exe. It compiles this repo's (or -p:UiDir=<copy>'s) job launcher, links
       the controls host's picture helper, references FluentFin.Core (the backend host) and copies libmpv-2.dll and the DLLs it loads (next to the exe: the spike loads it by name) from
       -p:LibmpvDir (vendor\libmpv\VENDORED.md). Built and run by run.ps1 from a copy under its -Out, never inside ui\. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CompositionSpike</RootNamespace>
    <AssemblyName>CompositionSpike</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RepoDir Condition="'$(RepoDir)' == ''">$(MSBuildThisFileDirectory)..\..\..</RepoDir>
    <UiDir Condition="'$(UiDir)' == ''">$(RepoDir)\ui</UiDir>
    <CoreDir Condition="'$(CoreDir)' == ''">$(UiDir)\FluentFin.Core</CoreDir>
    <ControlsHostDir Condition="'$(ControlsHostDir)' == ''">$(RepoDir)\tools\ui-harness\controls-host</ControlsHostDir>
    <LibmpvDir Condition="'$(LibmpvDir)' == ''">$(RepoDir)\vendor\libmpv\msys2-20261116-mpv-0.42.0-2</LibmpvDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(ControlsHostDir)\Shots.cs" Link="Linked\Shots.cs" />
    <Compile Include="$(UiDir)\FluentFin\Mpv\JobObject.cs" Link="Linked\JobObject.cs" />
    <Compile Include="$(UiDir)\FluentFin\Mpv\JobProcess.cs" Link="Linked\JobProcess.cs" />
    <Compile Include="$(UiDir)\FluentFin\Mpv\WindowsMpvBackendLauncher.cs" Link="Linked\WindowsMpvBackendLauncher.cs" />
    <ProjectReference Include="$(CoreDir)\FluentFin.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(LibmpvDir)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fakeserver.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckLibmpv" BeforeTargets="Build">
    <Error Condition="!Exists('$(LibmpvDir)\libmpv-2.dll')" Text="libmpv-2.dll not found in $(LibmpvDir): download it as vendor\libmpv\VENDORED.md says" />
  </Target>
</Project>
