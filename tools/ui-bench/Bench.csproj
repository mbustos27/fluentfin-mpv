<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs FluentFin.Core against fake servers (Program.cs). Default: this repository's ui\FluentFin.Core. For another Core
    (an upstream FluentFin checkout, a copy of an older commit for before/after numbers) pass
    -p:CoreProject=<copy>\FluentFin.Core\FluentFin.Core.csproj and give each Core its own artifacts-path option
    (a scratch folder). Core types are made by CoreFactory, so their constructors may differ between Cores.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);CS1998;CS8602;CS8604</NoWarn>
    <CoreProject Condition="'$(CoreProject)' == ''">$(MSBuildThisFileDirectory)..\..\ui\FluentFin.Core\FluentFin.Core.csproj</CoreProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="$(CoreProject)" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Blurhash.Core" Version="4.2.1" />
  </ItemGroup>
</Project>
